<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:appearance="using:Forge.App.Appearance"
             xmlns:ap="using:Forge.App.Approval"
             xmlns:views="using:Forge.App.Views"
             xmlns:vm="using:Forge.App.ViewModels"
             xmlns:loc="using:Forge.App.Localization"
             xmlns:term="using:Forge.App.Terminal"
             xmlns:git="using:Forge.App.Git"
             xmlns:notif="using:Forge.App.Notifications"
             xmlns:wc="using:Forge.App.Workbench.Controls"
             xmlns:editing="using:Forge.App.Editing"
             xmlns:set="using:Forge.App.ViewModels.Settings"
             xmlns:settings="using:Forge.App.Settings"
             xmlns:setviews="using:Forge.App.Views.Settings"
             xmlns:autoset="using:Forge.App.Automations.Settings"
             xmlns:promptset="using:Forge.App.Settings.Prompts"
             xmlns:webset="using:Forge.App.Web"
             xmlns:netset="using:Forge.App.Network"
             x:Class="Forge.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Forge.App/Resources/Icons.axaml" />
        <ResourceInclude Source="avares://Forge.App/Resources/Tokens.axaml" />
        <ResourceInclude Source="avares://Forge.App/Resources/Workbench.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <!-- Workbench content: a panel body or a tab carries its view model directly. -->
    <DataTemplate DataType="vm:SessionWorkspaceViewModel" x:DataType="vm:SessionWorkspaceViewModel">
      <views:SessionView />
    </DataTemplate>
    <DataTemplate DataType="vm:FileDocumentViewModel" x:DataType="vm:FileDocumentViewModel">
      <views:FileDocumentView />
    </DataTemplate>
    <DataTemplate DataType="vm:ChangesViewModel" x:DataType="vm:ChangesViewModel">
      <views:ChangesView />
    </DataTemplate>
    <DataTemplate DataType="vm:SubAgentViewModel" x:DataType="vm:SubAgentViewModel">
      <views:SubAgentView />
    </DataTemplate>
    <DataTemplate DataType="vm:FinishedSubAgentsViewModel" x:DataType="vm:FinishedSubAgentsViewModel">
      <views:FinishedSubAgentsHeaderView />
    </DataTemplate>
    <DataTemplate DataType="vm:ProjectTreeViewModel" x:DataType="vm:ProjectTreeViewModel">
      <views:ProjectView />
    </DataTemplate>
    <DataTemplate DataType="vm:FilesPanelViewModel" x:DataType="vm:FilesPanelViewModel">
      <views:FilesToolView />
    </DataTemplate>
    <DataTemplate DataType="vm:TodoListViewModel" x:DataType="vm:TodoListViewModel">
      <views:TodoToolView />
    </DataTemplate>
    <DataTemplate DataType="vm:ReviewPanelViewModel" x:DataType="vm:ReviewPanelViewModel">
      <views:ReviewToolView />
    </DataTemplate>
    <DataTemplate DataType="vm:SpecTreeViewModel" x:DataType="vm:SpecTreeViewModel">
      <views:SpecTreeToolView />
    </DataTemplate>

    <!-- Window overlays (MainWindowViewModel.Palette/Checks/Plan/Inspector/Onboarding): placeholders until their waves. -->
    <DataTemplate DataType="vm:PaletteViewModel" x:DataType="vm:PaletteViewModel">
      <views:PaletteView />
    </DataTemplate>
    <DataTemplate DataType="vm:ChecksPanelViewModel" x:DataType="vm:ChecksPanelViewModel">
      <views:ChecksPanelView />
    </DataTemplate>
    <DataTemplate DataType="vm:PlanPanelViewModel" x:DataType="vm:PlanPanelViewModel">
      <views:PlanPanelView />
    </DataTemplate>
    <DataTemplate DataType="vm:ResourceInspectorViewModel" x:DataType="vm:ResourceInspectorViewModel">
      <views:ResourceInspectorView />
    </DataTemplate>
    <DataTemplate DataType="vm:OnboardingViewModel" x:DataType="vm:OnboardingViewModel">
      <views:OnboardingView />
    </DataTemplate>

    <!-- Terminal: the tab body of a terminal and the terminal settings section. -->
    <DataTemplate DataType="term:TerminalViewModel" x:DataType="term:TerminalViewModel">
      <term:TerminalView />
    </DataTemplate>

    <DataTemplate DataType="term:TerminalSettingsViewModel" x:DataType="term:TerminalSettingsViewModel">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="170,*" Margin="0,2">
        <TextBlock Classes="label" Text="{Binding ShellLabel}" VerticalAlignment="Center" Margin="0,4" />
        <TextBox Grid.Column="1"
                 Classes="mono"
                 Margin="0,4"
                 Text="{Binding Shell, Mode=TwoWay}"
                 PlaceholderText="pwsh"
                 AutomationProperties.AutomationId="terminal-settings-shell"
                 AutomationProperties.Name="{Binding ShellLabel}" />
        <TextBlock Grid.Row="1" Classes="label" Text="{Binding ArgumentsLabel}" VerticalAlignment="Center" Margin="0,4" />
        <TextBox Grid.Row="1"
                 Grid.Column="1"
                 Classes="mono"
                 Margin="0,4"
                 Text="{Binding Arguments, Mode=TwoWay}"
                 PlaceholderText="-l"
                 AutomationProperties.AutomationId="terminal-settings-arguments"
                 AutomationProperties.Name="{Binding ArgumentsLabel}" />
        <TextBlock Grid.Row="2" Classes="label" Text="{Binding ScrollbackLabel}" VerticalAlignment="Center" Margin="0,4" />
        <NumericUpDown Grid.Row="2"
                       Grid.Column="1"
                       Margin="0,4"
                       Minimum="1000"
                       Maximum="100000"
                       Increment="1000"
                       FormatString="0"
                       Value="{Binding ScrollbackLines, Mode=TwoWay}"
                       AutomationProperties.AutomationId="terminal-settings-scrollback"
                       AutomationProperties.Name="{Binding ScrollbackLabel}" />
        <TextBlock Grid.Row="3"
                   Grid.ColumnSpan="2"
                   Classes="caption"
                   TextWrapping="Wrap"
                   Text="{Binding Hint}" />
      </Grid>
    </DataTemplate>

    <!-- Settings sections: a feature registers a view model with SettingsSections and this is where it gets a body. -->
    <DataTemplate DataType="autoset:AutomationsSettingsViewModel" x:DataType="autoset:AutomationsSettingsViewModel">
      <autoset:AutomationsSettingsView />
    </DataTemplate>
    <DataTemplate DataType="promptset:PromptsSettingsViewModel" x:DataType="promptset:PromptsSettingsViewModel">
      <promptset:PromptsSettingsView />
    </DataTemplate>
    <DataTemplate DataType="settings:ProvidersSettingsViewModel" x:DataType="settings:ProvidersSettingsViewModel">
      <settings:ProvidersSettingsView />
    </DataTemplate>

    <DataTemplate DataType="loc:LanguageSettingsViewModel" x:DataType="loc:LanguageSettingsViewModel">
      <StackPanel Spacing="6">
        <RadioButton GroupName="ui-language"
                     Content="{Binding SystemText}"
                     IsChecked="{Binding IsSystem, Mode=TwoWay}" />
        <TextBlock Classes="caption" Margin="24,0,0,0" TextWrapping="Wrap" Text="{Binding SystemResolvedText}" />
        <RadioButton GroupName="ui-language"
                     Content="{Binding ChineseText}"
                     IsChecked="{Binding IsChinese, Mode=TwoWay}" />
        <RadioButton GroupName="ui-language"
                     Content="{Binding EnglishText}"
                     IsChecked="{Binding IsEnglish, Mode=TwoWay}" />
        <TextBlock Classes="caption" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Hint}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="appearance:AppearanceSettingsViewModel" x:DataType="appearance:AppearanceSettingsViewModel">
      <appearance:AppearanceSettingsView />
    </DataTemplate>

    <DataTemplate DataType="vm:PathsSettingsSectionViewModel" x:DataType="vm:PathsSettingsSectionViewModel">
      <ItemsControl ItemsSource="{Binding Paths}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SettingLine">
            <Grid ColumnDefinitions="150,*" Margin="0,3">
              <TextBlock Classes="label" Text="{Binding Label}" VerticalAlignment="Top" />
              <TextBlock Grid.Column="1"
                         Classes="caption"
                         Text="{Binding Value}"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding Value}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>

    <!-- The four instrument sections the session strip's counters open: read-only views of the approvals database, the
         discovered skills, the configured MCP servers and the active session's tool list. -->
    <DataTemplate DataType="set:ApprovalsSettingsSectionViewModel" x:DataType="set:ApprovalsSettingsSectionViewModel">
      <views:InstrumentSectionView />
    </DataTemplate>
    <DataTemplate DataType="set:SkillsSettingsSectionViewModel" x:DataType="set:SkillsSettingsSectionViewModel">
      <views:InstrumentSectionView />
    </DataTemplate>
    <DataTemplate DataType="set:McpSettingsSectionViewModel" x:DataType="set:McpSettingsSectionViewModel">
      <views:InstrumentSectionView />
    </DataTemplate>
    <DataTemplate DataType="set:ToolsSettingsSectionViewModel" x:DataType="set:ToolsSettingsSectionViewModel">
      <!-- Grouped by origin: built-in groups carry a switch per tool, extension and MCP tools are read-only here. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10">
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Hint}" />
          <TextBlock Classes="caption"
                     TextWrapping="Wrap"
                     Text="{Binding InventoryText}"
                     IsVisible="{Binding HasInventory}"
                     AutomationProperties.AutomationId="settings-tools-inventory" />
          <ItemsControl ItemsSource="{Binding Groups}" AutomationProperties.AutomationId="settings-tools-groups">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="set:ToolGroupViewModel">
                <StackPanel Spacing="2" Margin="0,4,0,6">
                  <TextBlock Classes="label" FontWeight="SemiBold" Text="{Binding Title}" />
                  <ItemsControl ItemsSource="{Binding Tools}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="set:ToolRowViewModel">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                          <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}"
                                       FontFamily="{DynamicResource FontMono}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="caption" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" />
                          </StackPanel>
                          <CheckBox Grid.Column="1"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding CanToggle}"
                                    IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                    AutomationProperties.Name="{Binding Name}"
                                    AutomationProperties.AutomationId="settings-tools-switch" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="caption"
                     TextWrapping="Wrap"
                     Text="{Binding EmptyText}"
                     IsVisible="{Binding !HasGroups}" />
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <!-- The notification section: the one switch that decides whether anything is shown at all, in the window or on the desktop. -->
    <DataTemplate DataType="notif:NotificationsSettingsViewModel" x:DataType="notif:NotificationsSettingsViewModel">
      <StackPanel Spacing="6">
        <CheckBox Content="{Binding [notifications.enabled], Source={x:Static loc:Loc.Instance}}"
                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                  AutomationProperties.AutomationId="notifications-enabled"
                  AutomationProperties.Name="{Binding [notifications.enabled], Source={x:Static loc:Loc.Instance}}" />
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   Text="{Binding [notifications.enabledHint], Source={x:Static loc:Loc.Instance}}" />
      </StackPanel>
    </DataTemplate>

    <!-- The extensions section: installed extensions, staged drafts and the remembered approval rules. -->
    <DataTemplate DataType="ap:ExtensionsSettingsSectionViewModel" x:DataType="ap:ExtensionsSettingsSectionViewModel">
      <ap:ExtensionsSettingsView />
    </DataTemplate>

    <!-- The editor section: every option is a live switch on the editor settings the open editors read. -->
    <DataTemplate DataType="editing:EditorSettings" x:DataType="editing:EditorSettings">
      <StackPanel Spacing="2">
        <TextBlock Classes="caption"
                   Margin="0,0,0,6"
                   TextWrapping="Wrap"
                   Text="{Binding [editor.settings.hint], Source={x:Static loc:Loc.Instance}}"
                   AutomationProperties.AutomationId="editor-settings-hint" />
        <CheckBox Content="{Binding [editor.settings.lineNumbers], Source={x:Static loc:Loc.Instance}}"
                  IsChecked="{Binding ShowLineNumbers, Mode=TwoWay}"
                  AutomationProperties.AutomationId="editor-settings-line-numbers" />
        <CheckBox Content="{Binding [editor.settings.wordWrap], Source={x:Static loc:Loc.Instance}}"
                  IsChecked="{Binding WordWrap, Mode=TwoWay}"
                  AutomationProperties.AutomationId="editor-settings-word-wrap" />
        <CheckBox Content="{Binding [editor.settings.spaces], Source={x:Static loc:Loc.Instance}}"
                  IsChecked="{Binding ShowSpaces, Mode=TwoWay}"
                  AutomationProperties.AutomationId="editor-settings-spaces" />
        <CheckBox Content="{Binding [editor.settings.tabs], Source={x:Static loc:Loc.Instance}}"
                  IsChecked="{Binding ShowTabs, Mode=TwoWay}"
                  AutomationProperties.AutomationId="editor-settings-tabs" />
        <CheckBox Content="{Binding [editor.settings.endOfLine], Source={x:Static loc:Loc.Instance}}"
                  IsChecked="{Binding ShowEndOfLine, Mode=TwoWay}"
                  AutomationProperties.AutomationId="editor-settings-eol" />
        <CheckBox Content="{Binding [editor.settings.controlCharacters], Source={x:Static loc:Loc.Instance}}"
                  IsChecked="{Binding ShowControlCharacters, Mode=TwoWay}"
                  AutomationProperties.AutomationId="editor-settings-control" />
        <CheckBox Content="{Binding [editor.settings.currentLine], Source={x:Static loc:Loc.Instance}}"
                  IsChecked="{Binding HighlightCurrentLine, Mode=TwoWay}"
                  AutomationProperties.AutomationId="editor-settings-current-line" />
        <CheckBox Content="{Binding [editor.settings.scrollBelow], Source={x:Static loc:Loc.Instance}}"
                  IsChecked="{Binding ScrollBelowDocument, Mode=TwoWay}"
                  AutomationProperties.AutomationId="editor-settings-scroll-below" />
        <CheckBox Content="{Binding [editor.settings.hyperlinks], Source={x:Static loc:Loc.Instance}}"
                  IsChecked="{Binding Hyperlinks, Mode=TwoWay}"
                  AutomationProperties.AutomationId="editor-settings-hyperlinks" />
        <CheckBox Content="{Binding [editor.settings.folding], Source={x:Static loc:Loc.Instance}}"
                  IsChecked="{Binding AutoFolding, Mode=TwoWay}"
                  AutomationProperties.AutomationId="editor-settings-folding" />
        <CheckBox Content="{Binding [editor.settings.tabsToSpaces], Source={x:Static loc:Loc.Instance}}"
                  IsChecked="{Binding TabsToSpaces, Mode=TwoWay}"
                  AutomationProperties.AutomationId="editor-settings-tabs-to-spaces" />
        <Grid ColumnDefinitions="150,*" Margin="0,6,0,0">
          <TextBlock Classes="label"
                     VerticalAlignment="Center"
                     Text="{Binding [editor.settings.indentation], Source={x:Static loc:Loc.Instance}}" />
          <NumericUpDown Grid.Column="1"
                         MinWidth="120"
                         HorizontalAlignment="Left"
                         Minimum="1"
                         Maximum="8"
                         Increment="1"
                         FormatString="0"
                         Value="{Binding IndentationSize, Mode=TwoWay}"
                         AutomationProperties.AutomationId="editor-settings-indentation" />
        </Grid>
        <Grid ColumnDefinitions="150,*" Margin="0,3">
          <TextBlock Classes="label"
                     VerticalAlignment="Center"
                     Text="{Binding [editor.settings.rulers], Source={x:Static loc:Loc.Instance}}" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBox MinWidth="170"
                     HorizontalAlignment="Left"
                     Text="{Binding ColumnRulers, Mode=TwoWay}"
                     AutomationProperties.AutomationId="editor-settings-rulers" />
            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       Text="{Binding [editor.settings.rulersHint], Source={x:Static loc:Loc.Instance}}" />
          </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="150,*" Margin="0,3">
          <TextBlock Classes="label"
                     VerticalAlignment="Center"
                     Text="{Binding [editor.settings.theme], Source={x:Static loc:Loc.Instance}}" />
          <ComboBox Grid.Column="1"
                    MinWidth="170"
                    HorizontalAlignment="Left"
                    SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}"
                    AutomationProperties.AutomationId="editor-settings-theme">
            <ComboBoxItem Content="{Binding [editor.settings.theme.auto], Source={x:Static loc:Loc.Instance}}" />
            <ComboBoxItem Content="{Binding [editor.settings.theme.light], Source={x:Static loc:Loc.Instance}}" />
            <ComboBoxItem Content="{Binding [editor.settings.theme.dark], Source={x:Static loc:Loc.Instance}}" />
          </ComboBox>
        </Grid>
      </StackPanel>
    </DataTemplate>

    <!-- The web section: search backend, key or SearXNG URL, test and the private-network switch. -->
    <DataTemplate DataType="webset:WebSettingsSectionViewModel" x:DataType="webset:WebSettingsSectionViewModel">
      <StackPanel Spacing="8">
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="{Binding [web.hint], Source={x:Static loc:Loc.Instance}}" />
        <Grid ColumnDefinitions="150,*" Margin="0,3">
          <TextBlock Classes="label" VerticalAlignment="Center"
                     Text="{Binding [web.backend], Source={x:Static loc:Loc.Instance}}" />
          <ComboBox Grid.Column="1" MinWidth="200" HorizontalAlignment="Left"
                    ItemsSource="{Binding Backends}"
                    SelectedItem="{Binding SelectedBackend, Mode=TwoWay}"
                    AutomationProperties.AutomationId="web-backend">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="webset:WebBackendOption">
                <TextBlock Classes="caption" Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
        <StackPanel Spacing="4" IsVisible="{Binding ShowsKey}">
          <TextBlock Classes="label" Text="{Binding [web.apiKey], Source={x:Static loc:Loc.Instance}}" />
          <TextBox Text="{Binding ApiKeyText, Mode=TwoWay}" PasswordChar="•"
                   PlaceholderText="{Binding [web.apiKey.placeholder], Source={x:Static loc:Loc.Instance}}"
                   AutomationProperties.AutomationId="web-api-key" />
          <TextBlock Classes="caption" IsVisible="{Binding HasStoredKey}"
                     Text="{Binding [web.apiKey.stored], Source={x:Static loc:Loc.Instance}}" />
        </StackPanel>
        <StackPanel Spacing="4" IsVisible="{Binding ShowsUrl}">
          <TextBlock Classes="label" Text="{Binding [web.searxngUrl], Source={x:Static loc:Loc.Instance}}" />
          <TextBox Text="{Binding SearxngUrl, Mode=TwoWay}" PlaceholderText="https://searx.example.org"
                   AutomationProperties.AutomationId="web-searxng-url" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{Binding [web.save], Source={x:Static loc:Loc.Instance}}"
                  Command="{Binding SaveCommand}" AutomationProperties.AutomationId="web-save" />
          <Button Content="{Binding [web.test], Source={x:Static loc:Loc.Instance}}"
                  Command="{Binding TestCommand}" AutomationProperties.AutomationId="web-test" />
        </StackPanel>
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding StatusText}" />
        <CheckBox Content="{Binding [web.allowPrivate], Source={x:Static loc:Loc.Instance}}"
                  IsChecked="{Binding AllowPrivateNetwork, Mode=TwoWay}"
                  AutomationProperties.AutomationId="web-allow-private" />
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="{Binding [web.allowPrivate.hint], Source={x:Static loc:Loc.Instance}}" />
      </StackPanel>
    </DataTemplate>

    <!-- The network section: DNS mode and proxy mode for every outbound connection, validated inline; Apply saves and applies live, Test resolves a host with the entered settings. -->
    <DataTemplate DataType="netset:NetworkSettingsSectionViewModel" x:DataType="netset:NetworkSettingsSectionViewModel">
      <StackPanel Spacing="8">
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="{Binding [network.hint], Source={x:Static loc:Loc.Instance}}" />
        <TextBlock Classes="caption" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                   IsVisible="{Binding HasLoadProblem}" Text="{Binding LoadProblemText}" />
        <TextBlock Classes="label" Text="{Binding [network.dns], Source={x:Static loc:Loc.Instance}}" />
        <StackPanel Orientation="Horizontal" Spacing="16">
          <RadioButton GroupName="network-dns" IsChecked="{Binding IsDnsSystem, Mode=TwoWay}"
                       Content="{Binding [network.dns.system], Source={x:Static loc:Loc.Instance}}"
                       AutomationProperties.AutomationId="network-dns-system" />
          <RadioButton GroupName="network-dns" IsChecked="{Binding IsDnsServers, Mode=TwoWay}"
                       Content="{Binding [network.dns.servers], Source={x:Static loc:Loc.Instance}}"
                       AutomationProperties.AutomationId="network-dns-servers" />
          <RadioButton GroupName="network-dns" IsChecked="{Binding IsDnsDoh, Mode=TwoWay}"
                       Content="{Binding [network.dns.doh], Source={x:Static loc:Loc.Instance}}"
                       AutomationProperties.AutomationId="network-dns-doh" />
        </StackPanel>
        <StackPanel Spacing="4" IsVisible="{Binding IsDnsServers}">
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="{Binding [network.dns.servers.label], Source={x:Static loc:Loc.Instance}}" />
          <TextBox Text="{Binding ServersText, Mode=TwoWay}" AcceptsReturn="True" MinHeight="56"
                   PlaceholderText="1.1.1.1"
                   AutomationProperties.AutomationId="network-dns-servers-text" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                     IsVisible="{Binding HasServersError}" Text="{Binding ServersError}" />
        </StackPanel>
        <StackPanel Spacing="4" IsVisible="{Binding IsDnsDoh}">
          <TextBlock Classes="caption" Text="{Binding [network.dns.doh.label], Source={x:Static loc:Loc.Instance}}" />
          <TextBox Text="{Binding DohUrl, Mode=TwoWay}" PlaceholderText="https://1.1.1.1/dns-query"
                   AutomationProperties.AutomationId="network-doh-url" />
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="{Binding [network.dns.doh.hint], Source={x:Static loc:Loc.Instance}}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                     IsVisible="{Binding HasDohError}" Text="{Binding DohError}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                     IsVisible="{Binding ShowsDohNameHint}"
                     Text="{Binding [network.dns.doh.nameHint], Source={x:Static loc:Loc.Instance}}"
                     AutomationProperties.AutomationId="network-doh-name-hint" />
        </StackPanel>
        <TextBlock Classes="label" Margin="0,6,0,0" Text="{Binding [network.proxy], Source={x:Static loc:Loc.Instance}}" />
        <StackPanel Orientation="Horizontal" Spacing="16">
          <RadioButton GroupName="network-proxy" IsChecked="{Binding IsProxySystem, Mode=TwoWay}"
                       Content="{Binding [network.proxy.system], Source={x:Static loc:Loc.Instance}}"
                       AutomationProperties.AutomationId="network-proxy-system" />
          <RadioButton GroupName="network-proxy" IsChecked="{Binding IsProxyNone, Mode=TwoWay}"
                       Content="{Binding [network.proxy.none], Source={x:Static loc:Loc.Instance}}"
                       AutomationProperties.AutomationId="network-proxy-none" />
          <RadioButton GroupName="network-proxy" IsChecked="{Binding IsProxyManual, Mode=TwoWay}"
                       Content="{Binding [network.proxy.manual], Source={x:Static loc:Loc.Instance}}"
                       AutomationProperties.AutomationId="network-proxy-manual" />
        </StackPanel>
        <StackPanel Spacing="4" IsVisible="{Binding IsProxyManual}">
          <TextBlock Classes="caption" Text="{Binding [network.proxy.url], Source={x:Static loc:Loc.Instance}}" />
          <TextBox Text="{Binding ProxyUrl, Mode=TwoWay}" PlaceholderText="socks5://127.0.0.1:1080"
                   AutomationProperties.AutomationId="network-proxy-url" />
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="{Binding [network.proxy.url.hint], Source={x:Static loc:Loc.Instance}}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                     IsVisible="{Binding HasProxyError}" Text="{Binding ProxyError}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                     IsVisible="{Binding ShowsSocks4Hint}"
                     Text="{Binding [network.proxy.socks4.hint], Source={x:Static loc:Loc.Instance}}"
                     AutomationProperties.AutomationId="network-proxy-socks4-hint" />
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="{Binding [network.proxy.bypass], Source={x:Static loc:Loc.Instance}}" />
          <TextBox Text="{Binding BypassText, Mode=TwoWay}" AcceptsReturn="True" MinHeight="56"
                   PlaceholderText="*.corp.example"
                   AutomationProperties.AutomationId="network-proxy-bypass" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                     IsVisible="{Binding HasBypassError}" Text="{Binding BypassError}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
          <Button Content="{Binding [network.apply], Source={x:Static loc:Loc.Instance}}"
                  Command="{Binding ApplyCommand}" IsEnabled="{Binding IsValid}"
                  AutomationProperties.AutomationId="network-apply" />
          <TextBox Text="{Binding TestHost, Mode=TwoWay}" MinWidth="200"
                   PlaceholderText="{Binding [network.test.host], Source={x:Static loc:Loc.Instance}}"
                   AutomationProperties.AutomationId="network-test-host" />
          <Button Content="{Binding [network.test], Source={x:Static loc:Loc.Instance}}"
                  Command="{Binding TestCommand}" IsEnabled="{Binding IsValid}"
                  AutomationProperties.AutomationId="network-test" />
        </StackPanel>
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding StatusText}" />
      </StackPanel>
    </DataTemplate>

    <!-- The chat section: how large a tool result's images render in the transcript and whether the model receives them. -->
    <DataTemplate DataType="settings:ChatSettingsSectionViewModel" x:DataType="settings:ChatSettingsSectionViewModel">
      <setviews:ChatSettingsSectionView />
    </DataTemplate>

    <!-- The files section: what the rich viewer parses (CSV rows, notebook output, image size limit). -->
    <DataTemplate DataType="settings:FilesSettingsSectionViewModel" x:DataType="settings:FilesSettingsSectionViewModel">
      <setviews:FilesSettingsSectionView />
    </DataTemplate>

    <!-- The git section: pull strategy, network timeout, step commits, the checks wait timing and the gh path, edited live on the preferences they belong to. Notifications are not a git preference any more; the notification section owns that switch. -->
    <DataTemplate DataType="git:GitSettingsSectionViewModel" x:DataType="git:GitSettingsSectionViewModel">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="150,*" Margin="0,3">
          <TextBlock Classes="label"
                     VerticalAlignment="Center"
                     Text="{Binding [git.settings.pullStrategy], Source={x:Static loc:Loc.Instance}}" />
          <ComboBox Grid.Column="1"
                    MinWidth="170"
                    HorizontalAlignment="Left"
                    ItemsSource="{Binding PullStrategies}"
                    SelectedItem="{Binding SelectedPullStrategy, Mode=TwoWay}"
                    AutomationProperties.AutomationId="git-pull-strategy"
                    AutomationProperties.Name="{Binding [git.settings.pullStrategy], Source={x:Static loc:Loc.Instance}}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="git:GitPullStrategyOption">
                <TextBlock Classes="caption" Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
        <Grid ColumnDefinitions="150,*" Margin="0,3">
          <TextBlock Classes="label"
                     VerticalAlignment="Center"
                     Text="{Binding [git.settings.networkTimeout], Source={x:Static loc:Loc.Instance}}" />
          <NumericUpDown Grid.Column="1"
                         MinWidth="120"
                         HorizontalAlignment="Left"
                         Minimum="10"
                         Maximum="600"
                         Increment="10"
                         FormatString="0"
                         Value="{Binding NetworkTimeoutSeconds, Mode=TwoWay}"
                         AutomationProperties.AutomationId="git-network-timeout"
                         AutomationProperties.Name="{Binding [git.settings.networkTimeout], Source={x:Static loc:Loc.Instance}}" />
        </Grid>
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   Text="{Binding [git.settings.networkTimeoutHint], Source={x:Static loc:Loc.Instance}}" />
        <Grid ColumnDefinitions="150,*" Margin="0,9,0,3">
          <TextBlock Classes="label"
                     VerticalAlignment="Center"
                     Text="{Binding [git.settings.stepCommits], Source={x:Static loc:Loc.Instance}}" />
          <CheckBox Grid.Column="1"
                    IsChecked="{Binding StepCommits, Mode=TwoWay}"
                    AutomationProperties.AutomationId="git-step-commits"
                    AutomationProperties.Name="{Binding [git.settings.stepCommits], Source={x:Static loc:Loc.Instance}}" />
        </Grid>
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   Text="{Binding [git.settings.stepCommitsHint], Source={x:Static loc:Loc.Instance}}" />
        <Grid ColumnDefinitions="150,*" Margin="0,9,0,3">
          <TextBlock Classes="label"
                     VerticalAlignment="Center"
                     Text="{Binding [git.settings.checksPoll], Source={x:Static loc:Loc.Instance}}" />
          <NumericUpDown Grid.Column="1"
                         MinWidth="120"
                         HorizontalAlignment="Left"
                         Minimum="10"
                         Maximum="300"
                         Increment="5"
                         FormatString="0"
                         Value="{Binding ChecksPollSeconds, Mode=TwoWay}"
                         AutomationProperties.AutomationId="git-checks-poll"
                         AutomationProperties.Name="{Binding [git.settings.checksPoll], Source={x:Static loc:Loc.Instance}}" />
        </Grid>
        <Grid ColumnDefinitions="150,*" Margin="0,3">
          <TextBlock Classes="label"
                     VerticalAlignment="Center"
                     Text="{Binding [git.settings.checksMaxWait], Source={x:Static loc:Loc.Instance}}" />
          <NumericUpDown Grid.Column="1"
                         MinWidth="120"
                         HorizontalAlignment="Left"
                         Minimum="1"
                         Maximum="180"
                         Increment="5"
                         FormatString="0"
                         Value="{Binding ChecksMaxWaitMinutes, Mode=TwoWay}"
                         AutomationProperties.AutomationId="git-checks-max-wait"
                         AutomationProperties.Name="{Binding [git.settings.checksMaxWait], Source={x:Static loc:Loc.Instance}}" />
        </Grid>
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   Text="{Binding [git.settings.checksHint], Source={x:Static loc:Loc.Instance}}" />
        <Grid ColumnDefinitions="150,*" Margin="0,9,0,3">
          <TextBlock Classes="label"
                     VerticalAlignment="Center"
                     Text="{Binding [git.settings.ghPath], Source={x:Static loc:Loc.Instance}}" />
          <TextBox Grid.Column="1"
                   MinWidth="260"
                   HorizontalAlignment="Left"
                   PlaceholderText="gh"
                   Text="{Binding GhPath, Mode=TwoWay}"
                   AutomationProperties.AutomationId="git-gh-path"
                   AutomationProperties.Name="{Binding [git.settings.ghPath], Source={x:Static loc:Loc.Instance}}" />
        </Grid>
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   Text="{Binding [git.settings.ghPathHint], Source={x:Static loc:Loc.Instance}}" />
      </StackPanel>
    </DataTemplate>

    <!-- User message: IM-style bubble aligned right. -->
    <DataTemplate DataType="vm:UserMessageViewModel" x:DataType="vm:UserMessageViewModel">
      <StackPanel Margin="0,10,0,4" HorizontalAlignment="Right" Spacing="2">
        <!-- Attached images: small thumbnails above the bubble, right-aligned like it. -->
        <ItemsControl ItemsSource="{Binding Images}"
                      IsVisible="{Binding HasImages}"
                      HorizontalAlignment="Right">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel HorizontalAlignment="Right" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TranscriptImageViewModel">
              <Border Width="72"
                      Height="72"
                      Margin="6,0,0,4"
                      CornerRadius="6"
                      ClipToBounds="True"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource BorderBrush}"
                      Background="{DynamicResource SurfaceMutedBrush}"
                      ToolTip.Tip="{Binding Caption}">
                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- Other attachments (PDF, audio, video, text files): a chip each with icon, name and size. -->
        <ItemsControl ItemsSource="{Binding Files}"
                      IsVisible="{Binding HasFiles}"
                      HorizontalAlignment="Right">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel HorizontalAlignment="Right" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TranscriptFileViewModel">
              <Border Margin="6,0,0,4"
                      Padding="8,4"
                      CornerRadius="6"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource BorderBrush}"
                      Background="{DynamicResource SurfaceMutedBrush}"
                      ToolTip.Tip="{Binding Name}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <wc:FluentIcon Data="{StaticResource IconChangesDocument}" Width="14" Height="14" VerticalAlignment="Center" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="caption" Text="{Binding Caption}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Classes="user-bubble" IsVisible="{Binding HasText}">
          <SelectableTextBlock Text="{Binding Text}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
          <views:CopyTextButton Classes="ghost icon"
                                Width="26"
                                Height="22"
                                IsVisible="{Binding HasText}"
                                ToolTip.Tip="{Binding [turn.copyMessage], Source={x:Static loc:Loc.Instance}}"
                                AutomationProperties.AutomationId="message-copy"
                                AutomationProperties.Name="{Binding [turn.copyMessage], Source={x:Static loc:Loc.Instance}}">
            <wc:FluentIcon Data="{StaticResource IconCopy}" Width="13" Height="13" />
          </views:CopyTextButton>
          <TextBlock Classes="caption" Text="{Binding Time}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:NoticeViewModel" x:DataType="vm:NoticeViewModel">
      <Border Classes="notice" Classes.error="{Binding IsError}" Margin="0,4">
        <TextBlock Classes="caption" Text="{Binding Text}" TextWrapping="Wrap" />
      </Border>
    </DataTemplate>

    <!-- One agent turn: header line plus the tree of reply text and tool rows. -->
    <DataTemplate DataType="vm:TurnCardViewModel" x:DataType="vm:TurnCardViewModel">
      <Border Classes="turn-card" Margin="0,6">
        <StackPanel Spacing="0">
          <Border Classes="turn-header">
            <Button Classes="link"
                    Command="{Binding ToggleCommand}"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Left"
                    AutomationProperties.AutomationId="turn-toggle"
                    AutomationProperties.Name="{Binding [turn.collapse], Source={x:Static loc:Loc.Instance}}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="glyph" Text="{Binding ExpandGlyph}" />
                <TextBlock Classes="caption" Text="{Binding Header}" />
              </StackPanel>
            </Button>
          </Border>
          <Border Classes="turn-body" IsVisible="{Binding IsExpanded}">
            <ItemsControl ItemsSource="{Binding Blocks}" />
          </Border>
          <TextBlock Classes="caption"
                     Margin="4,4,0,0"
                     IsVisible="{Binding HasFootnote}"
                     Text="{Binding Footnote}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="vm:TurnTextViewModel" x:DataType="vm:TurnTextViewModel">
      <views:TurnTextView />
    </DataTemplate>

    <DataTemplate DataType="vm:TurnNoticeViewModel" x:DataType="vm:TurnNoticeViewModel">
      <Border Classes="notice" Classes.error="{Binding IsError}">
        <TextBlock Classes="caption" Text="{Binding Text}" TextWrapping="Wrap" />
      </Border>
    </DataTemplate>

    <DataTemplate DataType="vm:ToolRowViewModel" x:DataType="vm:ToolRowViewModel">
      <views:ToolRowView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <Style Selector=":is(Window)">
      <Setter Property="Icon" Value="avares://Forge.App/Assets/forge.ico" />
    </Style>
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://Forge.App/Resources/Controls.axaml" />
    <StyleInclude Source="avares://Forge.App/Appearance/AppearanceStyles.axaml" />
  </Application.Styles>
</Application>
