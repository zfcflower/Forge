<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:term="using:Forge.App.Terminal"
             x:Class="Forge.App.Terminal.TerminalView"
             x:DataType="term:TerminalViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://Forge.App/Resources/ChromeStyles.axaml" />
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource WindowBackgroundBrush}">

    <!-- Vetoed close: a program is still running, so the tab stays and this banner asks what to do. -->
    <Border Grid.Row="0"
            Classes="notice"
            Margin="8,6,8,0"
            IsVisible="{Binding IsClosePromptVisible}"
            AutomationProperties.AutomationId="terminal-close-banner">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Classes="caption"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{Binding ClosePromptText}"
                   AutomationProperties.AutomationId="terminal-close-prompt" />
        <Button Grid.Column="1"
                Classes="primary"
                Margin="10,0,0,0"
                Content="{Binding ConfirmCloseText}"
                Command="{Binding ConfirmCloseCommand}"
                AutomationProperties.AutomationId="terminal-close-confirm"
                AutomationProperties.Name="{Binding ConfirmCloseText}" />
        <Button Grid.Column="2"
                Classes="ghost"
                Margin="6,0,0,0"
                Content="{Binding CancelCloseText}"
                Command="{Binding CancelCloseCommand}"
                AutomationProperties.AutomationId="terminal-close-cancel"
                AutomationProperties.Name="{Binding CancelCloseText}" />
      </Grid>
    </Border>

    <!-- Buffer search (Ctrl+F): the query, the case toggle, where the cursor sits in the result set and the two
         navigation buttons. Esc closes it, Enter walks the matches. -->
    <Border Grid.Row="1"
            Padding="8,5"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            IsVisible="{Binding IsSearchVisible}"
            AutomationProperties.AutomationId="terminal-search-bar">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto">
        <TextBox x:Name="SearchQuery"
                 Grid.Column="0"
                 MinHeight="26"
                 VerticalContentAlignment="Center"
                 Text="{Binding SearchText}"
                 PlaceholderText="{Binding SearchPlaceholder}"
                 AutomationProperties.AutomationId="terminal-search-query"
                 AutomationProperties.Name="{Binding SearchPlaceholder}" />
        <ToggleButton Grid.Column="1"
                      Margin="6,0,0,0"
                      Padding="7,0"
                      MinHeight="26"
                      VerticalContentAlignment="Center"
                      IsChecked="{Binding SearchCaseSensitive}"
                      Content="{Binding SearchCaseText}"
                      ToolTip.Tip="{Binding SearchCaseText}"
                      AutomationProperties.AutomationId="terminal-search-case" />
        <TextBlock Grid.Column="2"
                   Classes="mono"
                   Margin="10,0,0,0"
                   VerticalAlignment="Center"
                   Text="{Binding SearchMatchLabel}"
                   AutomationProperties.AutomationId="terminal-search-count" />
        <TextBlock Grid.Column="3"
                   Classes="caption"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center"
                   Text="{Binding SearchNoMatchesText}"
                   IsVisible="{Binding ShowSearchNoMatches}"
                   AutomationProperties.AutomationId="terminal-search-empty" />
        <Button Grid.Column="4"
                Classes="ghost"
                MinWidth="28"
                MinHeight="26"
                Margin="8,0,0,0"
                Padding="6,0"
                Content="&#x2191;"
                Command="{Binding SearchPreviousCommand}"
                ToolTip.Tip="{Binding SearchPreviousText}"
                AutomationProperties.AutomationId="terminal-search-previous"
                AutomationProperties.Name="{Binding SearchPreviousText}" />
        <Button Grid.Column="5"
                Classes="ghost"
                MinWidth="28"
                MinHeight="26"
                Margin="4,0,0,0"
                Padding="6,0"
                Content="&#x2193;"
                Command="{Binding SearchNextCommand}"
                ToolTip.Tip="{Binding SearchNextText}"
                AutomationProperties.AutomationId="terminal-search-next"
                AutomationProperties.Name="{Binding SearchNextText}" />
        <Button Grid.Column="6"
                Classes="ghost"
                MinWidth="28"
                MinHeight="26"
                Margin="4,0,0,0"
                Padding="6,0"
                Content="&#x2715;"
                Command="{Binding CloseSearchCommand}"
                ToolTip.Tip="{Binding SearchCloseText}"
                AutomationProperties.AutomationId="terminal-search-close"
                AutomationProperties.Name="{Binding SearchCloseText}" />
      </Grid>
    </Border>

    <term:TerminalControl Grid.Row="2" Source="{Binding}" />

    <!-- One local line after the screen: "starting", the exit code, or why the terminal stopped. A terminal that is over
         offers a restart here, next to the reason it stopped. -->
    <Border Grid.Row="3"
            Padding="10,3"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            IsVisible="{Binding ShowStatus}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Text="{Binding StatusText}"
                   AutomationProperties.AutomationId="terminal-status" />
        <Button Grid.Column="1"
                Classes="ghost"
                Margin="10,0,0,0"
                MinHeight="24"
                Padding="8,0"
                Content="{Binding RestartText}"
                Command="{Binding RestartCommand}"
                IsVisible="{Binding CanRestart}"
                AutomationProperties.AutomationId="terminal-restart"
                AutomationProperties.Name="{Binding RestartText}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
