<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="using:Forge.App.Settings"
        x:Class="Forge.App.Settings.ProviderEditorWindow"
        x:DataType="settings:ProviderEditorViewModel"
        Title="{Binding Title}"
        Width="480"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBackgroundBrush}">
  <Window.Styles>
    <Style Selector="TextBlock.field-label">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Margin" Value="0,0,0,3" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto" Margin="18,16">
    <StackPanel Grid.Row="0" Spacing="12">
      <StackPanel Spacing="3">
        <TextBlock Classes="field-label" Text="{Binding NameLabel}" />
        <TextBox Text="{Binding Name, Mode=TwoWay}"
                 AutomationProperties.AutomationId="provider-editor-name" />
      </StackPanel>

      <StackPanel Spacing="3">
        <TextBlock Classes="field-label" Text="{Binding BaseUrlLabel}" />
        <TextBox Text="{Binding BaseUrl, Mode=TwoWay}"
                 IsReadOnly="{Binding !CanEditBaseUrl}"
                 AutomationProperties.AutomationId="provider-editor-baseurl" />
      </StackPanel>

      <StackPanel Spacing="6" IsVisible="{Binding ShowsKey}">
        <TextBlock Classes="field-label" Text="{Binding KeyLabel}" />
        <CheckBox Content="{Binding KeyAsSecretText}"
                  IsChecked="{Binding KeyIsSecret, Mode=TwoWay}"
                  AutomationProperties.AutomationId="provider-editor-key-as-secret" />
        <TextBox IsVisible="{Binding KeyIsSecret}"
                 Text="{Binding KeyText, Mode=TwoWay}"
                 PasswordChar="•"
                 PlaceholderText="{Binding KeyPlaceholder}"
                 AutomationProperties.AutomationId="provider-editor-secret" />
        <TextBox IsVisible="{Binding !KeyIsSecret}"
                 Text="{Binding KeyText, Mode=TwoWay}"
                 AutomationProperties.Name="{Binding KeyVariableLabel}"
                 AutomationProperties.AutomationId="provider-editor-envvar" />
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding KeyHint}" />
      </StackPanel>

      <StackPanel Spacing="3">
        <TextBlock Classes="field-label" Text="{Binding HeadersLabel}" />
        <TextBox Text="{Binding HeadersText, Mode=TwoWay}"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 MinHeight="56"
                 MaxHeight="120"
                 FontFamily="{DynamicResource FontMono}"
                 AutomationProperties.Name="{Binding HeadersLabel}"
                 AutomationProperties.AutomationId="provider-editor-headers" />
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding HeadersHint}" />
      </StackPanel>

      <TextBlock Classes="caption"
                 IsVisible="{Binding HasStatus}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource SuccessBrush}"
                 Text="{Binding Status}"
                 AutomationProperties.AutomationId="provider-editor-status" />
      <TextBlock Classes="caption"
                 IsVisible="{Binding HasError}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource DangerBrush}"
                 Text="{Binding Error}"
                 AutomationProperties.AutomationId="provider-editor-error" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
      <Button Grid.Column="0"
              Classes="ghost"
              Command="{Binding CancelCommand}"
              Content="{Binding CancelText}"
              AutomationProperties.AutomationId="provider-editor-cancel" />
      <Button Grid.Column="2"
              Classes="primary"
              Command="{Binding TestOrSaveCommand}"
              Content="{Binding TestOrSaveText}"
              AutomationProperties.AutomationId="provider-editor-test-or-save" />
    </Grid>
  </Grid>
</Window>
