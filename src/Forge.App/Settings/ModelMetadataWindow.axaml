<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="using:Forge.App.Settings"
        xmlns:wc="using:Forge.App.Workbench.Controls"
        x:Class="Forge.App.Settings.ModelMetadataWindow"
        x:DataType="settings:ModelMetadataViewModel"
        Title="{Binding Title}"
        Width="1040"
        Height="620"
        MinWidth="920"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
  <!-- The settings sheet (buttons, headings, the field themes) is attached to the two small subtrees that need it - the
       title and the footer - instead of the window: every element in scope pays a match against each of its rules, and the
       table realizes a few hundred elements per screen for nothing (bench: table.metadata.open, ~87 ms of it). -->
  <Window.Styles>
    <Style Selector="TextBlock.meta-header">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- A number cell is the app's one number field (stepper and all), sized for the column instead of the 130 px the stock
         theme asks for: the cell is 94-120 px wide and the table already owns the layout. Its format is the column's -
         whole numbers for the window, up to six decimals for a price, the same digits InputRules accepts - and an empty box
         stays empty: a null value formats to nothing, not to "0". -->
    <Style Selector="NumericUpDown.meta-cell">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="6,4" />
      <!-- The control refuses a value outside its bounds and keeps the typed text, so the bounds are the whole number line:
           a negative or a zero window is InputRules' call (red cell, save blocked), not a silently dropped keystroke. -->
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="{x:Static settings:ModelMetadataRowViewModel.MaxCellValue}" />
    </Style>
    <!-- The cell keeps the field's bottom edge: without it the box looked cut off by the row line underneath. -->
    <Style Selector="Border.meta-line">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <!-- The editable cells wear the pale Tiffany tint and the cell the arrow keys are on steps one shade deeper. Both are
         styles rather than a Background in the templates: a local value outranks a style, and the highlight has to win. -->
    <Style Selector="Border.meta-line.editable">
      <Setter Property="Background" Value="{DynamicResource TiffanyTintBrush}" />
    </Style>
    <Style Selector="Border.meta-line.current">
      <Setter Property="Background" Value="{DynamicResource TiffanySelectionBrush}" />
    </Style>
    <!-- A resting number cell that cannot be saved draws the frame its field would: red on all four sides, same 1 px. -->
    <Style Selector="Border.meta-line.invalid">
      <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.meta-status">
      <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}" />
    </Style>
    <Style Selector="TextBlock.meta-status.error">
      <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
    </Style>
    <!-- The table: the control's own chrome is replaced by the window's band, cell grid and row lines; its border is the
         frame itself (BorderBrush/BorderThickness set on the instance, like the table preview's). -->
    <Style Selector="TableView">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TableViewCell">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TableViewColumnHeader">
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <!-- Columns are sized to their content and stay that way until the user drags a separator; the resizer's 1px line is
         kept inside the header band by the TableViewColumnResizerMargin override in the resources. -->
    <Style Selector="TableViewRow">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <!-- Banded rows: the classes come from the window's ContainerPrepared handler, which also runs on recycled rows. -->
    <Style Selector="TableViewRow.alt">
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
    </Style>
  </Window.Styles>
  <Window.Resources>
    <Thickness x:Key="TableViewRowPadding">0</Thickness>
    <!-- The separator the user drags to resize a column. The theme's handle reaches 9 px above and 12 px below the header, so
         its 1px line is drawn across the first row; keeping only the horizontal overhang leaves a 6 px grab band on each side
         of the grid line, inside the header band. A style cannot do this: the template's own value outranks a style setter. -->
    <Thickness x:Key="TableViewColumnResizerMargin">0,0,-6,0</Thickness>
    <!-- One cell template per column: the window builds the columns (their headers are localized and one of them is
         conditional), so each cell's markup lives here and is picked by a resource key. -->
    <DataTemplate x:Key="MetaVisibilityCell" x:DataType="settings:ModelMetadataRowViewModel">
      <Border Classes="meta-line" Padding="8,3">
        <CheckBox IsChecked="{Binding IsShown, Mode=TwoWay}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  ToolTip.Tip="{Binding Model}"
                  AutomationProperties.AutomationId="{Binding Model, StringFormat=model-metadata-shown-{0}}"
                  AutomationProperties.Name="{Binding Model}" />
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="MetaModelCell" x:DataType="settings:ModelMetadataRowViewModel">
      <Border Classes="meta-line" Padding="8,3">
        <TextBlock Text="{Binding Model}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding Model}" />
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="MetaCapabilitiesCell" x:DataType="settings:ModelMetadataRowViewModel">
      <Border Classes="meta-line"
              Padding="8,3"
              AutomationProperties.Name="{Binding CapabilitiesText}">
        <StackPanel Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{Binding CapabilitiesText}">
          <wc:FluentIcon Data="{StaticResource IconText}"
                         Width="14"
                         Height="14"
                         IsVisible="{Binding HasTextInput}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         ToolTip.Tip="{Binding TextCapabilityLabel}" />
          <wc:FluentIcon Data="{StaticResource IconImage}"
                         Width="14"
                         Height="14"
                         IsVisible="{Binding HasImageInput}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         ToolTip.Tip="{Binding ImageCapabilityLabel}" />
          <wc:FluentIcon Data="{StaticResource IconPdf}"
                         Width="14"
                         Height="14"
                         IsVisible="{Binding HasPdfInput}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         ToolTip.Tip="{Binding PdfCapabilityLabel}" />
          <wc:FluentIcon Data="{StaticResource IconAudio}"
                         Width="14"
                         Height="14"
                         IsVisible="{Binding HasAudioInput}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         ToolTip.Tip="{Binding AudioCapabilityLabel}" />
          <wc:FluentIcon Data="{StaticResource IconVideo}"
                         Width="14"
                         Height="14"
                         IsVisible="{Binding HasVideoInput}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         ToolTip.Tip="{Binding VideoCapabilityLabel}" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="MetaReasoningCell" x:DataType="settings:ModelMetadataRowViewModel">
      <Border Classes="meta-line" Padding="8,3" AutomationProperties.Name="{Binding ReasoningLabel}">
        <!-- A grid, not a horizontal stack: the tier text has to be measured against the column so it trims there instead of
             spilling over the next cell. -->
        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="2"
              VerticalAlignment="Center"
              IsVisible="{Binding HasReasoning}"
              ToolTip.Tip="{Binding ReasoningLabel}">
          <wc:FluentIcon Data="{StaticResource IconReasoning}"
                         Width="14"
                         Height="14"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Grid.Column="1"
                     Text="{Binding ReasoningText}"
                     IsVisible="{Binding HasReasoningText}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </Grid>
      </Border>
    </DataTemplate>
    <!-- A number cell rests as text and builds its field only while it is being edited (the editor templates below, chosen
         by the window when the cell is clicked). A live NumericUpDown per cell is the whole table's cost: its template plus
         the stepper's two repeat buttons come to ~1.1 ms and ~0.5 MB each, and a screen of rows carries 75-95 of them
         (bench: table.metadata.open, 275-390 ms -> ~100 ms). The text is the row's own formatted number, so an unknown
         value shows nothing rather than a zero. -->
    <DataTemplate x:Key="MetaContextCell" x:DataType="settings:ModelMetadataRowViewModel">
      <Border Classes="meta-line editable"
              Classes.invalid="{Binding HasContextWindowError}"
              Padding="6,3"
              ToolTip.Tip="{Binding ContextWindowError}">
        <Panel x:Name="CellBody">
          <TextBlock x:Name="ValueText"
                     Text="{Binding ContextWindowText}"
                     TextWrapping="NoWrap"
                     VerticalAlignment="Center"
                     AutomationProperties.Name="{Binding ContextWindowText}" />
        </Panel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="MetaInputCell" x:DataType="settings:ModelMetadataRowViewModel">
      <Border Classes="meta-line editable"
              Classes.invalid="{Binding InputPriceInvalid}"
              Padding="6,3"
              ToolTip.Tip="{Binding InputPriceTooltip}">
        <Panel x:Name="CellBody">
          <TextBlock x:Name="ValueText"
                     Text="{Binding InputText}"
                     TextWrapping="NoWrap"
                     VerticalAlignment="Center"
                     AutomationProperties.Name="{Binding InputText}" />
        </Panel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="MetaOutputCell" x:DataType="settings:ModelMetadataRowViewModel">
      <Border Classes="meta-line editable"
              Classes.invalid="{Binding OutputPriceInvalid}"
              Padding="6,3"
              ToolTip.Tip="{Binding OutputPriceTooltip}">
        <Panel x:Name="CellBody">
          <TextBlock x:Name="ValueText"
                     Text="{Binding OutputText}"
                     TextWrapping="NoWrap"
                     VerticalAlignment="Center"
                     AutomationProperties.Name="{Binding OutputText}" />
        </Panel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="MetaCacheReadCell" x:DataType="settings:ModelMetadataRowViewModel">
      <Border Classes="meta-line editable"
              Classes.invalid="{Binding CacheReadPriceInvalid}"
              Padding="6,3"
              ToolTip.Tip="{Binding CacheReadPriceTooltip}">
        <Panel x:Name="CellBody">
          <TextBlock x:Name="ValueText"
                     Text="{Binding CacheReadText}"
                     TextWrapping="NoWrap"
                     VerticalAlignment="Center"
                     AutomationProperties.Name="{Binding CacheReadText}" />
        </Panel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="MetaCacheWriteCell" x:DataType="settings:ModelMetadataRowViewModel">
      <Border Classes="meta-line editable"
              Classes.invalid="{Binding CacheWritePriceInvalid}"
              Padding="6,3"
              ToolTip.Tip="{Binding CacheWritePriceTooltip}">
        <Panel x:Name="CellBody">
          <TextBlock x:Name="ValueText"
                     Text="{Binding CacheWriteText}"
                     TextWrapping="NoWrap"
                     VerticalAlignment="Center"
                     AutomationProperties.Name="{Binding CacheWriteText}" />
        </Panel>
      </Border>
    </DataTemplate>
    <!-- The field a cell shows while it is edited. It carries its own copy of the field sheet, so the Forge frame, the
         stepper and the red error frame are in scope for this one field instead of for every element of the table. The cells
         bind Value, not Text: the control parses what is typed into a decimal? and hands back the absence of a number for an
         empty box, which is exactly the "unknown" the stored section must keep (binding Text writes the control's empty
         template state back over the value when it is first realized - measured: the stored window came back as "" after the
         window was shown). -->
    <DataTemplate x:Key="MetaContextEditor" x:DataType="settings:ModelMetadataRowViewModel">
      <NumericUpDown Classes="meta-cell"
                     Classes.invalid="{Binding HasContextWindowError}"
                     ToolTip.Tip="{Binding ContextWindowError}"
                     Value="{Binding ContextWindow, Mode=TwoWay}"
                     FormatString="0">
        <NumericUpDown.Styles>
          <StyleInclude Source="avares://Forge.App/Resources/FieldStyles.axaml" />
        </NumericUpDown.Styles>
      </NumericUpDown>
    </DataTemplate>
    <DataTemplate x:Key="MetaInputEditor" x:DataType="settings:ModelMetadataRowViewModel">
      <NumericUpDown Classes="meta-cell"
                     Classes.invalid="{Binding InputPriceInvalid}"
                     ToolTip.Tip="{Binding InputPriceTooltip}"
                     Value="{Binding Input, Mode=TwoWay}"
                     FormatString="0.######">
        <NumericUpDown.Styles>
          <StyleInclude Source="avares://Forge.App/Resources/FieldStyles.axaml" />
        </NumericUpDown.Styles>
      </NumericUpDown>
    </DataTemplate>
    <DataTemplate x:Key="MetaOutputEditor" x:DataType="settings:ModelMetadataRowViewModel">
      <NumericUpDown Classes="meta-cell"
                     Classes.invalid="{Binding OutputPriceInvalid}"
                     ToolTip.Tip="{Binding OutputPriceTooltip}"
                     Value="{Binding Output, Mode=TwoWay}"
                     FormatString="0.######">
        <NumericUpDown.Styles>
          <StyleInclude Source="avares://Forge.App/Resources/FieldStyles.axaml" />
        </NumericUpDown.Styles>
      </NumericUpDown>
    </DataTemplate>
    <DataTemplate x:Key="MetaCacheReadEditor" x:DataType="settings:ModelMetadataRowViewModel">
      <NumericUpDown Classes="meta-cell"
                     Classes.invalid="{Binding CacheReadPriceInvalid}"
                     ToolTip.Tip="{Binding CacheReadPriceTooltip}"
                     Value="{Binding CacheRead, Mode=TwoWay}"
                     FormatString="0.######">
        <NumericUpDown.Styles>
          <StyleInclude Source="avares://Forge.App/Resources/FieldStyles.axaml" />
        </NumericUpDown.Styles>
      </NumericUpDown>
    </DataTemplate>
    <DataTemplate x:Key="MetaCacheWriteEditor" x:DataType="settings:ModelMetadataRowViewModel">
      <NumericUpDown Classes="meta-cell"
                     Classes.invalid="{Binding CacheWritePriceInvalid}"
                     ToolTip.Tip="{Binding CacheWritePriceTooltip}"
                     Value="{Binding CacheWrite, Mode=TwoWay}"
                     FormatString="0.######">
        <NumericUpDown.Styles>
          <StyleInclude Source="avares://Forge.App/Resources/FieldStyles.axaml" />
        </NumericUpDown.Styles>
      </NumericUpDown>
    </DataTemplate>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="18,16">
    <StackPanel Grid.Row="0" Spacing="4">
      <StackPanel.Styles>
        <StyleInclude Source="avares://Forge.App/Resources/ChromeStyles.axaml" />
      </StackPanel.Styles>
      <TextBlock Classes="h2" Text="{Binding Title}" />
      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Intro}" />
    </StackPanel>

    <!-- The frame is the control's own border, so it cannot sit a pixel off the last row or column; VerticalAlignment=Top
         makes it hug the rows instead of running to the bottom of the window (more rows than fit still fill and scroll). -->
    <!-- Focusable so the arrow keys reach the table itself: the cells are not focusable controls, and the field the table
         builds exists only while a cell is being edited. -->
    <TableView x:Name="Table"
               Grid.Row="1"
               Focusable="True"
               Margin="0,14,0,0"
               VerticalAlignment="Top"
               ItemsSource="{Binding Rows}"
               IsVisible="{Binding HasRows}"
               BorderBrush="{DynamicResource BorderBrush}"
               BorderThickness="1"
               CornerRadius="4"
               ClipToBounds="True"
               AutomationProperties.AutomationId="model-metadata-rows" />

    <TextBlock Grid.Row="2"
               Classes="caption"
               Margin="0,8,0,0"
               IsVisible="{Binding !HasRows}"
               TextWrapping="Wrap"
               Text="{Binding EmptyText}" />

    <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,14,0,0">
      <Grid.Styles>
        <StyleInclude Source="avares://Forge.App/Resources/ChromeStyles.axaml" />
      </Grid.Styles>
      <TextBlock Grid.Column="0"
                 Classes="caption"
                 VerticalAlignment="Center"
                 Text="{Binding PerMillion}" />
      <TextBlock Grid.Column="1"
                 Classes="caption meta-status"
                 Classes.error="{Binding StatusIsError}"
                 VerticalAlignment="Center"
                 IsVisible="{Binding HasStatus}"
                 Text="{Binding Status}" />
      <Button Grid.Column="3" Classes="ghost" Command="{Binding RefreshCommand}" Content="{Binding RefreshText}" />
      <Button Grid.Column="4" Classes="ghost" Command="{Binding ResetCommand}" Content="{Binding ResetText}" />
      <Button Grid.Column="5" Classes="primary" Command="{Binding SaveCommand}" Content="{Binding SaveText}" AutomationProperties.AutomationId="model-metadata-save" />
    </Grid>
  </Grid>
</Window>
