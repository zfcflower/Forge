<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="using:Forge.App.Settings"
        xmlns:wc="using:Forge.App.Workbench.Controls"
        x:Class="Forge.App.Settings.ModelMetadataWindow"
        x:DataType="settings:ModelMetadataViewModel"
        Title="{Binding Title}"
        Width="940"
        Height="620"
        MinWidth="880"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
  <Window.Styles>
    <Style Selector="TextBlock.meta-header">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.meta-cell">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBox.meta-cell.invalid">
      <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBrush}" />
    </Style>
    <Style Selector="TextBox.meta-cell.invalid /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBrush}" />
    </Style>
    <Style Selector="Border.meta-line">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="TextBlock.meta-status">
      <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}" />
    </Style>
    <Style Selector="TextBlock.meta-status.error">
      <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
    </Style>
    <!-- The table: the control's own chrome is replaced by the window's band, cell grid and row lines. -->
    <Style Selector="TableView">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TableViewCell">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TableViewColumnHeader">
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <!-- Columns are sized to their content, not dragged; the resizer's 1px line only smears over the rows. -->
    <Style Selector="TableViewColumnHeader /template/ Thumb#PART_Resizer">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="TableViewRow">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <!-- Banded rows: the classes come from the window's ContainerPrepared handler, which also runs on recycled rows. -->
    <Style Selector="TableViewRow.alt">
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
    </Style>
  </Window.Styles>
  <Window.Resources>
    <Thickness x:Key="TableViewRowPadding">0</Thickness>
    <!-- One cell template per column: the window builds the columns (their headers are localized and one of them is
         conditional), so each cell's markup lives here and is picked by a resource key. -->
    <DataTemplate x:Key="MetaVisibilityCell" x:DataType="settings:ModelMetadataRowViewModel">
      <Border Classes="meta-line" Padding="8,3">
        <CheckBox IsChecked="{Binding IsShown, Mode=TwoWay}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  ToolTip.Tip="{Binding Model}"
                  AutomationProperties.AutomationId="{Binding Model, StringFormat=model-metadata-shown-{0}}"
                  AutomationProperties.Name="{Binding Model}" />
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="MetaModelCell" x:DataType="settings:ModelMetadataRowViewModel">
      <Border Classes="meta-line" Padding="8,3">
        <TextBlock Text="{Binding Model}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   FontSize="{DynamicResource FontSizeSm}" />
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="MetaCapabilitiesCell" x:DataType="settings:ModelMetadataRowViewModel">
      <Border Classes="meta-line"
              Padding="8,3"
              AutomationProperties.Name="{Binding CapabilitiesText}">
        <StackPanel Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{Binding CapabilitiesText}">
          <wc:FluentIcon Data="{StaticResource IconText}"
                         Width="14"
                         Height="14"
                         IsVisible="{Binding HasTextInput}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         ToolTip.Tip="{Binding TextCapabilityLabel}" />
          <wc:FluentIcon Data="{StaticResource IconImage}"
                         Width="14"
                         Height="14"
                         IsVisible="{Binding HasImageInput}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         ToolTip.Tip="{Binding ImageCapabilityLabel}" />
          <wc:FluentIcon Data="{StaticResource IconPdf}"
                         Width="14"
                         Height="14"
                         IsVisible="{Binding HasPdfInput}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         ToolTip.Tip="{Binding PdfCapabilityLabel}" />
          <wc:FluentIcon Data="{StaticResource IconAudio}"
                         Width="14"
                         Height="14"
                         IsVisible="{Binding HasAudioInput}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         ToolTip.Tip="{Binding AudioCapabilityLabel}" />
          <wc:FluentIcon Data="{StaticResource IconVideo}"
                         Width="14"
                         Height="14"
                         IsVisible="{Binding HasVideoInput}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         ToolTip.Tip="{Binding VideoCapabilityLabel}" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="MetaReasoningCell" x:DataType="settings:ModelMetadataRowViewModel">
      <Border Classes="meta-line" Padding="8,3" AutomationProperties.Name="{Binding ReasoningLabel}">
        <StackPanel Orientation="Horizontal"
                    Spacing="2"
                    VerticalAlignment="Center"
                    IsVisible="{Binding HasReasoning}"
                    ToolTip.Tip="{Binding ReasoningLabel}">
          <wc:FluentIcon Data="{StaticResource IconReasoning}"
                         Width="14"
                         Height="14"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="{Binding ReasoningText}"
                     IsVisible="{Binding HasReasoningText}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     FontSize="{DynamicResource FontSizeXs}"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="MetaContextCell" x:DataType="settings:ModelMetadataRowViewModel">
      <Border Classes="meta-line" Padding="6,3">
        <TextBox Classes="meta-cell"
                 Classes.invalid="{Binding HasContextWindowError}"
                 ToolTip.Tip="{Binding ContextWindowError}"
                 Text="{Binding ContextWindow, Mode=TwoWay}" />
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="MetaInputCell" x:DataType="settings:ModelMetadataRowViewModel">
      <Border Classes="meta-line" Padding="6,3">
        <TextBox Classes="meta-cell"
                 Classes.invalid="{Binding InputPriceInvalid}"
                 ToolTip.Tip="{Binding InputPriceTooltip}"
                 Text="{Binding Input, Mode=TwoWay}" />
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="MetaOutputCell" x:DataType="settings:ModelMetadataRowViewModel">
      <Border Classes="meta-line" Padding="6,3">
        <TextBox Classes="meta-cell"
                 Classes.invalid="{Binding OutputPriceInvalid}"
                 ToolTip.Tip="{Binding OutputPriceTooltip}"
                 Text="{Binding Output, Mode=TwoWay}" />
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="MetaCacheReadCell" x:DataType="settings:ModelMetadataRowViewModel">
      <Border Classes="meta-line" Padding="6,3">
        <TextBox Classes="meta-cell"
                 Classes.invalid="{Binding CacheReadPriceInvalid}"
                 ToolTip.Tip="{Binding CacheReadPriceTooltip}"
                 Text="{Binding CacheRead, Mode=TwoWay}" />
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="MetaCacheWriteCell" x:DataType="settings:ModelMetadataRowViewModel">
      <Border Classes="meta-line" Padding="6,3">
        <TextBox Classes="meta-cell"
                 Classes.invalid="{Binding CacheWritePriceInvalid}"
                 ToolTip.Tip="{Binding CacheWritePriceTooltip}"
                 Text="{Binding CacheWrite, Mode=TwoWay}" />
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="18,16">
    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Classes="h2" Text="{Binding Title}" />
      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Intro}" />
    </StackPanel>

    <Border Grid.Row="1"
            Margin="0,14,0,0"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            ClipToBounds="True">
      <TableView x:Name="Table"
                 ItemsSource="{Binding Rows}"
                 IsVisible="{Binding HasRows}"
                 CanUserResizeColumns="False"
                 AutomationProperties.AutomationId="model-metadata-rows" />
    </Border>

    <TextBlock Grid.Row="2"
               Classes="caption"
               Margin="0,8,0,0"
               IsVisible="{Binding !HasRows}"
               TextWrapping="Wrap"
               Text="{Binding EmptyText}" />

    <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,14,0,0">
      <TextBlock Grid.Column="0"
                 Classes="caption"
                 VerticalAlignment="Center"
                 Text="{Binding PerMillion}" />
      <TextBlock Grid.Column="1"
                 Classes="caption meta-status"
                 Classes.error="{Binding StatusIsError}"
                 VerticalAlignment="Center"
                 IsVisible="{Binding HasStatus}"
                 Text="{Binding Status}" />
      <Button Grid.Column="3" Classes="ghost" Command="{Binding RefreshCommand}" Content="{Binding RefreshText}" />
      <Button Grid.Column="4" Classes="ghost" Command="{Binding ResetCommand}" Content="{Binding ResetText}" />
      <Button Grid.Column="5" Classes="primary" Command="{Binding SaveCommand}" Content="{Binding SaveText}" AutomationProperties.AutomationId="model-metadata-save" />
    </Grid>
  </Grid>
</Window>
