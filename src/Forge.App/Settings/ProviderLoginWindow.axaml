<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="using:Forge.App.Settings"
        x:Class="Forge.App.Settings.ProviderLoginWindow"
        x:DataType="settings:ProviderLoginViewModel"
        Title="{Binding Title}"
        Width="480"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBackgroundBrush}">
  <Grid RowDefinitions="Auto,Auto" Margin="18,16">
    <StackPanel Grid.Row="0" Spacing="12">

      <!-- Claude Code is missing: say what to install and where. -->
      <StackPanel Spacing="8" IsVisible="{Binding ClaudeNotInstalled}">
        <TextBlock Text="{Binding ClaudeNotInstalledText}" TextWrapping="Wrap" />
        <TextBlock Classes="caption" Text="{Binding ClaudeStepsText}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="primary"
                  Command="{Binding InstallCommand}"
                  Content="{Binding InstallText}"
                  AutomationProperties.AutomationId="provider-login-install" />
          <Button Classes="ghost"
                  Command="{Binding RecheckCommand}"
                  Content="{Binding RecheckText}"
                  AutomationProperties.AutomationId="provider-login-recheck" />
        </StackPanel>
      </StackPanel>

      <!-- Installed but not signed in: the CLI's own login is the only way in. -->
      <StackPanel Spacing="8" IsVisible="{Binding ClaudeNotSignedIn}">
        <TextBlock Text="{Binding ClaudeNotSignedInText}" TextWrapping="Wrap" />
        <Button Classes="ghost"
                HorizontalAlignment="Left"
                Command="{Binding RecheckCommand}"
                Content="{Binding RecheckText}"
                AutomationProperties.AutomationId="provider-login-recheck" />
      </StackPanel>

      <!-- Signed in: the definition is the subscription, so it carries no key. -->
      <StackPanel Spacing="8" IsVisible="{Binding ClaudeReady}">
        <TextBlock Text="{Binding ClaudeReadyText}" TextWrapping="Wrap" />
        <Button Classes="primary"
                HorizontalAlignment="Left"
                Command="{Binding UseClaudeCommand}"
                Content="{Binding UseText}"
                AutomationProperties.AutomationId="provider-login-use" />
      </StackPanel>

      <!-- GitHub Copilot: device-code sign-in. -->
      <StackPanel Spacing="8" IsVisible="{Binding IsCopilot}">
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding CopilotHint}" />
        <Button Classes="primary"
                HorizontalAlignment="Left"
                Command="{Binding StartCopilotCommand}"
                Content="{Binding StartCopilotText}"
                AutomationProperties.AutomationId="provider-login-copilot-start" />
        <StackPanel Spacing="4" IsVisible="{Binding HasDeviceCode}">
          <TextBlock Classes="h2" Text="{Binding DeviceCodeText}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding DeviceCodeHint}" />
        </StackPanel>
        <TextBlock Classes="caption" IsVisible="{Binding HasLoginState}" Text="{Binding LoginState}" />
      </StackPanel>

      <!-- Kimi For Coding: device-code sign-in, same presentation as Copilot. -->
      <StackPanel Spacing="8" IsVisible="{Binding IsKimi}">
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding KimiHint}" />
        <Button Classes="primary"
                HorizontalAlignment="Left"
                Command="{Binding StartKimiCommand}"
                Content="{Binding StartKimiText}"
                AutomationProperties.AutomationId="provider-login-kimi-start" />
        <StackPanel Spacing="4" IsVisible="{Binding HasDeviceCode}">
          <TextBlock Classes="h2" Text="{Binding DeviceCodeText}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding DeviceCodeHint}" />
        </StackPanel>
        <TextBlock Classes="caption" IsVisible="{Binding HasLoginState}" Text="{Binding LoginState}" />
      </StackPanel>

      <!-- xAI: device-code sign-in, same presentation as Kimi. -->
      <StackPanel Spacing="8" IsVisible="{Binding IsXAi}">
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding XAiHint}" />
        <Button Classes="primary"
                HorizontalAlignment="Left"
                Command="{Binding StartXAiCommand}"
                Content="{Binding StartXAiText}"
                AutomationProperties.AutomationId="provider-login-xai-start" />
        <StackPanel Spacing="4" IsVisible="{Binding HasDeviceCode}">
          <TextBlock Classes="h2" Text="{Binding DeviceCodeText}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding DeviceCodeHint}" />
        </StackPanel>
        <TextBlock Classes="caption" IsVisible="{Binding HasLoginState}" Text="{Binding LoginState}" />
      </StackPanel>

      <!-- Meta: device-code sign-in, then the key mint that enables access; same presentation as Kimi. -->
      <StackPanel Spacing="8" IsVisible="{Binding IsMeta}">
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding MetaHint}" />
        <Button Classes="primary"
                HorizontalAlignment="Left"
                Command="{Binding StartMetaCommand}"
                Content="{Binding StartMetaText}"
                AutomationProperties.AutomationId="provider-login-meta-start" />
        <StackPanel Spacing="4" IsVisible="{Binding HasDeviceCode}">
          <TextBlock Classes="h2" Text="{Binding DeviceCodeText}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding DeviceCodeHint}" />
        </StackPanel>
        <TextBlock Classes="caption" IsVisible="{Binding HasLoginState}" Text="{Binding LoginState}" />
      </StackPanel>

      <!-- ChatGPT: device-code sign-in for a plan rather than a platform key. -->
      <StackPanel Spacing="8" IsVisible="{Binding IsChatGpt}">
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding ChatGptHint}" />
        <Button Classes="primary"
                HorizontalAlignment="Left"
                Command="{Binding StartChatGptCommand}"
                Content="{Binding StartChatGptText}"
                AutomationProperties.AutomationId="provider-login-chatgpt-start" />
        <StackPanel Spacing="4" IsVisible="{Binding HasDeviceCode}">
          <TextBlock Classes="h2" Text="{Binding DeviceCodeText}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding DeviceCodeHint}" />
        </StackPanel>
        <TextBlock Classes="caption" IsVisible="{Binding HasLoginState}" Text="{Binding LoginState}" />
      </StackPanel>

      <TextBlock Classes="caption"
                 IsVisible="{Binding HasError}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource DangerBrush}"
                 Text="{Binding Error}"
                 AutomationProperties.AutomationId="provider-login-error" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,16,0,0">
      <Button Classes="ghost"
              HorizontalAlignment="Left"
              Command="{Binding CancelCommand}"
              Content="{Binding CancelText}"
              AutomationProperties.AutomationId="provider-login-cancel" />
    </Grid>
  </Grid>
</Window>
