<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wc="using:Forge.App.Workbench.Controls"
             xmlns:settings="using:Forge.App.Settings"
             x:Class="Forge.App.Settings.ProvidersSettingsView"
             x:DataType="settings:ProvidersSettingsViewModel">
  <UserControl.Styles>
    <Style Selector="Border.provider-row">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="0,10" />
    </Style>
    <Style Selector="Ellipse.provider-state">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Ellipse.provider-state.ready">
      <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="Ellipse.provider-state.warning">
      <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="Ellipse.provider-state.signin">
      <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="Ellipse.provider-state.error">
      <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Button.provider-action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
    </Style>
    <Style Selector="Button.provider-action /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.provider-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="14">
    <!-- Top banner: no connected provider means no agent can run. -->
    <Border IsVisible="{Binding ShowsNeedProviderBanner}"
            Background="{DynamicResource AccentSubtleBrush}"
            CornerRadius="6"
            Padding="12,8"
            AutomationProperties.AutomationId="providers-banner">
      <TextBlock Text="{Binding BannerText}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource WarningBrush}" />
    </Border>

    <!-- Model metadata that is not per provider: the window every model uses unless it has its own. -->
    <StackPanel Spacing="3">
      <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
        <TextBlock Grid.Column="0"
                   Text="{Binding DefaultContextWindowLabel}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="{DynamicResource FontSizeSm}"
                   VerticalAlignment="Center" />
        <TextBox Grid.Column="1"
                 Width="120"
                 Text="{Binding DefaultContextWindowText, Mode=TwoWay}"
                 LostFocus="OnDefaultWindowCommit"
                 KeyDown="OnDefaultWindowKeyDown"
                 AutomationProperties.AutomationId="providers-default-context"
                 AutomationProperties.Name="{Binding DefaultContextWindowLabel}" />
      </Grid>
      <TextBlock Classes="caption"
                 TextWrapping="Wrap"
                 Text="{Binding DefaultContextWindowHint}" />
    </StackPanel>

    <!-- Automatic compaction: trigger and target in percent of each model's usable window (the window above caps it). -->
    <StackPanel Spacing="3" DataContext="{Binding Compaction}" x:DataType="settings:CompactionSettingsViewModel">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">
        <CheckBox Grid.Column="0"
                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                  Content="{Binding EnabledLabel}"
                  FontSize="{DynamicResource FontSizeSm}"
                  VerticalAlignment="Center"
                  AutomationProperties.AutomationId="providers-compaction-enabled" />
        <TextBlock Grid.Column="1"
                   Text="{Binding TriggerLabel}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="{DynamicResource FontSizeSm}"
                   VerticalAlignment="Center" />
        <TextBox Grid.Column="2"
                 Width="64"
                 Text="{Binding TriggerText, Mode=TwoWay}"
                 IsEnabled="{Binding Enabled}"
                 LostFocus="OnCompactionCommit"
                 KeyDown="OnCompactionKeyDown"
                 AutomationProperties.AutomationId="providers-compaction-trigger"
                 AutomationProperties.Name="{Binding TriggerLabel}" />
        <TextBlock Grid.Column="3"
                   Text="{Binding TargetLabel}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="{DynamicResource FontSizeSm}"
                   VerticalAlignment="Center" />
        <TextBox Grid.Column="4"
                 Width="64"
                 Text="{Binding TargetText, Mode=TwoWay}"
                 IsEnabled="{Binding Enabled}"
                 LostFocus="OnCompactionCommit"
                 KeyDown="OnCompactionKeyDown"
                 AutomationProperties.AutomationId="providers-compaction-target"
                 AutomationProperties.Name="{Binding TargetLabel}" />
      </Grid>
      <TextBlock Classes="caption"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource DangerBrush}"
                 IsVisible="{Binding HasTriggerError}"
                 Text="{Binding TriggerError}" />
      <TextBlock Classes="caption"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource DangerBrush}"
                 IsVisible="{Binding HasTargetError}"
                 Text="{Binding TargetError}" />
      <TextBlock Classes="caption"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource DangerBrush}"
                 IsVisible="{Binding HasSaveError}"
                 Text="{Binding SaveError}" />
      <TextBlock Classes="caption"
                 TextWrapping="Wrap"
                 Text="{Binding Hint}" />
    </StackPanel>

    <!-- The fetched catalog: the layer between the compiled table and what a provider reports. -->
    <StackPanel Spacing="3">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding CatalogLabel}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontSize="{DynamicResource FontSizeSm}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding CatalogStatusText}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontSize="{DynamicResource FontSizeSm}"
                     VerticalAlignment="Center" />
        </StackPanel>
        <TextBox Grid.Column="1"
                 MinWidth="220"
                 Text="{Binding CatalogSourceUrl, Mode=TwoWay}"
                 LostFocus="OnCatalogSourceCommit"
                 KeyDown="OnCatalogSourceKeyDown"
                 AutomationProperties.AutomationId="providers-catalog-source"
                 AutomationProperties.Name="{Binding CatalogSourceLabel}" />
        <Button Grid.Column="2"
                Classes="provider-action"
                Command="{Binding UpdateCatalogCommand}"
                AutomationProperties.AutomationId="providers-catalog-update">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <wc:FluentIcon Data="{StaticResource IconRefresh}" Width="14" Height="14" />
            <TextBlock Text="{Binding CatalogActionText}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding CatalogSourceHint}" />
      <TextBlock IsVisible="{Binding HasCatalogProblem}"
                 TextWrapping="Wrap"
                 Text="{Binding CatalogProblem}"
                 Foreground="{DynamicResource DangerBrush}" />
    </StackPanel>

    <!-- 1. Connected: what is already set up. -->
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Classes="section-title" Text="{Binding ConnectedTitle}" VerticalAlignment="Center" />
      <Button Grid.Column="1"
              Classes="provider-action"
              Command="{Binding RefreshCommand}"
              AutomationProperties.AutomationId="providers-refresh">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <wc:FluentIcon Data="{StaticResource IconRefresh}" Width="14" Height="14" />
          <TextBlock Text="{Binding RefreshText}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.AutomationId="providers-connected">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="settings:ProviderRowViewModel">
          <Border Classes="provider-row">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeMd}" VerticalAlignment="Center" />
                <Border IsVisible="{Binding IsDefault}"
                        Background="{DynamicResource AccentSubtleBrush}"
                        CornerRadius="4"
                        Padding="6,1">
                  <TextBlock Text="{Binding DefaultText}"
                             FontSize="{DynamicResource FontSizeXs}"
                             Foreground="{DynamicResource AccentTextBrush}" />
                </Border>
              </StackPanel>

              <TextBlock Grid.Column="1"
                         Text="{Binding CredentialText}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         FontSize="{DynamicResource FontSizeSm}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />

              <Ellipse Grid.Column="2"
                       Classes="provider-state"
                       Classes.ready="{Binding IsReady}"
                       Classes.warning="{Binding NeedsKey}"
                       Classes.signin="{Binding NeedsSignIn}"
                       Classes.error="{Binding HasError}"
                       ToolTip.Tip="{Binding StatusTooltip}"
                       VerticalAlignment="Center" />

              <Button Grid.Column="3"
                      Classes="provider-action"
                      Click="OnEditClick"
                      ToolTip.Tip="{Binding EditText}"
                      AutomationProperties.Name="{Binding EditText}"
                      AutomationProperties.AutomationId="{Binding Id}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <wc:FluentIcon Data="{StaticResource IconEdit}" Width="14" Height="14" />
                  <TextBlock Text="{Binding EditText}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Grid.Column="4"
                      Classes="provider-action"
                      Click="OnModelsClick"
                      ToolTip.Tip="{Binding StatusText}"
                      AutomationProperties.Name="{Binding ModelsLabel}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <wc:FluentIcon Data="{StaticResource IconEye}" Width="14" Height="14" />
                  <TextBlock Text="{Binding ModelsLabel}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Grid.Column="5"
                      Classes="provider-action"
                      IsVisible="{Binding !IsDefault}"
                      Click="OnMakeDefaultClick"
                      Content="{Binding MakeDefaultText}"
                      AutomationProperties.AutomationId="{Binding Id, StringFormat=provider-default-{0}}" />

              <Button Grid.Column="6"
                      Classes="provider-action"
                      Click="OnDeleteClick"
                      Content="{Binding DeleteText}"
                      AutomationProperties.AutomationId="{Binding Id, StringFormat=provider-delete-{0}}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="caption"
               IsVisible="{Binding HasProblem}"
               TextWrapping="Wrap"
               Text="{Binding Problem}" />

    <!-- 2. Custom: any OpenAI-compatible server, typed by hand. -->
    <Border Classes="divider" Margin="0,6" />

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="4" VerticalAlignment="Center">
        <TextBlock Classes="section-title" Text="{Binding CustomTitle}" />
        <TextBlock Text="{Binding CustomHint}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="{DynamicResource FontSizeSm}" />
      </StackPanel>
      <Button Grid.Column="1"
              Classes="primary"
              Click="OnAddClick"
              VerticalAlignment="Center"
              AutomationProperties.AutomationId="providers-add">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <wc:FluentIcon Data="{StaticResource IconPlus}" Width="14" Height="14" />
          <TextBlock Text="{Binding AddServerText}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- 3. Built-in: the vendors this app knows, each with the ways it can be reached. -->
    <Border Classes="divider" Margin="0,6" />

    <StackPanel Spacing="4">
      <TextBlock Classes="section-title" Text="{Binding BuiltInTitle}" />
      <TextBlock Text="{Binding BuiltInHint}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 FontSize="{DynamicResource FontSizeSm}" />
    </StackPanel>

    <ItemsControl ItemsSource="{Binding BuiltInRows}" AutomationProperties.AutomationId="providers-builtin">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="settings:BuiltInProviderRowViewModel">
          <Border Classes="provider-row">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBlock Text="{Binding Name}"
                         FontSize="{DynamicResource FontSizeMd}"
                         VerticalAlignment="Center" />

              <Button Grid.Column="1"
                      Classes="provider-action"
                      IsVisible="{Binding ShowsLogin}"
                      Click="OnLoginClick"
                      Content="{Binding LoginText}"
                      AutomationProperties.AutomationId="{Binding Preset.Id, StringFormat=provider-login-{0}}" />

              <Button Grid.Column="2"
                      Classes="provider-action"
                      IsVisible="{Binding ShowsApiKey}"
                      Click="OnApiKeyClick"
                      Content="{Binding ApiKeyText}"
                      AutomationProperties.AutomationId="{Binding Preset.Id, StringFormat=provider-apikey-{0}}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- 4. Built-in agent defaults: which model and thinking step each built-in agent runs on. Last, because it depends on
         the model lists above it. -->
    <Border Classes="divider" Margin="0,6" />

    <StackPanel Spacing="4">
      <TextBlock Classes="section-title" Text="{Binding AgentsTitle}" />
      <TextBlock Text="{Binding AgentsHint}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 FontSize="{DynamicResource FontSizeSm}" />
    </StackPanel>

    <Grid ColumnDefinitions="120,*,170" ColumnSpacing="8">
      <TextBlock Grid.Column="1" Classes="caption" Text="{Binding AgentsModelHeader}" />
      <TextBlock Grid.Column="2" Classes="caption" Text="{Binding AgentsThinkingHeader}" />
    </Grid>

    <ItemsControl ItemsSource="{Binding AgentRows}" AutomationProperties.AutomationId="providers-agent-defaults">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="settings:AgentDefaultsRowViewModel">
          <Border Classes="provider-row">
            <Grid ColumnDefinitions="120,*,170" ColumnSpacing="8">
              <TextBlock Text="{Binding Name}"
                         FontSize="{DynamicResource FontSizeMd}"
                         VerticalAlignment="Center" />

              <ComboBox Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Models}"
                        SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                        AutomationProperties.AutomationId="{Binding AgentId, StringFormat=agent-model-{0}}"
                        AutomationProperties.Name="{Binding Name}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="settings:AgentModelChoice">
                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <ComboBox Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding ThinkingChoices}"
                        SelectedItem="{Binding SelectedThinking, Mode=TwoWay}"
                        IsEnabled="{Binding CanChooseThinking}"
                        AutomationProperties.AutomationId="{Binding AgentId, StringFormat=agent-thinking-{0}}"
                        AutomationProperties.Name="{Binding Name}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="settings:AgentThinkingChoice">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="caption"
               IsVisible="{Binding HasAgentsProblem}"
               TextWrapping="Wrap"
               Foreground="{DynamicResource DangerBrush}"
               Text="{Binding AgentsProblem}"
               AutomationProperties.AutomationId="providers-agents-problem" />
  </StackPanel>
</UserControl>
