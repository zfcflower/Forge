<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Forge.App.ViewModels"
             xmlns:wc="using:Forge.App.Workbench.Controls"
             xmlns:loc="using:Forge.App.Localization"
             x:Class="Forge.App.Views.ResourceInspectorView"
             x:DataType="vm:ResourceInspectorViewModel"
             AutomationProperties.AutomationId="resource-inspector">

  <UserControl.Styles>
    <StyleInclude Source="avares://Forge.App/Resources/ChromeStyles.axaml" />
    <!-- The scrim covers the whole workbench row: it dims what is behind the window and takes the click that closes it. -->
    <Style Selector="Grid.inspector-scrim">
      <Setter Property="Background" Value="{DynamicResource BackdropScrimBrush}" />
    </Style>

    <Style Selector="Border.inspector-card">
      <Setter Property="MaxWidth" Value="760" />
      <Setter Property="MaxHeight" Value="680" />
      <Setter Property="Margin" Value="16,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
      <Setter Property="BoxShadow" Value="{DynamicResource ShadowMd}" />
    </Style>

    <!-- A bordered table: the frame, and a tinted header band. -->
    <Style Selector="Border.res-table">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.res-head">
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="Border.res-row">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Border.res-total">
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
    </Style>
    <Style Selector="Border.res-total TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.res-num">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Dots: green while a server is ready, red when it failed. -->
    <Style Selector="Ellipse.res-dot">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Ellipse.res-dot.ready">
      <Setter Property="Fill" Value="{DynamicResource StatusSuccessBrush}" />
    </Style>
    <Style Selector="Ellipse.res-dot.failed">
      <Setter Property="Fill" Value="{DynamicResource StatusErrorBrush}" />
    </Style>

    <Style Selector="Border.res-chip">
      <Setter Property="Background" Value="{DynamicResource BrandTintBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.res-chip TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BrandActionBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="Scrim"
        Classes="inspector-scrim"
        Focusable="True"
        PointerPressed="OnScrimPressed"
        KeyDown="OnKeyDown">
    <Border Classes="inspector-card">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}"
                Padding="14,10,10,10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="label"
                       FontWeight="SemiBold"
                       FontSize="{DynamicResource FontSizeBase}"
                       VerticalAlignment="Center"
                       Text="{Binding Title}" />
            <Button Grid.Column="1"
                    x:Name="CloseButton"
                    Classes="ghost icon"
                    Width="28"
                    Height="24"
                    Command="{Binding CloseCommand}"
                    ToolTip.Tip="{Binding CloseTooltip}"
                    AutomationProperties.AutomationId="inspector-close"
                    AutomationProperties.Name="{Binding CloseLabel}">
              <wc:FluentIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
            </Button>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14,10,14,14" Spacing="16">

            <!-- 1. Automation agents that are running: names open the agent's tab. -->
            <StackPanel Spacing="6">
              <TextBlock Classes="label" FontWeight="SemiBold" Text="{Binding AgentsTitle}" />
              <TextBlock Classes="caption" IsVisible="{Binding !HasAgents}" Text="{Binding AgentsEmpty}" />
              <ItemsControl ItemsSource="{Binding Agents}" IsVisible="{Binding HasAgents}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SubAgentViewModel">
                    <Border Classes="res-row" BorderThickness="0,0,0,1">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                        <Ellipse Classes="status-dot running" VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="link"
                                Margin="8,0,0,0"
                                HorizontalAlignment="Left"
                                Click="OnOpenAgent"
                                ToolTip.Tip="{Binding [resources.agents.openTooltip], Source={x:Static loc:Loc.Instance}}"
                                AutomationProperties.AutomationId="inspector-open-agent">
                          <TextBlock Classes="mono" TextTrimming="CharacterEllipsis" Text="{Binding TabTitle}" />
                        </Button>
                        <TextBlock Grid.Column="2"
                                   Classes="caption"
                                   Margin="8,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding StatusText}" />
                        <TextBlock Grid.Column="3"
                                   Classes="mono"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding ElapsedText}" />
                        <Button Grid.Column="4"
                                Classes="ghost"
                                Content="{Binding [subagent.stop], Source={x:Static loc:Loc.Instance}}"
                                Command="{Binding StopCommand}"
                                IsVisible="{Binding CanStop}"
                                ToolTip.Tip="{Binding [subagent.stopTooltip], Source={x:Static loc:Loc.Instance}}"
                                AutomationProperties.AutomationId="inspector-stop-agent"
                                AutomationProperties.Name="{Binding [subagent.stopName], Source={x:Static loc:Loc.Instance}}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- 2. MCP servers. -->
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="label" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding McpTitle}" />
                <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding McpNote}" />
              </StackPanel>
              <TextBlock Classes="caption" IsVisible="{Binding !HasMcp}" Text="{Binding McpEmpty}" />
              <Border Classes="res-table" IsVisible="{Binding HasMcp}">
                <StackPanel>
                  <Border Classes="res-head">
                    <Grid ColumnDefinitions="*,110,50,70,70,Auto">
                      <TextBlock Classes="caption" Text="{Binding McpServerHeader}" />
                      <TextBlock Grid.Column="1" Classes="caption" Text="{Binding McpStatusHeader}" />
                      <TextBlock Grid.Column="2" Classes="caption res-num" Text="{Binding ColumnTools}" />
                      <TextBlock Grid.Column="3" Classes="caption res-num" Text="{Binding ColumnChars}" />
                      <TextBlock Grid.Column="4" Classes="caption res-num" Text="{Binding ColumnTokens}" />
                      <Border Grid.Column="5" Width="150" />
                    </Grid>
                  </Border>
                  <ItemsControl ItemsSource="{Binding McpServers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ResourceMcpRowViewModel">
                        <Border Classes="res-row">
                          <Grid ColumnDefinitions="*,110,50,70,70,Auto">
                            <TextBlock Classes="mono"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Name}" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        ToolTip.Tip="{Binding ErrorText}">
                              <Ellipse Classes="res-dot" Classes.ready="{Binding IsReady}" Classes.failed="{Binding IsFailed}" />
                              <TextBlock Classes="caption"
                                         VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis"
                                         Text="{Binding StatusText}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Classes="res-num" Text="{Binding ToolsText}" />
                            <TextBlock Grid.Column="3" Classes="res-num" Text="{Binding CharsText}" />
                            <TextBlock Grid.Column="4" Classes="res-num" Text="{Binding TokensText}" />
                            <StackPanel Grid.Column="5"
                                        Width="150"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="2">
                              <Button Classes="ghost" Content="{Binding SignInText}" Command="{Binding SignInCommand}" IsVisible="{Binding CanSignIn}" />
                              <Button Classes="ghost" Content="{Binding StartText}" Command="{Binding StartCommand}" IsVisible="{Binding CanStart}" />
                              <Button Classes="ghost" Content="{Binding RestartText}" Command="{Binding RestartCommand}" IsVisible="{Binding CanStopOrRestart}" />
                              <Button Classes="ghost" Content="{Binding StopText}" Command="{Binding StopCommand}" IsVisible="{Binding CanStopOrRestart}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- 3. Tool definitions the model is sent, by category. -->
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="label" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding ToolsTitle}" />
                <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding ToolsNote}" />
              </StackPanel>
              <TextBlock Classes="caption" IsVisible="{Binding !HasTools}" Text="{Binding ToolsEmpty}" />
              <Border Classes="res-table" IsVisible="{Binding HasTools}">
                <StackPanel>
                  <Border Classes="res-head">
                    <Grid ColumnDefinitions="*,50,80,80">
                      <TextBlock Classes="caption" Text="{Binding ToolsCategoryHeader}" />
                      <TextBlock Grid.Column="1" Classes="caption res-num" Text="{Binding ColumnTools}" />
                      <TextBlock Grid.Column="2" Classes="caption res-num" Text="{Binding ColumnChars}" />
                      <TextBlock Grid.Column="3" Classes="caption res-num" Text="{Binding ColumnTokens}" />
                    </Grid>
                  </Border>
                  <ItemsControl ItemsSource="{Binding Tools}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ResourceUsageLineViewModel">
                        <Border Classes="res-row" Classes.res-total="{Binding IsTotal}">
                          <Grid ColumnDefinitions="*,50,80,80">
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                            <TextBlock Grid.Column="1" Classes="res-num" Text="{Binding ToolsText}" />
                            <TextBlock Grid.Column="2" Classes="res-num" Text="{Binding CharsText}" />
                            <TextBlock Grid.Column="3" Classes="res-num" Text="{Binding TokensText}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- 4. Prompts in use, with the stale chip and the reload button docked right. -->
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock Classes="label" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding PromptsTitle}" />
                <Border Grid.Column="2" Classes="res-chip" Margin="0,0,8,0" IsVisible="{Binding PromptsAreStale}">
                  <TextBlock Text="{Binding PromptsStaleText}" />
                </Border>
                <Button Grid.Column="3"
                        Classes="ghost"
                        Content="{Binding PromptsReloadText}"
                        Command="{Binding ReloadCommand}"
                        ToolTip.Tip="{Binding ReloadTooltip}"
                        AutomationProperties.AutomationId="inspector-reload-prompts" />
              </Grid>
              <TextBlock Classes="caption" IsVisible="{Binding !HasPrompts}" Text="{Binding PromptsEmpty}" />
              <Border Classes="res-table" IsVisible="{Binding HasPrompts}">
                <StackPanel>
                  <Border Classes="res-head">
                    <Grid ColumnDefinitions="*,80,80">
                      <TextBlock Classes="caption" Text="{Binding PromptsSourceHeader}" />
                      <TextBlock Grid.Column="1" Classes="caption res-num" Text="{Binding ColumnChars}" />
                      <TextBlock Grid.Column="2" Classes="caption res-num" Text="{Binding ColumnTokens}" />
                    </Grid>
                  </Border>
                  <ItemsControl ItemsSource="{Binding Prompts}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ResourceUsageLineViewModel">
                        <Border Classes="res-row" Classes.res-total="{Binding IsTotal}">
                          <Grid ColumnDefinitions="*,80,80">
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                            <TextBlock Grid.Column="1" Classes="res-num" Text="{Binding CharsText}" />
                            <TextBlock Grid.Column="2" Classes="res-num" Text="{Binding TokensText}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>

            <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasUsage}" Text="{Binding EstimateNote}" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
