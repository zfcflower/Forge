<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:wc="using:Forge.App.Workbench.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Forge.App.ViewModels"
             xmlns:loc="using:Forge.App.Localization"
             x:Class="Forge.App.Views.ChangesView"
             x:DataType="vm:ChangesViewModel">

  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:DiffFileRowViewModel" x:DataType="vm:DiffFileRowViewModel">
      <Border Background="{DynamicResource SurfaceMutedBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,1,0,1"
              Padding="8,4">
        <Grid ColumnDefinitions="Auto,*">
          <Border Background="{DynamicResource AccentSubtleBrush}"
                  CornerRadius="{StaticResource RadiusSm}"
                  Padding="4,0"
                  MinWidth="20">
            <TextBlock Classes="label"
                       Text="{Binding Badge}"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource AccentTextBrush}" />
          </Border>
          <TextBlock Grid.Column="1" Classes="mono" Margin="6,0,0,0" Text="{Binding Header}" />
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="vm:DiffLineRowViewModel" x:DataType="vm:DiffLineRowViewModel">
      <Border Classes="diff-line" Classes.add="{Binding IsAdd}" Classes.del="{Binding IsRemove}" Classes.hunk="{Binding IsHunk}">
        <Grid ColumnDefinitions="46,46,Auto,*" Height="17">
          <TextBlock Classes="mono"
                     Text="{Binding OldNumber}"
                     TextAlignment="Right"
                     Margin="0,0,6,0"
                     Foreground="{DynamicResource TextMutedBrush}" />
          <TextBlock Grid.Column="1"
                     Classes="mono"
                     Text="{Binding NewNumber}"
                     TextAlignment="Right"
                     Margin="0,0,6,0"
                     Foreground="{DynamicResource TextMutedBrush}" />
          <TextBlock Grid.Column="2" Classes="mono" Text="{Binding Prefix}" Foreground="{DynamicResource TextMutedBrush}" />
          <TextBlock Grid.Column="3" Classes="mono" Text="{Binding Text}" Foreground="{DynamicResource TextPrimaryBrush}" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid RowDefinitions="Auto,Auto,Auto,*" Background="{DynamicResource SurfaceBrush}">
    <Border Classes="toolbar">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <Button Classes="tab"
                Classes.selected="{Binding IsByTurn}"
                Content="{Binding [changes.byTurn], Source={x:Static loc:Loc.Instance}}"
                Command="{Binding ByTurnCommand}"
                AutomationProperties.AutomationId="changes-by-turn"
                AutomationProperties.Name="{Binding [changes.byTurn], Source={x:Static loc:Loc.Instance}}" />
        <Button Grid.Column="1"
                Classes="tab"
                Classes.selected="{Binding IsUncommitted}"
                Content="{Binding [changes.uncommitted], Source={x:Static loc:Loc.Instance}}"
                Command="{Binding UncommittedCommand}"
                AutomationProperties.AutomationId="changes-uncommitted"
                AutomationProperties.Name="{Binding [changes.uncommitted], Source={x:Static loc:Loc.Instance}}" />
        <ComboBox Grid.Column="2"
                  Margin="10,0"
                  MinWidth="180"
                  HorizontalAlignment="Left"
                  IsVisible="{Binding IsByTurn}"
                  ItemsSource="{Binding Turns}"
                  SelectedItem="{Binding SelectedTurn, Mode=TwoWay}"
                  AutomationProperties.AutomationId="changes-turn"
                  AutomationProperties.Name="{Binding [changes.turns.name], Source={x:Static loc:Loc.Instance}}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TurnChoiceViewModel">
              <TextBlock Classes="caption" Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Grid.Column="3"
                   Classes="caption"
                   Margin="0,0,10,0"
                   VerticalAlignment="Center"
                   Text="{Binding Summary}" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Classes="toolbar">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
        <Button Classes="ghost"
                Command="{Binding PreviousFileCommand}"
                ToolTip.Tip="{Binding [changes.previousFile], Source={x:Static loc:Loc.Instance}}"
                AutomationProperties.AutomationId="changes-previous-file"
                AutomationProperties.Name="{Binding [changes.previousFile], Source={x:Static loc:Loc.Instance}}"
                Content="{Binding [changes.previousFile], Source={x:Static loc:Loc.Instance}}" />
        <Button Grid.Column="1"
                Classes="ghost"
                Margin="4,0,0,0"
                Command="{Binding NextFileCommand}"
                ToolTip.Tip="{Binding [changes.nextFile], Source={x:Static loc:Loc.Instance}}"
                AutomationProperties.AutomationId="changes-next-file"
                AutomationProperties.Name="{Binding [changes.nextFile], Source={x:Static loc:Loc.Instance}}"
                Content="{Binding [changes.nextFile], Source={x:Static loc:Loc.Instance}}" />
        <TextBlock Grid.Column="2"
                   Classes="mono caption"
                   Margin="10,0"
                   VerticalAlignment="Center"
                   Text="{Binding SelectedFile.Path}"
                   TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding HasSelectedFile}"
                   ToolTip.Tip="{Binding SelectedFile.Path}" />
        <Button Grid.Column="3"
                Classes="ghost"
                Command="{Binding OpenInEditorCommand}"
                ToolTip.Tip="{Binding [changes.openInEditor], Source={x:Static loc:Loc.Instance}}"
                AutomationProperties.AutomationId="changes-open-in-editor"
                AutomationProperties.Name="{Binding [changes.openInEditor], Source={x:Static loc:Loc.Instance}}"
                Content="{Binding [changes.openInEditor], Source={x:Static loc:Loc.Instance}}" />
        <Button Grid.Column="4"
                Classes="ghost"
                Margin="4,0,0,0"
                Click="OnCopyPathClick"
                IsEnabled="{Binding HasSelectedFile}"
                ToolTip.Tip="{Binding [changes.copyPath], Source={x:Static loc:Loc.Instance}}"
                AutomationProperties.AutomationId="changes-copy-path"
                AutomationProperties.Name="{Binding [changes.copyPath], Source={x:Static loc:Loc.Instance}}"
                Content="{Binding [changes.copyPath], Source={x:Static loc:Loc.Instance}}" />
        <Button Grid.Column="5"
                Classes="ghost icon"
                Margin="4,0,0,0"
                Command="{Binding RefreshCommand}"
                ToolTip.Tip="{Binding [changes.refresh], Source={x:Static loc:Loc.Instance}}"
                AutomationProperties.AutomationId="refresh-changes"
                AutomationProperties.Name="{Binding [changes.refresh.name], Source={x:Static loc:Loc.Instance}}">
          <wc:FluentIcon Data="{StaticResource IconRefresh}" Width="14" Height="14" />
        </Button>
      </Grid>
    </Border>

    <TextBlock Grid.Row="2"
               Classes="caption"
               Margin="12,6"
               IsVisible="{Binding HasMessage}"
               Text="{Binding Message}" />

    <ListBox x:Name="RowList"
             Grid.Row="3"
             ItemsSource="{Binding Rows}"
             Padding="0,0,0,8"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"
             AutomationProperties.AutomationId="changes-rows"
             AutomationProperties.Name="{Binding [changes.rows.name], Source={x:Static loc:Loc.Instance}}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
    </ListBox>
  </Grid>
</UserControl>
