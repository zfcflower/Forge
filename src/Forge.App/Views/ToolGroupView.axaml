<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Forge.App.ViewModels"
             xmlns:views="using:Forge.App.Views"
             xmlns:wc="using:Forge.App.Workbench.Controls"
             x:Class="Forge.App.Views.ToolGroupView"
             x:DataType="vm:TurnToolGroupViewModel">
  <UserControl.Resources>
    <views:ToolIconConverter x:Key="ToolIcon" />
  </UserControl.Resources>

  <UserControl.DataTemplates>

    <!-- One call as a card: the reply card's face (white, 1px outline, 8px corner); hovering and pressing only move the surface. -->
    <DataTemplate DataType="vm:ToolRowViewModel" x:DataType="vm:ToolRowViewModel">
      <Button Classes="tool-card"
              Classes.open="{Binding IsExpanded}"
              Command="{Binding ToggleCommand}"
              Margin="0,1,6,4"
              AutomationProperties.AutomationId="tool-card"
              AutomationProperties.Name="{Binding Name}"
              ToolTip.Tip="{Binding Headline}">
        <StackPanel Spacing="3">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <wc:FluentIcon Data="{Binding Kind, Converter={StaticResource ToolIcon}}"
                           Width="13"
                           Height="13"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Grid.Column="1"
                       Classes="mono tool-card-name"
                       Margin="5,0,6,0"
                       VerticalAlignment="Center"
                       Text="{Binding Name}" />
            <Panel Grid.Column="2" VerticalAlignment="Center">
              <wc:FluentIcon Classes="tool-status ok"
                             Data="{StaticResource IconCheck}"
                             IsVisible="{Binding IsSucceeded}" />
              <wc:FluentIcon Classes="tool-status fail"
                             Data="{StaticResource IconClose}"
                             IsVisible="{Binding IsError}" />
              <wc:FluentIcon Classes="tool-status run"
                             Data="{StaticResource IconRefresh}"
                             IsVisible="{Binding IsRunning}" />
              <wc:FluentIcon Classes="tool-status wait"
                             Data="{StaticResource IconEllipsis}"
                             IsVisible="{Binding IsWaiting}" />
            </Panel>
          </Grid>
          <TextBlock Classes="mono tool-card-body" Text="{Binding CardBody}" />
        </StackPanel>
      </Button>
    </DataTemplate>

    <!-- The open call's whole body, full width under its own row. A question call shows the question card (options and answer)
         instead of the raw arguments. -->
    <DataTemplate DataType="vm:ToolOpenViewModel" x:DataType="vm:ToolOpenViewModel">
      <Panel Margin="0,1,6,6">
        <Border Classes="tool-open" IsVisible="{Binding !Tool.IsQuestionCard}">
          <views:ToolRowExpandedView DataContext="{Binding Tool}" />
        </Border>
        <Border Classes="tool-open" IsVisible="{Binding Tool.IsQuestionCard}">
          <views:QuestionCardView DataContext="{Binding Tool}" />
        </Border>
      </Panel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <ItemsControl ItemsSource="{Binding Items}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <views:ToolCardPanel Columns="4" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
  </ItemsControl>
</UserControl>
