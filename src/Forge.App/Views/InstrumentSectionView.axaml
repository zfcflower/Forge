<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:set="using:Forge.App.ViewModels.Settings"
             x:Class="Forge.App.Views.InstrumentSectionView"
             x:DataType="set:InstrumentSettingsSectionViewModel">
  <!-- The body the four instrument sections share: a hint, a read-only row list and the empty state. It is a view rather
       than a keyed DataTemplate so each section's template refers to a type the compiler checks instead of a resource key
       that would only fail the moment a section is selected. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="8">
      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Hint}" />
      <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.AutomationId="instrument-section-rows">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="set:InstrumentRow">
            <Grid ColumnDefinitions="*,Auto" Margin="0,3">
              <StackPanel Spacing="1">
                <TextBlock Text="{Binding Title}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="caption"
                           Text="{Binding Detail}"
                           IsVisible="{Binding HasDetail}"
                           TextWrapping="Wrap"
                           MaxWidth="520" />
              </StackPanel>
              <TextBlock Grid.Column="1"
                         Classes="caption"
                         Margin="12,0,0,0"
                         VerticalAlignment="Top"
                         MaxWidth="240"
                         Text="{Binding Trailing}"
                         IsVisible="{Binding HasTrailing}"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding Trailing}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="caption"
                 TextWrapping="Wrap"
                 Text="{Binding EmptyText}"
                 IsVisible="{Binding !HasRows}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
