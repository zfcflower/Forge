<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Forge.App.Localization"
             xmlns:vm="using:Forge.App.ViewModels"
             xmlns:views="using:Forge.App.Views"
             x:Class="Forge.App.Views.SubAgentView"
             x:DataType="vm:SubAgentViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource CardBackgroundBrush}">
    <!-- Where this tab sits: the parent session's title, then the sub-agent's own name. The parent segment switches the
         shell back to the parent's tab; the sub-agent keeps running and its tab stays in the bottom group. -->
    <Border Grid.Row="0"
            Padding="12,6"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            AutomationProperties.AutomationId="subagent-breadcrumb">
      <Border.Styles>
        <StyleInclude Source="avares://Forge.App/Resources/ChromeStyles.axaml" />
      </Border.Styles>
      <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Button Classes="breadcrumb"
                IsVisible="{Binding HasBackToParent}"
                Content="{Binding ParentSessionTitle}"
                Command="{Binding BackToParentCommand}"
                ToolTip.Tip="{Binding BackToParentText}"
                AutomationProperties.AutomationId="subagent-breadcrumb-parent"
                AutomationProperties.Name="{Binding BackToParentText}" />
        <TextBlock Classes="breadcrumb-separator"
                   IsVisible="{Binding HasBackToParent}"
                   Text="&#x203A;" />
        <TextBlock Classes="breadcrumb-current"
                   MaxWidth="420"
                   TextTrimming="CharacterEllipsis"
                   Text="{Binding BreadcrumbName}"
                   AutomationProperties.AutomationId="subagent-breadcrumb-name" />
      </StackPanel>
    </Border>

    <views:TranscriptListBox x:Name="Transcript"
             Grid.Row="1"
             ItemsSource="{Binding Transcript.Rounds}"
             Padding="{DynamicResource ChatTranscriptPadding}"
             SelectionMode="Single"
             AutoScrollToSelectedItem="False"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <views:TranscriptStackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
    </views:TranscriptListBox>

    <Border Grid.Row="2"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,6">
      <Border.Styles>
        <StyleInclude Source="avares://Forge.App/Resources/ChromeStyles.axaml" />
      </Border.Styles>
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Ellipse Classes="status-dot" Classes.running="{Binding IsLive}" />
          <TextBlock Classes="label" Text="{Binding StatusText}" VerticalAlignment="Center" />
          <TextBlock Classes="caption" Text="{Binding StatusNote}" VerticalAlignment="Center" IsVisible="{Binding HasStatusNote}" />
          <Border IsVisible="{Binding ReadOnlyBadgeVisible}"
                  Background="{DynamicResource BrandTintBrush}"
                  CornerRadius="{StaticResource RadiusSm}"
                  Padding="5,0"
                  VerticalAlignment="Center">
            <TextBlock Classes="label" Text="{Binding ReadOnlyBadgeText}" Foreground="{DynamicResource BrandActionBrush}" />
          </Border>
        </StackPanel>
        <TextBlock Grid.Column="1"
                   Classes="caption"
                   Margin="12,0,0,0"
                   MaxWidth="280"
                   VerticalAlignment="Center"
                   Text="{Binding TaskSummary}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding Task}" />
        <TextBlock Grid.Column="3" Classes="caption" Margin="0,0,12,0" Text="{Binding UsageText}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="4" Classes="mono" Margin="0,0,12,0" Text="{Binding ElapsedText}" VerticalAlignment="Center" />
        <Button Grid.Column="5"
                Classes="ghost"
                Content="{Binding [subagent.stop], Source={x:Static loc:Loc.Instance}}"
                IsVisible="{Binding CanStop}"
                Command="{Binding StopCommand}"
                AutomationProperties.AutomationId="stop-subagent"
                AutomationProperties.Name="{Binding [subagent.stopName], Source={x:Static loc:Loc.Instance}}"
                ToolTip.Tip="{Binding [subagent.stopTooltip], Source={x:Static loc:Loc.Instance}}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
