<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:set="using:Forge.App.Settings"
             xmlns:loc="using:Forge.App.Localization"
             x:Class="Forge.App.Views.Settings.ChatSettingsSectionView"
             x:DataType="set:ChatSettingsSectionViewModel">
  <StackPanel Spacing="6">

    <!-- Thumbnail edge of tool-result images: the decode bound, never a re-encode of the stored image. -->
    <Grid ColumnDefinitions="150,*" Margin="0,3">
      <TextBlock Classes="label"
                 VerticalAlignment="Center"
                 Text="{Binding [chat.settings.thumbnailEdge], Source={x:Static loc:Loc.Instance}}" />
      <NumericUpDown Grid.Column="1"
                     MinWidth="120"
                     HorizontalAlignment="Left"
                     Minimum="{x:Static set:ChatSettingsSectionViewModel.MinThumbnailEdgeDecimal}"
                     Maximum="{x:Static set:ChatSettingsSectionViewModel.MaxThumbnailEdgeDecimal}"
                     Increment="16"
                     FormatString="0"
                     Value="{Binding ThumbnailEdge, Mode=TwoWay}"
                     AutomationProperties.AutomationId="chat-thumbnail-edge"
                     AutomationProperties.Name="{Binding [chat.settings.thumbnailEdge], Source={x:Static loc:Loc.Instance}}" />
    </Grid>

    <!-- Whether the tool result's images reach the model; the transcript always shows them. -->
    <Grid ColumnDefinitions="150,*" Margin="0,9,0,3">
      <TextBlock Classes="label"
                 VerticalAlignment="Center"
                 Text="{Binding [chat.settings.sendToolImages], Source={x:Static loc:Loc.Instance}}" />
      <CheckBox Grid.Column="1"
                IsChecked="{Binding SendToolImagesToModel, Mode=TwoWay}"
                AutomationProperties.AutomationId="chat-send-tool-images"
                AutomationProperties.Name="{Binding [chat.settings.sendToolImages], Source={x:Static loc:Loc.Instance}}" />
    </Grid>

    <!-- Which Mermaid diagram types are drawn (wave W11); the accepted tokens are a constant, so they bind statically. -->
    <Grid ColumnDefinitions="150,*" Margin="0,9,0,3">
      <TextBlock Classes="label"
                 VerticalAlignment="Center"
                 Text="{Binding [chat.settings.mermaidTypes], Source={x:Static loc:Loc.Instance}}" />
      <StackPanel Grid.Column="1" Spacing="3">
        <TextBox Text="{Binding MermaidTypes, Mode=TwoWay}"
                 AutomationProperties.AutomationId="chat-mermaid-types"
                 AutomationProperties.Name="{Binding [chat.settings.mermaidTypes], Source={x:Static loc:Loc.Instance}}" />
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   Text="{Binding [chat.settings.mermaidTypesHint], Source={x:Static loc:Loc.Instance}}" />
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   Text="{x:Static set:ChatSettingsSectionViewModel.KnownMermaidTypes}" />
      </StackPanel>
    </Grid>

    <!-- Wall-clock bound of one diagram render; the preference clamps it to the same bounds as this control. -->
    <Grid ColumnDefinitions="150,*" Margin="0,3">
      <TextBlock Classes="label"
                 VerticalAlignment="Center"
                 Text="{Binding [chat.settings.mermaidTimeout], Source={x:Static loc:Loc.Instance}}" />
      <NumericUpDown Grid.Column="1"
                     MinWidth="120"
                     HorizontalAlignment="Left"
                     Minimum="{x:Static set:ChatSettingsSectionViewModel.MinMermaidTimeoutDecimal}"
                     Maximum="{x:Static set:ChatSettingsSectionViewModel.MaxMermaidTimeoutDecimal}"
                     Increment="100"
                     FormatString="0"
                     Value="{Binding MermaidTimeoutMilliseconds, Mode=TwoWay}"
                     AutomationProperties.AutomationId="chat-mermaid-timeout"
                     AutomationProperties.Name="{Binding [chat.settings.mermaidTimeout], Source={x:Static loc:Loc.Instance}}" />
    </Grid>

    <TextBlock Classes="caption"
               TextWrapping="Wrap"
               Text="{Binding [chat.settings.hint], Source={x:Static loc:Loc.Instance}}" />
  </StackPanel>
</UserControl>
