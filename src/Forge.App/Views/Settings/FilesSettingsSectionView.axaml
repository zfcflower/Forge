<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Forge.App.Settings"
             x:Class="Forge.App.Views.Settings.FilesSettingsSectionView"
             x:DataType="settings:FilesSettingsSectionViewModel">
  <StackPanel Spacing="6">
    <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Hint}"
               AutomationProperties.AutomationId="files-settings-hint" />
    <Grid ColumnDefinitions="150,*" Margin="0,3">
      <TextBlock Classes="label" VerticalAlignment="Center" Text="{Binding PreviewRowsLabel}" />
      <NumericUpDown Grid.Column="1"
                     MinWidth="120"
                     HorizontalAlignment="Left"
                     Minimum="{Binding MinRows}"
                     Maximum="{Binding MaxRows}"
                     Increment="100"
                     FormatString="0"
                     Value="{Binding PreviewRows, Mode=TwoWay}"
                     AutomationProperties.AutomationId="files-preview-rows"
                     AutomationProperties.Name="{Binding PreviewRowsLabel}" />
    </Grid>
    <Grid ColumnDefinitions="150,*" Margin="0,3">
      <TextBlock Classes="label" VerticalAlignment="Center" Text="{Binding NotebookOutputLabel}" />
      <NumericUpDown Grid.Column="1"
                     MinWidth="120"
                     HorizontalAlignment="Left"
                     Minimum="{Binding MinNotebookKilobytes}"
                     Maximum="{Binding MaxNotebookKilobytes}"
                     Increment="4"
                     FormatString="0"
                     Value="{Binding NotebookOutputKilobytes, Mode=TwoWay}"
                     AutomationProperties.AutomationId="files-notebook-output"
                     AutomationProperties.Name="{Binding NotebookOutputLabel}" />
    </Grid>
    <Grid ColumnDefinitions="150,*" Margin="0,3">
      <TextBlock Classes="label" VerticalAlignment="Center" Text="{Binding ImageLimitLabel}" />
      <NumericUpDown Grid.Column="1"
                     MinWidth="120"
                     HorizontalAlignment="Left"
                     Minimum="{Binding MinImageMegabytes}"
                     Maximum="{Binding MaxImageMegabytes}"
                     Increment="1"
                     FormatString="0"
                     Value="{Binding ImageLimitMiB, Mode=TwoWay}"
                     AutomationProperties.AutomationId="files-image-limit"
                     AutomationProperties.Name="{Binding ImageLimitLabel}" />
    </Grid>
  </StackPanel>
</UserControl>
