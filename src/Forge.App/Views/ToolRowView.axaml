<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Forge.App.ViewModels"
             xmlns:views="using:Forge.App.Views"
             xmlns:loc="using:Forge.App.Localization"
             xmlns:wc="using:Forge.App.Workbench.Controls"
             x:Class="Forge.App.Views.ToolRowView"
             x:DataType="vm:ToolRowViewModel">
  <Panel>
  <!-- ask_user: the question-and-answer card. -->
  <ContentControl Content="{Binding QuestionBody}" IsVisible="{Binding IsQuestionCard}">
    <ContentControl.ContentTemplate>
      <DataTemplate x:DataType="vm:ToolRowViewModel">
        <Border Classes="turn-card" Padding="10" Margin="0,2">
          <views:QuestionCardView />
        </Border>
      </DataTemplate>
    </ContentControl.ContentTemplate>
  </ContentControl>
  <Border Classes="tool-row" Classes.expanded="{Binding IsExpanded}" IsVisible="{Binding !IsQuestionCard}">
    <StackPanel Spacing="2">
      <!-- The header is one toggle button over the whole row; a tool that works on a file (read, write, edit...) shows that path as
           its own link inside it, so a click on the path opens the file in the preview tab and a click anywhere else expands. -->
      <Button Classes="link"
              Command="{Binding ToggleCommand}"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Left">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
          <wc:FluentIcon Data="{StaticResource TreeChevronGeometry}" Classes="tree-chevron" Rotated="{Binding IsExpanded}" Width="12" Height="12" />
          <TextBlock Grid.Column="1" Classes="mono" Margin="6,0,0,0" Text="{Binding Name}" />
          <TextBlock Grid.Column="2"
                     Classes="caption"
                     Margin="8,0"
                     TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding !HasTarget}"
                     ToolTip.Tip="{Binding Headline}"
                     Text="{Binding Headline}" />
          <Button Grid.Column="2"
                  Classes="link"
                  Click="OnOpenTarget"
                  IsVisible="{Binding HasTarget}"
                  HorizontalAlignment="Left"
                  Margin="8,0"
                  AutomationProperties.AutomationId="tool-open-path"
                  ToolTip.Tip="{Binding Headline}">
            <TextBlock Classes="caption" Text="{Binding Headline}" TextDecorations="Underline" TextTrimming="CharacterEllipsis" />
          </Button>
          <!-- The call's status: the ✓/✗ of a returned call, the still clock of a call the policy asked about, and the same
               turning glyph the cards wear while it has not returned yet. -->
          <Panel Grid.Column="3" VerticalAlignment="Center">
            <TextBlock Classes="caption" Text="{Binding Status}" IsVisible="{Binding ShowStatusText}" />
            <wc:FluentIcon Data="{StaticResource IconClock}"
                           Width="12"
                           Height="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           IsVisible="{Binding IsAwaitingApproval}" />
            <views:WaitingGlyph Data="{StaticResource IconRefresh}"
                                Width="12"
                                Height="12"
                                Foreground="{DynamicResource BrandActionBrush}"
                                IsVisible="{Binding IsRunning}" />
          </Panel>
        </Grid>
      </Button>
      <ContentControl Content="{Binding ExpandedBody}" IsVisible="{Binding IsExpanded}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:ToolRowViewModel">
            <Border Margin="18,2,0,2">
              <views:ToolRowExpandedView />
            </Border>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </StackPanel>
  </Border>
  </Panel>
</UserControl>
