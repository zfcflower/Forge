<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wc="using:Forge.App.Workbench.Controls">

  <!-- The composer's chips and the rows of the pickers that open from them (agent, model, orchestration). Shared by the toolbar
       and the suggestion list, so they live here instead of in either view. The chip and the composer's icon buttons wear the
       light, borderless tier: one grey fill at rest, two deeper ones under the pointer, so a chip reads as a button without
       drawing a second outline inside the card's own. -->
    <Style Selector="Button.composer-chip">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.composer-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.composer-chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.composer-chip:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <!-- The composer bar's icon buttons (attach, history) are the same light tier in an icon's box: 26px square, the small
         radius, no border - the geometry `Button.icon` has, with the fill the chip carries. -->
    <Style Selector="Button.composer-tool">
      <Setter Property="MinWidth" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.composer-tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.composer-tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.composer-tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Rectangle.effort-bar">
      <Setter Property="Width" Value="2.5" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.composer-row">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.composer-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Button.composer-row.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
    </Style>
    <Style Selector="Button.composer-mini">
      <Setter Property="MinWidth" Value="20" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The picker rows (PickerRow): a plain decorator, so a popup that attaches dozens of them stays cheap. The transparent
         fill is what makes the row hit-testable; it lives here rather than in the control, because a local value would
         outrank the `:pointerover` fill below and no picker row would ever highlight. -->
    <Style Selector="Border.picker-row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    </Style>
    <!-- One hover fill for every row of every flyout menu (model rows, provider groups, the agent and orchestration
         pickers): `SurfaceHoverBrush`, the one tint a menu row takes under the pointer. -->
    <Style Selector="Border.picker-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Border.picker-row:focus-visible">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Border.picker-row.pin">
      <Setter Property="Padding" Value="6,5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Rows of the model picker: the pinned caption, one header per provider and the models under it. A model row carries
         the list's one light rule at its bottom - a rectangle inset to the name's edge (26 px = the row padding + the check
         column), not a border, because a border cannot start mid-row. Hovering paints the whole row, pin included, so the
         hit target and the highlight are the same rectangle. -->
    <Style Selector="Border.model-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Rectangle.model-row-rule">
      <Setter Property="Fill" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Height" Value="1" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Margin" Value="26,0,0,0" />
    </Style>
    <!-- The model id itself: the body size, the same as the provider headers above it and as the composer that named the model. -->
    <Style Selector="TextBlock.model-name">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
    </Style>
    <!-- The provider header is a band: the same grey as a panel's scope row, at the body size, with 2 px more headroom than a
         model row on each side - the group names the block below it instead of looking like one more entry. Declared after
         the generic row hover, so its band and the hover tint above it need their own, later rules. -->
    <Style Selector="Border.picker-row.model-group">
      <Setter Property="Padding" Value="8,8" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="{DynamicResource PanelBandBrush}" />
      <!-- 1 px of card below each band: collapsed groups would otherwise touch and read as one grey block. -->
      <Setter Property="Margin" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.picker-row.model-group:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Border.picker-row.model-group:focus-visible">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="TextBlock.model-group-name">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- The pinned section is a caption, not a group to open: no chevron, no count - but at body size and bold, so the
         word that names the block reads on its own instead of hiding under the provider headers. -->
    <Style Selector="Border.picker-row.model-group.section">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.picker-row.model-group.section:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Border.picker-row.model-group.section TextBlock.model-group-name">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="0.6" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <!-- The price line under the model id: one size with the id above it (the body size), quieter only through its colour. -->
    <Style Selector="TextBlock.model-price">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <!-- The pin: hollow while the model is not pinned, filled while it is. Icons rather than glyphs, like every other mark in the
         app; the state is told twice, by shape and by colour. -->
    <Style Selector="wc|FluentIcon.pin-icon">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="wc|FluentIcon.pin-icon.pinned">
      <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.effort-track">
      <!-- The gradient is the scale, not a progress read: it always spans the whole track, so the low end stays light and
           the high end stays deep wherever the thumb sits. -->
      <Setter Property="Height" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
          <GradientStop Offset="0" Color="{DynamicResource SystemAccentColorLight3}" />
          <GradientStop Offset="1" Color="{DynamicResource SystemAccentColorDark2}" />
        </LinearGradientBrush>
      </Setter>
    </Style>
    <Style Selector="TextBlock.effort-title">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.8" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <!-- The step labels under the track: one per accepted step, placed by EffortTickPanel on the thumb's own stops (the row is
         inset by the thumb's radius in Views/ComposerToolbar). The chosen step is inked as a chip - the thumb alone is too small
         to read the value off. -->
    <Style Selector="Border.effort-tick">
      <Setter Property="Padding" Value="3,1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    </Style>
    <Style Selector="Border.effort-tick > TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
      <!-- One line each, and never shortened: the panel pushes a label that would collide instead of trimming it, so at a full
           seven-step dial the row may reach a few pixels into the popup's padding at the ends. -->
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <!-- The stop mark on the track: a slice of the surface colour, so a pixel row of the bar reads as a position without
         needing a second colour slot. The thumb, which carries the same surface tint, covers the chosen stop's notch. -->
    <Style Selector="Border.effort-notch">
      <Setter Property="Width" Value="2" />
      <Setter Property="Height" Value="6" />
      <Setter Property="CornerRadius" Value="1" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Border.effort-tick.selected">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
    </Style>
    <Style Selector="Border.effort-tick.selected > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BrandActionBrush}" />
    </Style>
    <!-- Fluent's own slider keeps the behaviour; only its geometry and the colours that would draw a second, straight track
         over the gradient are redirected. The thumb is a circle wearing the same brand tint and outline as the picker's
         footer buttons, so the dial reads as one family with the actions under it. -->
    <Style Selector="Slider.effort">
      <Style.Resources>
        <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent" />
        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="Transparent" />
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent" />
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="Transparent" />
        <SolidColorBrush x:Key="SliderContainerBackground" Color="Transparent" />
        <SolidColorBrush x:Key="SliderContainerBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="SliderContainerBackgroundPressed" Color="Transparent" />
        <SolidColorBrush x:Key="SliderContainerBackgroundDisabled" Color="Transparent" />
        <x:Double x:Key="SliderHorizontalHeight">22</x:Double>
        <!-- The two margins and the 22 above must add up to the 16 px thumb below: the thumb then sits centred on the 6 px
             track, where a bare 22 left the leftover 6 px under it and the circle rode 2 px high. -->
        <GridLength x:Key="SliderPreContentMargin">3</GridLength>
        <GridLength x:Key="SliderPostContentMargin">3</GridLength>
        <CornerRadius x:Key="SliderThumbCornerRadius">8</CornerRadius>
      </Style.Resources>
    </Style>
    <!-- The thumb is named `thumb` by Fluent's horizontal slider template (the vertical one is `SliderThumb`); a theme update
         that renames it leaves the defaults in place rather than failing loudly, so this selector is the thing to re-check
         after an Avalonia upgrade. -->
    <Style Selector="Slider.effort /template/ Thumb#thumb">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Background" Value="{DynamicResource BrandTintBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrandInteractiveBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Slider.effort:pointerover /template/ Thumb#thumb">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrandActionBrush}" />
    </Style>
    <Style Selector="Slider.effort:pressed /template/ Thumb#thumb">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrandActionBrush}" />
    </Style>
    <Style Selector="Slider.effort:disabled /template/ Thumb#thumb">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <!-- The picker's outlined action: a brand tint under a brand outline, with the body text ink so the label stays the
         strongest thing in the button. The model picker's refresh wears it on the search row. -->
    <Style Selector="Button.composer-row.outlined">
      <Setter Property="Background" Value="{DynamicResource BrandTintBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrandInteractiveBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
      <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style Selector="Button.composer-row.outlined:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrandActionBrush}" />
    </Style>
    <Style Selector="Button.composer-row.outlined:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
    </Style>
    <Style Selector="Button.composer-row.outlined:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <!-- The refresh action on the model picker's search row: the same outlined family, sized to the field it sits beside. -->
    <Style Selector="Button.composer-row.search-action">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="8,3" />
    </Style>
    <!-- The Chat History flyout: one block per round - the user's message, then the answer it got. The block's two lines are
         the fill target (one message, one answer), so that button is bare chrome and takes no hover fill of its own: a tint
         under the words would read as selection, and the two icon buttons beside them are separate targets with their own. -->
    <Style Selector="Border.composer-history-row">
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- The row is the hover surface: the whole row - message, answer, age and the two actions - lights up together, because the
         whole row is what the pointer is on. The text block inside paints nothing of its own, so the tint is never doubled. -->
    <Style Selector="Border.composer-history-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Button.composer-history-block">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <!-- Stretch, not Left: the block's lines must be measured against the row's width, otherwise a long message lays out at
           its full length and never trims. -->
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.composer-history-block:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.composer-history-block:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- The block's two lines: the user's own words in the body ink on one line (the whole message is its tooltip), the
         answer a step quieter and allowed two lines. -->
    <Style Selector="TextBlock.composer-history-text">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.composer-history-text.user">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="MaxLines" Value="1" />
    </Style>
    <Style Selector="TextBlock.composer-history-text.agent">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="MaxLines" Value="2" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxWidth" Value="240" />
    </Style>
    <!-- The answer is quoted under the message it answers: the divider's colour as a 2 px rule on its left edge and 9 px of
         indent (2 + 7), no fill of its own - the row already owns the hover tint, and a second surface would read as a card
         inside a card. -->
    <Style Selector="Border.composer-history-quote">
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Padding" Value="7,0,0,0" />
      <Setter Property="Margin" Value="0,1,0,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="TextBlock.composer-history-time">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0,4,0" />
    </Style>
    <!-- The two row actions: one 22px box each, the small radius, nothing until the pointer is on them. -->
    <Style Selector="Button.composer-history-action">
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.composer-history-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.composer-history-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource IconButtonPressedBrush}" />
    </Style>
</Styles>
