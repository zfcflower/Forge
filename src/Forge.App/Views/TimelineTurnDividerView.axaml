<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Forge.App.ViewModels"
             xmlns:views="using:Forge.App.Views"
             x:Class="Forge.App.Views.TimelineTurnDividerView"
             x:DataType="vm:TurnDividerViewModel">
  <!-- The round-end row: the axis stops on this round's closing node (a check when the round finished cleanly, the failure
       icon when it did not) and the round's numbers ride beside it. It is the last row of its round, so it can never be
       crossed by another round's axis. The tooltip carries the full breakdown the line leaves out. -->
  <Grid ColumnDefinitions="Auto,*" ToolTip.Tip="{Binding Tooltip}">
    <views:TimelineGutter Kind="RoundEnd" IsFailing="{Binding HasFailed}" />
    <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                Margin="0,2,8,8"
                VerticalAlignment="Center"
                Spacing="8">
      <TextBlock Classes="caption"
                 VerticalAlignment="Center"
                 Text="{Binding Line}"
                 AutomationProperties.AutomationId="turn-divider" />
      <Border VerticalAlignment="Center"
              Height="1"
              MinWidth="24"
              Background="{DynamicResource BorderBrush}"
              IsVisible="True" />
    </StackPanel>
  </Grid>
</UserControl>
