<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Forge.App.ViewModels"
             xmlns:views="using:Forge.App.Views"
             x:Class="Forge.App.Views.TimelineTurnDividerView"
             x:DataType="vm:TurnDividerViewModel">
  <!-- The round-end row: the axis stops on this round's closing node (a check when the round finished cleanly, the failure
       icon when it did not) and the round's numbers ride beside it. The line wraps instead of trimming: its tail is the model
       name, and a metrics line that loses its tail reads as missing data. The tooltip carries the full breakdown. -->
  <Grid ColumnDefinitions="Auto,*">
    <views:TimelineGutter Kind="RoundEnd" IsFailing="{Binding HasFailed}" />
    <StackPanel Grid.Column="1" Margin="0,5,8,8" Spacing="2">
      <TextBlock Classes="round-end-line"
                 Classes.failed="{Binding HasFailed}"
                 TextWrapping="Wrap"
                 Text="{Binding Line}"
                 AutomationProperties.AutomationId="turn-divider" />
      <!-- The numbers the line leaves out, printed rather than hidden behind a hover: a wavy rule marks them as the detail. -->
      <Panel IsVisible="{Binding HasExtra}" HorizontalAlignment="Left">
        <StackPanel Spacing="0">
          <TextBlock Classes="round-end-extra"
                     Classes.failed="{Binding HasFailed}"
                     MaxWidth="640"
                     TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding Extra}"
                     AutomationProperties.AutomationId="turn-divider-extra" />
          <views:WavyUnderline Height="5"
                               Classes.failed="{Binding HasFailed}"
                               Stroke="{DynamicResource StatusSuccessBrush}" />
        </StackPanel>
      </Panel>
    </StackPanel>
  </Grid>
</UserControl>
