<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:wc="using:Forge.App.Workbench.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Forge.App.Localization"
             xmlns:vm="using:Forge.App.ViewModels"
             x:Class="Forge.App.Views.SessionView"
             x:DataType="vm:SessionWorkspaceViewModel">
  <UserControl.Styles>
    <!-- The composer is two rounded panels sharing one outline, exactly like the reference: the white strip carries the
         session's readout and buttons, and the grey input panel lies over the bottom of it, so its own rounded top edge is
         the seam between the zones while its left, right and bottom edges coincide with the strip's. The card itself only
         supplies the rounded clip and the focus state. -->
    <Style Selector="Border.composer-card">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <!-- No clip: each panel draws the part of the shared outline it owns, so the 1 px stroke along the arcs is the panels'
           own border and is not shaved off by a clip curve drawn at the same radius. -->
    </Style>

    <!-- 44 px tall with its bottom 10 px (the grey panel's corner radius) behind the grey panel: the visible white band stays
         34 px, and the white panel's straight side borders run all the way down to where the grey panel's side borders
         begin, so the outline never steps in at the seam. -->
    <Style Selector="Border.instrument-strip">
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="11,0,11,10" />
      <!-- Square bottom corners: square is what lets the side borders reach past the seam without curving inwards. -->
      <Setter Property="CornerRadius" Value="10,10,0,0" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <!-- No bottom edge: the grey panel's top edge is the seam, and two 1 px strokes there would read as a thick line. -->
      <Setter Property="BorderThickness" Value="1,1,1,0" />
      <!-- The width rule is the only thing that gives way; clipping guarantees that a pathological branch name can never
           paint outside the card. -->
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- The grey panel keeps all four corners rounded: its top arcs are drawn over the white panel's last 10 px, against the
         white behind them, while the straight part of its top border is the seam between the zones. Its left, right and
         bottom borders land on the same pixels as the white panel's, so the outline stays one straight line per side. -->
    <Style Selector="Border.composer-body">
      <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Margin" Value="0,-10,0,0" />
    </Style>

    <!-- Focus lights up the shared outline: both panels draw part of it, so both take the accent. -->
    <Style Selector="Border.composer-card.focused Border.instrument-strip">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.composer-card.focused Border.composer-body">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.instrument-info">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.instrument-meta">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The account-window reading (the provider's own 5h/7d utilization). It only takes a colour when the server said so:
         allowed_warning is the server's "near the limit", rejected is "the next request would be refused". There is no
         percentage threshold here, because a threshold this app invented would be a guess dressed as a measurement. -->
    <Style Selector="TextBlock.instrument-meta.quota-warning">
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="TextBlock.instrument-meta.quota-rejected">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Border.instrument-pill">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.instrument-pill > TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Button.instrument-chip">
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="7,0" />
      <!-- Icon, label and count are one centred group inside the chip. -->
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The pointer wash is defined last on purpose: Avalonia applies the later of two matching styles, not the more
         specific one, so hovering always wins over the resting state - including the active chip's accent wash, which stays
         the resting reading for "the area is open". -->
    <Style Selector="Button.instrument-chip.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Button.instrument-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- The context gauge: accent while there is room, the warning colour within 10 points of the trigger line, the danger
         colour at or past it. The segments and the label take the colour; the brushes live here and not in the template so
         the state classes can replace them. -->
    <Style Selector="Button.context-gauge Polygon.gauge-fill">
      <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.context-gauge Polygon.gauge-outline">
      <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.context-gauge.warning Polygon.gauge-fill">
      <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="Button.context-gauge.warning Polygon.gauge-outline">
      <Setter Property="Stroke" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="Button.context-gauge.warning TextBlock.gauge-label">
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="Button.context-gauge.over Polygon.gauge-fill">
      <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Button.context-gauge.over Polygon.gauge-outline">
      <Setter Property="Stroke" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Button.context-gauge.over TextBlock.gauge-label">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style Selector="Button.instrument-project">
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.instrument-project:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.instrument-count">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <!-- The sub-agent chip's run count: a round accent badge, one digit wide, that widens to a pill at two. It shares the
         accent-on-accent language of the composer's round send button, so both read as "this is live" at a glance. -->
    <Style Selector="Border.instrument-badge">
      <Setter Property="MinWidth" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.instrument-badge > TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LineHeight" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.instrument-divider">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The context bar is drawn, not a ProgressBar: the control's theme decides its own track size, while two borders keep
         the width exactly what the style says. The fill's width is computed by the view model. -->
    <Style Selector="Border.instrument-track">
      <Setter Property="Width" Value="54" />
      <Setter Property="Height" Value="4" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    </Style>
    <Style Selector="Border.instrument-fill">
      <Setter Property="Height" Value="4" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- the input sits borderless inside the card -->
    <Style Selector="TextBox.composer-input">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,8,10,4" />
    </Style>
    <Style Selector="TextBox.composer-input:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.composer-input:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.composer-chip">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.composer-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.composer-chip:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Rectangle.effort-bar">
      <Setter Property="Width" Value="2.5" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- full-width rows inside the flyouts and the suggestion list -->
    <Style Selector="Button.composer-row">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.composer-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    </Style>
    <Style Selector="Button.composer-row.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    </Style>
    <Style Selector="Border.image-thumb">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    </Style>
    <Style Selector="Button.image-remove">
      <Setter Property="Margin" Value="0,2,2,0" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="Button.composer-mini">
      <Setter Property="MinWidth" Value="20" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The pin lives in the composer's model list: a hollow star while the model is not pinned, the filled one while it is.
         Colour alone (muted vs warning) tells the two apart besides the shape. -->
    <Style Selector="wc|FluentIcon.star">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="wc|FluentIcon.star.pinned">
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- round send button: accent circle with an up arrow; "…" while a turn runs -->
    <Style Selector="Button.composer-send">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>
    <Style Selector="Button.composer-send /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
      <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Button.composer-send:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Button.composer-send:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Border.queued-chip">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Padding" Value="7,2,3,2" />
      <Setter Property="Margin" Value="0,0,4,4" />
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="Border.queued-chip.interjection">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
      <Setter Property="Padding" Value="7,2" />
    </Style>
    <Style Selector="TextBlock.queued-label">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <!-- effort slider over a gradient track -->
    <Style Selector="Border.effort-track">
      <Setter Property="Height" Value="4" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
          <GradientStop Offset="0" Color="{DynamicResource SystemAccentColorLight3}" />
          <GradientStop Offset="1" Color="{DynamicResource SystemAccentColorDark1}" />
        </LinearGradientBrush>
      </Setter>
    </Style>
    <Style Selector="Slider.effort">
      <Style.Resources>
        <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent" />
        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="Transparent" />
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent" />
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="Transparent" />
      </Style.Resources>
    </Style>

    <Style Selector="Border.composer-suggestions">
      <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="MinWidth" Value="320" />
      <Setter Property="MaxWidth" Value="560" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="BoxShadow" Value="{DynamicResource ShadowMd}" />
    </Style>
    <Style Selector="Border.suggestion-badge">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.suggestion-badge > TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto,Auto" Background="{DynamicResource SurfaceBrush}">
    <Panel Grid.Row="0">
      <ListBox x:Name="Transcript"
               ItemsSource="{Binding Transcript.Items}"
               Padding="16,10,16,4"
               SelectionMode="Single"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
      <StackPanel IsVisible="{Binding Transcript.IsEmpty}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="6"
                  MaxWidth="440">
        <TextBlock Classes="h2"
                   Text="{Binding [session.startConversation], Source={x:Static loc:Loc.Instance}}"
                   HorizontalAlignment="Center" />
        <!-- The workspace button above already names the folder; the empty state keeps the hint only. -->
        <TextBlock Classes="caption"
                   TextAlignment="Center"
                   Text="{Binding [session.chatHint], Source={x:Static loc:Loc.Instance}}" />
      </StackPanel>
    </Panel>

    <!-- An automation attached to this session (waiting for the quota or for the session to be idle, or running): it
    never interrupts the session, and the user can call it off here. -->
    <Border x:Name="AutomationBanner"
            Grid.Row="1"
            Classes="composer-card"
            Margin="12,6,12,0"
            Padding="10,6"
            IsVisible="{Binding HasAutomationBanner}"
            AutomationProperties.AutomationId="automation-banner">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <wc:FluentIcon Grid.Column="0"
                       Data="{StaticResource IconBolt}"
                       Width="14"
                       Height="14"
                       Margin="0,0,8,0"
                       Foreground="{DynamicResource AccentTextBrush}" />
        <TextBlock Grid.Column="1" Classes="caption" TextWrapping="Wrap" Text="{Binding AutomationBanner}" />
        <Button Grid.Column="2"
                Classes="ghost"
                Margin="8,0,0,0"
                Command="{Binding CancelAutomationCommand}"
                Content="{Binding [automations.banner.cancel], Source={x:Static loc:Loc.Instance}}"
                AutomationProperties.AutomationId="automation-banner-cancel" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="12,6,12,8">
      <!-- A session that is not the active one of its workspace is a read-only view: no composer, only the way back. -->
      <Border x:Name="ReadOnlyBar"
              Classes="composer-card"
              IsVisible="{Binding IsReadOnlyView}"
              Padding="12,8">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
            <TextBlock TextWrapping="Wrap" Text="{Binding ReadOnlyBanner}" />
            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasPendingComposer}"
                       Text="{Binding PendingComposerNote}"
                       AutomationProperties.AutomationId="read-only-pending" />
          </StackPanel>
          <Button Grid.Column="1"
                  Classes="primary"
                  Margin="8,0,0,0"
                  IsVisible="{Binding HasContinue}"
                  Command="{Binding ContinueCommand}"
                  Content="{Binding ContinueLabel}"
                  AutomationProperties.Name="{Binding [lifecycle.continueSession], Source={x:Static loc:Loc.Instance}}" />
          <Button Grid.Column="2"
                  Classes="ghost"
                  Margin="8,0,0,0"
                  IsVisible="{Binding HasRestore}"
                  Command="{Binding RestoreCommand}"
                  Content="{Binding [lifecycle.restoreSession], Source={x:Static loc:Loc.Instance}}"
                  AutomationProperties.Name="{Binding [lifecycle.restoreSession], Source={x:Static loc:Loc.Instance}}" />
        </Grid>
      </Border>
      <Border x:Name="ComposerCard"
              IsVisible="{Binding !IsReadOnlyView}"
              Classes="composer-card"
              Classes.focused="{Binding #Input.IsKeyboardFocusWithin}">
        <Grid RowDefinitions="Auto,Auto">
          <!-- The strip: counters and the workspace button on the left, the context readout on the right. The working
               directory is not shown here any more - the project tree on the left already names the session; the full path
               stays in the workspace button's tooltip. -->
          <Border x:Name="InstrumentStrip"
                  Grid.Row="0"
                  Classes="instrument-strip"
                  SizeChanged="OnInstrumentStripSizeChanged">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- No status dot and no path here: the project tree already carries both the session and its state, and
                     the path repeated the workspace button's own folder name. -->
                <!-- Only the git markers: the branch is named by the workspace button and the project tree, so a chip for it
                     repeated a value the user already sees twice. -->
                <StackPanel x:Name="StripGit" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Classes="instrument-meta"
                             Text="{Binding Instruments.AheadBehindText}"
                             IsVisible="{Binding Instruments.HasAheadBehind}"
                             AutomationProperties.AutomationId="strip-ahead-behind" />
                </StackPanel>

                <!-- One button for the four counters: the strip stays short, and the four readings live in its menu.
                     It sits first because it is the busiest thing in the strip; the sub-agent toggle follows it. -->
                <Button x:Name="StripResources"
                        Classes="instrument-chip"
                        ToolTip.Tip="{Binding Instruments.ResourcesTooltip}"
                        AutomationProperties.AutomationId="strip-resources"
                        AutomationProperties.Name="{Binding Instruments.ResourcesLabel}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <wc:FluentIcon Data="{StaticResource IconLayers}" Width="14" Height="14" />
                    <TextBlock Text="{Binding Instruments.ResourcesLabel}" VerticalAlignment="Center" />
                    <wc:FluentIcon Data="{DynamicResource IconChevronDown}" Width="12" Height="12" />
                  </StackPanel>
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                      <MenuItem Header="{Binding Instruments.ApprovalMenuText}"
                                Command="{Binding Instruments.OpenApprovalsCommand}"
                                AutomationProperties.AutomationId="strip-resources-approvals" />
                      <MenuItem Header="{Binding Instruments.SkillMenuText}"
                                Command="{Binding Instruments.OpenSkillsCommand}"
                                AutomationProperties.AutomationId="strip-resources-skills" />
                      <MenuItem Header="{Binding Instruments.McpMenuText}"
                                Command="{Binding Instruments.OpenMcpCommand}"
                                AutomationProperties.AutomationId="strip-resources-mcp" />
                      <MenuItem Header="{Binding Instruments.ToolMenuText}"
                                Command="{Binding Instruments.OpenToolsCommand}"
                                AutomationProperties.AutomationId="strip-resources-tools" />
                      <!-- The resource inspector: this session's running tool calls and sub-agents. Hidden when no window wired
                           the overlay (a standalone view), so the row is never a dead entry. -->
                      <MenuItem Header="{Binding Instruments.OpenInspectorMenuText}"
                                Command="{Binding Instruments.OpenInspectorCommand}"
                                IsVisible="{Binding Instruments.CanOpenInspector}"
                                ToolTip.Tip="{Binding Instruments.OpenInspectorTooltip}"
                                AutomationProperties.AutomationId="strip-resources-inspector" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>

                <!-- The accent marks the open area, not the collapsed one: green on this strip elsewhere means "live", so an
                     accented chip while the region is hidden read as its opposite. Collapsed is the plain resting state. -->
                <Button Classes="instrument-chip"
                        Classes.active="{Binding !SubAgentsCollapsed}"
                        Command="{Binding ToggleSubAgentsCommand}"
                        IsVisible="{Binding HasSubAgentActivity}"
                        ToolTip.Tip="{Binding SubAgentToggleTooltip}"
                        AutomationProperties.AutomationId="strip-subagents"
                        AutomationProperties.Name="{Binding SubAgentToggleName}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <wc:FluentIcon Data="{StaticResource IconSparkle}" Width="14" Height="14" />
                    <!-- The label never carries a number: the badge beside it is the only reading, and only while a child
                         actually holds a run slot (a queued one or a finished one draws no badge). -->
                    <TextBlock Text="{Binding SubAgentLabel}" VerticalAlignment="Center" />
                    <Border Classes="instrument-badge" IsVisible="{Binding HasRunningSubAgents}">
                      <TextBlock Text="{Binding RunningSubAgentCount}"
                                 AutomationProperties.AutomationId="strip-subagents-count" />
                    </Border>
                  </StackPanel>
                </Button>

                <Border Classes="instrument-divider" />

                <!-- The workspace button names the session's working directory; the menu offers the project and the
                     workspace separately, because they are two different folders for a worktree session. -->
                <Button x:Name="StripWorkspace"
                        Classes="instrument-project"
                        ToolTip.Tip="{Binding Instruments.WorkspaceTooltip}"
                        AutomationProperties.AutomationId="strip-workspace"
                        AutomationProperties.Name="{Binding Instruments.WorkspaceName}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <wc:FluentIcon Data="{StaticResource IconFolder}" Width="14" Height="14" />
                    <TextBlock Text="{Binding Instruments.WorkspaceName}"
                               MaxWidth="160"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                    <wc:FluentIcon Data="{DynamicResource IconChevronDown}" Width="12" Height="12" />
                  </StackPanel>
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="{Binding [session.strip.project.vscode], Source={x:Static loc:Loc.Instance}}"
                                Command="{Binding Instruments.OpenProjectInVsCodeCommand}"
                                IsVisible="{Binding Instruments.CanOpenProjectInVsCode}"
                                AutomationProperties.AutomationId="strip-project-vscode" />
                      <MenuItem Header="{Binding [session.strip.workspace.vscode], Source={x:Static loc:Loc.Instance}}"
                                Command="{Binding Instruments.OpenWorkspaceInVsCodeCommand}"
                                IsVisible="{Binding Instruments.CanOpenWorkspaceInVsCode}"
                                AutomationProperties.AutomationId="strip-workspace-vscode" />
                      <MenuItem Header="{Binding [session.strip.project.explorer], Source={x:Static loc:Loc.Instance}}"
                                Command="{Binding Instruments.OpenProjectInExplorerCommand}"
                                IsVisible="{Binding Instruments.CanOpenProjectInExplorer}"
                                AutomationProperties.AutomationId="strip-project-explorer" />
                      <MenuItem Header="{Binding [session.strip.workspace.explorer], Source={x:Static loc:Loc.Instance}}"
                                Command="{Binding Instruments.OpenWorkspaceInExplorerCommand}"
                                IsVisible="{Binding Instruments.CanOpenWorkspaceInExplorer}"
                                AutomationProperties.AutomationId="strip-workspace-explorer" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>

              <!-- Right half: the token reading — the provider's account windows when it reports them, the cache-read hit
                   rate, then the gauge button: five segments and "<used>/<usable> · <percent>" for the root context against
                   its model's usable budget (tokens only when the window is unknown). Hovering the strip gives the spend
                   breakdown; hovering the gauge gives the context numbers and the trigger line. The gauge turns to the warning
                   colour within 10 points of the trigger line and to the danger colour at it, and a click runs the same manual
                   compaction as /compact. -->
              <StackPanel Grid.Column="2"
                          Orientation="Horizontal"
                          Spacing="8"
                          VerticalAlignment="Center"
                          ToolTip.Tip="{Binding Instruments.UsageTooltip}"
                          AutomationProperties.AutomationId="strip-context">
                <TextBlock Classes="instrument-meta"
                           Classes.quota-warning="{Binding Instruments.IsQuotaWarning}"
                           Classes.quota-rejected="{Binding Instruments.IsQuotaRejected}"
                           VerticalAlignment="Center"
                           IsVisible="{Binding Instruments.HasQuota}"
                           Text="{Binding Instruments.QuotaLabel}"
                           ToolTip.Tip="{Binding Instruments.QuotaTooltip}"
                           AutomationProperties.AutomationId="strip-quota" />
                <TextBlock Classes="instrument-meta"
                           VerticalAlignment="Center"
                           IsVisible="{Binding Instruments.HasCacheTtl}"
                           Text="{Binding Instruments.CacheTtlText}"
                           ToolTip.Tip="{Binding Instruments.CacheTtlTooltip}"
                           AutomationProperties.AutomationId="strip-cache-ttl" />
                <TextBlock Classes="instrument-meta"
                           VerticalAlignment="Center"
                           Text="{Binding Instruments.CacheReadText}" />
                <Button Classes="instrument-chip context-gauge"
                        Classes.warning="{Binding Instruments.IsContextWarning}"
                        Classes.over="{Binding Instruments.IsContextOver}"
                        Padding="4,0"
                        Command="{Binding CompactCommand}"
                        ToolTip.Tip="{Binding Instruments.ContextTooltip}"
                        AutomationProperties.AutomationId="strip-context-compact"
                        AutomationProperties.Name="{Binding [session.strip.context.compact], Source={x:Static loc:Loc.Instance}}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ItemsControl ItemsSource="{Binding Instruments.ContextSegments}"
                                  VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="strip-context-gauge">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ContextSegment">
                          <!-- One slanted quadrilateral, same size for every segment; filled ones are solid, the rest outline
                               only. The brush comes from the gauge's state styles above. -->
                          <Panel Width="13" Height="8" VerticalAlignment="Center">
                            <Polygon Classes="gauge-fill"
                                     Points="0,8 3,0 13,0 10,8"
                                     IsVisible="{Binding IsFilled}" />
                            <Polygon Classes="gauge-outline"
                                     Points="0,8 3,0 13,0 10,8"
                                     StrokeThickness="1"
                                     Fill="Transparent"
                                     IsVisible="{Binding IsEmpty}" />
                          </Panel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="instrument-meta gauge-label"
                               VerticalAlignment="Center"
                               Text="{Binding Instruments.ContextLabel}"
                               AutomationProperties.AutomationId="strip-context-label" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Row="1" Classes="composer-body">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,10,0,0">
              <!-- queued and interjected messages -->
              <StackPanel Grid.Row="0"
                          Spacing="4"
                          Margin="8,8,8,0"
                          IsVisible="{Binding HasQueued}">
                <ItemsControl ItemsSource="{Binding Queued}"
                              AutomationProperties.AutomationId="composer-queue">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:QueuedMessageViewModel">
                      <Border Classes="queued-chip"
                              Classes.interjection="{Binding IsInterjection}"
                              ToolTip.Tip="{Binding Text}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Classes="queued-label" Text="{Binding Label}" VerticalAlignment="Center" />
                          <TextBlock Classes="queued-label"
                                     Text="{Binding AttachmentsLabel}"
                                     IsVisible="{Binding HasAttachments}"
                                     VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Preview}"
                                     MaxWidth="260"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center" />
                          <Button Classes="icon composer-mini"
                                  Command="{Binding RemoveCommand}"
                                  IsVisible="{Binding CanRemove}"
                                  AutomationProperties.Name="{Binding [session.composer.removeQueued], Source={x:Static loc:Loc.Instance}}"
                                  ToolTip.Tip="{Binding [session.composer.removeQueued], Source={x:Static loc:Loc.Instance}}">
                            <wc:FluentIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
                          </Button>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="caption"
                           IsVisible="{Binding QueuePaused}"
                           Text="{Binding [session.composer.queuePaused], Source={x:Static loc:Loc.Instance}}" />
              </StackPanel>

              <!-- attachments of the draft (image thumbnails, file chips), why the last one was refused, and why they block sending -->
              <StackPanel Grid.Row="1" Spacing="4">
                <ItemsControl ItemsSource="{Binding Composer.Attachments}"
                              Margin="8,8,8,0"
                              IsVisible="{Binding Composer.HasImageAttachments}"
                              AutomationProperties.AutomationId="composer-attachments">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PendingImageViewModel">
                      <Panel Width="56" Height="56" Margin="0,0,6,6" ToolTip.Tip="{Binding Caption}">
                        <Border Classes="image-thumb" Width="56" Height="56">
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </Border>
                        <Button Classes="icon composer-mini image-remove"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Command="{Binding RemoveCommand}"
                                AutomationProperties.AutomationId="composer-attachment-remove"
                                AutomationProperties.Name="{Binding [session.images.remove], Source={x:Static loc:Loc.Instance}}"
                                ToolTip.Tip="{Binding [session.images.remove], Source={x:Static loc:Loc.Instance}}">
                          <wc:FluentIcon Data="{StaticResource IconClose}" Width="10" Height="10" />
                        </Button>
                      </Panel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Composer.Files}"
                              Margin="8,8,8,0"
                              IsVisible="{Binding Composer.HasFileAttachments}"
                              AutomationProperties.AutomationId="composer-file-attachments">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PendingFileViewModel">
                      <Border Classes="queued-chip" Margin="0,0,6,6" ToolTip.Tip="{Binding Name}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <wc:FluentIcon Data="{StaticResource IconChangesDocument}" Width="14" Height="14" VerticalAlignment="Center" />
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="caption" Text="{Binding Caption}" />
                          </StackPanel>
                          <Button Classes="icon composer-mini"
                                  VerticalAlignment="Center"
                                  Command="{Binding RemoveCommand}"
                                  AutomationProperties.AutomationId="composer-file-remove"
                                  AutomationProperties.Name="{Binding [session.attachments.remove], Source={x:Static loc:Loc.Instance}}"
                                  ToolTip.Tip="{Binding [session.attachments.remove], Source={x:Static loc:Loc.Instance}}">
                            <wc:FluentIcon Data="{StaticResource IconClose}" Width="10" Height="10" />
                          </Button>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="caption"
                           Margin="10,4,8,0"
                           Foreground="{DynamicResource WarningBrush}"
                           TextWrapping="Wrap"
                           Text="{Binding Composer.AttachmentsBlockedHint}"
                           IsVisible="{Binding Composer.AttachmentsBlocked}"
                           AutomationProperties.AutomationId="composer-attachments-blocked" />
                <Grid ColumnDefinitions="*,Auto"
                      Margin="10,4,8,0"
                      IsVisible="{Binding Composer.HasAttachmentError}">
                  <TextBlock Classes="caption"
                             Foreground="{DynamicResource DangerBrush}"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center"
                             Text="{Binding Composer.AttachmentError}"
                             AutomationProperties.AutomationId="composer-attachment-error" />
                  <Button Grid.Column="1"
                          Classes="icon composer-mini"
                          Click="OnDismissAttachmentError"
                          AutomationProperties.Name="{Binding [session.images.dismiss], Source={x:Static loc:Loc.Instance}}"
                          ToolTip.Tip="{Binding [session.images.dismiss], Source={x:Static loc:Loc.Instance}}">
                    <wc:FluentIcon Data="{StaticResource IconClose}" Width="10" Height="10" />
                  </Button>
                </Grid>
              </StackPanel>

              <TextBox x:Name="Input"
                       Grid.Row="2"
                       Classes="composer-input"
                       Text="{Binding Draft, Mode=TwoWay}"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="44"
                       MaxHeight="180"
                       VerticalContentAlignment="Top"
                       PlaceholderText="{Binding [session.messagePlaceholder], Source={x:Static loc:Loc.Instance}}"
                       AutomationProperties.AutomationId="session-input"
                       AutomationProperties.Name="{Binding [session.messageName], Source={x:Static loc:Loc.Instance}}" />

              <!-- toolbar: agent and model chips on the left, send / running menu on the right -->
              <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto" Margin="6,0,6,6">
                <Button x:Name="AgentChip"
                        Classes="composer-chip"
                        AutomationProperties.AutomationId="composer-agent"
                        AutomationProperties.Name="{Binding [session.composer.agent], Source={x:Static loc:Loc.Instance}}"
                        ToolTip.Tip="{Binding [session.composer.agentTooltip], Source={x:Static loc:Loc.Instance}}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <wc:FluentIcon Data="{StaticResource IconSparkle}" Width="14" Height="14" />
                    <TextBlock Text="{Binding Composer.AgentLabel}" VerticalAlignment="Center" />
                    <wc:FluentIcon Data="{DynamicResource IconChevronDown}" Width="12" Height="12" />
                  </StackPanel>
                  <Button.Flyout>
                    <Flyout Placement="TopEdgeAlignedLeft">
                      <ItemsControl ItemsSource="{Binding Composer.Agents}"
                                    MinWidth="260"
                                    AutomationProperties.AutomationId="composer-agent-list">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ComposerAgentOption">
                            <Button Classes="composer-row"
                                    Command="{Binding SelectCommand}"
                                    Click="OnAgentPicked"
                                    AutomationProperties.Name="{Binding Name}">
                              <Grid ColumnDefinitions="18,*">
                                <TextBlock Text="✓" IsVisible="{Binding IsSelected}" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                  <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                  <TextBlock Classes="caption"
                                             Text="{Binding Description}"
                                             MaxWidth="300"
                                             TextWrapping="Wrap" />
                                </StackPanel>
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Flyout>
                  </Button.Flyout>
                </Button>

                <Button x:Name="ModelChip"
                        Grid.Column="1"
                        Margin="4,0,0,0"
                        Classes="composer-chip"
                        IsEnabled="{Binding Composer.HasModel}"
                        AutomationProperties.AutomationId="composer-model"
                        AutomationProperties.Name="{Binding Composer.ModelLabel}"
                        ToolTip.Tip="{Binding [session.composer.modelTooltip], Source={x:Static loc:Loc.Instance}}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Composer.ModelLabel}"
                               MaxWidth="220"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding Composer.EffortBars}"
                                  VerticalAlignment="Center"
                                  Height="10">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="1.5" VerticalAlignment="Bottom" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ComposerEffortBarViewModel">
                          <Rectangle Classes="effort-bar" Height="{Binding Height}" Opacity="{Binding Opacity}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <wc:FluentIcon Data="{DynamicResource IconChevronDown}" Width="12" Height="12" />
                  </StackPanel>
                  <Button.Flyout>
                    <Flyout Placement="TopEdgeAlignedLeft">
                      <StackPanel Width="300" Spacing="6" AutomationProperties.AutomationId="composer-model-panel">
                        <TextBox x:Name="ModelSearch"
                                 Text="{Binding Composer.ModelSearch, Mode=TwoWay}"
                                 PlaceholderText="{Binding [session.composer.searchModels], Source={x:Static loc:Loc.Instance}}"
                                 AutomationProperties.AutomationId="composer-model-search"
                                 AutomationProperties.Name="{Binding [session.composer.searchModels], Source={x:Static loc:Loc.Instance}}" />
                        <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
                          <ItemsControl ItemsSource="{Binding Composer.Models}"
                                        AutomationProperties.AutomationId="composer-model-list">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:ComposerModelOption">
                                <Grid ColumnDefinitions="*,Auto">
                                  <Button Classes="composer-row"
                                          Command="{Binding SelectCommand}"
                                          Click="OnModelPicked"
                                          AutomationProperties.Name="{Binding Name}">
                                    <Grid ColumnDefinitions="18,*,Auto">
                                      <TextBlock Text="✓" IsVisible="{Binding IsSelected}" />
                                      <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                      <TextBlock Grid.Column="2"
                                                 Margin="8,0,0,0"
                                                 Classes="caption"
                                                 IsVisible="{Binding ShowProviderCaption}"
                                                 Text="{Binding Caption}"
                                                 VerticalAlignment="Center" />
                                    </Grid>
                                  </Button>
                                  <Button Grid.Column="1"
                                          Classes="icon composer-mini"
                                          Command="{Binding TogglePinCommand}"
                                          AutomationProperties.Name="{Binding [session.composer.pin], Source={x:Static loc:Loc.Instance}}"
                                          ToolTip.Tip="{Binding [session.composer.pin], Source={x:Static loc:Loc.Instance}}">
                                    <Panel Width="12" Height="12">
                                      <wc:FluentIcon Classes="star"
                                                     Data="{StaticResource IconStar}"
                                                     Width="12"
                                                     Height="12"
                                                     IsVisible="{Binding !IsPinned}" />
                                      <wc:FluentIcon Classes="star pinned"
                                                     Data="{StaticResource IconStarFilled}"
                                                     Width="12"
                                                     Height="12"
                                                     IsVisible="{Binding IsPinned}" />
                                    </Panel>
                                  </Button>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Classes="caption"
                                   IsVisible="{Binding Composer.HasNoModels}"
                                   Text="{Binding [session.composer.noModels], Source={x:Static loc:Loc.Instance}}" />
                        <Separator />
                        <Grid ColumnDefinitions="*,Auto" Margin="2,0">
                          <TextBlock Classes="label" Text="{Binding [session.composer.effort], Source={x:Static loc:Loc.Instance}}" />
                          <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Composer.EffortName}" />
                        </Grid>
                        <Panel Margin="2,0">
                          <Border Classes="effort-track" />
                          <Slider Classes="effort"
                                  Minimum="0"
                                  Maximum="{Binding Composer.EffortMaximum, Mode=OneWay}"
                                  TickFrequency="1"
                                  IsSnapToTickEnabled="True"
                                  Value="{Binding Composer.EffortValue, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="composer-effort"
                                  AutomationProperties.Name="{Binding [session.composer.effort], Source={x:Static loc:Loc.Instance}}" />
                        </Panel>
                        <Separator />
                        <Button Classes="composer-row"
                                Command="{Binding Composer.SaveDefaultsCommand}"
                                AutomationProperties.AutomationId="composer-save-defaults"
                                Content="{Binding [session.composer.saveDefaults], Source={x:Static loc:Loc.Instance}}" />
                        <Button Classes="composer-row"
                                Command="{Binding Composer.RefreshCommand}"
                                AutomationProperties.AutomationId="composer-refresh">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <wc:FluentIcon Data="{DynamicResource IconRefresh}" Width="14" Height="14" />
                            <TextBlock Text="{Binding [session.composer.refresh], Source={x:Static loc:Loc.Instance}}" />
                          </StackPanel>
                        </Button>
                        <TextBlock Classes="caption"
                                   Margin="8,0"
                                   IsVisible="{Binding Composer.HasStatus}"
                                   Text="{Binding Composer.Status}" />
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                  <!-- Always enabled: each picked file is gated by kind; the tooltip says when images are refused. -->
                  <Button Classes="icon"
                          Click="OnAttachImagesClick"
                          AutomationProperties.AutomationId="composer-attach-images"
                          AutomationProperties.Name="{Binding [session.attachments.attach], Source={x:Static loc:Loc.Instance}}">
                    <ToolTip.Tip>
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding [session.attachments.attach.tooltip], Source={x:Static loc:Loc.Instance}}" />
                        <TextBlock Text="{Binding Composer.ImageGateHint}"
                                   IsVisible="{Binding !Composer.AcceptsImages}" />
                      </StackPanel>
                    </ToolTip.Tip>
                    <wc:FluentIcon Data="{StaticResource IconPlus}" Width="14" Height="14" />
                  </Button>
                  <Button Classes="icon"
                          Command="{Binding CancelCommand}"
                          IsVisible="{Binding IsRunning}"
                          AutomationProperties.AutomationId="session-stop-turn"
                          AutomationProperties.Name="{Binding [session.stopTurn], Source={x:Static loc:Loc.Instance}}"
                          ToolTip.Tip="{Binding [session.composer.stopHint], Source={x:Static loc:Loc.Instance}}">
                    <wc:FluentIcon Data="{StaticResource IconStop}" Width="14" Height="14" />
                  </Button>
                  <Button Classes="composer-send"
                          Command="{Binding SendCommand}"
                          IsEnabled="{Binding CanSendNow}"
                          IsVisible="{Binding IsIdle}"
                          AutomationProperties.AutomationId="session-send"
                          AutomationProperties.Name="{Binding [session.send], Source={x:Static loc:Loc.Instance}}"
                          ToolTip.Tip="{Binding [session.sendTooltip], Source={x:Static loc:Loc.Instance}}">
                    <wc:FluentIcon Data="{StaticResource IconArrowUp}" Width="14" Height="14" />
                  </Button>
                  <Button x:Name="RunningMenu"
                          Classes="composer-send running"
                          IsVisible="{Binding IsRunning}"
                          AutomationProperties.AutomationId="composer-running-menu"
                          AutomationProperties.Name="{Binding [session.composer.runningMenu], Source={x:Static loc:Loc.Instance}}"
                          ToolTip.Tip="{Binding [session.composer.runningMenu], Source={x:Static loc:Loc.Instance}}">
                    <wc:FluentIcon Data="{StaticResource IconEllipsis}" Width="14" Height="14" />
                    <Button.Flyout>
                      <MenuFlyout Placement="TopEdgeAlignedRight">
                        <MenuItem Header="{Binding [session.composer.interject], Source={x:Static loc:Loc.Instance}}"
                                  Command="{Binding InterjectCommand}"
                                  ToolTip.Tip="{Binding [session.composer.interjectHint], Source={x:Static loc:Loc.Instance}}"
                                  AutomationProperties.AutomationId="composer-interject" />
                        <MenuItem Header="{Binding [session.composer.queue], Source={x:Static loc:Loc.Instance}}"
                                  Command="{Binding QueueCommand}"
                                  InputGesture="Ctrl+Enter"
                                  ToolTip.Tip="{Binding [session.composer.queueHint], Source={x:Static loc:Loc.Instance}}"
                                  AutomationProperties.AutomationId="composer-queue-item" />
                        <MenuItem Header="{Binding [session.composer.redirect], Source={x:Static loc:Loc.Instance}}"
                                  Command="{Binding RedirectCommand}"
                                  ToolTip.Tip="{Binding [session.composer.redirectHint], Source={x:Static loc:Loc.Instance}}"
                                  AutomationProperties.AutomationId="composer-redirect" />
                        <Separator />
                        <MenuItem Header="{Binding [session.stopName], Source={x:Static loc:Loc.Instance}}"
                                  Command="{Binding CancelCommand}"
                                  ToolTip.Tip="{Binding [session.composer.stopHint], Source={x:Static loc:Loc.Instance}}"
                                  AutomationProperties.AutomationId="composer-stop" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- the / and @ picker, above the input -->
      <Popup x:Name="SuggestionPopup"
             PlacementTarget="{Binding #ComposerCard}"
             Placement="TopEdgeAlignedLeft"
             IsLightDismissEnabled="False"
             IsOpen="{Binding Composer.IsSuggestionOpen, Mode=OneWay}">
        <Border Classes="composer-suggestions">
          <ScrollViewer x:Name="SuggestionScroll" MaxHeight="280" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="SuggestionList"
                          ItemsSource="{Binding Composer.Suggestions}"
                          AutomationProperties.AutomationId="composer-suggestions">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ComposerSuggestionItem">
                  <Button Classes="composer-row suggestion"
                          Classes.selected="{Binding IsSelected}"
                          Focusable="False"
                          Click="OnSuggestionClick"
                          AutomationProperties.Name="{Binding Title}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <TextBlock Text="{Binding Title}" FontWeight="Medium" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1"
                                 Classes="caption"
                                 Margin="10,0,0,0"
                                 Text="{Binding Detail}"
                                 IsVisible="{Binding HasDetail}"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                      <Border Grid.Column="2" Classes="suggestion-badge" IsVisible="{Binding HasBadge}">
                        <TextBlock Text="{Binding Badge}" />
                      </Border>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Popup>

    </Grid>
  </Grid>
</UserControl>
