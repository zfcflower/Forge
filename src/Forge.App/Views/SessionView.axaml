<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:wc="using:Forge.App.Workbench.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Forge.App.Localization"
             xmlns:vm="using:Forge.App.ViewModels"
             xmlns:views="using:Forge.App.Views"
             x:Class="Forge.App.Views.SessionView"
             x:DataType="vm:SessionWorkspaceViewModel">
  <UserControl.DataTemplates>
    <!-- One session-to-session receipt (forge-core "reply receipt"): the three lines the target wrote back - header, change line
         and report - as a card of its own instead of a user bubble. -->
    <DataTemplate DataType="vm:SessionReplyViewModel" x:DataType="vm:SessionReplyViewModel">
      <Grid ColumnDefinitions="Auto,*">
        <views:TimelineGutter Kind="User" />
        <Border Grid.Column="1"
                Classes="session-reply-card"
                Margin="0,4,0,6"
                Padding="10,8"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource SurfaceSubtleBrush}"
                AutomationProperties.AutomationId="session-reply-card">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding Header}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasHeader}"
                       AutomationProperties.AutomationId="session-reply-header" />
            <TextBlock Classes="caption"
                       Text="{Binding Changes}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasChanges}"
                       AutomationProperties.AutomationId="session-reply-changes" />
            <SelectableTextBlock Text="{Binding Report}"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding HasReport}"
                                 AutomationProperties.AutomationId="session-reply-report" />
            <StackPanel Orientation="Horizontal" Spacing="4">
              <!-- The part of the report the caps cut away lives in the artifact the receipt points at; the button is the way
                   to it (a receipt that fit whole carries no pointer and gets no button). -->
              <Button Classes="ghost"
                      Height="22"
                      Padding="8,0"
                      IsVisible="{Binding HasArtifact}"
                      Command="{Binding OpenReportCommand}"
                      Content="{Binding OpenReportLabel}"
                      ToolTip.Tip="{Binding OpenReportLabel}"
                      AutomationProperties.AutomationId="session-reply-artifact"
                      AutomationProperties.Name="{Binding OpenReportLabel}" />
              <views:CopyTextButton Classes="ghost icon"
                                    Width="26"
                                    Height="22"
                                    ToolTip.Tip="{Binding CopyLabel}"
                                    AutomationProperties.AutomationId="session-reply-copy"
                                    AutomationProperties.Name="{Binding CopyLabel}">
                <wc:FluentIcon Data="{StaticResource IconCopy}" Width="13" Height="13" />
              </views:CopyTextButton>
              <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding Time}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>
  <Grid RowDefinitions="*,Auto,Auto" Background="{DynamicResource CardBackgroundBrush}">
    <Panel Grid.Row="0">
      <Grid RowDefinitions="Auto,*">
      <!-- A restored tab reads one page of its history, so the store may still hold older turns: this strip is the way back
           to them. It sits above the list (not in it), so prepending a page cannot move the reader's own rows around. -->
      <Button Grid.Row="0"
              Classes="link"
              Margin="0,6,0,2"
              HorizontalAlignment="Center"
              IsVisible="{Binding HasOlderHistory}"
              Click="OnLoadOlderClick"
              Content="{Binding [session.loadOlder], Source={x:Static loc:Loc.Instance}}"
              AutomationProperties.AutomationId="transcript-load-older"
              AutomationProperties.Name="{Binding [session.loadOlder], Source={x:Static loc:Loc.Instance}}" />
      <Panel Grid.Row="1">
      <views:TranscriptListBox x:Name="Transcript"
               ItemsSource="{Binding Transcript.Rounds}"
               Padding="{DynamicResource ChatTranscriptPadding}"
               SelectionMode="Single"
               AutoScrollToSelectedItem="False"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <views:TranscriptStackPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
      </views:TranscriptListBox>
      <StackPanel IsVisible="{Binding !IsHistoryLoading}">
        <StackPanel IsVisible="{Binding Transcript.IsEmpty}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="6"
                    MaxWidth="440">
          <StackPanel.Styles>
            <StyleInclude Source="avares://Forge.App/Resources/ChromeStyles.axaml" />
          </StackPanel.Styles>
          <TextBlock Classes="h2"
                     Text="{Binding [session.startConversation], Source={x:Static loc:Loc.Instance}}"
                     HorizontalAlignment="Center" />
          <!-- The workspace button above already names the folder; the empty state keeps the hint only. -->
          <TextBlock Classes="caption"
                     TextAlignment="Center"
                     Text="{Binding [session.chatHint], Source={x:Static loc:Loc.Instance}}" />
        </StackPanel>
      </StackPanel>
      <!-- A tab restored at start-up keeps its history in the store and replays it on first activation; until then the
           transcript is empty, which is not the same thing as a session without messages. -->
      <StackPanel IsVisible="{Binding IsHistoryLoading}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="8"
                  AutomationProperties.AutomationId="session-history-loading">
        <views:WaitingGlyph Data="{StaticResource IconRefresh}"
                            Width="18"
                            Height="18"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource TextMutedBrush}" />
        <TextBlock Classes="caption"
                   Text="{Binding [session.historyLoading], Source={x:Static loc:Loc.Instance}}" />
      </StackPanel>
      </Panel>
      </Grid>
    </Panel>

    <!-- An automation attached to this session (waiting for the quota or for the session to be idle, or running): it
    never interrupts the session, and the user can call it off here. -->
    <Border x:Name="AutomationBanner"
            Grid.Row="1"
            Classes="composer-card"
            Margin="{DynamicResource ChatBannerMargin}"
            Padding="10,6"
            IsVisible="{Binding HasAutomationBanner}"
            AutomationProperties.AutomationId="automation-banner">
      <Border.Styles>
        <StyleInclude Source="avares://Forge.App/Resources/ComposerStyles.axaml" />
        <StyleInclude Source="avares://Forge.App/Resources/ChromeStyles.axaml" />
      </Border.Styles>
      <Grid ColumnDefinitions="Auto,*,Auto">
        <wc:FluentIcon Grid.Column="0"
                       Data="{StaticResource IconBolt}"
                       Width="14"
                       Height="14"
                       Margin="0,0,8,0"
                       Foreground="{DynamicResource BrandActionBrush}" />
        <TextBlock Grid.Column="1" Classes="caption" TextWrapping="Wrap" Text="{Binding AutomationBanner}" />
        <Button Grid.Column="2"
                Classes="ghost"
                Margin="8,0,0,0"
                Command="{Binding CancelAutomationCommand}"
                Content="{Binding [automations.banner.cancel], Source={x:Static loc:Loc.Instance}}"
                AutomationProperties.AutomationId="automation-banner-cancel" />
      </Grid>
    </Border>

    <!-- A session that is not the active one of its workspace is a read-only view: its input area (composer and the old
         read-only bar) is not shown at all - the tab is the transcript, and "restore session" lives in the tree's menu. -->
    <Grid Grid.Row="2"
          Margin="{DynamicResource ChatComposerMargin}"
          IsVisible="{Binding !IsReadOnlyView}">
      <Grid.Styles>
        <StyleInclude Source="avares://Forge.App/Resources/ComposerStyles.axaml" />
        <StyleInclude Source="avares://Forge.App/Resources/ChromeStyles.axaml" />
      </Grid.Styles>
      <Border x:Name="ComposerCard"
              Classes="composer-card"
              Classes.focused="{Binding #Input.IsKeyboardFocusWithin}">
        <Grid RowDefinitions="Auto,Auto">
          <!-- The strip: the running counters on the left, the context readout on the right. Neither the working directory
               nor the branch is shown here: the project tree on the left already names both, and a chip for either repeated a
               value the user already sees twice. -->
          <Border x:Name="InstrumentStrip"
                  Grid.Row="0"
                  Classes="instrument-strip">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- No status dot, no path and no branch: the project tree already carries the session, its state and
                     the branch it runs on, so a chip for any of them repeated a value the user already sees twice. The
                     ahead/behind pair moved to the right group, next to the readings it belongs with. -->
                <!-- The resource button: a plain button that opens the resource window. A dot and the number of running
                     automation agents appear beside it while any runs (green), or a bare red dot when an MCP server failed. -->
                <Button x:Name="StripResources"
                        Classes="instrument-chip"
                        Command="{Binding Instruments.OpenInspectorCommand}"
                        IsEnabled="{Binding Instruments.CanOpenInspector}"
                        ToolTip.Tip="{Binding Instruments.ResourcesTooltip}"
                        AutomationProperties.AutomationId="strip-resources"
                        AutomationProperties.Name="{Binding Instruments.ResourcesLabel}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <wc:FluentIcon Data="{StaticResource IconLayers}" Width="14" Height="14" />
                    <TextBlock Text="{Binding Instruments.ResourcesLabel}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center"
                                IsVisible="{Binding Instruments.ShowResourceDot}"
                                AutomationProperties.AutomationId="strip-resources-dot">
                      <Ellipse Width="7"
                               Height="7"
                               VerticalAlignment="Center"
                               Fill="{DynamicResource StatusSuccessBrush}"
                               IsVisible="{Binding !Instruments.HasResourceProblem}" />
                      <Ellipse Width="7"
                               Height="7"
                               VerticalAlignment="Center"
                               Fill="{DynamicResource StatusErrorBrush}"
                               IsVisible="{Binding Instruments.HasResourceProblem}" />
                      <TextBlock Text="{Binding Instruments.RunningResources}"
                                 IsVisible="{Binding Instruments.HasRunningResources}"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                </Button>

                <!-- The accent marks the open area, not the collapsed one: green on this strip elsewhere means "live", so an
                     accented chip while the region is hidden read as its opposite. Collapsed is the plain resting state. -->
                <Button Classes="instrument-chip"
                        Classes.active="{Binding SubAgentRegionOpen}"
                        Command="{Binding ToggleSubAgentsCommand}"
                        IsVisible="{Binding HasSubAgentActivity}"
                        IsEnabled="{Binding CanToggleSubAgents}"
                        ToolTip.Tip="{Binding SubAgentToggleTooltip}"
                        AutomationProperties.AutomationId="strip-subagents"
                        AutomationProperties.Name="{Binding SubAgentToggleName}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <wc:FluentIcon Data="{StaticResource IconSparkle}" Width="14" Height="14" />
                    <!-- The label never carries a number: the badge beside it is the only reading, and only while a child
                         actually holds a run slot (a queued one or a finished one draws no badge). -->
                    <TextBlock Text="{Binding SubAgentLabel}" VerticalAlignment="Center" />
                    <Border Classes="instrument-badge" IsVisible="{Binding HasRunningSubAgents}">
                      <TextBlock Text="{Binding RunningSubAgentCount}"
                                 AutomationProperties.AutomationId="strip-subagents-count" />
                    </Border>
                  </StackPanel>
                </Button>
              </StackPanel>

              <!-- The readings themselves live in InstrumentReadingsView, hosted by the strip here and by a
                   sub-agent's breadcrumb there: one rendering, two hosts. The gauge's click is this session's own
                   manual compaction. -->
              <views:InstrumentReadingsView Grid.Column="2"
                                            DataContext="{Binding Instruments}"
                                            CompactCommand="{Binding $parent[UserControl].((vm:SessionWorkspaceViewModel)DataContext).CompactCommand}" />
            </Grid>
          </Border>

          <Border Grid.Row="1" Classes="composer-body">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,10,0,0">
              <!-- the session-messaging grants of this session: one revocable mark per target ("Authorized: X") -->
              <ItemsControl Grid.Row="0"
                            ItemsSource="{Binding SessionAuthorizations}"
                            Margin="8,8,8,0"
                            IsVisible="{Binding HasSessionAuthorizations}"
                            AutomationProperties.AutomationId="composer-authorizations">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SessionAuthorizationMarkViewModel">
                    <Border Classes="queued-chip"
                            Margin="0,0,6,4"
                            ToolTip.Tip="{Binding RevokeTip}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <wc:FluentIcon Data="{StaticResource IconSparkle}" Width="12" Height="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                        <Button Classes="icon composer-mini"
                                Command="{Binding RevokeCommand}"
                                AutomationProperties.AutomationId="composer-authorization-revoke"
                                AutomationProperties.Name="{Binding RevokeText}"
                                ToolTip.Tip="{Binding RevokeTip}">
                          <wc:FluentIcon Data="{StaticResource IconClose}" Width="10" Height="10" />
                        </Button>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- queued and interjected messages. The card's top border is drawn 10px above this grid (the body's
                   Margin="0,-10,0,0" plus this grid's 10px is the shared-outline trick), so -8 puts the chips' own top
                   2px below that border: the strip hugs the input area's top edge instead of floating 18px under it. -->
              <StackPanel Grid.Row="1"
                          Spacing="4"
                          Margin="8,-8,8,0"
                          IsVisible="{Binding HasQueued}">
                <ItemsControl ItemsSource="{Binding Queued}"
                              AutomationProperties.AutomationId="composer-queue">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:QueuedMessageViewModel">
                      <Border Classes="queued-chip"
                              Classes.interjection="{Binding IsInterjection}"
                              ToolTip.Tip="{Binding Text}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Classes="queued-label" Text="{Binding Label}" VerticalAlignment="Center" />
                          <TextBlock Classes="queued-label"
                                     Text="{Binding AttachmentsLabel}"
                                     IsVisible="{Binding HasAttachments}"
                                     VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Preview}"
                                     MaxWidth="260"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center" />
                          <Button Classes="icon composer-mini"
                                  Command="{Binding WithdrawCommand}"
                                  IsVisible="{Binding CanWithdraw}"
                                  AutomationProperties.AutomationId="composer-chip-withdraw"
                                  AutomationProperties.Name="{Binding [session.composer.withdrawQueued], Source={x:Static loc:Loc.Instance}}"
                                  ToolTip.Tip="{Binding [session.composer.withdrawQueued], Source={x:Static loc:Loc.Instance}}">
                            <wc:FluentIcon Data="{StaticResource IconEditArrowBack}" Width="14" Height="14" />
                          </Button>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="caption"
                           IsVisible="{Binding QueuePaused}"
                           Text="{Binding [session.composer.queuePaused], Source={x:Static loc:Loc.Instance}}" />
              </StackPanel>

              <!-- attachments of the draft (image thumbnails, file chips), why the last one was refused, and why they block sending -->
              <StackPanel Grid.Row="2" Spacing="4">
                <ItemsControl ItemsSource="{Binding Composer.Attachments}"
                              Margin="8,8,8,0"
                              IsVisible="{Binding Composer.HasImageAttachments}"
                              AutomationProperties.AutomationId="composer-attachments">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PendingImageViewModel">
                      <Panel Width="56" Height="56" Margin="0,0,6,6" ToolTip.Tip="{Binding Caption}">
                        <Border Classes="image-thumb" Width="56" Height="56">
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </Border>
                        <Button Classes="icon composer-mini image-remove"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Command="{Binding RemoveCommand}"
                                AutomationProperties.AutomationId="composer-attachment-remove"
                                AutomationProperties.Name="{Binding [session.images.remove], Source={x:Static loc:Loc.Instance}}"
                                ToolTip.Tip="{Binding [session.images.remove], Source={x:Static loc:Loc.Instance}}">
                          <wc:FluentIcon Data="{StaticResource IconClose}" Width="10" Height="10" />
                        </Button>
                      </Panel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Composer.Files}"
                              Margin="8,8,8,0"
                              IsVisible="{Binding Composer.HasFileAttachments}"
                              AutomationProperties.AutomationId="composer-file-attachments">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PendingFileViewModel">
                      <Border Classes="queued-chip" Margin="0,0,6,6" ToolTip.Tip="{Binding Name}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <wc:FluentIcon Data="{StaticResource IconChangesDocument}" Width="14" Height="14" VerticalAlignment="Center" />
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="caption" Text="{Binding Caption}" />
                          </StackPanel>
                          <Button Classes="icon composer-mini"
                                  VerticalAlignment="Center"
                                  Command="{Binding RemoveCommand}"
                                  AutomationProperties.AutomationId="composer-file-remove"
                                  AutomationProperties.Name="{Binding [session.attachments.remove], Source={x:Static loc:Loc.Instance}}"
                                  ToolTip.Tip="{Binding [session.attachments.remove], Source={x:Static loc:Loc.Instance}}">
                            <wc:FluentIcon Data="{StaticResource IconClose}" Width="10" Height="10" />
                          </Button>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="caption"
                           Margin="10,4,8,0"
                           Foreground="{DynamicResource StatusWarningBrush}"
                           TextWrapping="Wrap"
                           Text="{Binding Composer.AttachmentsBlockedHint}"
                           IsVisible="{Binding Composer.AttachmentsBlocked}"
                           AutomationProperties.AutomationId="composer-attachments-blocked" />
                <Grid ColumnDefinitions="*,Auto"
                      Margin="10,4,8,0"
                      IsVisible="{Binding Composer.HasAttachmentError}">
                  <TextBlock Classes="caption"
                             Foreground="{DynamicResource StatusErrorBrush}"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center"
                             Text="{Binding Composer.AttachmentError}"
                             AutomationProperties.AutomationId="composer-attachment-error" />
                  <Button Grid.Column="1"
                          Classes="icon composer-mini"
                          Click="OnDismissAttachmentError"
                          AutomationProperties.Name="{Binding [session.images.dismiss], Source={x:Static loc:Loc.Instance}}"
                          ToolTip.Tip="{Binding [session.images.dismiss], Source={x:Static loc:Loc.Instance}}">
                    <wc:FluentIcon Data="{StaticResource IconClose}" Width="10" Height="10" />
                  </Button>
                </Grid>
              </StackPanel>

              <TextBox x:Name="Input"
                       Grid.Row="3"
                       Classes="composer-input"
                       Text="{Binding Draft, Mode=TwoWay}"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="44"
                       MaxHeight="180"
                       VerticalContentAlignment="Top"
                       PlaceholderText="{Binding [session.messagePlaceholder], Source={x:Static loc:Loc.Instance}}"
                       AutomationProperties.AutomationId="session-input"
                       AutomationProperties.Name="{Binding [session.messageName], Source={x:Static loc:Loc.Instance}}" />

              <!-- toolbar: the agent, model and orchestration pickers on the left, send / running menu on the right -->
              <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="6,0,6,6">
                <views:ComposerToolbar HorizontalAlignment="Left" DataContext="{Binding Composer}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                  <!-- Always enabled: each picked file is gated by kind; the tooltip says when images are refused. -->
                  <Button Classes="icon"
                          Click="OnAttachImagesClick"
                          AutomationProperties.AutomationId="composer-attach-images"
                          AutomationProperties.Name="{Binding [session.attachments.attach], Source={x:Static loc:Loc.Instance}}">
                    <ToolTip.Tip>
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding [session.attachments.attach.tooltip], Source={x:Static loc:Loc.Instance}}" />
                        <TextBlock Text="{Binding Composer.ImageGateHint}"
                                   IsVisible="{Binding !Composer.AcceptsImages}" />
                      </StackPanel>
                    </ToolTip.Tip>
                    <wc:FluentIcon Data="{StaticResource IconPlus}" Width="14" Height="14" />
                  </Button>
                  <Button Classes="icon"
                          Command="{Binding CancelCommand}"
                          IsVisible="{Binding IsRunning}"
                          AutomationProperties.AutomationId="session-stop-turn"
                          AutomationProperties.Name="{Binding [session.stopTurn], Source={x:Static loc:Loc.Instance}}"
                          ToolTip.Tip="{Binding [session.composer.stopHint], Source={x:Static loc:Loc.Instance}}">
                    <wc:FluentIcon Data="{StaticResource IconStop}" Width="14" Height="14" />
                  </Button>
                  <Button Classes="composer-send"
                          Command="{Binding SendCommand}"
                          IsEnabled="{Binding CanSendNow}"
                          IsVisible="{Binding IsIdle}"
                          AutomationProperties.AutomationId="session-send"
                          AutomationProperties.Name="{Binding [session.send], Source={x:Static loc:Loc.Instance}}"
                          ToolTip.Tip="{Binding [session.sendTooltip], Source={x:Static loc:Loc.Instance}}">
                    <wc:FluentIcon Data="{StaticResource IconArrowUp}" Width="14" Height="14" />
                  </Button>
                  <Button x:Name="RunningMenu"
                          Classes="composer-send running"
                          IsVisible="{Binding IsRunning}"
                          AutomationProperties.AutomationId="composer-running-menu"
                          AutomationProperties.Name="{Binding [session.composer.runningMenu], Source={x:Static loc:Loc.Instance}}"
                          ToolTip.Tip="{Binding [session.composer.runningMenu], Source={x:Static loc:Loc.Instance}}">
                    <wc:FluentIcon Data="{StaticResource IconEllipsis}" Width="14" Height="14" />
                    <Button.Flyout>
                      <MenuFlyout Placement="TopEdgeAlignedRight">
                        <MenuItem Header="{Binding [session.composer.interject], Source={x:Static loc:Loc.Instance}}"
                                  Command="{Binding InterjectCommand}"
                                  InputGesture="Enter"
                                  ToolTip.Tip="{Binding [session.composer.interjectHint], Source={x:Static loc:Loc.Instance}}"
                                  AutomationProperties.AutomationId="composer-interject" />
                        <MenuItem Header="{Binding [session.composer.queue], Source={x:Static loc:Loc.Instance}}"
                                  Command="{Binding QueueCommand}"
                                  InputGesture="Ctrl+Enter"
                                  ToolTip.Tip="{Binding [session.composer.queueHint], Source={x:Static loc:Loc.Instance}}"
                                  AutomationProperties.AutomationId="composer-queue-item" />
                        <MenuItem Header="{Binding [session.composer.redirect], Source={x:Static loc:Loc.Instance}}"
                                  Command="{Binding RedirectCommand}"
                                  InputGesture="Ctrl+Shift+Enter"
                                  ToolTip.Tip="{Binding [session.composer.redirectHint], Source={x:Static loc:Loc.Instance}}"
                                  AutomationProperties.AutomationId="composer-redirect" />
                        <Separator />
                        <MenuItem Header="{Binding [session.stopName], Source={x:Static loc:Loc.Instance}}"
                                  Command="{Binding CancelCommand}"
                                  ToolTip.Tip="{Binding [session.composer.stopHint], Source={x:Static loc:Loc.Instance}}"
                                  AutomationProperties.AutomationId="composer-stop" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- the / and @ picker, above the input -->
      <Popup x:Name="SuggestionPopup"
             PlacementTarget="{Binding #ComposerCard}"
             Placement="TopEdgeAlignedLeft"
             IsLightDismissEnabled="False"
             IsOpen="{Binding Composer.IsSuggestionOpen, Mode=OneWay}">
        <Border Classes="composer-suggestions">
          <ScrollViewer x:Name="SuggestionScroll" MaxHeight="280" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="SuggestionList"
                          ItemsSource="{Binding Composer.Suggestions}"
                          AutomationProperties.AutomationId="composer-suggestions">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ComposerSuggestionItem">
                  <Button Classes="composer-row suggestion"
                          Classes.selected="{Binding IsSelected}"
                          IsEnabled="{Binding IsAvailable}"
                          Focusable="False"
                          Click="OnSuggestionClick"
                          ToolTip.ShowOnDisabled="True"
                          ToolTip.Tip="{Binding UnavailableReason}"
                          AutomationProperties.Name="{Binding Title}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <TextBlock Text="{Binding Title}" FontWeight="Medium" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1"
                                 Classes="caption"
                                 Margin="10,0,0,0"
                                 Text="{Binding Detail}"
                                 IsVisible="{Binding HasDetail}"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                      <Border Grid.Column="2" Classes="suggestion-badge" IsVisible="{Binding HasBadge}">
                        <TextBlock Text="{Binding Badge}" />
                      </Border>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Popup>

    </Grid>
  </Grid>
</UserControl>
