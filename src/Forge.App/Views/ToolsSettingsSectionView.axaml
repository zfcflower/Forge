<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Forge.App.Localization"
             xmlns:set="using:Forge.App.ViewModels.Settings"
             x:Class="Forge.App.Views.ToolsSettingsSectionView"
             x:DataType="set:ToolsSettingsSectionViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://Forge.App/Resources/ChromeStyles.axaml" />
  </UserControl.Styles>
  <!-- The `tools` section body: the run_code script block on top, then the active session's catalog grouped by origin:
       built-in groups carry a switch per tool, extension and MCP tools are read-only here. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="10">
      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Hint}" />
      <!-- Wave W14: what a run_code script may call, how many calls it keeps in flight and how much text comes back. -->
      <StackPanel Spacing="6">
        <TextBlock Classes="h2"
                   
                   Text="{Binding [codeMode.settings.heading], Source={x:Static loc:Loc.Instance}}" />
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   Text="{Binding [codeMode.settings.hint], Source={x:Static loc:Loc.Instance}}" />
        <Grid ColumnDefinitions="180,*" Margin="0,9,0,3">
          <TextBlock Classes="label"
                     VerticalAlignment="Center"
                     Text="{Binding [codeMode.settings.concurrency], Source={x:Static loc:Loc.Instance}}" />
          <NumericUpDown Grid.Column="1"
                         MinWidth="120"
                         HorizontalAlignment="Left"
                         Minimum="{Binding MinCodeScriptMaxConcurrentCalls}"
                         Maximum="{Binding MaxCodeScriptMaxConcurrentCalls}"
                         Increment="1"
                         FormatString="0"
                         Value="{Binding CodeScriptMaxConcurrentCalls, Mode=TwoWay}"
                         AutomationProperties.AutomationId="settings-code-concurrency"
                         AutomationProperties.Name="{Binding [codeMode.settings.concurrency], Source={x:Static loc:Loc.Instance}}" />
        </Grid>
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   Text="{Binding [codeMode.settings.concurrencyHint], Source={x:Static loc:Loc.Instance}}" />
        <Grid ColumnDefinitions="180,*" Margin="0,9,0,3">
          <TextBlock Classes="label"
                     VerticalAlignment="Center"
                     Text="{Binding [codeMode.settings.resultChars], Source={x:Static loc:Loc.Instance}}" />
          <NumericUpDown Grid.Column="1"
                         MinWidth="120"
                         HorizontalAlignment="Left"
                         Minimum="{Binding MinCodeScriptResultChars}"
                         Maximum="{Binding MaxCodeScriptResultChars}"
                         Increment="1"
                         FormatString="0"
                         Value="{Binding CodeScriptResultChars, Mode=TwoWay}"
                         AutomationProperties.AutomationId="settings-code-result-chars"
                         AutomationProperties.Name="{Binding [codeMode.settings.resultChars], Source={x:Static loc:Loc.Instance}}" />
        </Grid>
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   Text="{Binding [codeMode.settings.resultCharsHint], Source={x:Static loc:Loc.Instance}}" />
        <Grid ColumnDefinitions="180,*" Margin="0,9,0,3">
          <TextBlock Classes="label"
                     VerticalAlignment="Center"
                     Text="{Binding [codeMode.settings.innerResultChars], Source={x:Static loc:Loc.Instance}}" />
          <NumericUpDown Grid.Column="1"
                         MinWidth="120"
                         HorizontalAlignment="Left"
                         Minimum="{Binding MinCodeScriptInnerResultChars}"
                         Maximum="{Binding MaxCodeScriptInnerResultChars}"
                         Increment="1"
                         FormatString="0"
                         Value="{Binding CodeScriptInnerResultChars, Mode=TwoWay}"
                         AutomationProperties.AutomationId="settings-code-inner-result-chars"
                         AutomationProperties.Name="{Binding [codeMode.settings.innerResultChars], Source={x:Static loc:Loc.Instance}}" />
        </Grid>
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   Text="{Binding [codeMode.settings.innerResultCharsHint], Source={x:Static loc:Loc.Instance}}" />
        <Grid ColumnDefinitions="180,*" Margin="0,9,0,3">
          <TextBlock Classes="label"
                     VerticalAlignment="Center"
                     Text="{Binding [codeMode.settings.tools], Source={x:Static loc:Loc.Instance}}" />
          <TextBox Grid.Column="1"
                   HorizontalAlignment="Stretch"
                   Text="{Binding CodeScriptTools, Mode=TwoWay}"
                   AutomationProperties.AutomationId="settings-code-tools"
                   AutomationProperties.Name="{Binding [codeMode.settings.tools], Source={x:Static loc:Loc.Instance}}" />
        </Grid>
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   Text="{Binding [codeMode.settings.toolsHint], Source={x:Static loc:Loc.Instance}}" />
      </StackPanel>
      <Separator Margin="0,4,0,0" />
      <!-- Context footprint: what one tool result may put into the conversation. Read per call (bash, grep) or when a
           session host is built (artifact spill and preview). -->
      <StackPanel Spacing="6">
        <TextBlock Classes="h2" Text="{Binding LimitsTitle}" />
        <Grid ColumnDefinitions="180,*" Margin="0,9,0,3">
          <TextBlock Classes="label" VerticalAlignment="Center" Text="{Binding BashCaptureLabel}" />
          <NumericUpDown Grid.Column="1"
                         MinWidth="120"
                         HorizontalAlignment="Left"
                         Minimum="{Binding MinBashCaptureKilobytes}"
                         Maximum="{Binding MaxBashCaptureKilobytes}"
                         Increment="16"
                         FormatString="0"
                         Value="{Binding BashCaptureKilobytes, Mode=TwoWay}"
                         AutomationProperties.AutomationId="settings-bash-capture"
                         AutomationProperties.Name="{Binding BashCaptureLabel}" />
        </Grid>
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding BashCaptureHint}" />
        <Grid ColumnDefinitions="180,*" Margin="0,9,0,3">
          <TextBlock Classes="label" VerticalAlignment="Center" Text="{Binding GrepResultsLabel}" />
          <NumericUpDown Grid.Column="1"
                         MinWidth="120"
                         HorizontalAlignment="Left"
                         Minimum="{Binding MinGrepResults}"
                         Maximum="{Binding MaxGrepResults}"
                         Increment="100"
                         FormatString="0"
                         Value="{Binding GrepMaxResults, Mode=TwoWay}"
                         AutomationProperties.AutomationId="settings-grep-results"
                         AutomationProperties.Name="{Binding GrepResultsLabel}" />
        </Grid>
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding GrepResultsHint}" />
        <Grid ColumnDefinitions="180,*" Margin="0,9,0,3">
          <TextBlock Classes="label" VerticalAlignment="Center" Text="{Binding IgnoredDirectoriesLabel}" />
          <TextBox Grid.Column="1"
                   HorizontalAlignment="Stretch"
                   Text="{Binding IgnoredDirectories, Mode=TwoWay}"
                   AutomationProperties.AutomationId="settings-ignore-directories"
                   AutomationProperties.Name="{Binding IgnoredDirectoriesLabel}" />
        </Grid>
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding IgnoredDirectoriesHint}" />
        <Grid ColumnDefinitions="180,*" Margin="0,9,0,3">
          <TextBlock Classes="label" VerticalAlignment="Center" Text="{Binding SpillLabel}" />
          <NumericUpDown Grid.Column="1"
                         MinWidth="120"
                         HorizontalAlignment="Left"
                         Minimum="{Binding MinSpillChars}"
                         Maximum="{Binding MaxSpillChars}"
                         Increment="4000"
                         FormatString="0"
                         Value="{Binding SpillChars, Mode=TwoWay}"
                         AutomationProperties.AutomationId="settings-artifact-spill"
                         AutomationProperties.Name="{Binding SpillLabel}" />
        </Grid>
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding SpillHint}" />
        <Grid ColumnDefinitions="180,*" Margin="0,9,0,3">
          <TextBlock Classes="label" VerticalAlignment="Center" Text="{Binding PreviewLabel}" />
          <NumericUpDown Grid.Column="1"
                         MinWidth="120"
                         HorizontalAlignment="Left"
                         Minimum="{Binding MinPreviewChars}"
                         Maximum="{Binding MaxPreviewChars}"
                         Increment="500"
                         FormatString="0"
                         Value="{Binding PreviewChars, Mode=TwoWay}"
                         AutomationProperties.AutomationId="settings-artifact-preview"
                         AutomationProperties.Name="{Binding PreviewLabel}" />
        </Grid>
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding PreviewHint}" />
      </StackPanel>
      <Separator Margin="0,4,0,0" />
      <!-- Wave W17a: how the terminal looks and which shell it starts. The font fields follow the code font of the appearance
           section until they are given a value of their own. -->
      <StackPanel Spacing="6">
        <TextBlock Classes="h2"
                   
                   Text="{Binding [terminal.settings.section], Source={x:Static loc:Loc.Instance}}" />
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   Text="{Binding [terminal.settings.fontsHint], Source={x:Static loc:Loc.Instance}}" />
        <Grid ColumnDefinitions="180,*" Margin="0,9,0,3">
          <TextBlock Classes="label"
                     VerticalAlignment="Center"
                     Text="{Binding [terminal.settings.fontFamily], Source={x:Static loc:Loc.Instance}}" />
          <TextBox Grid.Column="1"
                   Classes="mono"
                   HorizontalAlignment="Stretch"
                   Text="{Binding TerminalFontFamily, Mode=TwoWay}"
                   PlaceholderText="{Binding [appearance.family.placeholder], Source={x:Static loc:Loc.Instance}}"
                   AutomationProperties.AutomationId="settings-terminal-font-family"
                   AutomationProperties.Name="{Binding [terminal.settings.fontFamily], Source={x:Static loc:Loc.Instance}}" />
        </Grid>
        <Grid ColumnDefinitions="180,*" Margin="0,9,0,3">
          <TextBlock Classes="label"
                     VerticalAlignment="Center"
                     Text="{Binding [terminal.settings.fontSize], Source={x:Static loc:Loc.Instance}}" />
          <NumericUpDown Grid.Column="1"
                         MinWidth="120"
                         HorizontalAlignment="Left"
                         Minimum="0"
                         Maximum="{Binding MaxTerminalFontSize}"
                         Increment="1"
                         FormatString="0"
                         Value="{Binding TerminalFontSize, Mode=TwoWay}"
                         AutomationProperties.AutomationId="settings-terminal-font-size"
                         AutomationProperties.Name="{Binding [terminal.settings.fontSize], Source={x:Static loc:Loc.Instance}}" />
        </Grid>
        <Grid ColumnDefinitions="180,*" Margin="0,9,0,3">
          <TextBlock Classes="label"
                     VerticalAlignment="Center"
                     Text="{Binding [terminal.settings.shell], Source={x:Static loc:Loc.Instance}}" />
          <TextBox Grid.Column="1"
                   Classes="mono"
                   HorizontalAlignment="Stretch"
                   Text="{Binding TerminalShell, Mode=TwoWay}"
                   PlaceholderText="pwsh"
                   AutomationProperties.AutomationId="settings-terminal-shell"
                   AutomationProperties.Name="{Binding [terminal.settings.shell], Source={x:Static loc:Loc.Instance}}" />
        </Grid>
        <Grid ColumnDefinitions="180,*" Margin="0,9,0,3">
          <TextBlock Classes="label"
                     VerticalAlignment="Center"
                     Text="{Binding [terminal.settings.arguments], Source={x:Static loc:Loc.Instance}}" />
          <TextBox Grid.Column="1"
                   Classes="mono"
                   HorizontalAlignment="Stretch"
                   Text="{Binding TerminalArguments, Mode=TwoWay}"
                   PlaceholderText="-l"
                   AutomationProperties.AutomationId="settings-terminal-arguments"
                   AutomationProperties.Name="{Binding [terminal.settings.arguments], Source={x:Static loc:Loc.Instance}}" />
        </Grid>
        <Grid ColumnDefinitions="180,*" Margin="0,9,0,3">
          <TextBlock Classes="label"
                     VerticalAlignment="Center"
                     Text="{Binding [terminal.settings.scrollback], Source={x:Static loc:Loc.Instance}}" />
          <NumericUpDown Grid.Column="1"
                         MinWidth="120"
                         HorizontalAlignment="Left"
                         Minimum="{Binding MinTerminalScrollbackLines}"
                         Maximum="{Binding MaxTerminalScrollbackLines}"
                         Increment="1000"
                         FormatString="0"
                         Value="{Binding TerminalScrollbackLines, Mode=TwoWay}"
                         AutomationProperties.AutomationId="settings-terminal-scrollback"
                         AutomationProperties.Name="{Binding [terminal.settings.scrollback], Source={x:Static loc:Loc.Instance}}" />
        </Grid>
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   Text="{Binding [terminal.settings.hint], Source={x:Static loc:Loc.Instance}}" />
      </StackPanel>
      <Separator Margin="0,4,0,0" />
      <TextBlock Classes="caption"
                 TextWrapping="Wrap"
                 Text="{Binding InventoryText}"
                 IsVisible="{Binding HasInventory}"
                 AutomationProperties.AutomationId="settings-tools-inventory" />
      <ItemsControl ItemsSource="{Binding Groups}" AutomationProperties.AutomationId="settings-tools-groups">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="set:ToolGroupViewModel">
            <StackPanel Spacing="2" Margin="0,4,0,6">
              <TextBlock Classes="h2" Text="{Binding Title}" />
              <ItemsControl ItemsSource="{Binding Tools}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="set:ToolRowViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                      <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   FontFamily="{DynamicResource FontMono}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="caption" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" />
                      </StackPanel>
                      <CheckBox Grid.Column="1"
                                VerticalAlignment="Center"
                                IsVisible="{Binding CanToggle}"
                                IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                AutomationProperties.Name="{Binding Name}"
                                AutomationProperties.AutomationId="settings-tools-switch" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="caption"
                 TextWrapping="Wrap"
                 Text="{Binding EmptyText}"
                 IsVisible="{Binding !HasGroups}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>