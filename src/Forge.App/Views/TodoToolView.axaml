<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Forge.App.ViewModels"
             xmlns:loc="using:Forge.App.Localization"
             x:Class="Forge.App.Views.TodoToolView"
             x:DataType="vm:TodoListViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource SurfaceBrush}" Margin="8,6">
    <TextBlock Classes="caption" Text="{Binding Summary}" HorizontalAlignment="Right" VerticalAlignment="Center" />

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,6">
      <TextBox Text="{Binding NewTitle, Mode=TwoWay}"
               PlaceholderText="{Binding [todo.newTaskPlaceholder], Source={x:Static loc:Loc.Instance}}"
               AutomationProperties.AutomationId="new-task"
               AutomationProperties.Name="{Binding [todo.newTask.name], Source={x:Static loc:Loc.Instance}}"
               KeyDown="OnNewTaskKeyDown" />
      <Button Grid.Column="1"
              Classes="ghost icon"
              Margin="6,0,0,0"
              Command="{Binding AddCommand}"
              AutomationProperties.AutomationId="add-task"
              AutomationProperties.Name="{Binding [todo.add], Source={x:Static loc:Loc.Instance}}">
        <PathIcon Data="{StaticResource IconPlus}" Width="11" Height="11" />
      </Button>
    </Grid>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TodoEntryViewModel">
            <Border Classes="tree-row">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          AutomationProperties.AutomationId="todo-done"
                          AutomationProperties.Name="{Binding [todo.done], Source={x:Static loc:Loc.Instance}}" />
                <TextBlock Grid.Column="1"
                           Margin="6,0"
                           VerticalAlignment="Center"
                           Text="{Binding Title}"
                           TextTrimming="CharacterEllipsis" />

                <!-- The step commit: the short id once committed (full id on hover); a failure shows below with a retry. -->
                <TextBlock Grid.Column="2"
                           Classes="caption mono"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           IsVisible="{Binding HasCommitId}"
                           Text="{Binding CommitShort}"
                           ToolTip.Tip="{Binding CommitId}"
                           AutomationProperties.AutomationId="todo-commit-id" />
                <Button Grid.Column="3"
                        Classes="ghost"
                        MinHeight="22"
                        Padding="6,0"
                        Margin="0,0,4,0"
                        FontSize="{DynamicResource FontSizeXs}"
                        VerticalAlignment="Center"
                        IsVisible="{Binding HasCommitError}"
                        Command="{Binding RetryCommitCommand}"
                        Content="{Binding [git.todo.commitRetry], Source={x:Static loc:Loc.Instance}}"
                        AutomationProperties.AutomationId="todo-retry-commit"
                        AutomationProperties.Name="{Binding [git.todo.commitRetry], Source={x:Static loc:Loc.Instance}}" />
                <Button Grid.Column="4" Classes="ghost icon" Width="20" Height="20" Command="{Binding MoveUpCommand}"
                        ToolTip.Tip="{Binding [todo.moveUp], Source={x:Static loc:Loc.Instance}}">
                  <PathIcon Data="{StaticResource IconChevronUp}" Width="9" Height="9" />
                </Button>
                <Button Grid.Column="5" Classes="ghost icon" Width="20" Height="20" Command="{Binding MoveDownCommand}"
                        ToolTip.Tip="{Binding [todo.moveDown], Source={x:Static loc:Loc.Instance}}">
                  <PathIcon Data="{StaticResource IconChevronDown}" Width="9" Height="9" />
                </Button>
                <Button Grid.Column="6" Classes="ghost icon" Width="20" Height="20" Command="{Binding RemoveCommand}"
                        ToolTip.Tip="{Binding [todo.delete], Source={x:Static loc:Loc.Instance}}">
                  <PathIcon Data="{StaticResource IconTrash}" Width="9" Height="9" />
                </Button>

                <Grid Grid.Row="1"
                      Grid.Column="1"
                      Grid.ColumnSpan="6"
                      ColumnDefinitions="Auto,*"
                      Margin="6,0,0,4"
                      IsVisible="{Binding HasCommitError}"
                      ToolTip.Tip="{Binding CommitError}">
                  <TextBlock Classes="caption"
                             Margin="0,0,6,0"
                             Foreground="{DynamicResource DangerBrush}"
                             Text="{Binding [git.todo.commitFailed], Source={x:Static loc:Loc.Instance}}" />
                  <TextBlock Grid.Column="1"
                             Classes="caption"
                             TextWrapping="Wrap"
                             MaxLines="2"
                             Text="{Binding CommitError}"
                             AutomationProperties.AutomationId="todo-commit-error" />
                </Grid>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Button Grid.Row="3"
            Classes="ghost"
            Margin="0,6,0,0"
            HorizontalAlignment="Left"
            Content="{Binding [todo.clearDone], Source={x:Static loc:Loc.Instance}}"
            Command="{Binding ClearDoneCommand}" />
  </Grid>
</UserControl>
