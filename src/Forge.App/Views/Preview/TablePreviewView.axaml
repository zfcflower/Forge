<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:preview="using:Forge.App.ViewModels.Preview"
             x:Class="Forge.App.Views.Preview.TablePreviewView"
             x:DataType="preview:TableFilePreviewViewModel">
  <UserControl.Styles>
    <!-- Grid lines and banded rows: a hairline right and below every cell, the header on a stronger band, every second data
         row tinted. The row Border spans the cells, so the band is one continuous stripe. -->
    <Style Selector="Border.table-cell">
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Border.table-row.alt">
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
    </Style>
    <Style Selector="Border.table-row">
      <Setter Property="BorderThickness" Value="1,0,0,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Border.table-header">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
      <Setter Property="BorderThickness" Value="1,1,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <!-- One shared cell template: both the header row and the data rows lay cells out at the precomputed column
         widths, so the columns align. Font family and size are inherited from the host ItemsControl. -->
    <DataTemplate x:Key="TableCellTemplate" x:DataType="preview:TablePreviewCellViewModel">
      <Border Classes="table-cell" Width="{Binding Column.Width}" Height="24">
        <TextBlock Text="{Binding Text}"
                   Padding="6,2"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </Border>
    </DataTemplate>
    <!-- The header cell adds a grip on its right edge: dragging it resizes the whole column. -->
    <DataTemplate x:Key="TableHeaderCellTemplate" x:DataType="preview:TablePreviewCellViewModel">
      <Border Classes="table-cell" Width="{Binding Column.Width}" Height="24">
        <Panel>
          <TextBlock Text="{Binding Text}"
                     Padding="6,2"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
          <Thumb Classes="column-grip" Width="7" HorizontalAlignment="Right" Cursor="SizeWestEast" Background="Transparent" />
        </Panel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource CardBackgroundBrush}">
    <TextBlock Classes="caption" Margin="12,6,12,2" Text="{Binding Caption}" />
    <TextBlock Grid.Row="1" Classes="caption" Margin="12,0,12,4" Text="{Binding Summary}" />
    <!-- One horizontal scroller around the header and the rows, so a wide table scrolls as one piece and the columns
         stay aligned; the rows keep their own vertical virtualization inside it. -->
    <ScrollViewer Grid.Row="2"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled">
      <Grid RowDefinitions="Auto,*">
        <Border Classes="table-header" Margin="12,0" IsVisible="{Binding HasHeader}">
        <ItemsControl
                      FontFamily="{DynamicResource FontMono}" FontSize="{DynamicResource FontSizeCode}"
                      FontWeight="SemiBold"
                      ItemsSource="{Binding Header.Cells}" ItemTemplate="{StaticResource TableHeaderCellTemplate}"
                      AutomationProperties.AutomationId="table-preview-header">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        </Border>
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.AutomationId="table-preview-rows">
          <ItemsControl ItemsSource="{Binding Rows}"
                        FontFamily="{DynamicResource FontMono}" FontSize="{DynamicResource FontSizeCode}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="preview:TablePreviewRowViewModel">
                <Border Classes="table-row" Classes.alt="{Binding IsAlternate}" Margin="12,0">
                  <ItemsControl ItemsSource="{Binding Cells}" ItemTemplate="{StaticResource TableCellTemplate}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </ScrollViewer>
    <TextBlock Grid.Row="3" Classes="caption" Margin="12,6" TextWrapping="Wrap"
               Foreground="{DynamicResource StatusErrorBrush}"
               IsVisible="{Binding HasNotice}" Text="{Binding Notice}"
               AutomationProperties.AutomationId="file-preview-notice" />
  </Grid>
</UserControl>
