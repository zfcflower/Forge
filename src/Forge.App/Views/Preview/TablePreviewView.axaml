<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:preview="using:Forge.App.ViewModels.Preview"
             x:Class="Forge.App.Views.Preview.TablePreviewView"
             x:DataType="preview:TableFilePreviewViewModel">
  <UserControl.Styles>
    <!-- The Fluent TableView theme pads the header band and every row with this key; zeroed so the grid lines meet edge to
         edge and the header band is exactly the height the header cells give it. -->
    <Style Selector="TableView">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <!-- The cells draw their own grid, the header its own band: neither keeps the theme's chrome or its padding. -->
    <Style Selector="TableViewCell">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TableViewColumnHeader">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Height" Value="24" />
    </Style>
    <!-- Column resizing is off, so the theme's resizer (a 1px line drawn with negative margins) only smears over the rows. -->
    <Style Selector="TableViewColumnHeader /template/ Thumb#PART_Resizer">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.table-cell">
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <!-- Banded rows: the classes come from the view's ContainerPrepared handler, which also runs on recycled rows. -->
    <Style Selector="TableViewRow.alt">
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <Thickness x:Key="TableViewRowPadding">0</Thickness>
    <!-- One shared cell template: a fixed-height monospace line over the grid line. The view builds one cell per column,
         because a table's column count comes from the file and cannot be written in XAML. -->
    <DataTemplate x:Key="TableCellTemplate" x:DataType="preview:TablePreviewCellViewModel">
      <Border Classes="table-cell" Height="24">
        <TextBlock Text="{Binding Text}"
                   Padding="6,2"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource CardBackgroundBrush}">
    <TextBlock Classes="caption" Margin="12,6,12,2" Text="{Binding Caption}" />
    <TextBlock Grid.Row="1" Classes="caption" Margin="12,0,12,4" Text="{Binding Summary}" />
    <!-- The TableView owns the header band, both scroll bars, the column layout and the row virtualization. -->
    <Border Grid.Row="2" Margin="12,0" ClipToBounds="True">
      <TableView x:Name="Table"
                 ItemsSource="{Binding Rows}"
                 CanUserResizeColumns="False"
                 FontFamily="{DynamicResource FontMono}"
                 FontSize="{DynamicResource FontSizeCode}"
                 AutomationProperties.AutomationId="table-preview" />
    </Border>
    <TextBlock Grid.Row="3" Classes="caption" Margin="12,6" TextWrapping="Wrap"
               Foreground="{DynamicResource StatusErrorBrush}"
               IsVisible="{Binding HasNotice}" Text="{Binding Notice}"
               AutomationProperties.AutomationId="file-preview-notice" />
  </Grid>
</UserControl>
