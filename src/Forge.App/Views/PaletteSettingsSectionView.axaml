<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Forge.App.Localization"
             xmlns:palette="using:Forge.App.Settings"
             x:Class="Forge.App.Views.PaletteSettingsSectionView"
             x:DataType="palette:PaletteSettingsSectionViewModel">

  <!-- The palette section: how many rows one source lists, and the directory names the content search leaves out. Two
       editors over live preferences, so a change applies to the next keystroke. -->
  <StackPanel Spacing="6">
    <Grid ColumnDefinitions="150,*" Margin="0,3">
      <TextBlock Classes="label"
                 VerticalAlignment="Center"
                 Text="{Binding [palette.settings.limit], Source={x:Static loc:Loc.Instance}}" />
      <NumericUpDown Grid.Column="1"
                     MinWidth="120"
                     HorizontalAlignment="Left"
                     Minimum="{Binding MinimumLimit}"
                     Maximum="{Binding MaximumLimit}"
                     Increment="10"
                     FormatString="0"
                     Value="{Binding ResultLimit, Mode=TwoWay}"
                     AutomationProperties.AutomationId="palette-settings-limit"
                     AutomationProperties.Name="{Binding [palette.settings.limit], Source={x:Static loc:Loc.Instance}}" />
    </Grid>
    <TextBlock Classes="caption"
               TextWrapping="Wrap"
               Text="{Binding [palette.settings.limitHint], Source={x:Static loc:Loc.Instance}}" />

    <Grid ColumnDefinitions="150,*" Margin="0,9,0,3">
      <TextBlock Classes="label"
                 VerticalAlignment="Center"
                 Text="{Binding [palette.settings.exclude], Source={x:Static loc:Loc.Instance}}" />
      <TextBox Grid.Column="1"
               Text="{Binding ExcludeDirectories, Mode=TwoWay}"
               AutomationProperties.AutomationId="palette-settings-exclude"
               AutomationProperties.Name="{Binding [palette.settings.exclude], Source={x:Static loc:Loc.Instance}}" />
    </Grid>
    <TextBlock Classes="caption"
               TextWrapping="Wrap"
               Text="{Binding [palette.settings.excludeHint], Source={x:Static loc:Loc.Instance}}" />
  </StackPanel>
</UserControl>
