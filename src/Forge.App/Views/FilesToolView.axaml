<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:wc="using:Forge.App.Workbench.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Forge.App.ViewModels"
             xmlns:loc="using:Forge.App.Localization"
             x:Class="Forge.App.Views.FilesToolView"
             x:DataType="vm:FilesPanelViewModel">
  <UserControl.Resources>
    <!-- One indent step, sized by the mark; the guide line is centred in the chevron slot so it lines up under
         the ancestor's chevron. -->
    <DataTemplate x:Key="IndentGuideTemplate" x:DataType="vm:IndentMark">
      <Border Width="{Binding Step}" VerticalAlignment="Stretch">
        <Grid ColumnDefinitions="8,*" VerticalAlignment="Stretch">
          <Border Width="1"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding DrawLine}"
                  Background="{DynamicResource BorderBrush}" />
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="FileNodeTemplate" x:DataType="vm:FileNodeViewModel">
      <Border Classes="tree-row">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{Binding [files.openInNewTab], Source={x:Static loc:Loc.Instance}}"
                      Command="{Binding OpenInNewTabCommand}" />
          </ContextMenu>
        </Border.ContextMenu>
        <Grid ColumnDefinitions="Auto,*">
          <ItemsControl Grid.Column="0"
                        VerticalAlignment="Stretch"
                        ItemsSource="{Binding Guides}"
                        ItemTemplate="{StaticResource IndentGuideTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <Border Grid.Column="1" Classes="tree-row-content">
            <Button Classes="tree-row-hit"
                    Command="{Binding ToggleCommand}"
                    AutomationProperties.AutomationId="file-row"
                    AutomationProperties.Name="{Binding Name}">
              <Grid ColumnDefinitions="Auto,Auto,*">
                <Border Grid.Column="0" Width="10" Margin="6,0,0,0">
                  <wc:FluentIcon Data="{StaticResource TreeChevronGeometry}"
                                 Classes="tree-chevron"
                                 Classes.expanded="{Binding ChevronRotated}"
                                 IsVisible="{Binding IsDirectory}"
                                 Width="12"
                                 Height="12"
                                 HorizontalAlignment="Center" />
                </Border>
                <wc:FluentIcon Grid.Column="1"
                               Classes="tree-icon"
                               Data="{Binding Icon}"
                               Margin="6,0,4,0" />
                <TextBlock Grid.Column="2"
                           Text="{Binding Name}"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
              </Grid>
            </Button>
          </Border>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ChangedFileDiffTemplate" x:DataType="vm:FileDiffViewModel">
      <Grid ColumnDefinitions="*,Auto" Margin="4,2">
        <TextBlock Classes="mono"
                   VerticalAlignment="Center"
                   Text="{Binding Path}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding Description}" />
        <TextBlock Grid.Column="1"
                   Classes="mono"
                   Margin="10,0,0,0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   Text="{Binding Meta}"
                   Foreground="{DynamicResource AccentTextBrush}"
                   AutomationProperties.AutomationId="changed-meta"
                   AutomationProperties.Name="{Binding Meta}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.change-picker">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.change-picker:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
    </Style>
    <Style Selector="Border.change-menu">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="BoxShadow" Value="{StaticResource ShadowSm}" />
    </Style>
    <Style Selector="Button.change-menu-row">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
    </Style>
    <Style Selector="Button.change-menu-row.selected">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Button.change-menu-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
    </Style>
    <Style Selector="TextBlock.change-menu-group">
      <Setter Property="Margin" Value="6,4,6,2" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Background="Transparent">
    <Border Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto">
        <!-- Each tab carries its own count: the panel no longer spells both numbers out in a summary after the buttons. A
             badge is never hidden, so an idle session reads "已改动 0" rather than leaving the reader to guess. -->
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Classes="tab"
                  Classes.selected="{Binding IsAllTab}"
                  Command="{Binding AllTabCommand}"
                  AutomationProperties.AutomationId="files-all"
                  AutomationProperties.Name="{Binding AllTabName}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="{Binding [files.all], Source={x:Static loc:Loc.Instance}}"
                         VerticalAlignment="Center" />
              <Border Classes="count-badge">
                <TextBlock Text="{Binding AllCount}"
                           AutomationProperties.AutomationId="files-all-count" />
              </Border>
            </StackPanel>
          </Button>
          <Button Classes="tab"
                  Classes.selected="{Binding IsChangedTab}"
                  Command="{Binding ChangedTabCommand}"
                  AutomationProperties.AutomationId="files-changed"
                  AutomationProperties.Name="{Binding ChangedTabName}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="{Binding [files.changed], Source={x:Static loc:Loc.Instance}}"
                         VerticalAlignment="Center" />
              <Border Classes="count-badge">
                <TextBlock Text="{Binding ChangedCount}"
                           AutomationProperties.AutomationId="files-changed-count" />
              </Border>
            </StackPanel>
          </Button>
        </StackPanel>
        <Button Grid.Column="1"
                Classes="ghost icon"
                Command="{Binding ChangedCommand}"
                ToolTip.Tip="{Binding [files.refresh], Source={x:Static loc:Loc.Instance}}"
                AutomationProperties.AutomationId="refresh-files"
                AutomationProperties.Name="{Binding [files.refresh.name], Source={x:Static loc:Loc.Instance}}">
          <wc:FluentIcon Data="{StaticResource IconRefresh}" Width="14" Height="14" />
        </Button>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Classes="toolbar"
            Padding="6,4"
            IsVisible="{Binding ShowSharedChanges}">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
        <Button x:Name="ScopePicker"
                Classes="change-picker"
                AutomationProperties.AutomationId="changes-scope-picker"
                AutomationProperties.Name="{Binding ChangeReview.ScopeLabel}"
                ToolTip.Tip="{Binding ChangeReview.ScopeLabel}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="{Binding ChangeReview.ScopeLabel}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <wc:FluentIcon Data="{DynamicResource IconChevronDown}" Width="12" Height="12" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <Border Classes="change-menu">
                <StackPanel MinWidth="220" Spacing="2">
                  <Button Classes="change-menu-row"
                          Classes.selected="{Binding ChangeReview.IsAllChanges}"
                          Command="{Binding ChangeReview.AllChangesCommand}"
                          Click="OnScopePicked"
                          AutomationProperties.AutomationId="changes-scope-all"
                          AutomationProperties.Name="{Binding [changes.all], Source={x:Static loc:Loc.Instance}}">
                    <Grid ColumnDefinitions="16,*">
                      <TextBlock Text="✓"
                                 Foreground="{DynamicResource AccentTextBrush}"
                                 IsVisible="{Binding ChangeReview.IsAllChanges}"
                                 AutomationProperties.AccessibilityView="Raw" />
                      <TextBlock Grid.Column="1" Text="{Binding [changes.all], Source={x:Static loc:Loc.Instance}}" />
                    </Grid>
                  </Button>
                  <Button Classes="change-menu-row"
                          Classes.selected="{Binding ChangeReview.IsUncommitted}"
                          Command="{Binding ChangeReview.UncommittedCommand}"
                          Click="OnScopePicked"
                          AutomationProperties.AutomationId="changes-scope-uncommitted"
                          AutomationProperties.Name="{Binding [changes.uncommitted], Source={x:Static loc:Loc.Instance}}">
                    <Grid ColumnDefinitions="16,*">
                      <TextBlock Text="✓"
                                 Foreground="{DynamicResource AccentTextBrush}"
                                 IsVisible="{Binding ChangeReview.IsUncommitted}"
                                 AutomationProperties.AccessibilityView="Raw" />
                      <TextBlock Grid.Column="1" Text="{Binding [changes.uncommitted], Source={x:Static loc:Loc.Instance}}" />
                    </Grid>
                  </Button>
                  <Border Classes="divider" Margin="5,3" />
                  <ItemsControl ItemsSource="{Binding ChangeReview.Turns}"
                                AutomationProperties.AutomationId="changes-turn-list">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TurnChoiceViewModel">
                        <Button Classes="change-menu-row"
                                Classes.selected="{Binding IsSelected}"
                                Command="{Binding SelectCommand}"
                                Click="OnScopePicked"
                                AutomationProperties.AutomationId="{Binding AutomationId}"
                                AutomationProperties.Name="{Binding Label}">
                          <Grid ColumnDefinitions="16,*">
                            <TextBlock Text="✓"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       IsVisible="{Binding IsSelected}"
                                       AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="caption"
                             Margin="8,4"
                             IsVisible="{Binding ChangeReview.HasNoTurns}"
                             Text="{Binding [changes.turns.none], Source={x:Static loc:Loc.Instance}}" />
                </StackPanel>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>

        <Button x:Name="CompareBranchPicker"
                Grid.Column="1"
                Classes="change-picker"
                AutomationProperties.AutomationId="changes-branch-picker"
                AutomationProperties.Name="{Binding ChangeReview.CompareBranchLabel}"
                ToolTip.Tip="{Binding ChangeReview.CompareBranchLabel}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="{Binding ChangeReview.CompareBranchLabel}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <wc:FluentIcon Data="{DynamicResource IconChevronDown}" Width="12" Height="12" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <Border Classes="change-menu">
                <StackPanel MinWidth="220" Spacing="2">
                  <TextBlock Classes="change-menu-group"
                             IsVisible="{Binding ChangeReview.HasLocalBranches}"
                             Text="{Binding [changes.compareBranch.local], Source={x:Static loc:Loc.Instance}}" />
                  <ItemsControl ItemsSource="{Binding ChangeReview.LocalBranches}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:BranchChoiceViewModel">
                        <Button Classes="change-menu-row"
                                Classes.selected="{Binding IsSelected}"
                                Command="{Binding SelectCommand}"
                                Click="OnBranchPicked"
                                AutomationProperties.AutomationId="{Binding AutomationId}"
                                AutomationProperties.Name="{Binding Name}">
                          <Grid ColumnDefinitions="16,*">
                            <TextBlock Text="✓"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       IsVisible="{Binding IsSelected}"
                                       AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Classes="divider"
                          Margin="5,3"
                          IsVisible="{Binding ChangeReview.HasLocalAndRemoteBranches}" />
                  <TextBlock Classes="change-menu-group"
                             IsVisible="{Binding ChangeReview.HasRemoteBranches}"
                             Text="{Binding [changes.compareBranch.remote], Source={x:Static loc:Loc.Instance}}" />
                  <ItemsControl ItemsSource="{Binding ChangeReview.RemoteBranches}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:BranchChoiceViewModel">
                        <Button Classes="change-menu-row"
                                Classes.selected="{Binding IsSelected}"
                                Command="{Binding SelectCommand}"
                                Click="OnBranchPicked"
                                AutomationProperties.AutomationId="{Binding AutomationId}"
                                AutomationProperties.Name="{Binding Name}">
                          <Grid ColumnDefinitions="16,*">
                            <TextBlock Text="✓"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       IsVisible="{Binding IsSelected}"
                                       AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="caption"
                             Margin="8,4"
                             IsVisible="{Binding ChangeReview.HasNoBranches}"
                             Text="{Binding [changes.compareBranch.none], Source={x:Static loc:Loc.Instance}}" />
                </StackPanel>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>

    <ListBox x:Name="TreeList"
             Grid.Row="2"
             IsVisible="{Binding IsAllTab}"
             ItemsSource="{Binding Rows}"
             ItemTemplate="{StaticResource FileNodeTemplate}"
             Padding="4,2"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             AutomationProperties.AutomationId="files-tree"
             AutomationProperties.Name="{Binding [files.tree.name], Source={x:Static loc:Loc.Instance}}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
    </ListBox>

    <ListBox x:Name="ChangedDiffList"
             Grid.Row="2"
             IsVisible="{Binding ShowSharedChanges}"
             ItemsSource="{Binding ChangeReview.Files}"
             SelectionChanged="OnChangedSelection"
             Padding="2,2"
             AutomationProperties.AutomationId="changed-files"
             AutomationProperties.Name="{Binding [files.changedList.name], Source={x:Static loc:Loc.Instance}}"
             ItemTemplate="{StaticResource ChangedFileDiffTemplate}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
    </ListBox>

    <ListBox x:Name="ChangedList"
             Grid.Row="2"
             IsVisible="{Binding ShowFallbackChanges}"
             ItemsSource="{Binding Changes}"
             SelectionChanged="OnChangedSelection"
             Padding="2,2"
             AutomationProperties.AutomationId="changed-files-fallback"
             AutomationProperties.Name="{Binding [files.changedList.name], Source={x:Static loc:Loc.Instance}}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ChangedFileViewModel">
          <Grid ColumnDefinitions="*,Auto" Margin="4,2">
            <TextBlock Classes="mono"
                       VerticalAlignment="Center"
                       Text="{Binding Path}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Description}" />
            <TextBlock Grid.Column="1"
                       Classes="mono"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Text="{Binding Meta}"
                       Foreground="{DynamicResource AccentTextBrush}"
                       AutomationProperties.AutomationId="changed-meta-fallback"
                       AutomationProperties.Name="{Binding Meta}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
