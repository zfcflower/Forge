<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:wc="using:Forge.App.Workbench.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Forge.App.ViewModels"
             xmlns:git="using:Forge.App.Git"
             xmlns:loc="using:Forge.App.Localization"
             xmlns:views="using:Forge.App.Views"
             x:Class="Forge.App.Views.FilesToolView"
             x:DataType="vm:FilesPanelViewModel">
  <UserControl.Resources>
    <!-- One indent step, sized by the mark; the guide line is centred in the chevron slot so it lines up under
         the ancestor's chevron. -->
    <DataTemplate x:Key="IndentGuideTemplate" x:DataType="vm:IndentMark">
      <Border Width="{Binding Step}" VerticalAlignment="Stretch">
        <Grid ColumnDefinitions="8,*" VerticalAlignment="Stretch">
          <Border Width="1"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding DrawLine}"
                  Background="{DynamicResource BorderBrush}" />
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="FileNodeTemplate" x:DataType="vm:FileNodeViewModel">
      <Border Classes="tree-row">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{Binding [files.openInNewTab], Source={x:Static loc:Loc.Instance}}"
                      Command="{Binding OpenInNewTabCommand}" />
          </ContextMenu>
        </Border.ContextMenu>
        <Grid ColumnDefinitions="Auto,*">
          <ItemsControl Grid.Column="0"
                        VerticalAlignment="Stretch"
                        ItemsSource="{Binding Guides}"
                        ItemTemplate="{StaticResource IndentGuideTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <Border Grid.Column="1" Classes="tree-row-content">
            <Button Classes="tree-row-hit"
                    Command="{Binding ToggleCommand}"
                    AutomationProperties.AutomationId="file-row"
                    AutomationProperties.Name="{Binding Name}">
              <Grid ColumnDefinitions="Auto,Auto,*">
                <Border Grid.Column="0" Width="10" Margin="6,0,0,0">
                  <wc:FluentIcon Data="{StaticResource TreeChevronGeometry}"
                                 Classes="tree-chevron"
                                 Classes.expanded="{Binding ChevronRotated}"
                                 IsVisible="{Binding IsDirectory}"
                                 Width="12"
                                 Height="12"
                                 HorizontalAlignment="Center" />
                </Border>
                <wc:FluentIcon Grid.Column="1"
                               Classes="tree-icon"
                               Data="{Binding Icon}"
                               Margin="6,0,4,0" />
                <TextBlock Grid.Column="2"
                           Text="{Binding Name}"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
              </Grid>
            </Button>
          </Border>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- The 已改动 tree: the same row anatomy as the 全部 tree (chevron, indent guides, icon, name) plus the diff counts
         at the right edge. An added file's name is drawn in the success green; a binary file shows only its status letter. -->
    <DataTemplate x:Key="ChangedNodeTemplate" x:DataType="vm:ChangedTreeNodeViewModel">
      <Border Classes="tree-row">
        <Grid ColumnDefinitions="Auto,*">
          <ItemsControl Grid.Column="0"
                        VerticalAlignment="Stretch"
                        ItemsSource="{Binding Guides}"
                        ItemTemplate="{StaticResource IndentGuideTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <Border Grid.Column="1"
                  Classes="tree-row-content"
                  Classes.active-row="{Binding IsSelectedFile}">
            <Button Classes="tree-row-hit"
                    Command="{Binding ToggleCommand}"
                    ToolTip.Tip="{Binding ToolTip}"
                    AutomationProperties.AutomationId="changed-row"
                    AutomationProperties.Name="{Binding Path}">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <Border Grid.Column="0" Width="10" Margin="6,0,0,0">
                  <wc:FluentIcon Data="{StaticResource TreeChevronGeometry}"
                                 Classes="tree-chevron"
                                 Classes.expanded="{Binding ChevronRotated}"
                                 IsVisible="{Binding IsDirectory}"
                                 Width="12"
                                 Height="12"
                                 HorizontalAlignment="Center" />
                </Border>
                <wc:FluentIcon Grid.Column="1"
                               Classes="tree-icon"
                               Data="{Binding Icon}"
                               Margin="6,0,4,0" />
                <TextBlock Grid.Column="2"
                           Text="{Binding Name}"
                           Classes.change-added="{Binding IsAdded}"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="6"
                            Margin="8,0,6,0"
                            VerticalAlignment="Center"
                            IsVisible="{Binding !IsDirectory}">
                  <TextBlock Classes="mono change-added"
                             Text="{Binding AddedText}"
                             IsVisible="{Binding ShowCounts}"
                             AutomationProperties.AutomationId="changed-added" />
                  <TextBlock Classes="mono change-removed"
                             Text="{Binding RemovedText}"
                             IsVisible="{Binding ShowCounts}"
                             AutomationProperties.AutomationId="changed-removed" />
                  <TextBlock Classes="mono"
                             Text="{Binding Badge}"
                             Foreground="{DynamicResource AccentTextBrush}"
                             IsVisible="{Binding ShowBadgeOnly}"
                             AutomationProperties.AutomationId="changed-meta" />
                </StackPanel>
              </Grid>
            </Button>
          </Border>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Background="Transparent">
    <Border Grid.Row="2" Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto">
        <!-- Each tab carries its own count: the panel no longer spells both numbers out in a summary after the buttons. A
             badge is never hidden, so an idle session reads "已改动 0" rather than leaving the reader to guess. -->
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Classes="tab"
                  Classes.selected="{Binding IsAllTab}"
                  Command="{Binding AllTabCommand}"
                  AutomationProperties.AutomationId="files-all"
                  AutomationProperties.Name="{Binding AllTabName}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="{Binding [files.all], Source={x:Static loc:Loc.Instance}}"
                         VerticalAlignment="Center" />
              <Border Classes="count-badge">
                <TextBlock Text="{Binding AllCount}"
                           AutomationProperties.AutomationId="files-all-count" />
              </Border>
            </StackPanel>
          </Button>
          <Button Classes="tab"
                  Classes.selected="{Binding IsChangedTab}"
                  Command="{Binding ChangedTabCommand}"
                  AutomationProperties.AutomationId="files-changed"
                  AutomationProperties.Name="{Binding ChangedTabName}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="{Binding [files.changed], Source={x:Static loc:Loc.Instance}}"
                         VerticalAlignment="Center" />
              <Border Classes="count-badge">
                <TextBlock Text="{Binding ChangedCount}"
                           AutomationProperties.AutomationId="files-changed-count" />
              </Border>
            </StackPanel>
          </Button>
        </StackPanel>
        <!-- The right-hand button follows the tab: refresh for 全部, fold/unfold-all for the 已改动 tree. -->
        <Button Grid.Column="1"
                Classes="ghost icon"
                Command="{Binding ChangedCommand}"
                IsVisible="{Binding ShowRefreshButton}"
                ToolTip.Tip="{Binding [files.refresh], Source={x:Static loc:Loc.Instance}}"
                AutomationProperties.AutomationId="refresh-files"
                AutomationProperties.Name="{Binding [files.refresh.name], Source={x:Static loc:Loc.Instance}}">
          <wc:FluentIcon Data="{StaticResource IconRefresh}" Width="14" Height="14" />
        </Button>
        <Button Grid.Column="1"
                Classes="ghost icon"
                Command="{Binding ToggleChangedFoldingCommand}"
                IsVisible="{Binding ShowFoldingButton}"
                ToolTip.Tip="{Binding FoldingToggleText}"
                AutomationProperties.AutomationId="changed-fold-toggle"
                AutomationProperties.Name="{Binding FoldingToggleText}">
          <Panel>
            <wc:FluentIcon Data="{StaticResource IconCollapseAll}"
                           Width="14"
                           Height="14"
                           IsVisible="{Binding IsChangedUnfolded}" />
            <wc:FluentIcon Data="{StaticResource IconExpandAll}"
                           Width="14"
                           Height="14"
                           IsVisible="{Binding IsChangedFolded}" />
          </Panel>
        </Button>
      </Grid>
    </Border>

    <Border Grid.Row="3"
            Classes="toolbar"
            Padding="6,4"
            IsVisible="{Binding ShowSharedChanges}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
        <Button x:Name="ScopePicker"
                Classes="change-picker"
                MaxWidth="170"
                AutomationProperties.AutomationId="changes-scope-picker"
                AutomationProperties.Name="{Binding ChangeReview.ScopeLabel}"
                ToolTip.Tip="{Binding ChangeReview.ScopeLabel}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <wc:FluentIcon Data="{StaticResource IconBranchCompare}" Width="14" Height="14" />
            <TextBlock Text="{Binding ChangeReview.ScopeLabel}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <wc:FluentIcon Data="{DynamicResource IconChevronDown}" Width="12" Height="12" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft"
                    FlyoutPresenterClasses="change-flyout"
                    Opening="OnScopeFlyoutOpening">
              <Border Classes="change-menu">
                <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel MinWidth="250" MaxWidth="340" Spacing="0">
                    <Button Classes="change-menu-row"
                            Classes.selected="{Binding ChangeReview.IsAllChanges}"
                            Command="{Binding ChangeReview.AllChangesCommand}"
                            Click="OnScopePicked"
                            AutomationProperties.AutomationId="changes-scope-all"
                            AutomationProperties.Name="{Binding [changes.all], Source={x:Static loc:Loc.Instance}}">
                      <Grid ColumnDefinitions="16,*">
                        <wc:FluentIcon Classes="change-menu-check"
                                       Data="{StaticResource IconCheck}"
                                       IsVisible="{Binding ChangeReview.IsAllChanges}"
                                       AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="{Binding [changes.all], Source={x:Static loc:Loc.Instance}}" />
                      </Grid>
                    </Button>
                    <!-- A clean working tree turns this row into a disabled, muted statement instead of an empty diff. -->
                    <Button Classes="change-menu-row"
                            Classes.selected="{Binding ChangeReview.IsUncommitted}"
                            Command="{Binding ChangeReview.UncommittedCommand}"
                            IsEnabled="{Binding ChangeReview.HasUncommitted}"
                            Click="OnScopePicked"
                            AutomationProperties.AutomationId="changes-scope-uncommitted"
                            AutomationProperties.Name="{Binding [changes.uncommitted], Source={x:Static loc:Loc.Instance}}">
                      <Grid ColumnDefinitions="16,*">
                        <wc:FluentIcon Classes="change-menu-check"
                                       Data="{StaticResource IconCheck}"
                                       IsVisible="{Binding ChangeReview.IsUncommitted}"
                                       AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding ChangeReview.HasUncommitted}"
                                   Text="{Binding [changes.uncommitted], Source={x:Static loc:Loc.Instance}}" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding ChangeReview.HasNoUncommitted}"
                                   Text="{Binding [changes.picker.uncommittedNone], Source={x:Static loc:Loc.Instance}}" />
                      </Grid>
                    </Button>
                    <Button Classes="change-menu-row"
                            Classes.selected="{Binding ChangeReview.IsLatestTurnChecked}"
                            Command="{Binding ChangeReview.LatestTurnCommand}"
                            IsVisible="{Binding !ChangeReview.HasNoTurns}"
                            Click="OnScopePicked"
                            AutomationProperties.AutomationId="changes-scope-latest-turn"
                            AutomationProperties.Name="{Binding ChangeReview.LatestTurnShortcutText}">
                      <Grid ColumnDefinitions="16,18,*">
                        <wc:FluentIcon Classes="change-menu-check"
                                       Data="{StaticResource IconCheck}"
                                       IsVisible="{Binding ChangeReview.IsLatestTurnChecked}"
                                       AutomationProperties.AccessibilityView="Raw" />
                        <wc:FluentIcon Grid.Column="1"
                                       Classes="tree-icon"
                                       Data="{StaticResource IconBot}"
                                       HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding ChangeReview.LatestTurnShortcutText}" />
                      </Grid>
                    </Button>

                    <Border Classes="divider" Margin="4,4" />
                    <TextBlock Classes="change-menu-group"
                               Text="{Binding [changes.picker.turns], Source={x:Static loc:Loc.Instance}}" />
                    <ItemsControl ItemsSource="{Binding ChangeReview.Turns}"
                                  AutomationProperties.AutomationId="changes-turn-list">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TurnChoiceViewModel">
                          <Button Classes="change-menu-row"
                                  Classes.selected="{Binding IsChecked}"
                                  Command="{Binding SelectCommand}"
                                  Click="OnScopePicked"
                                  AutomationProperties.AutomationId="{Binding AutomationId}"
                                  AutomationProperties.Name="{Binding Title}">
                            <Grid ColumnDefinitions="16,18,*">
                              <wc:FluentIcon Classes="change-menu-check"
                                             Data="{StaticResource IconCheck}"
                                             IsVisible="{Binding IsChecked}"
                                             AutomationProperties.AccessibilityView="Raw" />
                              <wc:FluentIcon Grid.Column="1"
                                             Classes="tree-icon"
                                             Data="{StaticResource IconBot}"
                                             HorizontalAlignment="Left" />
                              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="change-menu-hint"
                                           Text="{Binding Subtitle}"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="change-menu-hint"
                               Margin="8,4"
                               IsVisible="{Binding ChangeReview.HasNoTurns}"
                               Text="{Binding [changes.turns.none], Source={x:Static loc:Loc.Instance}}" />

                    <Border Classes="divider" Margin="4,4" />
                    <TextBlock Classes="change-menu-group"
                               Text="{Binding [changes.picker.commits], Source={x:Static loc:Loc.Instance}}" />
                    <ItemsControl ItemsSource="{Binding ChangeReview.Commits}"
                                  AutomationProperties.AutomationId="changes-commit-list">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CommitChoiceViewModel">
                          <Button Classes="change-menu-row"
                                  Classes.selected="{Binding IsChecked}"
                                  Command="{Binding SelectCommand}"
                                  Click="OnScopePicked"
                                  AutomationProperties.AutomationId="{Binding AutomationId}"
                                  AutomationProperties.Name="{Binding Subject}">
                            <Grid ColumnDefinitions="16,*">
                              <wc:FluentIcon Classes="change-menu-check"
                                             Data="{StaticResource IconCheck}"
                                             IsVisible="{Binding IsChecked}"
                                             AutomationProperties.AccessibilityView="Raw" />
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="change-menu-hint"
                                           Text="{Binding Subtitle}"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="change-menu-hint"
                               Margin="8,4"
                               IsVisible="{Binding ChangeReview.HasNoCommits}"
                               Text="{Binding [changes.picker.noCommits], Source={x:Static loc:Loc.Instance}}" />
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>

        <Button x:Name="CompareBranchPicker"
                Grid.Column="1"
                Classes="change-picker"
                HorizontalAlignment="Right"
                AutomationProperties.AutomationId="changes-branch-picker"
                AutomationProperties.Name="{Binding ChangeReview.CompareBranchLabel}"
                ToolTip.Tip="{Binding ChangeReview.CompareBranchLabel}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <wc:FluentIcon Data="{StaticResource IconBranch}" Width="14" Height="14" />
            <TextBlock Text="{Binding ChangeReview.CompareBranchLabel}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <wc:FluentIcon Data="{DynamicResource IconChevronDown}" Width="12" Height="12" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="change-flyout">
              <views:BranchPickerView DataContext="{Binding ChangeReview.Picker}" BranchSelected="OnBranchPicked" />
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>

    <!-- A stopped rebase/merge is the one blocking state this panel owns: it says what stopped and opens the files it
         stopped on (the same files carry U in the 已改动 tree). Continue/Abort are the only writes here besides sync. -->
    <Border Grid.Row="4"
            Classes="git-banner"
            IsVisible="{Binding Git.HasOperation}"
            AutomationProperties.AutomationId="git-operation">
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <TextBlock Classes="git-banner-title"
                     VerticalAlignment="Center"
                     Text="{Binding Git.OperationText}"
                     AutomationProperties.AutomationId="git-operation-title" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button Classes="ghost"
                    MinHeight="22"
                    Padding="8,2"
                    Content="{Binding [git.button.continue], Source={x:Static loc:Loc.Instance}}"
                    Command="{Binding Git.ContinueOperationCommand}"
                    AutomationProperties.AutomationId="git-continue" />
            <Button Classes="ghost"
                    MinHeight="22"
                    Padding="8,2"
                    Content="{Binding [git.button.abort], Source={x:Static loc:Loc.Instance}}"
                    Command="{Binding Git.AbortOperationCommand}"
                    AutomationProperties.AutomationId="git-abort" />
          </StackPanel>
        </Grid>
        <ItemsControl ItemsSource="{Binding Git.ConflictedFiles}"
                      AutomationProperties.AutomationId="git-conflicts">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="git:ConflictedFileItem">
              <Button Classes="git-banner-file"
                      Command="{Binding OpenCommand}"
                      ToolTip.Tip="{Binding Path}"
                      AutomationProperties.AutomationId="git-conflict-file"
                      AutomationProperties.Name="{Binding Path}">
                <TextBlock Classes="mono" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <ListBox x:Name="TreeList"
             Grid.Row="5"
             IsVisible="{Binding IsAllTab}"
             ItemsSource="{Binding Rows}"
             ItemTemplate="{StaticResource FileNodeTemplate}"
             Padding="4,2"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             AutomationProperties.AutomationId="files-tree"
             AutomationProperties.Name="{Binding [files.tree.name], Source={x:Static loc:Loc.Instance}}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
    </ListBox>

    <ListBox x:Name="ChangedDiffList"
             Grid.Row="5"
             IsVisible="{Binding ShowSharedChanges}"
             ItemsSource="{Binding ChangedRows}"
             ItemTemplate="{StaticResource ChangedNodeTemplate}"
             Padding="4,2"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             AutomationProperties.AutomationId="changed-files"
             AutomationProperties.Name="{Binding [files.changedList.name], Source={x:Static loc:Loc.Instance}}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
    </ListBox>

    <ListBox x:Name="ChangedList"
             Grid.Row="5"
             IsVisible="{Binding ShowFallbackChanges}"
             ItemsSource="{Binding Changes}"
             SelectionChanged="OnChangedSelection"
             Padding="2,2"
             AutomationProperties.AutomationId="changed-files-fallback"
             AutomationProperties.Name="{Binding [files.changedList.name], Source={x:Static loc:Loc.Instance}}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ChangedFileViewModel">
          <Grid ColumnDefinitions="*,Auto" Margin="4,2">
            <TextBlock Classes="mono"
                       VerticalAlignment="Center"
                       Text="{Binding Path}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Description}" />
            <TextBlock Grid.Column="1"
                       Classes="mono"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Text="{Binding Meta}"
                       Foreground="{DynamicResource AccentTextBrush}"
                       AutomationProperties.AutomationId="changed-meta-fallback"
                       AutomationProperties.Name="{Binding Meta}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>


    <!-- Row 2 of the header: how this branch ships. Two controls only — publish (before the first push) and 提交目标, whose
         menu lists the ways out. The branch name is one row above; it is never repeated here. -->
    <Border Grid.Row="1"
            Classes="git-ship"
            IsVisible="{Binding Git.HasRepository}"
            AutomationProperties.AutomationId="git-ship-row">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
        <TextBlock Grid.Column="0"
                   Classes="git-ship-hint"
                   IsVisible="{Binding Git.HasPublishHint}"
                   VerticalAlignment="Center"
                   Text="{Binding Git.PublishHint}"
                   AutomationProperties.AutomationId="git-ship-hint" />

        <Button Grid.Column="1"
                Classes="git-pill publish"
                IsVisible="{Binding Git.ShowPublish}"
                VerticalAlignment="Center"
                Command="{Binding Git.PushCommand}"
                ToolTip.Tip="{Binding Git.PushTooltip}"
                AutomationProperties.AutomationId="git-publish"
                AutomationProperties.Name="{Binding Git.PushTooltip}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <wc:FluentIcon Data="{StaticResource IconGitPush}" Width="12" Height="12" />
            <TextBlock Text="{Binding [git.ship.publish], Source={x:Static loc:Loc.Instance}}" />
          </StackPanel>
        </Button>

        <Button Grid.Column="2"
                Classes="git-pill target"
                Classes.open="{Binding Git.PullRequestIsOpen}"
                Classes.draft="{Binding Git.PullRequestIsDraft}"
                Classes.merged="{Binding Git.PullRequestIsMerged}"
                Classes.closed="{Binding Git.PullRequestIsClosed}"
                VerticalAlignment="Center"
                ToolTip.Tip="{Binding Git.PullRequestProblemText}"
                AutomationProperties.AutomationId="git-ship-target"
                AutomationProperties.Name="{Binding Git.PullRequestLabel}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Ellipse Width="6" Height="6" IsVisible="{Binding Git.HasPullRequestState}" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Git.PullRequestLabel}" VerticalAlignment="Center" />
            <TextBlock IsVisible="{Binding Git.HasPullRequestState}"
                       Text="{Binding Git.PullRequestNumberText}"
                       VerticalAlignment="Center" />
            <wc:FluentIcon Data="{StaticResource IconChevronDown}" Width="12" Height="12" VerticalAlignment="Center" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel MinWidth="230" Spacing="0">
                <ItemsControl ItemsSource="{Binding Git.ShipActions}" AutomationProperties.AutomationId="git-ship-menu">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="git:ShipActionViewModel">
                      <Button Classes="git-ship-item"
                              Classes.disabled="{Binding !IsEnabled}"
                              Command="{Binding Command}"
                              ToolTip.Tip="{Binding DisabledReason}"
                              AutomationProperties.AutomationId="{Binding Key}"
                              AutomationProperties.Name="{Binding Label}">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding Label}" />
                          <TextBlock Classes="caption"
                                     IsVisible="{Binding !IsEnabled}"
                                     Text="{Binding DisabledReason}"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>
    <!-- The git row: the branch of the active session at the left, the three sync verbs at the right, and the numbers on
         the two verbs that change something. Fetch carries no number because it only makes the others current. -->
    <Border Grid.Row="0"
            Classes="git-row"
            Classes.bad="{Binding Git.MessageIsError}"
            IsVisible="{Binding Git.HasRepository}"
            ToolTip.Tip="{Binding Git.BranchTooltip}"
            ClipToBounds="True"
            AutomationProperties.AutomationId="git-status-row"
            AutomationProperties.Name="{Binding Git.RowAutomationName}">
      <!-- Layout rule: the three verbs and the details link are docked to the right edge first, so they are never
           clipped; the message is docked next (bounded), and the branch name fills whatever is left and truncates. At the
           inspector's 200px minimum the branch (then the message) gives way — the verbs always stay clickable. -->
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Classes="git-row-action"
                  Command="{Binding Git.FetchCommand}"
                  ToolTip.Tip="{Binding Git.FetchTooltip}"
                  AutomationProperties.AutomationId="git-fetch"
                  AutomationProperties.Name="{Binding Git.FetchTooltip}">
            <Panel Width="12" Height="12">
              <wc:FluentIcon Data="{StaticResource IconGitFetch}"
                             Width="12"
                             Height="12"
                             IsVisible="{Binding !Git.IsFetchRunning}" />
              <Ellipse Width="6"
                       Height="6"
                       Fill="{DynamicResource AccentBrush}"
                       IsVisible="{Binding Git.IsFetchRunning}"
                       AutomationProperties.AccessibilityView="Raw" />
            </Panel>
          </Button>

          <Button Classes="git-row-action"
                  Command="{Binding Git.PullCommand}"
                  ToolTip.Tip="{Binding Git.PullTooltip}"
                  AutomationProperties.AutomationId="git-pull"
                  AutomationProperties.Name="{Binding Git.PullTooltip}">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Panel Width="12" Height="12">
                <wc:FluentIcon Data="{StaticResource IconGitPull}"
                               Width="12"
                               Height="12"
                               IsVisible="{Binding !Git.IsPullRunning}" />
                <Ellipse Width="6"
                         Height="6"
                         Fill="{DynamicResource AccentBrush}"
                         IsVisible="{Binding Git.IsPullRunning}"
                         AutomationProperties.AccessibilityView="Raw" />
              </Panel>
              <TextBlock Classes="git-row-count down"
                         IsVisible="{Binding Git.HasBehind}"
                         Text="{Binding Git.BehindText}"
                         AutomationProperties.AccessibilityView="Raw" />
            </StackPanel>
          </Button>

          <Button Classes="git-row-action"
                  Command="{Binding Git.PushCommand}"
                  ToolTip.Tip="{Binding Git.PushTooltip}"
                  AutomationProperties.AutomationId="git-push"
                  AutomationProperties.Name="{Binding Git.PushTooltip}">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Panel Width="12" Height="12">
                <wc:FluentIcon Data="{StaticResource IconGitPush}"
                               Width="12"
                               Height="12"
                               IsVisible="{Binding !Git.IsPushRunning}" />
                <Ellipse Width="6"
                         Height="6"
                         Fill="{DynamicResource AccentBrush}"
                         IsVisible="{Binding Git.IsPushRunning}"
                         AutomationProperties.AccessibilityView="Raw" />
              </Panel>
              <TextBlock Classes="git-row-count up"
                         IsVisible="{Binding Git.HasAhead}"
                         Text="{Binding Git.AheadText}"
                         AutomationProperties.AccessibilityView="Raw" />
            </StackPanel>
          </Button>
        </StackPanel>

        <Button DockPanel.Dock="Right"
                Classes="git-row-details"
                Margin="4,0,0,0"
                IsVisible="{Binding Git.HasMessageDetail}"
                VerticalAlignment="Center"
                Content="{Binding [git.row.details], Source={x:Static loc:Loc.Instance}}"
                AutomationProperties.AutomationId="git-message-details">
          <Button.Flyout>
            <Flyout Placement="TopEdgeAlignedLeft">
              <StackPanel MaxWidth="420" Spacing="6">
                <SelectableTextBlock Classes="mono"
                                     MaxHeight="220"
                                     TextWrapping="Wrap"
                                     Text="{Binding Git.MessageDetail}" />
                <TextBlock Classes="caption"
                           IsVisible="{Binding Git.HasHint}"
                           TextWrapping="Wrap"
                           Text="{Binding Git.HintText}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>

        <!-- The last operation's outcome, or the last re-read's failure; one line, bounded so it can never push the
             verbs out. Its full text stays available in the branch tooltip's row (the row's own name carries the state). -->
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Margin="6,0,0,0"
                    MaxWidth="150"
                    VerticalAlignment="Center"
                    IsVisible="{Binding Git.HasMessage}">
          <TextBlock Classes="git-row-message"
                     Text="{Binding Git.MessageText}"
                     ToolTip.Tip="{Binding Git.MessageText}" />
        </StackPanel>

        <wc:FluentIcon DockPanel.Dock="Left"
                       Classes="git-row-branch-icon"
                       Data="{StaticResource IconBranch}"
                       Width="11"
                       Height="11"
                       Margin="0,0,5,0"
                       VerticalAlignment="Center" />
        <TextBlock Classes="git-row-branch"
                   Text="{Binding Git.BranchLabel}"
                   AutomationProperties.AutomationId="git-branch"
                   AutomationProperties.Name="{Binding Git.BranchLabel}" />
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
