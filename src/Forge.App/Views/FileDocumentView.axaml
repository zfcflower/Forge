<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Forge.App.ViewModels"
             xmlns:preview="using:Forge.App.ViewModels.Preview"
             xmlns:pv="using:Forge.App.Views.Preview"
             xmlns:wc="using:Forge.App.Workbench.Controls"
             xmlns:loc="using:Forge.App.Localization"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="Forge.App.Views.FileDocumentView"
             x:DataType="vm:FileDocumentViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
  </UserControl.KeyBindings>
  <UserControl.Styles>
    <Style Selector="wc|PanelIconButton.active /template/ Border#PART_Background">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    </Style>
    <Style Selector="Button.reviewIcon, Button.reviewMarker">
      <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.reviewMarker.lost">
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="wc|FluentIcon.reviewGlyph">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.reviewMarker.lost wc|FluentIcon.reviewGlyph">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Border.reviewComposer">
      <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="BoxShadow" Value="0 4 16 0 #40000000" />
    </Style>
  </UserControl.Styles>
  <UserControl.DataTemplates>
    <!-- The read-only previews: one view per preview view model, selected by runtime type. -->
    <DataTemplate DataType="preview:ImageFilePreviewViewModel" x:DataType="preview:ImageFilePreviewViewModel">
      <pv:ImagePreviewView />
    </DataTemplate>
    <DataTemplate DataType="preview:TableFilePreviewViewModel" x:DataType="preview:TableFilePreviewViewModel">
      <pv:TablePreviewView />
    </DataTemplate>
    <DataTemplate DataType="preview:NotebookFilePreviewViewModel" x:DataType="preview:NotebookFilePreviewViewModel">
      <pv:NotebookPreviewView />
    </DataTemplate>
    <DataTemplate DataType="preview:PlaceholderFilePreviewViewModel" x:DataType="preview:PlaceholderFilePreviewViewModel">
      <pv:PlaceholderPreviewView />
    </DataTemplate>
  </UserControl.DataTemplates>
  <Grid RowDefinitions="Auto,Auto,*" Background="{DynamicResource SurfaceBrush}">
    <Border Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
        <TextBlock Classes="mono" Text="{Binding PathDisplay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="caption" Margin="6,0" Text="*" IsVisible="{Binding IsDirty}" VerticalAlignment="Center" />
        <wc:PanelIconButton Grid.Column="2" Icon="{DynamicResource IconWrap}" Classes.active="{Binding WrapLines}"
                            Command="{Binding ToggleWrapCommand}" ToolTip.Tip="{Binding [files.wrap], Source={x:Static loc:Loc.Instance}}"
                            AutomationProperties.AutomationId="file-wrap" AutomationProperties.Name="{Binding [files.wrap], Source={x:Static loc:Loc.Instance}}"
                            IsVisible="{Binding HasDocument}" />
        <wc:PanelIconButton Grid.Column="3" Margin="2,0,0,0" Icon="{DynamicResource IconSave}" Command="{Binding SaveCommand}"
                            ToolTip.Tip="{Binding [files.save], Source={x:Static loc:Loc.Instance}}"
                            AutomationProperties.AutomationId="file-save" AutomationProperties.Name="{Binding [files.save], Source={x:Static loc:Loc.Instance}}"
                            IsVisible="{Binding HasDocument}" />
        <wc:PanelIconButton Grid.Column="4" Margin="2,0,0,0" Icon="{DynamicResource IconCopy}" Click="OnCopyClick"
                            ToolTip.Tip="{Binding [files.copy], Source={x:Static loc:Loc.Instance}}"
                            AutomationProperties.AutomationId="file-copy" AutomationProperties.Name="{Binding [files.copy], Source={x:Static loc:Loc.Instance}}"
                            IsVisible="{Binding HasDocument}" />
        <wc:PanelIconButton Grid.Column="5" Margin="2,0,0,0" Icon="{DynamicResource IconOpen}" Command="{Binding OpenExternallyCommand}"
                            ToolTip.Tip="{Binding [files.preview.openExternal], Source={x:Static loc:Loc.Instance}}"
                            AutomationProperties.AutomationId="file-open-external" AutomationProperties.Name="{Binding [files.preview.openExternal], Source={x:Static loc:Loc.Instance}}" />
        <wc:PanelIconButton x:Name="EditorMenuButton" Grid.Column="6" Margin="2,0,0,0" Icon="{DynamicResource IconEllipsis}" Click="OnEditorMenuClick"
                            ToolTip.Tip="{Binding [editor.menu.label], Source={x:Static loc:Loc.Instance}}"
                            AutomationProperties.AutomationId="file-editor-menu" AutomationProperties.Name="{Binding [editor.menu.label], Source={x:Static loc:Loc.Instance}}"
                            IsVisible="{Binding HasDocument}" />
        <Button x:Name="ReviewSendAll" Grid.Column="7" Margin="2,0,0,0" Classes="icon" IsVisible="False"
                AutomationProperties.AutomationId="review-send-all">
          <wc:FluentIcon Classes="reviewGlyph" Data="{DynamicResource IconSend}" Width="14" Height="14" />
        </Button>
      </Grid>
    </Border>
    <StackPanel Grid.Row="1">
      <TextBlock Margin="12,6" Classes="caption" IsVisible="{Binding IsLoading}" Text="{Binding [files.loading], Source={x:Static loc:Loc.Instance}}" />
      <TextBlock Margin="12,6" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasError}" Text="{Binding Error}"
                 Foreground="{DynamicResource DangerBrush}" AutomationProperties.AutomationId="file-error" />
      <TextBlock Margin="12,6" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasSaveError}" Text="{Binding SaveError}"
                 Foreground="{DynamicResource DangerBrush}" AutomationProperties.AutomationId="file-save-error" />
      <TextBlock Margin="12,6" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasCopyError}" Text="{Binding CopyError}"
                 Foreground="{DynamicResource DangerBrush}" AutomationProperties.AutomationId="file-copy-error" />
      <TextBlock Margin="12,6" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasLspStatus}" Text="{Binding LspStatus}"
                 Foreground="{DynamicResource TextMutedBrush}" AutomationProperties.AutomationId="file-lsp-status" />
      <TextBlock Margin="12,6" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasEditorNotice}" Text="{Binding EditorNotice}"
                 Foreground="{DynamicResource TextMutedBrush}" AutomationProperties.AutomationId="file-editor-notice" />
      <TextBlock Margin="12,6" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasFoldingNotice}" Text="{Binding FoldingNotice}"
                 Foreground="{DynamicResource TextMutedBrush}" AutomationProperties.AutomationId="file-folding-notice" />
      <TextBlock Margin="12,6" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasEditorActionNotice}" Text="{Binding EditorActionNotice}"
                 Foreground="{DynamicResource TextMutedBrush}" AutomationProperties.AutomationId="file-editor-action-notice" />
      <TextBlock x:Name="ReviewStatus" Margin="12,6" Classes="caption" TextWrapping="Wrap" IsVisible="False"
                 Foreground="{DynamicResource TextMutedBrush}" AutomationProperties.AutomationId="file-review-status" />
    </StackPanel>
    <Grid Grid.Row="2">
      <ae:TextEditor x:Name="Editor" ShowLineNumbers="True" WordWrap="{Binding WrapLines}"
                     FontFamily="{DynamicResource FontMono}" FontSize="{DynamicResource FontSizeCode}"
                     Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                     LineNumbersForeground="{DynamicResource TextMutedBrush}"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                     IsReadOnly="{Binding IsEditorFaulted}"
                     IsVisible="{Binding HasDocument}" AutomationProperties.AutomationId="file-editor">
        <!-- The right-click menu and the toolbar ellipsis are built in code (one builder, two hosts): an
             Avalonia ContextMenu can only be opened on the control it is attached to, so the toolbar cannot reuse it. -->
      </ae:TextEditor>
      <ContentControl x:Name="PreviewHost" Content="{Binding Preview}" IsVisible="{Binding HasPreview}"
                      AutomationProperties.AutomationId="file-preview" />
      <Canvas x:Name="ReviewLayer" ClipToBounds="True">
        <Button x:Name="ReviewIconButton" Classes="reviewIcon" Width="26" Height="26" IsVisible="False"
                AutomationProperties.AutomationId="review-add">
          <wc:FluentIcon Classes="reviewGlyph" Data="{DynamicResource IconCommentAdd}" Width="14" Height="14" />
        </Button>
        <Border x:Name="ReviewComposer" Classes="reviewComposer" IsVisible="False"
                AutomationProperties.AutomationId="review-composer">
          <StackPanel Spacing="6">
            <TextBlock x:Name="ReviewRangeText" Classes="mono" />
            <TextBox x:Name="ReviewBodyBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="160"
                     AutomationProperties.AutomationId="review-body" />
            <TextBlock x:Name="ReviewComposerStatus" Classes="caption" TextWrapping="Wrap" IsVisible="False"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" HorizontalAlignment="Right">
              <Button x:Name="ReviewDeleteButton" Classes="ghost" AutomationProperties.AutomationId="review-delete" />
              <Button x:Name="ReviewCancelButton" Classes="ghost" AutomationProperties.AutomationId="review-cancel" />
              <Button x:Name="ReviewSaveButton" Classes="ghost" AutomationProperties.AutomationId="review-save" />
              <Button x:Name="ReviewSendButton" Classes="primary" AutomationProperties.AutomationId="review-send" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </Canvas>
    </Grid>
  </Grid>
</UserControl>
