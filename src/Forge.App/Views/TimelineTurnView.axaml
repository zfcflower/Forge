<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Forge.App.ViewModels"
             xmlns:views="using:Forge.App.Views"
             xmlns:loc="using:Forge.App.Localization"
             xmlns:wc="using:Forge.App.Workbench.Controls"
             x:Class="Forge.App.Views.TimelineTurnView"
             x:DataType="vm:TurnCardViewModel">
  <!-- The turn's metadata row on the timeline: a node-less row the axis passes through. The turn's blocks and its footnote are
       rows of their own in the flat transcript list, so every gutter lands on the same x as the rows of every other item. -->
  <Grid ColumnDefinitions="Auto,*">
      <views:TimelineGutter Role="TurnHeader" Kind="Turn" IsRunning="{Binding IsRunning}" />
      <Button Grid.Column="1"
              Classes="link"
              Margin="0,3,8,2"
              HorizontalAlignment="Left"
              HorizontalContentAlignment="Left"
              Command="{Binding ToggleCommand}"
              AutomationProperties.AutomationId="turn-toggle"
              AutomationProperties.Name="{Binding [turn.collapse], Source={x:Static loc:Loc.Instance}}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <wc:FluentIcon Data="{StaticResource TreeChevronGeometry}" Classes="tree-chevron" Classes.expanded="{Binding IsExpanded}" Width="12" Height="12" />
          <TextBlock Classes="caption" Text="{Binding Header}" />
        </StackPanel>
      </Button>
    </Grid>
</UserControl>
