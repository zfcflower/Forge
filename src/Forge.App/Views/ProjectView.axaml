<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:wc="using:Forge.App.Workbench.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Forge.App.ViewModels"
             xmlns:loc="using:Forge.App.Localization"
             x:Class="Forge.App.Views.ProjectView"
             x:DataType="vm:ProjectTreeViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://Forge.App/Resources/ChromeStyles.axaml" />
    <StyleInclude Source="avares://Forge.App/Resources/TreeStyles.axaml" />
    <!-- A project's own name heads its subtree, so it reads one step larger and one weight heavier than the rows under it;
         a workspace row names its branch, so it takes the weight without the size. Declared here rather than in the shared
         dictionary: the tree's own view is the only place that spells this. -->
    <Style Selector="TextBlock.project-name">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeMd}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.branch-name">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- A recycled workspace row (lifecycle 5.1) stays in the tree only to be restored or purged, so it reads greyed. -->
    <Style Selector="Border.tree-row-content.recycled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <!-- The row's own tool button is 22 px, so it fits the 24 px name surface instead of pushing the surface (and with it the
         row) back to Button.icon's 26 px minimum. -->
    <Style Selector="Button.tree-plus, Button.tree-tool">
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="MinHeight" Value="22" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- One indent step, sized by the mark (folder rows and agent rows use different steps); the guide line is
         centred in the chevron slot so it lines up under the ancestor's chevron. -->
    <DataTemplate x:Key="IndentGuideTemplate" x:DataType="vm:IndentMark">
      <Border Width="{Binding Step}" VerticalAlignment="Stretch">
        <Grid VerticalAlignment="Stretch">
          <!-- The line sits 11 px into the step: the row's chevron box is 6 px of inset plus a 10 px box, so 11 is the
               centre of the ancestor's chevron (and of the icon block that follows it). -->
          <Border Width="1"
                  Margin="11,0,0,0"
                  HorizontalAlignment="Left"
                  IsVisible="{Binding DrawLine}"
                  Background="{DynamicResource BorderBrush}" />
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="TreeNodeTemplate" x:DataType="vm:TreeNodeViewModel">
      <Border Classes="tree-row">
        <Panel>
          <Grid ColumnDefinitions="Auto,*">
            <ItemsControl Grid.Column="0"
                          VerticalAlignment="Stretch"
                          ItemsSource="{Binding Guides}"
                          ItemTemplate="{StaticResource IndentGuideTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Border Grid.Column="1"
                    Classes="tree-row-content"
                    Classes.heading-row="{Binding IsHeadingRow}"
                    Classes.active-row="{Binding IsActiveRow}"
                    Classes.recycled="{Binding IsRecycled}">
              <!-- No shared ContextMenu: each row's menu is generated when it opens (lifecycle 5.4 rule 1), from the row's
                   snapshot only, by the view's context-request handler. -->
              <Grid>
                <!-- Project / worktree / session rows: the chevron leads, then icon, title and the row's one tool. The row
                     itself is the hit target - a tap anywhere on it activates the row - so a session row needs no separate
                     "open" button next to its title. -->
                <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                      IsVisible="{Binding !IsAgent}">
                  <!-- The chevron sits one panel padding inside the row, so the deepest level of the tree still keeps the same
                       gutter from the panel edge as the panel's own padding. -->
                  <Border Grid.Column="0" Width="10" Margin="6,0,0,0">
                    <Button Classes="tree-chevron-button"
                            Command="{Binding ToggleCommand}"
                            IsVisible="{Binding HasToggle}">
                      <!-- The Fluent chevron is a filled outline whose stroke is ~1.5 grid units: at 8 px it lands under a pixel
                           and disappears, so it is drawn at 12 px and overhangs its 10 px slot by a pixel on each side. -->
                      <wc:FluentIcon Data="{StaticResource TreeChevronGeometry}"
                                     Classes="tree-chevron"
                                     Classes.expanded="{Binding ChevronRotated}"
                                     Width="12"
                                     Height="12"
                                     HorizontalAlignment="Center" />
                    </Button>
                  </Border>
                  <wc:FluentIcon Grid.Column="1"
                                 Classes="tree-icon"
                                 Classes.project-icon="{Binding IsProject}"
                                 Classes.active-session="{Binding IsActiveSession}"
                                 Data="{Binding Icon}"
                                 Margin="6,0,4,0" />
                  <Grid Grid.Column="2" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
                    <!-- A project's own name is the heading of its subtree, so it reads one weight above the rows under it. -->
                    <TextBlock Text="{Binding Title}"
                               Classes.project-name="{Binding IsProject}"
                               Classes.branch-name="{Binding IsWorktree}"
                               TextWrapping="NoWrap"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,6,0" />
                    <!-- A fork workspace names its source branch after the title (5.4 rule 6), in the muted caption style. -->
                    <TextBlock Grid.Column="1"
                               Classes="caption"
                               Text="{Binding ForkLabel}"
                               IsVisible="{Binding HasForkLabel}"
                               TextWrapping="NoWrap"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,6,0" />
                    <!-- Recycled / directory missing / removed (lifecycle 5.1, 5.3), in the same muted caption style. -->
                    <TextBlock Grid.Column="2"
                               Classes="caption"
                               Text="{Binding RowMarkText}"
                               IsVisible="{Binding HasRowMark}"
                               TextWrapping="NoWrap"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <!-- A sparse checkout (7.9), read-only: the mark only says so. -->
                    <TextBlock Grid.Column="3"
                               Classes="caption"
                               Text="{Binding SparseLabel}"
                               IsVisible="{Binding IsSparse}"
                               TextWrapping="NoWrap"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <!-- Created by an automation: a small bolt, the same glyph as the title-bar entry. -->
                    <wc:FluentIcon Grid.Column="4"
                                   Data="{StaticResource IconBolt}"
                                   Width="11"
                                   Height="11"
                                   Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   IsVisible="{Binding IsAutomationSession}"
                                   ToolTip.Tip="{Binding [automations.session.createdBy], Source={x:Static loc:Loc.Instance}}" />
                    <!-- A running session's dot is centred on the same 11 px-from-the-edge point as a branch row's trailing
                         button, so the two columns line up; the row keeps its 24 px surface. -->
                    <Panel Grid.Column="5"
                           Width="22"
                           VerticalAlignment="Stretch"
                           IsVisible="{Binding IsRunning}">
                      <Ellipse Classes="status-dot running"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Panel>
                    <!-- A repository project without a remote: one click pairs it with one (a URL, or a new GitHub repository
                         through gh); the button is gone once a remote exists. -->
                    <Button Grid.Column="6"
                            Classes="ghost icon tree-tool"
                            Width="22"
                            Height="22"
                            Margin="4,0,0,0"
                            IsVisible="{Binding NeedsRemote}"
                            Command="{Binding PairRemoteCommand}"
                            ToolTip.Tip="{Binding PairRemoteTooltip}"
                            AutomationProperties.AutomationId="project-pair-remote"
                            AutomationProperties.Name="{Binding PairRemoteTooltip}">
                      <wc:FluentIcon Data="{StaticResource IconPlug}" Width="12" Height="12" />
                    </Button>
                  </Grid>
                  <!-- The section's own "new conversation" tool, or the project's "new workspace": same button, two actions,
                       so the glyph and the tooltip tell them apart instead of sharing one plus. On a workspace row it is the
                       menu's first group (5.3): the view runs its one enabled entry, or shows the group as a small menu. -->
                  <Button Grid.Column="3"
                          Classes="ghost icon tree-plus"
                          Width="22"
                          Height="22"
                          IsVisible="{Binding HasNewSession}"
                          ToolTip.Tip="{Binding NewSessionTooltip}"
                          AutomationProperties.AutomationId="project-new-session"
                          AutomationProperties.Name="{Binding NewSessionTooltip}">
                    <wc:FluentIcon Data="{Binding NewSessionGlyph}"
                                   Width="{Binding NewSessionGlyphSize}"
                                   Height="{Binding NewSessionGlyphSize}" />
                  </Button>
                </Grid>
                <!-- Agent rows: icon first, then title, the chevron and the grey status text. No guide lines. The icon's left
                     margin is IndentMarks.IconIndent (6 inset + the 8 px chevron slot this row leaves empty + 8 gap), so an
                     agent row indents exactly one step under the row it belongs to. -->
                <Grid ColumnDefinitions="Auto,*"
                      IsVisible="{Binding IsAgent}">
                  <wc:FluentIcon Grid.Column="0"
                                 Classes="tree-icon"
                                 Classes.agent-running="{Binding IsAgentRunning}"
                                 Classes.agent-running-animated="{Binding IsAgentRunningAnimated}"
                                 Classes.agent-queued="{Binding IsAgentQueued}"
                                 Classes.agent-completed="{Binding IsAgentCompleted}"
                                 Classes.agent-failed="{Binding IsAgentFailed}"
                                 Classes.agent-stopped="{Binding IsAgentStopped}"
                                 Data="{Binding Icon}"
                                 Margin="22,0,4,0" />
                  <Grid Grid.Column="1" ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               TextWrapping="NoWrap"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,8,0" />
                    <wc:FluentIcon Data="{StaticResource TreeChevronGeometry}"
                                   Classes="tree-chevron"
                                   Classes.expanded="{Binding ChevronRotated}"
                                   IsVisible="{Binding HasToggle}"
                                   Width="12"
                                   Height="12"
                                   Grid.Column="1"
                                   HorizontalAlignment="Center" />
                    <!-- A sub-agent's state is a mark, not a caption: a coloured dot while it is queued, running or ended
                         badly, a green check once it finished fine. The words stay in the tooltip. -->
                    <!-- The mark sits in the same 22 px right-hand slot a sibling row's trailing button occupies, so the
                         right rail of the tree is one straight column from the project row down to the last sub-agent. -->
                    <Panel Grid.Column="2"
                           Width="22"
                           VerticalAlignment="Stretch"
                           IsVisible="{Binding HasStatusGlyph}"
                           ToolTip.Tip="{Binding StatusText}">
                      <Ellipse Classes="status-dot"
                               Classes.agent-running="{Binding IsAgentRunning}"
                               Classes.agent-queued="{Binding IsAgentQueued}"
                               Classes.agent-failed="{Binding IsAgentFailed}"
                               Classes.agent-stopped="{Binding IsAgentStopped}"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding ShowsStatusDot}" />
                      <wc:FluentIcon Classes="status-check"
                                     Data="{StaticResource IconCheck}"
                                     HorizontalAlignment="Center"
                                     IsVisible="{Binding ShowsStatusCheck}" />
                    </Panel>
                  </Grid>
                </Grid>
              </Grid>
            </Border>
          </Grid>
        </Panel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*" Background="Transparent">
    <TextBlock Grid.Row="0"
               Classes="caption"
               Margin="6,4"
               TextWrapping="Wrap"
               IsVisible="{Binding HasStatusText}"
               Text="{Binding StatusText}" />

    <!-- One flat, virtualized row list: expanding or collapsing a row splices only its subtree. Projects are added from
         the panel's title bar, so the body holds nothing but the tree. The right padding is 6 px wider than the rest: the
         overlay scrollbar gets its own lane instead of sitting on top of a row's trailing button. -->
    <ListBox x:Name="TreeList"
             Grid.Row="1"
             ItemsSource="{Binding Rows}"
             ItemTemplate="{StaticResource TreeNodeTemplate}"
             Padding="8,8,14,8"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             AutomationProperties.AutomationId="project-tree"
             AutomationProperties.Name="{Binding [project.treeName], Source={x:Static loc:Loc.Instance}}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
    </ListBox>
  </Grid>
</UserControl>
