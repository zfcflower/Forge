<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Forge.App.ViewModels"
             xmlns:loc="using:Forge.App.Localization"
             x:Class="Forge.App.Views.ProjectView"
             x:DataType="vm:ProjectTreeViewModel">
  <UserControl.Resources>
    <!-- One indent step, sized by the mark (folder rows and agent rows use different steps); the guide line is
         centred in the chevron slot so it lines up under the ancestor's chevron. -->
    <DataTemplate x:Key="IndentGuideTemplate" x:DataType="vm:IndentMark">
      <Border Width="{Binding Step}" VerticalAlignment="Stretch">
        <Grid ColumnDefinitions="8,*" VerticalAlignment="Stretch">
          <Border Width="1"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding DrawLine}"
                  Background="{DynamicResource BorderBrush}" />
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="TreeNodeTemplate" x:DataType="vm:TreeNodeViewModel">
      <Border Classes="tree-row">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{Binding [project.newSession], Source={x:Static loc:Loc.Instance}}" Command="{Binding NewSessionCommand}" />
            <MenuItem Header="{Binding [project.rename], Source={x:Static loc:Loc.Instance}}" Command="{Binding RenameCommand}" />
            <MenuItem Header="{Binding [project.archive], Source={x:Static loc:Loc.Instance}}" Command="{Binding ArchiveCommand}" />
            <MenuItem Header="{Binding [project.reveal], Source={x:Static loc:Loc.Instance}}" Command="{Binding RevealCommand}" />
            <Separator />
            <MenuItem Header="{Binding [project.remove], Source={x:Static loc:Loc.Instance}}" Command="{Binding RemoveCommand}" />
          </ContextMenu>
        </Border.ContextMenu>
        <Grid ColumnDefinitions="Auto,*">
          <ItemsControl Grid.Column="0"
                        VerticalAlignment="Stretch"
                        ItemsSource="{Binding Guides}"
                        ItemTemplate="{StaticResource IndentGuideTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <Border Grid.Column="1" Classes="tree-row-content">
            <Grid>
              <!-- Project / worktree / session rows: the chevron leads, then icon, title and trailing tools. -->
              <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" IsVisible="{Binding !IsAgent}">
                <Border Grid.Column="0" Width="8">
                  <Button Classes="tree-chevron-button"
                          Command="{Binding ToggleCommand}"
                          IsVisible="{Binding HasToggle}">
                    <Path Data="{StaticResource TreeChevronGeometry}"
                          Classes="tree-chevron"
                          Classes.expanded="{Binding ChevronRotated}"
                          Width="8"
                          Height="8"
                          HorizontalAlignment="Center"
                          Stretch="Uniform" />
                  </Button>
                </Border>
                <Path Grid.Column="1"
                      Classes="tree-icon"
                      Data="{Binding Icon}"
                      Margin="14,0,6,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}"
                             TextWrapping="NoWrap"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <Ellipse Classes="status-dot running" IsVisible="{Binding IsRunning}" />
                </StackPanel>
                <Button Grid.Column="3"
                        Classes="ghost icon"
                        Width="20"
                        Height="20"
                        Command="{Binding NewSessionCommand}"
                        IsVisible="{Binding HasNewSession}"
                        ToolTip.Tip="{Binding [project.newSessionTooltip], Source={x:Static loc:Loc.Instance}}"
                        AutomationProperties.AutomationId="project-new-session"
                        AutomationProperties.Name="{Binding [project.newSessionTooltip], Source={x:Static loc:Loc.Instance}}">
                  <PathIcon Data="{StaticResource IconPlusSmall}" Width="9" Height="9" />
                </Button>
                <Button Grid.Column="4"
                        Classes="ghost icon"
                        Width="20"
                        Height="20"
                        Command="{Binding OpenCommand}"
                        IsVisible="{Binding HasOpen}"
                        ToolTip.Tip="{Binding [project.open], Source={x:Static loc:Loc.Instance}}"
                        AutomationProperties.AutomationId="project-open-session"
                        AutomationProperties.Name="{Binding [project.openSessionName], Source={x:Static loc:Loc.Instance}}">
                  <TextBlock Classes="glyph" Text="›" />
                </Button>
              </Grid>
              <!-- Agent rows: icon first, then title, the chevron and the grey status text. No guide lines. -->
              <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsAgent}">
                <Path Grid.Column="0"
                      Classes="tree-icon"
                      Classes.agent-running="{Binding IsAgentRunning}"
                      Classes.agent-running-animated="{Binding IsAgentRunningAnimated}"
                      Classes.agent-queued="{Binding IsAgentQueued}"
                      Classes.agent-completed="{Binding IsAgentCompleted}"
                      Classes.agent-failed="{Binding IsAgentFailed}"
                      Classes.agent-stopped="{Binding IsAgentStopped}"
                      Data="{Binding Icon}"
                      Margin="0,0,6,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}"
                             MaxWidth="260"
                             TextWrapping="NoWrap"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <Path Data="{StaticResource TreeChevronGeometry}"
                        Classes="tree-chevron"
                        Classes.expanded="{Binding ChevronRotated}"
                        IsVisible="{Binding HasToggle}"
                        Width="8"
                        Height="8"
                        HorizontalAlignment="Center"
                        Stretch="Uniform" />
                  <TextBlock Classes="caption" Text="{Binding StatusText}" VerticalAlignment="Center" IsVisible="{Binding HasStatusText}" />
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,Auto,*" Background="{DynamicResource SurfaceBrush}">
    <Border Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <Button Grid.Column="1"
                Classes="ghost icon"
                Command="{Binding GeneralSessionCommand}"
                ToolTip.Tip="{Binding [project.newGeneralSession], Source={x:Static loc:Loc.Instance}}"
                AutomationProperties.AutomationId="new-general-session"
                AutomationProperties.Name="{Binding [project.newGeneralSession], Source={x:Static loc:Loc.Instance}}">
          <PathIcon Data="{StaticResource IconPlus}" Width="10" Height="10" />
        </Button>
        <Button Grid.Column="2"
                Classes="ghost icon"
                Command="{Binding RefreshCommand}"
                ToolTip.Tip="{Binding [project.refresh], Source={x:Static loc:Loc.Instance}}"
                AutomationProperties.AutomationId="refresh-projects"
                AutomationProperties.Name="{Binding [project.refreshProjectsName], Source={x:Static loc:Loc.Instance}}">
          <PathIcon Data="{StaticResource IconRefresh}" Width="11" Height="11" />
        </Button>
      </Grid>
    </Border>

    <Button Grid.Row="1"
            Classes="primary"
            Margin="8,6"
            HorizontalAlignment="Stretch"
            Content="{Binding [project.addProject], Source={x:Static loc:Loc.Instance}}"
            Command="{Binding AddProjectCommand}"
            AutomationProperties.AutomationId="add-project"
            AutomationProperties.Name="{Binding [project.addProjectName], Source={x:Static loc:Loc.Instance}}" />

    <TextBlock Grid.Row="2"
               Classes="caption"
               Margin="6,4"
               TextWrapping="Wrap"
               IsVisible="{Binding HasStatusText}"
               Text="{Binding StatusText}" />

    <!-- One flat, virtualized row list: expanding or collapsing a row splices only its subtree. -->
    <ListBox x:Name="TreeList"
             Grid.Row="3"
             ItemsSource="{Binding Rows}"
             ItemTemplate="{StaticResource TreeNodeTemplate}"
             Padding="6,4"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             AutomationProperties.AutomationId="project-tree"
             AutomationProperties.Name="{Binding [project.treeName], Source={x:Static loc:Loc.Instance}}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
    </ListBox>
  </Grid>
</UserControl>
