<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wc="using:Forge.App.Workbench.Controls"
        xmlns:views="using:Forge.App.Views">

  <!--
    The chat timeline's presentation (wave W13). One place answers "how thick is the axis, how big is a node, how far is a
    node from the row's top, what colour is each state and how does a running node pulse"; the views only place the gutter.
    Sizes are tokens (Resources/Tokens.axaml), colours are the theme's brushes, so a theme or font change needs nothing here.
  -->

  <Styles.Resources>
    <!-- The left column of one transcript row: the axis with this row's node on it. Both a row with a node (icon between the
         two line segments) and the node-less turn header (one continuous segment through the middle row) use it; a fixed
         top row and icon row mean the node never moves when a segment is hidden. -->
    <ControlTheme x:Key="{x:Type views:TimelineGutter}" TargetType="views:TimelineGutter">
      <Setter Property="Width" Value="{DynamicResource TimelineGutterWidth}" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid RowDefinitions="Auto,Auto,*">
            <Panel Grid.Row="0" Height="{DynamicResource TimelineNodeTopGap}">
              <Border x:Name="PART_TopLine" Classes="timeline-line" IsVisible="{TemplateBinding ShowTopLine}" />
            </Panel>
            <Panel Grid.Row="1"
                   Width="{DynamicResource TimelineNodeSize}"
                   Height="{DynamicResource TimelineNodeSize}"
                   HorizontalAlignment="Left">
              <Border x:Name="PART_MidLine" Classes="timeline-line" IsVisible="False" />
              <Ellipse x:Name="PART_Ring"
                       Classes="timeline-ring"
                       IsVisible="False"
                       IsHitTestVisible="False"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
              <wc:FluentIcon x:Name="PART_Icon"
                             Classes="timeline-node"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
            </Panel>
            <Border x:Name="PART_BottomLine"
                    Grid.Row="2"
                    Classes="timeline-line"
                    IsVisible="{TemplateBinding ShowBottomLine}" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>

  <!-- The axis rides on the left edge of the gutter instead of down its middle: the node is the anchor, the text column keeps
       its full 26 px, and the rail therefore sits 6 px further left than a centred one would. TimelineAxisOffset is the node's
       own centre inside that left-anchored slot, so the segments and the node stay on one line. -->
  <Style Selector="Border.timeline-line">
    <Setter Property="Width" Value="{DynamicResource TimelineAxisWidth}" />
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="{DynamicResource TimelineAxisOffset}" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="wc|FluentIcon.timeline-node">
    <Setter Property="Width" Value="{DynamicResource TimelineNodeSize}" />
    <Setter Property="Height" Value="{DynamicResource TimelineNodeSize}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="wc|FluentIcon.timeline-node.running">
    <Setter Property="Foreground" Value="{DynamicResource BrandActionBrush}" />
  </Style>

  <Style Selector="wc|FluentIcon.timeline-node.failed">
    <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
  </Style>

  <Style Selector="wc|FluentIcon.timeline-node.warning">
    <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
  </Style>

  <!-- The class is only present while motion is allowed (the control drops it when the appearance preference says so), so
       "reduce motion" needs no second selector and stops the pulse the moment the preference changes. -->
  <Style Selector="wc|FluentIcon.timeline-node.pulsing">
    <Style.Animations>
      <Animation Duration="0:0:1.2" IterationCount="INFINITE" Easing="SineEaseInOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="0.3" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- The ring behind a node: invisible by default, shown by the control only for a running reasoning stretch (thinking) or a
       node that waits for the user (waiting; still = the same ring without motion). Stroke is the non-text brand tier. -->
  <Style Selector="Ellipse.timeline-ring">
    <Setter Property="Width" Value="{DynamicResource TimelineNodeSize}" />
    <Setter Property="Height" Value="{DynamicResource TimelineNodeSize}" />
    <Setter Property="Stroke" Value="{DynamicResource BrandInteractiveBrush}" />
    <Setter Property="StrokeThickness" Value="1.5" />
  </Style>

  <Style Selector="Ellipse.timeline-ring.still">
    <Setter Property="Opacity" Value="0.8" />
    <Setter Property="Width" Value="18.9" />
    <Setter Property="Height" Value="18.9" />
  </Style>

  <Style Selector="Ellipse.timeline-ring.waiting">
    <Style.Animations>
      <Animation Duration="0:0:1.4" IterationCount="INFINITE" Easing="CubicEaseOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.9" />
          <Setter Property="Width" Value="11.2" />
          <Setter Property="Height" Value="11.2" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="Width" Value="26.6" />
          <Setter Property="Height" Value="26.6" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Ellipse.timeline-ring.thinking">
    <Style.Animations>
      <Animation Duration="0:0:1.8" IterationCount="INFINITE" Easing="SineEaseInOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.15" />
          <Setter Property="Width" Value="14" />
          <Setter Property="Height" Value="14" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="0.85" />
          <Setter Property="Width" Value="21" />
          <Setter Property="Height" Value="21" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.15" />
          <Setter Property="Width" Value="14" />
          <Setter Property="Height" Value="14" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
