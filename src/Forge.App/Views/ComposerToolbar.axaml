<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wc="using:Forge.App.Workbench.Controls"
             xmlns:loc="using:Forge.App.Localization"
             xmlns:vm="using:Forge.App.ViewModels"
             xmlns:views="using:Forge.App.Views"
             x:Class="Forge.App.Views.ComposerToolbar"
             x:DataType="vm:ComposerViewModel">
  <!-- The composer's three pickers, side by side: agent, model (with effort) and the per-message orchestration. Each is a chip that
       opens a picker; DataContext is the session's ComposerViewModel. The Flyout elements only hold the picker content: the code-behind
       moves it into a PickerPopup that stays in the overlay layer (a real flyout re-attaches its content on every open, which was the lag). -->
  <StackPanel Orientation="Horizontal">
    <Button x:Name="AgentChip"
            Classes="composer-chip"
            AutomationProperties.AutomationId="composer-agent"
            AutomationProperties.Name="{Binding [session.composer.agent], Source={x:Static loc:Loc.Instance}}"
            ToolTip.Tip="{Binding [session.composer.agentTooltip], Source={x:Static loc:Loc.Instance}}">
      <StackPanel Orientation="Horizontal" Spacing="5">
        <wc:FluentIcon Data="{StaticResource IconSparkle}" Width="14" Height="14" />
        <TextBlock Text="{Binding AgentLabel}" VerticalAlignment="Center" />
        <wc:FluentIcon Data="{DynamicResource IconChevronDown}" Width="12" Height="12" />
      </StackPanel>
      <Button.Flyout>
        <Flyout Placement="TopEdgeAlignedLeft">
          <ItemsControl ItemsSource="{Binding Agents}"
                        MinWidth="260"
                        AutomationProperties.AutomationId="composer-agent-list">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ComposerAgentOption">
                <views:PickerRow Command="{Binding SelectCommand}"
                        Click="OnAgentPicked"
                        IsEnabled="{Binding IsAvailable}"
                        Opacity="{Binding Opacity}"
                        ToolTip.ShowOnDisabled="True"
                        ToolTip.Tip="{Binding UnavailableReason}"
                        AutomationProperties.Name="{Binding Name}">
                  <Grid ColumnDefinitions="18,*">
                    <wc:FluentIcon Data="{StaticResource IconCheck}"
                                   Width="12"
                                   Height="12"
                                   IsVisible="{Binding IsSelected}"
                                   Foreground="{DynamicResource BrandActionBrush}"
                                   VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                      <TextBlock Classes="caption"
                                 Text="{Binding Description}"
                                 MaxWidth="300"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </views:PickerRow>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Flyout>
      </Button.Flyout>
    </Button>

    <Button x:Name="ModelChip"
            Margin="4,0,0,0"
            Classes="composer-chip"
            IsEnabled="{Binding HasModel}"
            AutomationProperties.AutomationId="composer-model"
            AutomationProperties.Name="{Binding ModelLabel}"
            ToolTip.Tip="{Binding [session.composer.modelTooltip], Source={x:Static loc:Loc.Instance}}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="{Binding ModelLabel}"
                   MaxWidth="220"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
        <ItemsControl ItemsSource="{Binding EffortBars}"
                      VerticalAlignment="Center"
                      Height="10">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="1.5" VerticalAlignment="Bottom" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ComposerEffortBarViewModel">
              <Rectangle Classes="effort-bar" Height="{Binding Height}" Opacity="{Binding Opacity}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <wc:FluentIcon Data="{DynamicResource IconChevronDown}" Width="12" Height="12" />
      </StackPanel>
      <Button.Flyout>
        <Flyout Placement="TopEdgeAlignedLeft">
          <StackPanel Width="410" Spacing="6" AutomationProperties.AutomationId="composer-model-panel">
            <TextBox x:Name="ModelSearch"
                     Text="{Binding ModelSearch, Mode=TwoWay}"
                     PlaceholderText="{Binding [session.composer.searchModels], Source={x:Static loc:Loc.Instance}}"
                     AutomationProperties.AutomationId="composer-model-search"
                     AutomationProperties.Name="{Binding [session.composer.searchModels], Source={x:Static loc:Loc.Instance}}" />
            <!-- Virtualized: the catalogue is ~180 rows, and only the ~8 that fit are ever built. -->
            <ItemsControl ItemsSource="{Binding Models}"
                            MaxHeight="220"
                            AutomationProperties.AutomationId="composer-model-list">
                <ItemsControl.Template>
                  <ControlTemplate>
                    <!-- The right padding is the scroll bar's own strip: the bar is drawn over the ScrollViewer's edge, so without
                         it a thin bar sits on top of the row's pin star. -->
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
                      <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </ScrollViewer>
                  </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                  <!-- A provider group: the tree's own chevron, so expanding here reads like expanding a folder. The pinned
                       section reuses the header without the chevron, count or toggle. -->
                  <DataTemplate DataType="{x:Type vm:ComposerModelGroupOption}" x:DataType="vm:ComposerModelGroupOption">
                    <views:PickerRow Classes="picker-row model-group"
                                     Classes.section="{Binding IsSection}"
                                     Command="{Binding ToggleCommand}"
                                     AutomationProperties.Name="{Binding Name}">
                      <Grid ColumnDefinitions="18,*,Auto">
                        <wc:FluentIcon Data="{StaticResource TreeChevronGeometry}"
                                       Classes="tree-chevron"
                                       Rotated="{Binding IsExpanded}"
                                       IsVisible="{Binding !IsSection}"
                                       Width="12"
                                       Height="12" />
                        <TextBlock Grid.Column="1"
                                   Classes="model-group-name"
                                   Text="{Binding Name}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Margin="8,0,0,0"
                                   Classes="caption"
                                   IsVisible="{Binding !IsSection}"
                                   Text="{Binding Count}"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </views:PickerRow>
                  </DataTemplate>
                  <DataTemplate DataType="{x:Type vm:ComposerModelOption}" x:DataType="vm:ComposerModelOption">
                    <Border Classes="model-row">
                      <Grid ColumnDefinitions="*,Auto">
                        <views:PickerRow Command="{Binding SelectCommand}"
                                Click="OnModelPicked"
                                AutomationProperties.Name="{Binding Label}">
                          <Grid ColumnDefinitions="18,*,Auto,Auto">
                            <wc:FluentIcon Data="{StaticResource IconCheck}"
                                           Width="12"
                                           Height="12"
                                           IsVisible="{Binding IsSelected}"
                                           Foreground="{DynamicResource BrandActionBrush}"
                                           VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Classes="model-name"
                                       Text="{Binding Label}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <wc:FluentIcon Grid.Column="2"
                                           Data="{StaticResource IconChat}"
                                           Margin="8,0,0,0"
                                           Width="12"
                                           Height="12"
                                           IsVisible="{Binding IsDefaultModel}"
                                           Foreground="{DynamicResource BrandActionBrush}"
                                           VerticalAlignment="Center"
                                           ToolTip.Tip="{Binding [session.composer.defaultModel], Source={x:Static loc:Loc.Instance}}" />
                            <TextBlock Grid.Column="3"
                                       Margin="6,0,0,0"
                                       Classes="model-price"
                                       IsVisible="{Binding HasPriceText}"
                                       Text="{Binding PriceText}"
                                       VerticalAlignment="Center" />
                          </Grid>
                        </views:PickerRow>
                        <views:PickerRow Grid.Column="1"
                                         Classes="pin"
                                         Command="{Binding TogglePinCommand}"
                                         AutomationProperties.Name="{Binding [session.composer.pin], Source={x:Static loc:Loc.Instance}}"
                                         ToolTip.Tip="{Binding [session.composer.pin], Source={x:Static loc:Loc.Instance}}">
                          <Panel>
                            <wc:FluentIcon Data="{StaticResource IconPin}"
                                           Classes="pin-icon"
                                           Width="12"
                                           Height="12"
                                           IsVisible="{Binding !IsPinned}" />
                            <wc:FluentIcon Data="{StaticResource IconPinSolid}"
                                           Classes="pin-icon pinned"
                                           Width="12"
                                           Height="12"
                                           IsVisible="{Binding IsPinned}" />
                          </Panel>
                        </views:PickerRow>
                        <!-- The row's light rule, drawn as an inset rectangle so it can start at the name's edge and still run
                             under the pin to the row's end; the border itself stays bare so the hover fill owns the whole row. -->
                        <Rectangle Classes="model-row-rule" Grid.ColumnSpan="2" />
                      </Grid>
                    </Border>
                </DataTemplate>
              </ItemsControl.DataTemplates>
            </ItemsControl>
            <TextBlock Classes="caption"
                       Margin="26,0"
                       IsVisible="{Binding HasNoModels}"
                       Text="{Binding [session.composer.noModels], Source={x:Static loc:Loc.Instance}}" />
            <!-- One left edge for the whole popup: the model id name's (26 px = the row's 8 px padding + the 18 px check
                 column). The row rules, the section separators, the effort title, the captions and the footer buttons'
                 text all start there; the dial's own track keeps its thumb-radius insets, which are geometry, not text. -->
            <Separator Margin="26,2" />
            <!-- The effort track: the gradient itself is the scale (light = least, deep = most), so the whole bar stays
                 visible and only the thumb marks the chosen step. The ticks under it are the steps this model accepts,
                 one label each, the chosen one inked. -->
            <StackPanel Margin="8,0" Spacing="5">
              <TextBlock Classes="effort-title"
                         Margin="18,0,0,0"
                         Text="{Binding [session.composer.effort], Source={x:Static loc:Loc.Instance}}" />
              <Panel>
                <Border Classes="effort-track" />
                <!-- The stops themselves, drawn as notches in the bar: two pixels of the popup surface, so each step reads as a
                     position on the scale rather than as a number the gradient only hints at. Same panel and inset as the labels
                     row below, which is what keeps the two lined up. -->
                <ItemsControl Classes="effort-notches"
                              ItemsSource="{Binding EffortTicks}"
                              IsHitTestVisible="False"
                              AutomationProperties.AutomationId="composer-effort-notches">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <views:EffortTickPanel Margin="8,0" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ComposerEffortTickViewModel">
                      <Border Classes="effort-notch" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Slider Classes="effort"
                        Minimum="0"
                        Maximum="{Binding EffortMaximum, Mode=OneWay}"
                        SmallChange="1"
                        LargeChange="1"
                        Value="{Binding EffortValue, Mode=TwoWay}"
                        PointerReleased="OnEffortReleased"
                        PointerCaptureLost="OnEffortReleased"
                        AutomationProperties.AutomationId="composer-effort"
                        AutomationProperties.Name="{Binding [session.composer.effort], Source={x:Static loc:Loc.Instance}}"
                        AutomationProperties.HelpText="{Binding EffortName}" />
              </Panel>
              <ItemsControl ItemsSource="{Binding EffortTicks}"
                            AutomationProperties.AutomationId="composer-effort-ticks">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <!-- Inset by the thumb's radius (16 px thumb, see Slider.effort in Views/ComposerStyles): the row's ends are
                         then the dial's first and last stops, so EffortTickPanel puts each label under its own notch. -->
                    <views:EffortTickPanel Margin="8,0" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ComposerEffortTickViewModel">
                    <Border Classes="effort-tick"
                            Classes.selected="{Binding IsSelected}"
                            ToolTip.Tip="{Binding Name}">
                      <TextBlock Text="{Binding Name}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <Separator Margin="26,2" />
            <!-- One row, two ends: refreshing the catalogue on the left, saving this pick as the new-session default on
                 the right. Same weight for both — neither is the popup's primary action. -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,0">
              <Button Classes="composer-row outlined"
                      Command="{Binding RefreshCommand}"
                      AutomationProperties.AutomationId="composer-refresh">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <wc:FluentIcon Data="{DynamicResource IconRefresh}" Width="12" Height="12" />
                  <TextBlock Text="{Binding [session.composer.refresh], Source={x:Static loc:Loc.Instance}}" />
                </StackPanel>
              </Button>
              <Button Grid.Column="2"
                      Classes="composer-row outlined"
                      Command="{Binding SaveDefaultsCommand}"
                      AutomationProperties.AutomationId="composer-save-defaults">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <wc:FluentIcon Data="{DynamicResource IconSave}" Width="12" Height="12" />
                  <TextBlock Text="{Binding [session.composer.saveDefaults], Source={x:Static loc:Loc.Instance}}" />
                </StackPanel>
              </Button>
            </Grid>
            <TextBlock Classes="caption"
                       Margin="26,0"
                       IsVisible="{Binding HasStatus}"
                       Text="{Binding Status}" />
          </StackPanel>
        </Flyout>
      </Button.Flyout>
    </Button>

  <Button x:Name="OrchestrationChip"
          Margin="4,0,0,0"
          Classes="composer-chip"
          IsVisible="{Binding !IsAgentSession}"
          AutomationProperties.AutomationId="composer-orchestration"
          AutomationProperties.Name="{Binding [session.composer.orchestration], Source={x:Static loc:Loc.Instance}}"
          ToolTip.Tip="{Binding [session.composer.orchestrationHint], Source={x:Static loc:Loc.Instance}}">
    <StackPanel Orientation="Horizontal" Spacing="5">
      <wc:FluentIcon Data="{DynamicResource IconBranchCompare}" Width="14" Height="14" />
      <TextBlock Text="{Binding OrchestrationLabel}"
                 MaxWidth="140"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" />
      <wc:FluentIcon Data="{DynamicResource IconChevronDown}" Width="12" Height="12" />
    </StackPanel>
    <Button.Flyout>
      <Flyout Placement="TopEdgeAlignedLeft">
        <StackPanel Width="300" Spacing="4" AutomationProperties.AutomationId="composer-orchestration-panel">
          <StackPanel Margin="2,0,2,2" Spacing="1">
            <TextBlock Classes="label" Text="{Binding [session.composer.orchestration], Source={x:Static loc:Loc.Instance}}" />
            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       Text="{Binding [session.composer.orchestrationHint], Source={x:Static loc:Loc.Instance}}" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Orchestrations}"
                        AutomationProperties.AutomationId="composer-orchestration-list">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ComposerOrchestrationOption">
                <views:PickerRow Command="{Binding SelectCommand}"
                        Click="OnOrchestrationPicked"
                        AutomationProperties.Name="{Binding Name}">
                  <Grid ColumnDefinitions="18,*">
                    <wc:FluentIcon Data="{StaticResource IconCheck}"
                                   Width="12"
                                   Height="12"
                                   IsVisible="{Binding IsSelected}"
                                   Foreground="{DynamicResource BrandActionBrush}"
                                   VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                      <TextBlock Classes="caption"
                                 Text="{Binding Description}"
                                 MaxLines="2"
                                 TextTrimming="CharacterEllipsis"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </views:PickerRow>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Flyout>
    </Button.Flyout>
  </Button>
  </StackPanel>
</UserControl>
