<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Forge.App.Workbench.Controls"
                    xmlns:vm="using:Forge.App.ViewModels"
                    xmlns:loc="using:Forge.App.Localization">

  <!-- Workbench chrome icons (same line family as the token geometries: strokes on a 24x24 grid). -->
  <!-- A pushpin, two states of one button. The outline version means "this panel is auto-hidden" (clicking docks it
       back); the solid silhouette below means "this panel is docked" (clicking auto-hides it). The tooltip is the
       same word in both states — the button is named after the thing it does to the region, not after its state. -->
  <StreamGeometry x:Key="IconPin">M9 4h6M10 4v5l-3 3v2h10v-2l-3-3V4M12 14v6</StreamGeometry>
  <!-- The same pushpin as a closed silhouette, drawn to be filled: head bar, body with its plate, and the needle. -->
  <StreamGeometry x:Key="IconPinSolid">M9 3.5h6v1.5H9zM10 5h4v6h3v3H7v-3h3zM11.4 14h1.2v6.5h-1.2z</StreamGeometry>
  <!-- Four corner brackets: spread the preview group over the whole Main region. -->
  <StreamGeometry x:Key="IconCoverMain">M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5</StreamGeometry>
  <!-- A frame with an arrow pointing into it: dock the floating window back. -->
  <StreamGeometry x:Key="IconDockBack">M6 4h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM16 12H8M11 9l-3 3 3 3</StreamGeometry>

  <!-- Title-bar tools of the model: a PanelToolButton renders as an icon button, every other item keeps its own template. -->
  <controls:HeaderToolTemplate x:Key="WorkbenchHeaderToolTemplate" />

  <!-- A 20x20 transparent icon button; the icon is a 12 px geometry. A closed-path icon renders solid when
       IsIconFilled is set: the fill follows the same brush as the stroke, including on hover. -->
  <ControlTheme x:Key="{x:Type controls:PanelIconButton}" TargetType="controls:PanelIconButton">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Background"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <controls:LineIcon Width="14"
                    Height="14"
                    Data="{TemplateBinding Icon}"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Background">
      <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
    </Style>
    <Style Selector="^:pointerover /template/ controls|LineIcon">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="^[IsIconFilled=True] /template/ controls|LineIcon">
      <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
      <!-- No stroke: a solid icon is its silhouette, and the fixed 1.25 px stroke would fatten small shapes into blobs. -->
      <Setter Property="StrokeThickness" Value="0" />
    </Style>
    <Style Selector="^[IsIconFilled=True]:pointerover /template/ controls|LineIcon">
      <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Background">
      <Setter Property="Background" Value="{DynamicResource IconButtonPressedBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Background">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </ControlTheme>

  <!-- A dock-strip tab: 34 px across the 40 px strip (indicator bar, gaps and separator take the rest), as long as its rotated title needs. -->
  <ControlTheme x:Key="{x:Type controls:AutoHideButton}" TargetType="controls:AutoHideButton">
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Background"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Background">
      <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Background">
      <Setter Property="Background" Value="{DynamicResource IconButtonPressedBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Background">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </ControlTheme>

  <!-- One tab, Visual Studio tool-window style: an inactive tab is plain, centred, muted text on the title bar; the active
       tab is a 1 px frame with rounded top corners, filled with the panel body's colour and standing on the title bar's
       bottom line so it merges with the body below. Only the active tab shows its close button. -->
  <ControlTheme x:Key="{x:Type controls:TabHeaderView}" TargetType="controls:TabHeaderView">
    <Setter Property="Height" Value="25" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="1,1,1,0"
                CornerRadius="4,4,0,0"
                Padding="12,0,4,0">
          <Grid ColumnDefinitions="Auto,Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Name="PART_Label"
                       Grid.Column="0"
                       Text="{TemplateBinding TabTitle}"
                       FontSize="{DynamicResource FontSizeMd}"
                       FontWeight="SemiBold"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="180"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <controls:PanelIconButton Name="PART_Close"
                                      Grid.Column="1"
                                      Width="16"
                                      Height="16"
                                      Margin="6,0,0,0"
                                      VerticalAlignment="Center"
                                      Icon="{DynamicResource IconClose}"
                                      IsVisible="{TemplateBinding IsClosable}"
                                      ToolTip.Tip="{Binding [workbench.closeTab], Source={x:Static loc:Loc.Instance}}"
                                      AutomationProperties.AutomationId="{TemplateBinding CloseAutomationId}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ controls|PanelIconButton#PART_Close">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <!-- A tab without a close box has no slot to reserve, so its label gets equal padding on both sides and lands on the
         tab's centre. A closable tab keeps 12/4: the 16 px slot plus its gap sit on the right and the label is centred
         with them. -->
    <Style Selector="^[IsClosable=False] /template/ Border#PART_Root">
      <Setter Property="Padding" Value="12,0,12,0" />
    </Style>
    <Style Selector="^:pointerover /template/ TextBlock#PART_Label">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="ZIndex" Value="1" />
    </Style>
    <Style Selector="^:selected /template/ Border#PART_Root">
      <Setter Property="Background" Value="{Binding $parent[controls:PanelChrome].Background}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="^:selected /template/ controls|PanelIconButton#PART_Close, ^:pointerover /template/ controls|PanelIconButton#PART_Close">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="^:selected /template/ TextBlock#PART_Label">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Root">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
  </ControlTheme>

  <!-- The tab strip itself: horizontal and scrollable, no scrollbars in a title bar. Once the tabs no longer fit, an
       ellipsis button sits in a column of its own at the right edge and lists the ones the strip had to clip. The column
       is Auto-sized and its child is collapsed while there is no overflow, so the button only takes width once the
       strip is already too narrow — a hidden button reserves nothing, a shown one keeps the tabs off itself, and the
       decision cannot oscillate (showing it narrows the viewport, which never un-clips a tab). -->
  <ControlTheme x:Key="{x:Type controls:PanelTabStrip}" TargetType="controls:PanelTabStrip">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="*,Auto">
          <ScrollViewer Name="PART_Scroller"
                        Grid.Column="0"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
            <StackPanel Name="PART_Tabs" Orientation="Horizontal" VerticalAlignment="Stretch" Margin="4,0,0,0" />
          </ScrollViewer>
          <Border Name="PART_OverflowHost"
                  Grid.Column="1"
                  Width="26"
                  VerticalAlignment="Stretch"
                  IsVisible="{TemplateBinding HasOverflow}">
            <controls:PanelIconButton Name="PART_Overflow"
                                      Width="20"
                                      Height="20"
                                      Margin="0,0,3,0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Icon="{DynamicResource IconEllipsisSolid}"
                                      IsIconFilled="True"
                                      ToolTip.Tip="{Binding [workbench.moreTabs], Source={x:Static loc:Loc.Instance}}"
                                      AutomationProperties.Name="{Binding [workbench.moreTabs], Source={x:Static loc:Loc.Instance}}" />
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- A panel: 28 px title bar over the body. Background is the body colour (white in Main, the sidebar grey at the
       sides); the active tab borrows it so it merges with the body. The title bar's bottom line is drawn under the tab
       strip, so the active tab covers it. Every panel, in every region, wears the same chrome colour. -->
  <ControlTheme x:Key="{x:Type controls:PanelChrome}" TargetType="controls:PanelChrome">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Body" Background="{TemplateBinding Background}" ClipToBounds="True">
          <Grid RowDefinitions="28,*">
            <Border Name="PART_TitleBar"
                    Grid.Row="0"
                    Height="28"
                    Background="{DynamicResource PanelTitleBarBrush}">
              <Grid ColumnDefinitions="*,Auto">
                <Border Grid.ColumnSpan="2"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource BorderBrush}" />
                <TextBlock Name="PART_Title"
                           Grid.Column="0"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeMd}"
                           FontWeight="SemiBold"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           IsVisible="{TemplateBinding ShowTitle}"
                           Text="{TemplateBinding HeaderTitle}" />
                <controls:PanelTabStrip Name="PART_TabStrip"
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        IsVisible="{TemplateBinding ShowTabStrip}"
                                        Group="{TemplateBinding TabGroup}"
                                        Layout="{TemplateBinding Layout}" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="1"
                            Margin="0,0,4,0">
                  <ItemsControl ItemsSource="{TemplateBinding HeaderTools}"
                                ItemTemplate="{StaticResource WorkbenchHeaderToolTemplate}"
                                VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="2" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <controls:PanelIconButton Name="PART_Cover"
                                            IsVisible="{TemplateBinding CoverVisible}"
                                            Icon="{TemplateBinding CoverIcon}"
                                            ToolTip.Tip="{TemplateBinding CoverTooltip}"
                                            AutomationProperties.Name="{TemplateBinding CoverTooltip}"
                                            AutomationProperties.AutomationId="{TemplateBinding CoverAutomationId}" />
                  <controls:PanelIconButton Name="PART_Pin"
                                            IsVisible="{TemplateBinding PinVisible}"
                                            Icon="{TemplateBinding PinIcon}"
                                            IsIconFilled="{TemplateBinding PinFilled}"
                                            ToolTip.Tip="{TemplateBinding PinTooltip}"
                                            AutomationProperties.Name="{TemplateBinding PinTooltip}"
                                            AutomationProperties.AutomationId="{TemplateBinding PinAutomationId}" />
                  <controls:PanelIconButton Name="PART_Minimize"
                                            IsVisible="{TemplateBinding MinimizeVisible}"
                                            Icon="{TemplateBinding MinimizeIcon}"
                                            ToolTip.Tip="{TemplateBinding MinimizeTooltip}"
                                            AutomationProperties.Name="{TemplateBinding MinimizeTooltip}"
                                            AutomationProperties.AutomationId="{TemplateBinding MinimizeAutomationId}" />
                  <controls:PanelIconButton Name="PART_Float"
                                            IsVisible="{TemplateBinding FloatVisible}"
                                            Icon="{TemplateBinding FloatIcon}"
                                            ToolTip.Tip="{TemplateBinding FloatTooltip}"
                                            AutomationProperties.Name="{TemplateBinding FloatTooltip}"
                                            AutomationProperties.AutomationId="{TemplateBinding FloatAutomationId}" />
                  <controls:PanelIconButton Name="PART_Close"
                                            IsVisible="{TemplateBinding CloseVisible}"
                                            Icon="{TemplateBinding CloseIcon}"
                                            ToolTip.Tip="{TemplateBinding CloseTooltip}"
                                            AutomationProperties.Name="{TemplateBinding CloseTooltip}"
                                            AutomationProperties.AutomationId="{TemplateBinding CloseAutomationId}" />
                </StackPanel>
              </Grid>
            </Border>
            <ContentControl Name="PART_Content" Grid.Row="1"
                            Content="{TemplateBinding Body}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            ClipToBounds="True" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:sidebar">
      <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
    </Style>
    <Style Selector="^:minimized /template/ ContentControl#PART_Content">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>

  <!-- The 1 px splitter between two docked regions: a 6 px hit band with the line centred in it. -->
  <ControlTheme x:Key="{x:Type controls:RegionSplitter}" TargetType="controls:RegionSplitter">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent">
          <Border Name="PART_Line"
                  Width="1"
                  HorizontalAlignment="Center"
                  Background="{DynamicResource BorderBrush}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Line">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="^:dragging /template/ Border#PART_Line">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
  </ControlTheme>

  <!-- The 1 px splitter between two panels; vertical for the preview column, horizontal elsewhere. -->
  <ControlTheme x:Key="{x:Type controls:PanelSplitter}" TargetType="controls:PanelSplitter">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent">
          <Border Name="PART_Line"
                  Width="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Stretch"
                  Background="{DynamicResource BorderBrush}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^[IsVertical=False] /template/ Border#PART_Line">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Height" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_Line">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="^:dragging /template/ Border#PART_Line">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
