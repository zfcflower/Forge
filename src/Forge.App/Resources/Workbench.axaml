<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Forge.App.Workbench.Controls"
                    xmlns:vm="using:Forge.App.ViewModels"
                    xmlns:loc="using:Forge.App.Localization">

  <!-- 图标(图钉、撑满主区、停靠回来)都在 Resources/Icons.axaml,这里不再有几何定义。 -->

  <!-- Title-bar tools of the model: a PanelToolButton renders as an icon button, every other item keeps its own template. -->
  <controls:HeaderToolTemplate x:Key="WorkbenchHeaderToolTemplate" />

  <!-- A transparent icon button that sizes itself to its icon: a 14 px icon inside 2 px of padding is the 20x20 minimum
       title-bar button, and a 24 px icon makes a 28 px one, exactly the height of the panel title bar. Icons are filled
       Fluent System Icons, so a solid state is the `_filled` variant of the same glyph rather than a fill switch. -->
  <ControlTheme x:Key="{x:Type controls:PanelIconButton}" TargetType="controls:PanelIconButton">
    <Setter Property="Padding" Value="2" />
    <Setter Property="MinWidth" Value="20" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Background"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <controls:FluentIcon Name="PART_Icon"
                               Data="{TemplateBinding Icon}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Background">
      <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
    </Style>
    <Style Selector="^:pointerover /template/ controls|FluentIcon">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <!-- The accent tool: green at rest, deeper on hover, so the title bar's one primary action reads as a button and not as an
         outlined icon. Declared after the plain hover rule, which would otherwise win on an equal selector. -->
    <Style Selector="^[IsAccent=True] /template/ controls|FluentIcon">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="^[IsAccent=True]:pointerover /template/ controls|FluentIcon">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Background">
      <Setter Property="Background" Value="{DynamicResource IconButtonPressedBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Background">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </ControlTheme>

  <!-- A dock-strip tab: 34 px across the 40 px strip (indicator bar, gaps and separator take the rest), as long as its rotated title needs. -->
  <ControlTheme x:Key="{x:Type controls:AutoHideButton}" TargetType="controls:AutoHideButton">
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Background"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Background">
      <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Background">
      <Setter Property="Background" Value="{DynamicResource IconButtonPressedBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Background">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </ControlTheme>

  <!-- One tab, Visual Studio tool-window style: an inactive tab is plain, centred, muted text on the title bar; the active
       tab is a 1 px frame with rounded top corners, filled with the panel body's colour, standing on the title bar's bottom
       line so it merges with the body below, and — where its two sides reach that line — turning outward through a 5 px
       fillet into the body, so the bottom corners round away from the label instead of ending on a square step. The
       fillet's inner edge stays concentric with its outer edge, so the frame is a true 1 px through the whole curve, and
       near each tip a short tangent-matched curve blends the divider row into the inner arc just outside the tab bounds.
       This keeps the visible straight run short, avoids a sharp join, and draws no horizontal border back into the tab.
       The body fill covers the divider beneath the tab; the frame meets the exposed divider at the outside foot. The frame
       and fill are drawn by TabHeaderView itself (a border can only round a corner inward); the template's
       border keeps its 1 px thickness only to keep the label's box the same size. Only the active tab shows its close
       button. -->
  <ControlTheme x:Key="{x:Type controls:TabHeaderView}" TargetType="controls:TabHeaderView">
    <!-- The foot is intentionally drawn 5 px outside this tab's rectangular slot; TemplatedControl clips its own render by default. -->
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Height" Value="25" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="1"
                Padding="12,0,4,0">
          <Grid ColumnDefinitions="Auto,Auto,Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- One leading glyph, chosen per kind by the header itself: the conversation's chat bubble (filled while the
                 tab is active), the file tree's document for a file preview. -->
            <controls:FluentIcon Name="PART_Icon"
                                 Grid.Column="0"
                                 Data="{TemplateBinding Icon}"
                                 Width="14"
                                 Height="14"
                                 Margin="0,0,5,0"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextMutedBrush}"
                                 IsVisible="{TemplateBinding IsIconVisible}" />
            <TextBlock Name="PART_Label"
                       Grid.Column="1"
                       Text="{TemplateBinding TabTitle}"
                       FontSize="{DynamicResource FontSizeBase}"
                       FontWeight="Normal"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="180"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <controls:PanelIconButton Name="PART_Close"
                                      Grid.Column="2"
                                      Width="16"
                                      Height="16"
                                      Margin="6,0,0,0"
                                      VerticalAlignment="Center"
                                      Icon="{DynamicResource IconClose}"
                                      IsVisible="{TemplateBinding IsClosable}"
                                      ToolTip.Tip="{Binding [workbench.closeTab], Source={x:Static loc:Loc.Instance}}"
                                      AutomationProperties.AutomationId="{TemplateBinding CloseAutomationId}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ controls|PanelIconButton#PART_Close">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <!-- A tab without a close box has no slot to reserve, so its label gets equal padding on both sides and lands on the
         tab's centre. A closable tab keeps 12/4: the 16 px slot plus its gap sit on the right and the label is centred
         with them. -->
    <Style Selector="^[IsClosable=False] /template/ Border#PART_Root">
      <Setter Property="Padding" Value="12,0,12,0" />
    </Style>
    <Style Selector="^:pointerover /template/ TextBlock#PART_Label">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="ZIndex" Value="1" />
      <Setter Property="Background" Value="{Binding $parent[controls:PanelChrome].Background}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <!-- The frame the render draws follows BorderBrush, so focus only has to recolour it; an inactive tab has no fill but
         still shows the accent frame while it holds the keyboard. -->
    <Style Selector="^:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="^:selected /template/ controls|PanelIconButton#PART_Close, ^:pointerover /template/ controls|PanelIconButton#PART_Close">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="^:selected /template/ TextBlock#PART_Label">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <!-- The tab's leading glyph follows the label's colour; which glyph it is (and whether it turns filled) is the
         header's business, so nothing here touches IsVisible or Data. -->
    <Style Selector="^:pointerover /template/ controls|FluentIcon#PART_Icon">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="^:selected /template/ controls|FluentIcon#PART_Icon">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
  </ControlTheme>

  <!-- The tab strip itself: horizontal and scrollable, no scrollbars in a title bar. Once the tabs no longer fit, an
       ellipsis button sits in a column of its own at the right edge and lists the ones the strip had to clip. The column
       is Auto-sized and its child is collapsed while there is no overflow, so the button only takes width once the
       strip is already too narrow — a hidden button reserves nothing, a shown one keeps the tabs off itself, and the
       decision cannot oscillate (showing it narrows the viewport, which never un-clips a tab). -->
  <ControlTheme x:Key="{x:Type controls:PanelTabStrip}" TargetType="controls:PanelTabStrip">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="*,Auto">
          <ScrollViewer Name="PART_Scroller"
                        Grid.Column="0"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
            <!-- Let an active tab's outward feet paint into its neighbours' slots; ScrollViewer remains the viewport clip. -->
            <StackPanel Name="PART_Tabs" Orientation="Horizontal" VerticalAlignment="Stretch" Margin="5,0,5,0" ClipToBounds="False" />
          </ScrollViewer>
          <Border Name="PART_OverflowHost"
                  Grid.Column="1"
                  Width="26"
                  VerticalAlignment="Stretch"
                  IsVisible="{TemplateBinding HasOverflow}">
            <controls:PanelIconButton Name="PART_Overflow"
                                      Width="20"
                                      Height="20"
                                      Margin="0,0,3,0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Icon="{DynamicResource IconEllipsisSolid}"
                                      ToolTip.Tip="{Binding [workbench.moreTabs], Source={x:Static loc:Loc.Instance}}"
                                      AutomationProperties.Name="{Binding [workbench.moreTabs], Source={x:Static loc:Loc.Instance}}" />
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- A panel: 28 px title bar over the body. Background is the body colour (white in Main, the sidebar grey at the
       sides); the active tab borrows it so it merges with the body. The title bar's bottom line is drawn under the tab
       strip, so the active tab covers it. Every panel, in every region, wears the same chrome colour. -->
  <ControlTheme x:Key="{x:Type controls:PanelChrome}" TargetType="controls:PanelChrome">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Body" Background="{TemplateBinding Background}" ClipToBounds="True">
          <Grid RowDefinitions="28,*">
            <Border Name="PART_TitleBar"
                    Grid.Row="0"
                    Height="28"
                    Background="{DynamicResource PanelTitleBarBrush}">
              <Grid ColumnDefinitions="*,Auto">
                <Border Grid.ColumnSpan="2"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource BorderBrush}" />
                <TextBlock Name="PART_Title"
                           Grid.Column="0"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeMd}"
                           FontWeight="Bold"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           IsVisible="{TemplateBinding ShowTitle}"
                           Text="{TemplateBinding HeaderTitle}" />
                <controls:PanelTabStrip Name="PART_TabStrip"
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        IsVisible="{TemplateBinding ShowTabStrip}"
                                        Group="{TemplateBinding TabGroup}"
                                        Layout="{TemplateBinding Layout}" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="1"
                            Margin="0,0,4,0">
                  <ItemsControl ItemsSource="{TemplateBinding HeaderTools}"
                                ItemTemplate="{StaticResource WorkbenchHeaderToolTemplate}"
                                VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="2" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <controls:PanelIconButton Name="PART_Cover"
                                            IsVisible="{TemplateBinding CoverVisible}"
                                            Icon="{TemplateBinding CoverIcon}"
                                            ToolTip.Tip="{TemplateBinding CoverTooltip}"
                                            AutomationProperties.Name="{TemplateBinding CoverTooltip}"
                                            AutomationProperties.AutomationId="{TemplateBinding CoverAutomationId}" />
                  <controls:PanelIconButton Name="PART_Pin"
                                            IsVisible="{TemplateBinding PinVisible}"
                                            Icon="{TemplateBinding PinIcon}"
                                            ToolTip.Tip="{TemplateBinding PinTooltip}"
                                            AutomationProperties.Name="{TemplateBinding PinTooltip}"
                                            AutomationProperties.AutomationId="{TemplateBinding PinAutomationId}" />
                  <controls:PanelIconButton Name="PART_Minimize"
                                            IsVisible="{TemplateBinding MinimizeVisible}"
                                            Icon="{TemplateBinding MinimizeIcon}"
                                            ToolTip.Tip="{TemplateBinding MinimizeTooltip}"
                                            AutomationProperties.Name="{TemplateBinding MinimizeTooltip}"
                                            AutomationProperties.AutomationId="{TemplateBinding MinimizeAutomationId}" />
                  <controls:PanelIconButton Name="PART_Float"
                                            IsVisible="{TemplateBinding FloatVisible}"
                                            Icon="{TemplateBinding FloatIcon}"
                                            ToolTip.Tip="{TemplateBinding FloatTooltip}"
                                            AutomationProperties.Name="{TemplateBinding FloatTooltip}"
                                            AutomationProperties.AutomationId="{TemplateBinding FloatAutomationId}" />
                  <controls:PanelIconButton Name="PART_Close"
                                            IsVisible="{TemplateBinding CloseVisible}"
                                            Icon="{TemplateBinding CloseIcon}"
                                            ToolTip.Tip="{TemplateBinding CloseTooltip}"
                                            AutomationProperties.Name="{TemplateBinding CloseTooltip}"
                                            AutomationProperties.AutomationId="{TemplateBinding CloseAutomationId}" />
                </StackPanel>
              </Grid>
            </Border>
            <ContentControl Name="PART_Content" Grid.Row="1"
                            Content="{TemplateBinding Body}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            ClipToBounds="True" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:sidebar">
      <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
    </Style>
    <Style Selector="^:minimized /template/ ContentControl#PART_Content">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>

  <!-- The 1 px splitter between two docked regions: a 6 px hit band with the line centred in it. -->
  <ControlTheme x:Key="{x:Type controls:RegionSplitter}" TargetType="controls:RegionSplitter">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent">
          <Border Name="PART_Line"
                  Width="1"
                  HorizontalAlignment="Center"
                  Background="{DynamicResource BorderBrush}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Line">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="^:dragging /template/ Border#PART_Line">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
  </ControlTheme>

  <!-- The 1 px splitter between two panels; vertical for the preview column, horizontal elsewhere. -->
  <ControlTheme x:Key="{x:Type controls:PanelSplitter}" TargetType="controls:PanelSplitter">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent">
          <Border Name="PART_Line"
                  Width="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Stretch"
                  Background="{DynamicResource BorderBrush}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^[IsVertical=False] /template/ Border#PART_Line">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Height" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_Line">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="^:dragging /template/ Border#PART_Line">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
