<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Button, text and surface classes that only the panels, dialogs and settings pages use (not the transcript).
       Every view that uses one of them includes this sheet on its own subtree: a sheet that applies to every Button, Border
       or TextBlock costs every control of those types a match when it attaches, and the transcript builds hundreds of
       rows (see src/Forge.App/SPEC.md, transcript scroll). The classes used inside the transcript rows (ghost, icon, link,
       caption, label, muted, mono, the row and bubble borders, the tree chevron) stay in `Controls.axaml`. -->

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeMd}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.section-title">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
    <!-- Bold, not SemiBold: the CJK fallback faces have no 600 weight, so SemiBold renders as regular here. -->
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <Style Selector="TextBlock.glyph">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="{StaticResource PaddingControl}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ButtonCornerRadius}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Session breadcrumbs (W16b): flat text buttons on the transcript header, muted until hovered; the separator and
       the current session segment are plain text. Shared by SessionView and SubAgentView. -->
  <Style Selector="Button.breadcrumb">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="CornerRadius" Value="{DynamicResource ButtonCornerRadius}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.breadcrumb:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="TextBlock.breadcrumb-separator">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="2,0" />
  </Style>

  <Style Selector="TextBlock.breadcrumb-current">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrandActionBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnBrandBrush}" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
  </Style>

  <Style Selector="Button.tab">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="{StaticResource PaddingControl}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ButtonCornerRadius}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.tab">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="Button.tab.selected">
    <Setter Property="Foreground" Value="{DynamicResource BrandActionBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
  </Style>

  <!-- A count badge: the number a tab (or any chrome row) owns, as a neutral pill so the accent colour stays with the
       selected item rather than with every count on the row. Inside a selected tab it flips to the panel surface with
       accent digits, reading as part of the accent chip instead of a second emphasis. Geometry follows the sub-agent run
       badge (16px pill, 10px semibold digits), which is the same "this row owns a count" reading. -->
  <!-- The pill grows with its digits (no fixed height or line height: those clipped the glyphs and pushed them off centre);
       the text is centred on both axes. -->
  <Style Selector="Border.count-badge">
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="MinHeight" Value="16" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource CountBadgeBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.count-badge > TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.tab.selected Border.count-badge">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
  </Style>

  <Style Selector="Button.tab.selected Border.count-badge > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource BrandActionBrush}" />
  </Style>

  <!-- Panel buttons. `tinted` is the picker-row button look (a brand tint inside the interactive brand border), `cta` is its
       primary-action tier (border and label one step deeper), `outline` is the neutral one. The composer's own copy of the
       tinted look sits in `Views/ComposerStyles.axaml`: that sheet loads on the composer's subtree only and carries the
       composer's row geometry, so the two do not share one selector. -->
  <Style Selector="Button.tinted">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
    <Setter Property="Background" Value="{DynamicResource BrandTintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrandInteractiveBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.tinted:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrandActionBrush}" />
  </Style>

  <Style Selector="Button.tinted:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
  </Style>

  <Style Selector="Button.tinted.cta">
    <Setter Property="BorderBrush" Value="{DynamicResource BrandActionBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BrandActionBrush}" />
  </Style>

  <!-- The taller tier: a panel footer that owns the decision of its card (the question panel's dismiss / step / submit
       row) sizes its buttons one step up from the inline ones, so the row reads as the card's action bar. -->
  <Style Selector="Button.tinted.large, Button.outline.large, Button.tinted.cta.large">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
  </Style>

  <Style Selector="Button.outline">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.outline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <Style Selector="Button.outline:disabled, Button.tinted:disabled">
    <Setter Property="Opacity" Value="0.45" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    <Setter Property="Padding" Value="{StaticResource PaddingCard}" />
  </Style>

  <Style Selector="Border.divider">
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Height" Value="1" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
  </Style>

  <!-- Transparent so a toolbar takes the colour of its region: white in Main, the sidebar grey at the sides. -->
  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <Style Selector="Ellipse.status-dot">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="Ellipse.status-dot.running">
    <Setter Property="Fill" Value="{DynamicResource BrandActionBrush}" />
  </Style>

  <Style Selector="Ellipse.status-dot.starting">
    <Setter Property="Fill" Value="{DynamicResource StatusWarningBrush}" />
  </Style>

  <Style Selector="Ellipse.status-dot.failed">
    <Setter Property="Fill" Value="{DynamicResource StatusErrorBrush}" />
  </Style>

</Styles>
