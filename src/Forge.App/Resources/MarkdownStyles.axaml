<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The presentation of rendered Markdown: every control MarkdownRenderer builds carries an md-* class, and these styles give
    those classes their typography, surface and table borders. Shared by both hosts - the file-diff preview
    (Changes/Markdown/MarkdownDiffView.axaml) and the plan panel - so the two never drift; a host adds only what frames its
    own content (the diff view's change bars and fold rows).

    Colors and sizes come from the design tokens (Tokens.axaml), never from literals, so a theme or language switch is free.
  -->

  <Style Selector="SelectableTextBlock.md-text">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="SelectableTextBlock.md-h1">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeXl}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="SelectableTextBlock.md-h2">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeLg}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="SelectableTextBlock.md-h3">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeMd}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="SelectableTextBlock.md-h4, SelectableTextBlock.md-h5">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="SelectableTextBlock.md-h6">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.md-marker">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.md-task-done">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <Style Selector="Border.md-quote">
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="Padding" Value="10,0,0,0" />
  </Style>
  <Style Selector="Border.md-quote SelectableTextBlock.md-text">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.md-rule">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,6" />
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="Border.md-code">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="SelectableTextBlock.md-code-text">
    <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCode}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Border.md-table">
    <Setter Property="BorderThickness" Value="1,1,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.md-cell">
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="Border.md-cell-head">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
  </Style>
  <Style Selector="SelectableTextBlock.md-th">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Grid.md-code-head">
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="TextBlock.md-code-lang">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
