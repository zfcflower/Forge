<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wc="using:Forge.App.Workbench.Controls"
        xmlns:ac="using:AvaloniaEdit.CodeCompletion">

  <!-- The files panel's git row, ship row and banner, and the +x -y counts of the changes tree. Included by Views/FilesToolView only: a style sheet that applies to every Border, Button or TextBlock costs every control of those types a match when it attaches, so the rules of one panel live with the panel (see src/Forge.App/SPEC.md, transcript scroll). -->

  <!-- The files panel's git row: a 28 px status line, the same height as a panel title bar and as the scope row above the
       tree, so every band of the panel lines up with the chrome around it. Its type is body size, regular weight: the
       branch is a value, not a heading, and bold at this size turned the row into a second title. One place answers
       "which branch, how far from the remote, and what can I do about it". Numbers ride on the two verbs that change
       something; the fetch verb has none because it only makes them current. -->
  <Style Selector="Border.git-row">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="8,0,4,0" />
    <Setter Property="Background" Value="{DynamicResource PanelBandBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <Style Selector="Border.git-row.bad">
    <Setter Property="Background" Value="{DynamicResource ErrorBubbleBrush}" />
  </Style>

  <Style Selector="wc|FluentIcon.git-row-branch-icon">
    <Setter Property="Foreground" Value="{DynamicResource BrandActionBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.git-row-branch">
    <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.git-row-message">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.git-row.bad TextBlock.git-row-message">
    <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
  </Style>

  <Style Selector="Button.git-row-details">
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />    
    <Setter Property="Foreground" Value="{DynamicResource BrandActionBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.git-row-action">
    <Setter Property="MinWidth" Value="22" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="3,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource ButtonCornerRadius}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.git-row-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
  </Style>

  <Style Selector="Button.git-row-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconButtonPressedBrush}" />
  </Style>

  <Style Selector="Button.git-row-action:disabled">
    <Setter Property="Opacity" Value="0.45" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <!-- A count is the information, so it keeps its colour only while its verb is usable. -->
  <Style Selector="TextBlock.git-row-count">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.git-row-count.up">
    <Setter Property="Foreground" Value="{DynamicResource BrandActionBrush}" />
  </Style>

  <Style Selector="TextBlock.git-row-count.down">
    <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
  </Style>

  <Style Selector="Button.git-row-action:disabled TextBlock.git-row-count">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <!-- The 提交目标 row under the git row: two pills, no labels, so the branch name above keeps its width. Both rows sit at
       the bottom of the file panel now, so this one carries the divider on its own top edge - between the two rows - instead
       of one on the panel's bottom edge, where nothing is below to separate from. -->
  <Style Selector="Border.git-ship">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Background" Value="{DynamicResource PanelBandBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <Style Selector="TextBlock.git-ship-hint">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- A chip, not a bare link: the two controls of this row are buttons and read as buttons - a 24 px rounded box filled
       with the card surface inside the divider's hairline, the same white-on-band pair the row itself sits on. Type is
       body size, regular weight, so the row never turns into a heading. -->
  <Style Selector="Button.git-pill">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="CornerRadius" Value="{DynamicResource ButtonCornerRadius}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BrandActionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.git-pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>

  <Style Selector="Button.git-pill:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
  </Style>

  <Style Selector="Button.git-pill.publish">
    <Setter Property="Foreground" Value="{DynamicResource BrandActionBrush}" />
  </Style>

  <!-- The pull-request pill takes the colour of what the platform last said; "no pull request yet" stays neutral. -->
  <Style Selector="Button.git-pill.target">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="Button.git-pill.target.open">
    <Setter Property="Foreground" Value="{DynamicResource BrandActionBrush}" />
  </Style>

  <Style Selector="Button.git-pill.target.draft">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="Button.git-pill.target.merged">
    <Setter Property="Foreground" Value="{DynamicResource BrandActionBrush}" />
  </Style>

  <Style Selector="Button.git-pill.target.closed">
    <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
  </Style>

  <Style Selector="Button.git-ship-item">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.git-ship-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
  </Style>

  <Style Selector="Button.git-ship-item.disabled">
    <Setter Property="Opacity" Value="0.55" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <!-- A stopped rebase/merge: the only blocking state the panel shows, so it is the only place the danger bar is used. -->
  <Style Selector="Border.git-banner">
    <Setter Property="Background" Value="{DynamicResource ErrorBubbleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBrush}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Padding" Value="6,4,6,6" />
  </Style>

  <Style Selector="TextBlock.git-banner-title">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="Button.git-banner-file">
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <!-- 已改动树:文件行右侧的 +x −y 计数。 -->
  <Style Selector="TextBlock.change-added">
    <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}" />
  </Style>
  <Style Selector="TextBlock.change-removed">
    <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
  </Style>

</Styles>
