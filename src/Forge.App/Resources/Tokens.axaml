<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

  <!-- The app's single colour source. Every key here is defined once per theme variant and consumed only through
       DynamicResource; the authority for the palette, the usage principles and the extension tokens is the
       "风格与配色" section of src/Forge.App/SPEC.md — this file is its implementation, so a value changed here without
       the table changing is a bug, not a tweak.

       Two groups live below. The first is the specification's own set (brand / surface / typography / status /
       interaction). The second, marked "Extension", covers what a colour specification cannot know about a specific
       app — a 1 px divider, one chrome colour, diff tints, the editor's syntax palette — derived from the same neutral
       ramp so that no two greys on one screen come from different families.

       No Layer-1 primitives any more: every literal used to have a name of its own (`LightBackground` and friends),
       but each was consumed exactly once, so the indirection only made the file harder to compare with the table. -->

  <sys:Double x:Key="FontSizeXs">11</sys:Double>
  <sys:Double x:Key="FontSizeSm">12</sys:Double>
  <sys:Double x:Key="FontSizeBase">13</sys:Double>
  <sys:Double x:Key="FontSizeMd">14</sys:Double>
  <sys:Double x:Key="FontSizeLg">18</sys:Double>
  <sys:Double x:Key="FontSizeXl">22</sys:Double>
  <!-- Code text: the code font size itself, not a step of the UI scale. -->
  <sys:Double x:Key="FontSizeCode">13</sys:Double>
  <!-- The header's FORGE wordmark: sized to the 18px logo it sits beside (same as FontSizeCode, this is its own
       size rather than a step of the UI scale). -->
  <sys:Double x:Key="FontSizeWordmark">18</sys:Double>

  <sys:Double x:Key="Space1">4</sys:Double>
  <sys:Double x:Key="Space2">8</sys:Double>
  <sys:Double x:Key="Space3">12</sys:Double>
  <sys:Double x:Key="Space4">16</sys:Double>
  <sys:Double x:Key="Space5">20</sys:Double>
  <sys:Double x:Key="Space6">24</sys:Double>

  <Thickness x:Key="PaddingPage">16</Thickness>
  <Thickness x:Key="PaddingCard">12</Thickness>
  <Thickness x:Key="PaddingControl">12,6</Thickness>

  <!-- 聊天时间轴(W13)。这四个尺寸是轴线几何的唯一来源:轴列宽、节点边长、节点离行顶的距离、轴线粗细。
       视图只引用它们,不再各自写数字。 -->
  <sys:Double x:Key="TimelineGutterWidth">26</sys:Double>
  <sys:Double x:Key="TimelineNodeSize">14</sys:Double>
  <sys:Double x:Key="TimelineNodeTopGap">6</sys:Double>
  <sys:Double x:Key="TimelineAxisWidth">1</sys:Double>
  <!-- 轴线在 gutter 内的位置不是令牌:它是节点居中线((TimelineNodeSize − TimelineAxisWidth)/2,节点贴 gutter 左沿),由 Views/TimelineGutter 从这几个尺寸算出。 -->

  <!-- 聊天区与窗口边缘的同一档内边距(左右都取 16 = PaddingPage):转录列表、输入卡、自动化横幅三处从这里取。
       上下两个方向同样对齐:列表底部 8 + 输入卡顶部 8 = 16,与窗口左右边距同档。 -->
  <Thickness x:Key="ChatTranscriptPadding">12</Thickness>
  <Thickness x:Key="ChatComposerMargin">12</Thickness>
  <Thickness x:Key="ChatBannerMargin">12,6,12,0</Thickness>

  <CornerRadius x:Key="RadiusSm">4</CornerRadius>
  <CornerRadius x:Key="RadiusMd">8</CornerRadius>
  <CornerRadius x:Key="RadiusLg">12</CornerRadius>

  <BoxShadows x:Key="ShadowSm">0 1 2 0 #20000000</BoxShadows>
  <BoxShadows x:Key="ShadowMd">0 8 24 -8 #33000000</BoxShadows>
  <!-- Two more steps that used to live inline in four views. They stay separate from ShadowMd because they were tuned
       against a different background (a card sitting inside a panel body vs a popover floating over a list), and folding
       them into one would visibly change three of the four surfaces. -->
  <BoxShadows x:Key="ShadowCard">0 4 16 0 #40000000</BoxShadows>
  <BoxShadows x:Key="ShadowPopover">0 10 30 0 #3A000000</BoxShadows>

  <!-- Built-in form controls: one tier of geometry, expressed in Fluent's own resource keys. Avalonia 12.1.6 drives every one of
       these through DynamicResource (TextBox/NumericUpDown/AutoCompleteBox take the TextControl* heights, ComboBox has its
       own pair, CheckBox/RadioButton their row height, and none of them carries a FontSize of its own), so this block is
       the single place an input box, a spinner, a dropdown and a tick box get their height and corner radius. Application
       resources are searched before the theme's style resources; the dictionary AppearanceApplier merges later still wins
       over these static defaults, so the interface-font preference keeps reaching built-in controls.

       ButtonPadding deliberately stays with Fluent: the clear button inside a TextBox template is sized from it, and a
       wider value clips its 12 px glyph. The border brushes, the fill and the type of the same controls are aliased to
       Forge's line, surface, text and status tokens further down (see the `TextControl*` / `ComboBox*` entries in each
       theme), so an input box, the divider above it and the button beside it all draw the same hairline and share one set
       of foregrounds; the template, the heights and the corner radius stay Fluent's. -->
  <!-- The smallest radius the system has: Fluent's own default for a control. Spelled out rather than dropped, because
       OverlayCornerRadius defaults to 5 and the two must not drift apart, and because Forge's button classes bind this same
       key (see Controls.axaml) — so an input box, the button beside it and the flyout they open share one radius, and a
       future change is one literal. Surfaces keep their own tokens: RadiusSm for chips and rows, RadiusMd for the
       transcript bubbles and turn cards, RadiusLg for a page card. -->
  <CornerRadius x:Key="ControlCornerRadius">3</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">3</CornerRadius>
  <!-- Buttons are deliberately one step rounder than the fields beside them: 3 keeps an input box crisp, 5 keeps a button
       from reading as a square block, and neither is the 8 that made a 28 px control look like a pill. Forge's own button
       classes bind this key, so `Button.primary`/`ghost`/`icon`/`tab`/`link`, `change-picker` and the git row's action
       buttons all move together; the framework's plain buttons keep `ControlCornerRadius`. -->
  <CornerRadius x:Key="ButtonCornerRadius">5</CornerRadius>
  <sys:Double x:Key="TextControlThemeMinHeight">28</sys:Double>
  <!-- 10 on both sides, like the field the prototype draws. Fluent's own default keeps 6 on the right for a clear button
       a plain TextBox does not have. -->
  <Thickness x:Key="TextControlThemePadding">10,4</Thickness>
  <!-- The field frame: a hairline on the top and the sides, nothing at the bottom - the bottom is a line of its own
       (`FieldStyles.axaml` draws it as a second element), because a Border paints all four edges with one brush and this
       edge has to be able to be the heaviest line and change with the state. -->
  <Thickness x:Key="FieldFrameThickness">1,1,1,0</Thickness>
  <!-- The bottom edge is a filled band. It stops one pixel short of each side (the frame's own line) and carries the field's
       bottom corner radius, so it tapers into the corner arc instead of ending square against it. -->
  <CornerRadius x:Key="FieldEdgeCornerRadius">0,0,3,3</CornerRadius>
  <sys:Double x:Key="ComboBoxMinHeight">28</sys:Double>
  <Thickness x:Key="ComboBoxPadding">12,4,0,4</Thickness>
  <!-- 24 leaves the 20 px tick box itself alone (Fluent pins the box, not the row) while keeping the row on the same
       baseline as a 28 px input beside it. -->
  <sys:Double x:Key="CheckBoxMinHeight">24</sys:Double>
  <sys:Double x:Key="RadioButtonMinHeight">24</sys:Double>
  <!-- The default interface size. AppearanceApplier replaces it at runtime with the scaled preference. -->
  <sys:Double x:Key="ControlContentThemeFontSize">13</sys:Double>

  <!-- Semantic tokens, one dictionary per theme variant. The two dictionaries must define exactly the same key set:
       a key missing from one theme is a rendering bug that only shows up after a theme switch. -->

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">

      <!-- Fluent system colours. SystemAccentColor is BrandActionBrush, not BrandPrimaryBrush: Fluent paints white
           foregrounds on it (check box tick, button text, focus), and #0ABAB5 would put white text at 2.41:1. -->
      <Color x:Key="SystemAccentColor">#067A76</Color>
      <Color x:Key="SystemAccentColorLight1">#33928F</Color>
      <Color x:Key="SystemAccentColorLight2">#51A29F</Color>
      <Color x:Key="SystemAccentColorLight3">#76B6B4</Color>
      <Color x:Key="SystemAccentColorDark1">#056461</Color>
      <Color x:Key="SystemAccentColorDark2">#04524F</Color>
      <Color x:Key="SystemAccentColorDark3">#033F3D</Color>
      <Color x:Key="SystemBaseHighColor">#1D2129</Color>
      <Color x:Key="SystemBaseMediumHighColor">#363D49</Color>
      <Color x:Key="SystemBaseMediumColor">#66717D</Color>
      <Color x:Key="SystemBaseMediumLowColor">#8A949E</Color>
      <Color x:Key="SystemBaseLowColor">#D8DEE1</Color>
      <Color x:Key="SystemChromeMediumColor">#FFFFFF</Color>
      <Color x:Key="SystemChromeMediumLowColor">#F4F7F8</Color>
      <Color x:Key="SystemChromeLowColor">#FAFAFA</Color>
      <Color x:Key="SystemChromeHighColor">#E4EBEC</Color>
      <Color x:Key="SystemAltHighColor">#FFFFFF</Color>
      <Color x:Key="SystemAltMediumHighColor">#F2F5F6</Color>
      <Color x:Key="RegionColor">#FAFAFA</Color>
      <Color x:Key="SystemListLowColor">#EDF3F4</Color>

      <!-- Brand. BrandPrimaryBrush identifies, BrandInteractiveBrush takes non-text interaction (3:1 is enough there),
           BrandActionBrush carries every readable brand pixel — it is the only tier that clears 4.5:1 in both
           directions: as a foreground on the card body (#067A76 on #FFFFFF = 5.18:1, 4.97:1 on the #FAFAFA window)
           and as a fill with white text (the same 5.18:1, contrast is symmetric). -->
      <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#0ABAB5" />
      <SolidColorBrush x:Key="BrandInteractiveBrush" Color="#078A86" />
      <SolidColorBrush x:Key="BrandActionBrush" Color="#067A76" />
      <SolidColorBrush x:Key="BrandHoverBrush" Color="#066E6A" />
      <!-- One step past hover, for the pressed state of a brand-filled button: the scale needs a third stop so a
           press reads differently from a hover without an opacity trick. -->
      <SolidColorBrush x:Key="BrandPressedBrush" Color="#055E5A" />
      <SolidColorBrush x:Key="BrandSoftBrush" Color="#81D8D0" />
      <!-- BrandSoftBrush is deliberately the same mint in both themes, so its ink cannot be a theme-dependent brand tier:
           BrandActionBrush on it is 3.13:1 in light and 1.28:1 in dark (where BrandAction is #26C6C1). This is the one
           foreground that is identical in both variants, and it is 9.65:1 on the soft mint. -->
      <SolidColorBrush x:Key="OnBrandSoftBrush" Color="#072625" />
      <SolidColorBrush x:Key="BrandTintBrush" Color="#E8F8F7" />
      <!-- The mint's second surface step: deep enough to read apart from the pale Tiffany editable tint beside it
           (BrandTint is nearly the same lightness as that tint, so "mine" vanished), still light enough that the table's
           normal ink on it keeps its contrast. Worn by values the user set themselves. -->
      <SolidColorBrush x:Key="BrandTintStrongBrush" Color="#C8ECE7" />
      <!-- The tinted button's hover / pressed fill. It used to borrow SelectionBackgroundBrush; the text selection turned
           translucent so the ink under it shows through, so the button keeps this opaque step of its own. -->
      <SolidColorBrush x:Key="BrandTintHoverBrush" Color="#D7F2EF" />

      <!-- The requested Tiffany accent (the round marker's #1B9EAA in `App.axaml`), as surfaces: the pale tint marks the
           editable cells of a table, the two deeper stops are its row states. A second family rather than another step of
           the brand teal, because it is a different hue: the brand's mint reads "ours", this blue reads "this is a cell you
           can act on / the row you are acting on". -->
      <!-- Three quarters opaque on purpose: the tint sits inside a row, so a selected row's own Tiffany background still reads
           through the editable cells (a solid fill would hide the selection in exactly the columns the user just clicked). -->
      <SolidColorBrush x:Key="TiffanyTintBrush" Color="#BFE7F6F8" />
      <SolidColorBrush x:Key="TiffanySelectionBrush" Color="#CFECF1" />
      <SolidColorBrush x:Key="TiffanySelectionStrongBrush" Color="#BFE5EC" />

      <!-- Surfaces. Window is the canvas behind everything, Card is a panel body, Sidebar is the two side panels,
           Subtle is a static inset (gutter, inline code, code block), Hover and Selected are the two row states,
           Input is the composer's input band. -->
      <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FAFAFA" />
      <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FBFCFD" />
      <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#F4F7F8" />
      <!-- A band inside a panel (the file panel's git rows and its scope row): one step lighter than the chrome above them,
           one step deeper than the panel body, so the band reads as part of the panel without disappearing into it. -->
      <SolidColorBrush x:Key="PanelBandBrush" Color="#F3F7F8" />
      <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EDF3F4" />
      <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#E8F8F7" />
      <SolidColorBrush x:Key="SurfaceInputBrush" Color="#FFFFFF" />
      <!-- The reply card of the transcript: a neutral near-white one step below the white page, so a long answer reads as a
           single surface without competing with the turn beside it. -->
      <SolidColorBrush x:Key="AssistantCardBrush" Color="#FBFCFD" />

      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1D2129" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4E5969" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="#66717D" />
      <!-- Disabled is not a dimmed Muted: Muted still has to be read (#66717D on white = 4.97:1), Disabled never does,
           and WCAG exempts it. -->
      <SolidColorBrush x:Key="TextDisabledBrush" Color="#9AA3AC" />
      <SolidColorBrush x:Key="TextOnBrandBrush" Color="#FFFFFF" />

      <SolidColorBrush x:Key="StatusSuccessBrush" Color="#16845B" />
      <SolidColorBrush x:Key="StatusWarningBrush" Color="#A85B00" />
      <SolidColorBrush x:Key="StatusErrorBrush" Color="#C43D4D" />
      <SolidColorBrush x:Key="StatusInfoBrush" Color="#2769B0" />
      <!-- Warm emphasis, kept apart from StatusWarning so "已停止" never reads as "警告". -->
      <SolidColorBrush x:Key="AccentWarmBrush" Color="#E97818" />

      <SolidColorBrush x:Key="FocusRingBrush" Color="#078A86" />
      <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#3D0ABAB5" />
      <!-- Fluent's TextBox reads this key for its own selection: point it at the one selection brush so the composer, the
           search boxes and the dialogs select with the same translucent tint instead of the theme's opaque accent. -->
      <StaticResource x:Key="TextControlSelectionHighlightColor" ResourceKey="SelectionBackgroundBrush" />

      <!-- Extension: dividers and chrome. A colour specification does not model a 1 px line, so the neutral ramp is
           extended two steps below the darkest surface; the existing rule that an icon button's hover equals the
           divider and its pressed state equals the stronger outline is preserved by using the two same values. -->
      <SolidColorBrush x:Key="BorderBrush" Color="#CFD7DA" />
      <SolidColorBrush x:Key="BorderStrongBrush" Color="#C3CDD0" />

      <!-- Form controls take Forge's own line colours instead of Fluent's greys: the same hairline as every divider, one
           step deeper under the pointer, and the brand tier for the focused frame (whose thickness token below makes the
           bottom edge the heaviest line) and for errors. Aliases, not copies, so an input can never drift from the divider
           it sits next to. -->
      <!-- The table's own states: pressed and selected rows are the Tiffany accent, not the brand mint - the requested blue
           is what marks the row the pointer is acting on. Hover stays neutral (a row under the pointer is not a choice yet),
           and the selected+pointerover / selected+pressed pair steps up together, as Fluent's three accent stops did. -->
      <StaticResource x:Key="TableViewRowBackgroundPressed" ResourceKey="TiffanyTintBrush" />
      <StaticResource x:Key="TableViewRowBackgroundSelected" ResourceKey="TiffanySelectionBrush" />
      <StaticResource x:Key="TableViewRowBackgroundSelectedPointerOver" ResourceKey="TiffanySelectionStrongBrush" />
      <StaticResource x:Key="TableViewRowBackgroundSelectedPressed" ResourceKey="TiffanySelectionStrongBrush" />

      <StaticResource x:Key="TextControlBorderBrush" ResourceKey="BorderBrush" />
      <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="BorderStrongBrush" />
      <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="BrandActionBrush" />
      <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="BorderBrush" />
      <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="BorderBrush" />
      <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="BorderStrongBrush" />
      <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="BorderStrongBrush" />
      <StaticResource x:Key="ComboBoxBorderBrushDisabled" ResourceKey="BorderBrush" />
      <StaticResource x:Key="ComboBoxBackgroundBorderBrushFocused" ResourceKey="BrandActionBrush" />
      <!-- The fill and the type inside a field are Forge's too: SurfaceInputBrush (white in light, one step below the body
           in dark) instead of Fluent's translucent wash, TextPrimaryBrush instead of pure black, and the muted grey for the
           placeholder and the dropdown's chevron. Hover and focus keep the same fill - the prototype changes only the line
           on hover and only the edge on focus - and the chevron inks brand while the list is focused. -->
      <StaticResource x:Key="TextControlBackground" ResourceKey="SurfaceInputBrush" />
      <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SurfaceInputBrush" />
      <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SurfaceInputBrush" />
      <StaticResource x:Key="TextControlForeground" ResourceKey="TextPrimaryBrush" />
      <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="TextPrimaryBrush" />
      <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="TextPrimaryBrush" />
      <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="TextMutedBrush" />
      <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="TextMutedBrush" />
      <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="TextMutedBrush" />
      <StaticResource x:Key="ComboBoxBackground" ResourceKey="SurfaceInputBrush" />
      <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="SurfaceInputBrush" />
      <StaticResource x:Key="ComboBoxForeground" ResourceKey="TextPrimaryBrush" />
      <StaticResource x:Key="ComboBoxForegroundFocused" ResourceKey="TextPrimaryBrush" />
      <StaticResource x:Key="ComboBoxPlaceholderForeground" ResourceKey="TextMutedBrush" />
      <StaticResource x:Key="ComboBoxDropDownGlyphForeground" ResourceKey="TextMutedBrush" />
      <StaticResource x:Key="ComboBoxDropDownGlyphForegroundFocused" ResourceKey="BrandActionBrush" />
      <!-- The bottom edge of an input at rest: the field closes on a line of ink, while its top and sides keep the divider
           colour. It is a brush, not a recoloured border, because the frame's four edges share one BorderBrush. -->
      <SolidColorBrush x:Key="FieldEdgeBrush" Color="#4E5969" />
      <StaticResource x:Key="SystemControlErrorTextForegroundBrush" ResourceKey="StatusErrorBrush" />
      <!-- One chrome colour: the window header row, every panel title bar (and the tab strip drawn on it), the dock
           strips and a floated panel's own title bar. One step below the darkest surface, so chrome never borrows the
           sidebar's or the card's grey. -->
      <SolidColorBrush x:Key="PanelTitleBarBrush" Color="#E9EFF0" />
      <!-- A count badge's fill: one neutral step below the card body and its sidebar grey, so a number stays legible in
           a toolbar without becoming a second button. Never brand — the brand belongs to the selected item. -->
      <SolidColorBrush x:Key="CountBadgeBrush" Color="#E4EBEC" />
      <!-- The 3px bar on a dock strip label, in its resting state: one step of the brand ramp above BrandActionBrush is
           the label on show, so two steps above it is the strip that is not. Light #51A29F / dark #6BD8D5 are each theme's
           SystemAccentColorLight2. -->
      <SolidColorBrush x:Key="DockIndicatorIdleBrush" Color="#51A29F" />
      <SolidColorBrush x:Key="IconButtonHoverBrush" Color="#CFD7DA" />
      <SolidColorBrush x:Key="IconButtonPressedBrush" Color="#C3CDD0" />

      <!-- Extension: the modal scrim. One token instead of four literals in four views. -->
      <SolidColorBrush x:Key="BackdropScrimBrush" Color="#5A000000" />

      <!-- Extension: the editor's own selection is the shared selection standard (a translucent brand tint the syntax
           colours show through), not a second brush with its own alpha. -->
      <StaticResource x:Key="EditorSelectionBrush" ResourceKey="SelectionBackgroundBrush" />
      <SolidColorBrush x:Key="EditorSearchResultBrush" Color="#59F5C542" />

      <!-- Extension: chat and diff surfaces, both tints of a status colour. DiffRemove and ErrorBubble share a value on
           purpose — a deleted line and an error are the same failure semantics at different scales. -->
      <SolidColorBrush x:Key="DiffAddBrush" Color="#E7F4EF" />
      <SolidColorBrush x:Key="DiffRemoveBrush" Color="#FBE9EC" />
      <SolidColorBrush x:Key="DiffHunkBrush" Color="#F2F6F7" />
      <SolidColorBrush x:Key="ErrorBubbleBrush" Color="#FBE9EC" />

      <!-- Extension: the editor palette (VS Code Light+). Deliberately not re-derived — a syntax palette is a tuned
           third-party artifact, and seeding it from the brand ramp would make code less readable, not more. -->
      <SolidColorBrush x:Key="SyntaxKeywordBrush" Color="#0000FF" />
      <SolidColorBrush x:Key="SyntaxStringBrush" Color="#A31515" />
      <SolidColorBrush x:Key="SyntaxCommentBrush" Color="#008000" />
      <SolidColorBrush x:Key="SyntaxNumberBrush" Color="#098658" />
      <SolidColorBrush x:Key="SyntaxTypeBrush" Color="#267F99" />
      <SolidColorBrush x:Key="SyntaxFunctionBrush" Color="#795E26" />
      <SolidColorBrush x:Key="SyntaxVariableBrush" Color="#001080" />
      <SolidColorBrush x:Key="SyntaxPreprocessorBrush" Color="#AF00DB" />

    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">

      <!-- SystemAccentColor is the brand tier that carries white in this theme, exactly as in light — Fluent fills a
           checked box with it and paints the tick #FFFFFF, so #26C6C1 (the spec's dark brand, 2.11:1 with white) cannot
           be the base here; its own Dark1 step can (3.27:1). The rest of the ramp keeps the previous steps around it. -->
      <Color x:Key="SystemAccentColor">#1E9E9A</Color>
      <Color x:Key="SystemAccentColorLight1">#4DD0CC</Color>
      <Color x:Key="SystemAccentColorLight2">#6BD8D5</Color>
      <Color x:Key="SystemAccentColorLight3">#8AE0DE</Color>
      <Color x:Key="SystemAccentColorDark1">#19817D</Color>
      <Color x:Key="SystemAccentColorDark2">#136361</Color>
      <Color x:Key="SystemAccentColorDark3">#0F4F4E</Color>
      <Color x:Key="SystemBaseHighColor">#F2F4F5</Color>
      <Color x:Key="SystemBaseMediumHighColor">#CBD1D6</Color>
      <Color x:Key="SystemBaseMediumColor">#A9B2B8</Color>
      <Color x:Key="SystemBaseMediumLowColor">#7B868D</Color>
      <Color x:Key="SystemBaseLowColor">#313B3E</Color>
      <Color x:Key="SystemChromeMediumColor">#1C2224</Color>
      <Color x:Key="SystemChromeMediumLowColor">#161B1D</Color>
      <Color x:Key="SystemChromeLowColor">#121617</Color>
      <Color x:Key="SystemChromeHighColor">#242C2E</Color>
      <Color x:Key="SystemAltHighColor">#1C2224</Color>
      <Color x:Key="SystemAltMediumHighColor">#242C2E</Color>
      <Color x:Key="RegionColor">#121617</Color>
      <Color x:Key="SystemListLowColor">#293235</Color>

      <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#26C6C1" />
      <SolidColorBrush x:Key="BrandInteractiveBrush" Color="#26C6C1" />
      <SolidColorBrush x:Key="BrandActionBrush" Color="#26C6C1" />
      <SolidColorBrush x:Key="BrandHoverBrush" Color="#3CD4CF" />
      <SolidColorBrush x:Key="BrandPressedBrush" Color="#1E9E9B" />
      <SolidColorBrush x:Key="BrandSoftBrush" Color="#81D8D0" />
      <SolidColorBrush x:Key="OnBrandSoftBrush" Color="#072625" />
      <SolidColorBrush x:Key="BrandTintBrush" Color="#0D3F3E" />
      <!-- The same second mint step on dark: above the panel body and greener than the Tiffany blue steps, so a user-set
           cell reads apart from the inherited/empty ones the same way it does in light. -->
      <SolidColorBrush x:Key="BrandTintStrongBrush" Color="#14514D" />
      <SolidColorBrush x:Key="BrandTintHoverBrush" Color="#17413F" />

      <!-- The Tiffany surfaces on dark: the same three steps, kept in the bluish range above the panel body so the editable
           cells still read as a band without glowing against the window. -->
      <SolidColorBrush x:Key="TiffanyTintBrush" Color="#B3103036" />
      <SolidColorBrush x:Key="TiffanySelectionBrush" Color="#14424A" />
      <SolidColorBrush x:Key="TiffanySelectionStrongBrush" Color="#1A5158" />

      <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#121617" />
      <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#181E20" />
      <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1C2224" />
      <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#242C2E" />
      <SolidColorBrush x:Key="PanelBandBrush" Color="#121A1B" />
      <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#293235" />
      <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#193332" />
      <!-- The one surface that goes the other way in dark: an input sits below the card it lives on. -->
      <SolidColorBrush x:Key="SurfaceInputBrush" Color="#161D1F" />
      <!-- The reply card keeps the light theme's relationship: one step below the card it sits on, above the page. -->
      <SolidColorBrush x:Key="AssistantCardBrush" Color="#181E20" />

      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F4F5" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A9B2B8" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="#87939D" />
      <SolidColorBrush x:Key="TextDisabledBrush" Color="#59656D" />
      <!-- Dark text on a light brand fill, not white: the brand is light in this theme. -->
      <SolidColorBrush x:Key="TextOnBrandBrush" Color="#072625" />

      <SolidColorBrush x:Key="StatusSuccessBrush" Color="#43C995" />
      <SolidColorBrush x:Key="StatusWarningBrush" Color="#FFB454" />
      <SolidColorBrush x:Key="StatusErrorBrush" Color="#FF6B78" />
      <SolidColorBrush x:Key="StatusInfoBrush" Color="#69A9F5" />
      <SolidColorBrush x:Key="AccentWarmBrush" Color="#FF8F33" />

      <SolidColorBrush x:Key="FocusRingBrush" Color="#3CD4CF" />
      <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#4D26C6C1" />
      <StaticResource x:Key="TextControlSelectionHighlightColor" ResourceKey="SelectionBackgroundBrush" />

      <SolidColorBrush x:Key="BorderBrush" Color="#3A4447" />
      <SolidColorBrush x:Key="BorderStrongBrush" Color="#465256" />

      <!-- The table's own states: pressed and selected rows are the Tiffany accent, not the brand mint - the requested blue
           is what marks the row the pointer is acting on. Hover stays neutral (a row under the pointer is not a choice yet),
           and the selected+pointerover / selected+pressed pair steps up together, as Fluent's three accent stops did. -->
      <StaticResource x:Key="TableViewRowBackgroundPressed" ResourceKey="TiffanyTintBrush" />
      <StaticResource x:Key="TableViewRowBackgroundSelected" ResourceKey="TiffanySelectionBrush" />
      <StaticResource x:Key="TableViewRowBackgroundSelectedPointerOver" ResourceKey="TiffanySelectionStrongBrush" />
      <StaticResource x:Key="TableViewRowBackgroundSelectedPressed" ResourceKey="TiffanySelectionStrongBrush" />

      <StaticResource x:Key="TextControlBorderBrush" ResourceKey="BorderBrush" />
      <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="BorderStrongBrush" />
      <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="BrandActionBrush" />
      <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="BorderBrush" />
      <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="BorderBrush" />
      <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="BorderStrongBrush" />
      <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="BorderStrongBrush" />
      <StaticResource x:Key="ComboBoxBorderBrushDisabled" ResourceKey="BorderBrush" />
      <StaticResource x:Key="ComboBoxBackgroundBorderBrushFocused" ResourceKey="BrandActionBrush" />
      <!-- Same aliases as the light dictionary: the two theme dictionaries must define the identical key set. -->
      <StaticResource x:Key="TextControlBackground" ResourceKey="SurfaceInputBrush" />
      <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SurfaceInputBrush" />
      <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SurfaceInputBrush" />
      <StaticResource x:Key="TextControlForeground" ResourceKey="TextPrimaryBrush" />
      <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="TextPrimaryBrush" />
      <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="TextPrimaryBrush" />
      <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="TextMutedBrush" />
      <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="TextMutedBrush" />
      <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="TextMutedBrush" />
      <StaticResource x:Key="ComboBoxBackground" ResourceKey="SurfaceInputBrush" />
      <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="SurfaceInputBrush" />
      <StaticResource x:Key="ComboBoxForeground" ResourceKey="TextPrimaryBrush" />
      <StaticResource x:Key="ComboBoxForegroundFocused" ResourceKey="TextPrimaryBrush" />
      <StaticResource x:Key="ComboBoxPlaceholderForeground" ResourceKey="TextMutedBrush" />
      <StaticResource x:Key="ComboBoxDropDownGlyphForeground" ResourceKey="TextMutedBrush" />
      <StaticResource x:Key="ComboBoxDropDownGlyphForegroundFocused" ResourceKey="BrandActionBrush" />
      <!-- Same bottom edge as the light theme, in the theme's muted grey: against #161D1F a darker line would vanish. -->
      <SolidColorBrush x:Key="FieldEdgeBrush" Color="#87939D" />
      <StaticResource x:Key="SystemControlErrorTextForegroundBrush" ResourceKey="StatusErrorBrush" />
      <SolidColorBrush x:Key="PanelTitleBarBrush" Color="#0D1213" />
      <SolidColorBrush x:Key="CountBadgeBrush" Color="#2C3538" />
      <SolidColorBrush x:Key="DockIndicatorIdleBrush" Color="#6BD8D5" />
      <SolidColorBrush x:Key="IconButtonHoverBrush" Color="#3A4447" />
      <SolidColorBrush x:Key="IconButtonPressedBrush" Color="#465256" />

      <SolidColorBrush x:Key="BackdropScrimBrush" Color="#5A000000" />

      <StaticResource x:Key="EditorSelectionBrush" ResourceKey="SelectionBackgroundBrush" />
      <SolidColorBrush x:Key="EditorSearchResultBrush" Color="#59B58B00" />

      <SolidColorBrush x:Key="DiffAddBrush" Color="#17332C" />
      <SolidColorBrush x:Key="DiffRemoveBrush" Color="#3A2126" />
      <SolidColorBrush x:Key="DiffHunkBrush" Color="#232C2E" />
      <SolidColorBrush x:Key="ErrorBubbleBrush" Color="#3A2126" />

      <!-- The editor palette in dark is VS Code Dark+, unchanged. -->
      <SolidColorBrush x:Key="SyntaxKeywordBrush" Color="#569CD6" />
      <SolidColorBrush x:Key="SyntaxStringBrush" Color="#CE9178" />
      <SolidColorBrush x:Key="SyntaxCommentBrush" Color="#6A9955" />
      <SolidColorBrush x:Key="SyntaxNumberBrush" Color="#B5CEA8" />
      <SolidColorBrush x:Key="SyntaxTypeBrush" Color="#4EC9B0" />
      <SolidColorBrush x:Key="SyntaxFunctionBrush" Color="#DCDCAA" />
      <SolidColorBrush x:Key="SyntaxVariableBrush" Color="#9CDCFE" />
      <SolidColorBrush x:Key="SyntaxPreprocessorBrush" Color="#C586C0" />

    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- Fonts. These static values are the defaults (the designer and a test without an applier use them);
       AppearanceApplier replaces them at runtime with the values from the preferences.
       The static default is the system Segoe UI chain, not the embedded Inter: Inter reads visibly larger at the same
       pixel size because of its bigger x-height. Inter still ships with the app (WithInterFont registers it as the
       "fonts:Inter" collection), so typing "fonts:Inter#Inter" in the settings selects it; a bare "Inter" only
       searches the OS-installed fonts and would fall through to the next family. -->
  <FontFamily x:Key="FontUi">Segoe UI, PingFang SC, Microsoft YaHei, sans-serif</FontFamily>
  <FontFamily x:Key="FontMono">Consolas, Cascadia Mono, Menlo, monospace</FontFamily>

  <!-- 图标不在这里:全部在 Resources/Icons.axaml(唯一来源 = Fluent System Icons,唯一渲染 = 内置 PathIcon)。 -->

</ResourceDictionary>
