<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

  <!-- Layer 1: primitives. VS Code-style neutral grey/white body; eye-care green only as accent. -->
  <Color x:Key="LightBackground">#F8F8F8</Color>
  <Color x:Key="LightPanel">#FFFFFF</Color>
  <Color x:Key="LightBorder">#E5E5E5</Color>
  <Color x:Key="LightText">#3B3B3B</Color>
  <Color x:Key="LightAccent">#3A8F5C</Color>

  <Color x:Key="DarkBackground">#181818</Color>
  <Color x:Key="DarkPanel">#1F1F1F</Color>
  <Color x:Key="DarkBorder">#2B2B2B</Color>
  <Color x:Key="DarkText">#CCCCCC</Color>
  <Color x:Key="DarkAccent">#5FBF86</Color>

  <sys:Double x:Key="FontSizeXs">11</sys:Double>
  <sys:Double x:Key="FontSizeSm">12</sys:Double>
  <sys:Double x:Key="FontSizeBase">13</sys:Double>
  <sys:Double x:Key="FontSizeMd">15</sys:Double>
  <sys:Double x:Key="FontSizeLg">18</sys:Double>
  <sys:Double x:Key="FontSizeXl">22</sys:Double>
  <!-- Code text: the code font size itself, not a step of the UI scale. -->
  <sys:Double x:Key="FontSizeCode">13</sys:Double>

  <sys:Double x:Key="Space1">4</sys:Double>
  <sys:Double x:Key="Space2">8</sys:Double>
  <sys:Double x:Key="Space3">12</sys:Double>
  <sys:Double x:Key="Space4">16</sys:Double>
  <sys:Double x:Key="Space5">20</sys:Double>
  <sys:Double x:Key="Space6">24</sys:Double>

  <Thickness x:Key="PaddingPage">16</Thickness>
  <Thickness x:Key="PaddingCard">12</Thickness>
  <Thickness x:Key="PaddingControl">12,6</Thickness>

  <CornerRadius x:Key="RadiusSm">4</CornerRadius>
  <CornerRadius x:Key="RadiusMd">8</CornerRadius>
  <CornerRadius x:Key="RadiusLg">12</CornerRadius>

  <BoxShadows x:Key="ShadowSm">0 1 2 0 #20000000</BoxShadows>
  <BoxShadows x:Key="ShadowMd">0 8 24 -8 #33000000</BoxShadows>

  <!-- Layer 2: semantic tokens, one dictionary per theme variant. -->
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <!-- Fluent system colours, so built-in controls follow the same palette. -->
      <Color x:Key="SystemAccentColor">#3A8F5C</Color>
      <Color x:Key="SystemAccentColorLight1">#4A9E6B</Color>
      <Color x:Key="SystemAccentColorLight2">#63B283</Color>
      <Color x:Key="SystemAccentColorLight3">#8AC9A3</Color>
      <Color x:Key="SystemAccentColorDark1">#2F7A4D</Color>
      <Color x:Key="SystemAccentColorDark2">#25653E</Color>
      <Color x:Key="SystemAccentColorDark3">#1B4F30</Color>
      <Color x:Key="SystemBaseHighColor">#3B3B3B</Color>
      <Color x:Key="SystemBaseMediumHighColor">#4A4A4A</Color>
      <Color x:Key="SystemBaseMediumColor">#6E6E6E</Color>
      <Color x:Key="SystemBaseMediumLowColor">#8F8F8F</Color>
      <Color x:Key="SystemBaseLowColor">#CECECE</Color>
      <Color x:Key="SystemChromeMediumColor">#FFFFFF</Color>
      <Color x:Key="SystemChromeMediumLowColor">#F8F8F8</Color>
      <Color x:Key="SystemChromeLowColor">#F2F2F2</Color>
      <Color x:Key="SystemChromeHighColor">#E5E5E5</Color>
      <Color x:Key="SystemAltHighColor">#FFFFFF</Color>
      <Color x:Key="SystemAltMediumHighColor">#F8F8F8</Color>
      <Color x:Key="RegionColor">#F8F8F8</Color>
      <Color x:Key="SystemListLowColor">#F2F2F2</Color>

      <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="{StaticResource LightBackground}" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource LightPanel}" />
      <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource LightPanel}" />
      <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F2F2F2" />
      <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#F8F8F8" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#F8F8F8" />
      <SolidColorBrush x:Key="PanelTitleBarBrush" Color="#F8F8F8" />
      <SolidColorBrush x:Key="SidebarTitleBarBrush" Color="#EFEFEF" />

      <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource LightText}" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4A4A4A" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="#6E6E6E" />
      <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

      <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource LightBorder}" />
      <SolidColorBrush x:Key="BorderStrongBrush" Color="#CECECE" />

      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource LightAccent}" />
      <SolidColorBrush x:Key="AccentTextBrush" Color="#2F7449" />
      <SolidColorBrush x:Key="AccentSubtleBrush" Color="#E4F1E9" />
      <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#2F7449" />
      <SolidColorBrush x:Key="DangerBrush" Color="#B3261E" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#2F7449" />
      <SolidColorBrush x:Key="WarningBrush" Color="#8A5A00" />
      <SolidColorBrush x:Key="SyntaxKeywordBrush" Color="#0000FF" />
      <SolidColorBrush x:Key="SyntaxStringBrush" Color="#A31515" />
      <SolidColorBrush x:Key="SyntaxCommentBrush" Color="#008000" />
      <SolidColorBrush x:Key="SyntaxNumberBrush" Color="#098658" />
      <SolidColorBrush x:Key="SyntaxTypeBrush" Color="#267F99" />
      <SolidColorBrush x:Key="SyntaxFunctionBrush" Color="#795E26" />
      <SolidColorBrush x:Key="SyntaxVariableBrush" Color="#001080" />
      <SolidColorBrush x:Key="SyntaxPreprocessorBrush" Color="#AF00DB" />

      <SolidColorBrush x:Key="UserBubbleBrush" Color="#E4F1E9" />
      <SolidColorBrush x:Key="AssistantBubbleBrush" Color="{StaticResource LightPanel}" />
      <SolidColorBrush x:Key="ToolBubbleBrush" Color="#F2F2F2" />
      <SolidColorBrush x:Key="ToolCardBrush" Color="#F8F8F8" />
      <SolidColorBrush x:Key="ErrorBubbleBrush" Color="#FBEAE9" />
      <SolidColorBrush x:Key="DiffAddBrush" Color="#E6F4EA" />
      <SolidColorBrush x:Key="DiffRemoveBrush" Color="#FBEAE9" />
      <SolidColorBrush x:Key="DiffHunkBrush" Color="#F0F0F0" />
      <SolidColorBrush x:Key="RunningBrush" Color="#2F7449" />

      <!-- Search box: one step lighter than the window background, with a border one step darker. -->
      <SolidColorBrush x:Key="SearchBoxBackgroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SearchBoxBorderBrush" Color="#E5E5E5" />

      <!-- VS Code-style chrome: dock strips, indicator bars and flat tabs. -->
      <SolidColorBrush x:Key="DockStripBackgroundBrush" Color="#F8F8F8" />
      <SolidColorBrush x:Key="DockIndicatorIdleBrush" Color="#C8C8C8" />
      <SolidColorBrush x:Key="TabActiveBackgroundBrush" Color="#E9E9E9" />
      <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="#F0F0F0" />

    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="SystemAccentColor">#5FBF86</Color>
      <Color x:Key="SystemAccentColorLight1">#79CC9A</Color>
      <Color x:Key="SystemAccentColorLight2">#95D9AF</Color>
      <Color x:Key="SystemAccentColorLight3">#B7E6C8</Color>
      <Color x:Key="SystemAccentColorDark1">#4CA872</Color>
      <Color x:Key="SystemAccentColorDark2">#3D8C5E</Color>
      <Color x:Key="SystemAccentColorDark3">#2E6E49</Color>
      <Color x:Key="SystemBaseHighColor">#CCCCCC</Color>
      <Color x:Key="SystemBaseMediumHighColor">#BBBBBB</Color>
      <Color x:Key="SystemBaseMediumColor">#9D9D9D</Color>
      <Color x:Key="SystemBaseMediumLowColor">#6E6E6E</Color>
      <Color x:Key="SystemBaseLowColor">#3C3C3C</Color>
      <Color x:Key="SystemChromeMediumColor">#1F1F1F</Color>
      <Color x:Key="SystemChromeMediumLowColor">#1B1B1B</Color>
      <Color x:Key="SystemChromeLowColor">#181818</Color>
      <Color x:Key="SystemChromeHighColor">#2B2B2B</Color>
      <Color x:Key="SystemAltHighColor">#1F1F1F</Color>
      <Color x:Key="SystemAltMediumHighColor">#252525</Color>
      <Color x:Key="RegionColor">#181818</Color>
      <Color x:Key="SystemListLowColor">#2A2A2A</Color>

      <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="{StaticResource DarkBackground}" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource DarkPanel}" />
      <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource DarkPanel}" />
      <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#2A2A2A" />
      <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#1A1A1A" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#181818" />
      <SolidColorBrush x:Key="PanelTitleBarBrush" Color="{StaticResource DarkBackground}" />
      <SolidColorBrush x:Key="SidebarTitleBarBrush" Color="#101010" />

      <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource DarkText}" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#BBBBBB" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="#9D9D9D" />
      <SolidColorBrush x:Key="TextOnAccentBrush" Color="#12211A" />

      <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource DarkBorder}" />
      <SolidColorBrush x:Key="BorderStrongBrush" Color="#3C3C3C" />

      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource DarkAccent}" />
      <SolidColorBrush x:Key="AccentTextBrush" Color="#79CC9A" />
      <SolidColorBrush x:Key="AccentSubtleBrush" Color="#223A2C" />
      <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#5FBF86" />
      <SolidColorBrush x:Key="DangerBrush" Color="#F2857C" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#79CC9A" />
      <SolidColorBrush x:Key="WarningBrush" Color="#E0B15A" />
      <SolidColorBrush x:Key="SyntaxKeywordBrush" Color="#569CD6" />
      <SolidColorBrush x:Key="SyntaxStringBrush" Color="#CE9178" />
      <SolidColorBrush x:Key="SyntaxCommentBrush" Color="#6A9955" />
      <SolidColorBrush x:Key="SyntaxNumberBrush" Color="#B5CEA8" />
      <SolidColorBrush x:Key="SyntaxTypeBrush" Color="#4EC9B0" />
      <SolidColorBrush x:Key="SyntaxFunctionBrush" Color="#DCDCAA" />
      <SolidColorBrush x:Key="SyntaxVariableBrush" Color="#9CDCFE" />
      <SolidColorBrush x:Key="SyntaxPreprocessorBrush" Color="#C586C0" />

      <SolidColorBrush x:Key="UserBubbleBrush" Color="#223A2C" />
      <SolidColorBrush x:Key="AssistantBubbleBrush" Color="{StaticResource DarkPanel}" />
      <SolidColorBrush x:Key="ToolBubbleBrush" Color="#2A2A2A" />
      <SolidColorBrush x:Key="ToolCardBrush" Color="#1A1A1A" />
      <SolidColorBrush x:Key="ErrorBubbleBrush" Color="#3A2323" />
      <SolidColorBrush x:Key="DiffAddBrush" Color="#1F3128" />
      <SolidColorBrush x:Key="DiffRemoveBrush" Color="#3A2323" />
      <SolidColorBrush x:Key="DiffHunkBrush" Color="#262626" />
      <SolidColorBrush x:Key="RunningBrush" Color="#79CC9A" />

      <SolidColorBrush x:Key="SearchBoxBackgroundBrush" Color="#1F1F1F" />
      <SolidColorBrush x:Key="SearchBoxBorderBrush" Color="#2B2B2B" />

      <SolidColorBrush x:Key="DockStripBackgroundBrush" Color="#181818" />
      <SolidColorBrush x:Key="DockIndicatorIdleBrush" Color="#4A4A4A" />
      <SolidColorBrush x:Key="TabActiveBackgroundBrush" Color="#2E2E2E" />
      <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="#262626" />

    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- Fonts. These static values are the defaults (the designer and a test without an applier use them);
       AppearanceApplier replaces them at runtime with the values from the preferences.
       The interface font spells the embedded Inter as "fonts:Inter#Inter": the package registers its collection as
       fonts:Inter (WithInterFont), and a keyless "Inter" only searches the OS-installed fonts, so it silently falls
       through to Segoe UI even though Inter ships with the app. -->
  <FontFamily x:Key="FontUi">fonts:Inter#Inter, Segoe UI, PingFang SC, Microsoft YaHei, sans-serif</FontFamily>
  <FontFamily x:Key="FontMono">Consolas, Cascadia Mono, Menlo, monospace</FontFamily>

  <!-- Icon geometry: one line (outline) family on a 24 grid, drawn by LineIcon with a fixed ~1.25 px stroke so every
       icon has the weight of the text next to it. Paths are strokes, not filled shapes. -->
  <StreamGeometry x:Key="IconPlus">M12 5v14M5 12h14</StreamGeometry>
  <StreamGeometry x:Key="IconClose">M6 6l12 12M18 6 6 18</StreamGeometry>
  <StreamGeometry x:Key="IconPlusSmall">M12 6v12M6 12h12</StreamGeometry>
  <StreamGeometry x:Key="IconSend">M4 12 20 4 13 20 11 13zM11 13l9-9</StreamGeometry>
  <!-- A six-tooth gear outline around a hub circle. -->
  <StreamGeometry x:Key="IconGear">M8.4 5.76A7.2 7.2 0 0 1 9.89 5.11L10.13 2.38A9.8 9.8 0 0 1 13.87 2.38L14.11 5.11A7.2 7.2 0 0 1 16.91 6.73L19.4 5.57A9.8 9.8 0 0 1 21.27 8.81L19.02 10.38A7.2 7.2 0 0 1 19.02 13.62L21.27 15.19A9.8 9.8 0 0 1 19.4 18.43L16.91 17.27A7.2 7.2 0 0 1 14.11 18.89L13.87 21.62A9.8 9.8 0 0 1 10.13 21.62L9.89 18.89A7.2 7.2 0 0 1 7.09 17.27L4.6 18.43A9.8 9.8 0 0 1 2.73 15.19L4.98 13.62A7.2 7.2 0 0 1 4.98 10.38L2.73 8.81A9.8 9.8 0 0 1 4.6 5.57L7.09 6.73ZM9 12A3 3 0 1 0 15 12A3 3 0 1 0 9 12Z</StreamGeometry>
  <StreamGeometry x:Key="IconStop">M8 6h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z</StreamGeometry>
  <StreamGeometry x:Key="IconRefresh">M19.5 12a7.5 7.5 0 1 1-2.2-5.3M19.5 4v4h-4</StreamGeometry>
  <StreamGeometry x:Key="IconWrap">M4 6h16M4 12h12a3 3 0 0 1 0 6h-4M14 15l-2 3 2 3M4 18h4</StreamGeometry>
  <StreamGeometry x:Key="IconEdit">M4 20h4L19 9l-4-4L4 16zM13 7l4 4</StreamGeometry>
  <StreamGeometry x:Key="IconSave">M5 4h11l3 3v13H5zM8 4v5h7V4M8 20v-6h8v6</StreamGeometry>
  <StreamGeometry x:Key="IconCopy">M9 9h10v11H9zM5 15V4h10</StreamGeometry>
  <StreamGeometry x:Key="IconChevronDown">M6 9l6 6 6-6</StreamGeometry>
  <StreamGeometry x:Key="IconMinimize">M5 12h14</StreamGeometry>
  <!-- A window with an arrow leaving it: "move to a window of its own". -->
  <StreamGeometry x:Key="IconWindowExternal">M11 5H6a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-5M14 4h6v6M20 4l-9 9</StreamGeometry>
  <StreamGeometry x:Key="IconMaximize">M6 4h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z</StreamGeometry>
  <!-- Two overlapping windows: the maximize button turns into "restore" while the window is maximized. -->
  <StreamGeometry x:Key="IconRestore">M8 8V5a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1h-3M5 8h10a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z</StreamGeometry>
  <StreamGeometry x:Key="TreeChevronGeometry">M9 5 15 12 9 19</StreamGeometry>
  <StreamGeometry x:Key="IconChevronUp">M6 15l6-6 6 6</StreamGeometry>
  <StreamGeometry x:Key="IconTrash">M4 7h16M10 3h4M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M10 11v6M14 11v6</StreamGeometry>
  <!-- Git remote operations: fetch (cloud with arrow in), pull (arrow down to a bar), push (arrow up from a bar). -->
  <StreamGeometry x:Key="IconGitFetch">M7 17a4 4 0 0 1-.5-8A6 6 0 0 1 18 8.5a4.25 4.25 0 0 1-1 8.5M12 11v9M9 17l3 3 3-3</StreamGeometry>
  <StreamGeometry x:Key="IconGitPull">M12 4v12M7 11l5 5 5-5M5 20h14</StreamGeometry>
  <StreamGeometry x:Key="IconGitPush">M12 20V8M7 13l5-5 5 5M5 4h14</StreamGeometry>
  <!-- Composer icons. -->
  <StreamGeometry x:Key="IconArrowUp">M12 19V5M6 11l6-6 6 6</StreamGeometry>
  <StreamGeometry x:Key="IconEllipsis">M5.5 12h.01M12 12h.01M18.5 12h.01</StreamGeometry>
  <StreamGeometry x:Key="IconStar">M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z</StreamGeometry>
  <StreamGeometry x:Key="IconSparkle">M10 3l1.8 5.2L17 10l-5.2 1.8L10 17l-1.8-5.2L3 10l5.2-1.8zM18 15l.8 2.2 2.2.8-2.2.8L18 21l-.8-2.2L15 18l2.2-.8z</StreamGeometry>

</ResourceDictionary>
