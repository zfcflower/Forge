<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wc="using:Forge.App.Workbench.Controls"
        xmlns:ac="using:AvaloniaEdit.CodeCompletion">

  <!-- Text ramp. -->
  <Style Selector="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeMd}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <!-- :is() so SelectableTextBlock (tool arguments/results) gets the code font too; a type selector skips subclasses. -->
  <Style Selector=":is(TextBlock).mono">
    <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCode}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <Style Selector="TextBlock.section-title">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
    <!-- Bold, not SemiBold: the CJK fallback faces have no 600 weight, so SemiBold renders as regular here. -->
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <Style Selector="TextBlock.glyph">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Buttons. The base look is scoped to Forge's own button classes so the workbench chrome keeps the geometry its
       ControlThemes give it. -->
  <Style Selector="Button.primary">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="{StaticResource PaddingControl}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ButtonCornerRadius}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.ghost, Button.link, Button.tab, Button.icon">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="{StaticResource PaddingControl}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ButtonCornerRadius}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
  </Style>

  <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconButtonPressedBrush}" />
  </Style>

  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
  </Style>

  <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconButtonPressedBrush}" />
  </Style>

  <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
  </Style>

  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="MinWidth" Value="26" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.tab">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="Button.tab.selected">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
  </Style>

  <!-- A count badge: the number a tab (or any chrome row) owns, as a neutral pill so the accent colour stays with the
       selected item rather than with every count on the row. Inside a selected tab it flips to the panel surface with
       accent digits, reading as part of the accent chip instead of a second emphasis. Geometry follows the sub-agent run
       badge (16px pill, 10px semibold digits), which is the same "this row owns a count" reading. -->
  <!-- The pill grows with its digits (no fixed height or line height: those clipped the glyphs and pushed them off centre);
       the text is centred on both axes. -->
  <Style Selector="Border.count-badge">
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="MinHeight" Value="16" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource CountBadgeBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.count-badge > TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.tab.selected Border.count-badge">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>

  <Style Selector="Button.tab.selected Border.count-badge > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <Style Selector="Button.primary:disabled, Button.ghost:disabled, Button.icon:disabled, Button.tab:disabled, Button.link:disabled">
    <Setter Property="Opacity" Value="0.45" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>


  <!-- Surfaces. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    <Setter Property="Padding" Value="{StaticResource PaddingCard}" />
  </Style>

  <Style Selector="Border.divider">
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Height" Value="1" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>

  <!-- Transparent so a toolbar takes the colour of its region: white in Main, the sidebar grey at the sides. -->
  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <!-- Built-in inputs (TextBox, ComboBox, CheckBox, RadioButton, NumericUpDown, AutoCompleteBox) carry no type style:
       their height, padding, corner radius and font size come from the Fluent keys in `Tokens.axaml`, which is also the
       one place a template-child TextBox (inside a spinner or an auto-complete box) picks them up. -->

  <!-- Transcript. -->
  <Style Selector="Border.user-bubble">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource UserBubbleBrush}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="MaxWidth" Value="640" />
  </Style>

  <Style Selector="Border.turn-card">
    <Setter Property="Background" Value="{DynamicResource ToolCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Border.turn-header">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <Style Selector="Border.turn-body">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Padding" Value="10,0,0,0" />
    <Setter Property="Margin" Value="2,0,0,0" />
  </Style>

  <Style Selector="Border.tool-row">
    <Setter Property="Background" Value="{DynamicResource ToolBubbleBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="Margin" Value="0,2" />
  </Style>

  <Style Selector="Border.tool-row.expanded">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>

  <Style Selector="Border.notice">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Margin" Value="0,3" />
  </Style>

  <Style Selector="Border.notice.error">
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- The files panel's git row: a 24 px status line. One place answers "which branch, how far from the remote, and what
       can I do about it". Numbers ride on the two verbs that change something; the fetch verb has none because it only
       makes them current. -->
  <Style Selector="Border.git-row">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="8,0,4,0" />
    <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <Style Selector="Border.git-row.bad">
    <Setter Property="Background" Value="{DynamicResource ErrorBubbleBrush}" />
  </Style>

  <Style Selector="wc|FluentIcon.git-row-branch-icon">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.git-row-branch">
    <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.git-row-message">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.git-row.bad TextBlock.git-row-message">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <Style Selector="Button.git-row-details">
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />    
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.git-row-action">
    <Setter Property="MinWidth" Value="22" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="3,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource ButtonCornerRadius}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.git-row-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
  </Style>

  <Style Selector="Button.git-row-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconButtonPressedBrush}" />
  </Style>

  <Style Selector="Button.git-row-action:disabled">
    <Setter Property="Opacity" Value="0.45" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <!-- A count is the information, so it keeps its colour only while its verb is usable. -->
  <Style Selector="TextBlock.git-row-count">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.git-row-count.up">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <Style Selector="TextBlock.git-row-count.down">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>

  <Style Selector="Button.git-row-action:disabled TextBlock.git-row-count">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <!-- The 提交目标 row under the git row: two pills, no labels, so the branch name above keeps its width. -->
  <Style Selector="Border.git-ship">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="TextBlock.git-ship-hint">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="Button.git-pill">
    <Setter Property="Height" Value="22" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.git-pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
  </Style>

  <Style Selector="Button.git-pill.publish">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- The pull-request pill takes the colour of what the platform last said; "no pull request yet" stays neutral. -->
  <Style Selector="Button.git-pill.target">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="Button.git-pill.target.open">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <Style Selector="Button.git-pill.target.draft">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="Button.git-pill.target.merged">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <Style Selector="Button.git-pill.target.closed">
    <Setter Property="Background" Value="{DynamicResource ErrorBubbleBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <Style Selector="Button.git-ship-item">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.git-ship-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
  </Style>

  <Style Selector="Button.git-ship-item.disabled">
    <Setter Property="Opacity" Value="0.55" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <!-- A stopped rebase/merge: the only blocking state the panel shows, so it is the only place the danger bar is used. -->
  <Style Selector="Border.git-banner">
    <Setter Property="Background" Value="{DynamicResource ErrorBubbleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Padding" Value="6,4,6,6" />
  </Style>

  <Style Selector="TextBlock.git-banner-title">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="Button.git-banner-file">
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <!-- Tree rows (project tree, file tree, spec tree). Rows touch vertically so the 1 px indent guides line up. -->
  <Style Selector="Border.tree-row">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- The hover/selection surface starts after the indent guides: rounded, muted, and stretched to the right edge. -->
  <Style Selector="Border.tree-row-content">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Border.tree-row-content:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
  </Style>

  <Style Selector="ListBoxItem:selected Border.tree-row-content">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
  </Style>

  <!-- The row the shell is showing: the active session in the main region, or the sub-agent whose tab the bottom group has. -->
  <Style Selector="Border.tree-row-content.active-row">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
  </Style>

  <!-- 树行箭头:一枚 Fluent chevron_right,展开时整个图标转 90°。 -->
  <Style Selector="wc|FluentIcon.tree-chevron">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
  </Style>

  <Style Selector="wc|FluentIcon.tree-chevron.expanded">
    <Setter Property="RenderTransform" Value="rotate(90deg)" />
  </Style>

  <Style Selector="wc|FluentIcon.tree-icon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- The active session's row takes the primary colour: the tree's own "this is the conversation you are in" mark. Every
       other conversation row stays muted. -->
  <Style Selector="wc|FluentIcon.tree-icon.active-session">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.tree-chevron-button">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="8" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.tree-chevron-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.tree-chevron-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- A transparent whole-row hit target for the file tree: the name is plain body text, not a link button. -->
  <Style Selector="Button.tree-row-hit">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.tree-row-hit:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.tree-row-hit:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Agent kind icons are coloured by run state; ended/unknown falls back to the muted stroke above. -->
  <Style Selector="wc|FluentIcon.tree-icon.agent-running">
    <Setter Property="Foreground" Value="{DynamicResource RunningBrush}" />
  </Style>

  <Style Selector="wc|FluentIcon.tree-icon.agent-queued">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="wc|FluentIcon.tree-icon.agent-completed">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>

  <Style Selector="wc|FluentIcon.tree-icon.agent-failed">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <Style Selector="wc|FluentIcon.tree-icon.agent-stopped">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>

  <Style Selector="wc|FluentIcon.tree-icon.agent-running-animated">
    <Style.Animations>
      <Animation Duration="0:0:1.6" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.45" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="wc|SyntaxTokenTextBlock.syntax-keyword">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxKeywordBrush}" />
  </Style>

  <Style Selector="wc|SyntaxTokenTextBlock.syntax-string">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxStringBrush}" />
  </Style>

  <Style Selector="wc|SyntaxTokenTextBlock.syntax-comment">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxCommentBrush}" />
  </Style>

  <Style Selector="wc|SyntaxTokenTextBlock.syntax-number">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxNumberBrush}" />
  </Style>

  <Style Selector="wc|SyntaxTokenTextBlock.syntax-type">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxTypeBrush}" />
  </Style>

  <Style Selector="wc|SyntaxTokenTextBlock.syntax-function">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxFunctionBrush}" />
  </Style>

  <Style Selector="wc|SyntaxTokenTextBlock.syntax-variable">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxVariableBrush}" />
  </Style>

  <Style Selector="wc|SyntaxTokenTextBlock.syntax-preprocessor">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxPreprocessorBrush}" />
  </Style>

  <Style Selector="wc|SyntaxTokenTextBlock.syntax-invalid">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <Style Selector="Ellipse.status-dot">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="Ellipse.status-dot.running">
    <Setter Property="Fill" Value="{DynamicResource RunningBrush}" />
  </Style>

  <Style Selector="Ellipse.status-dot.starting">
    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
  </Style>

  <Style Selector="Ellipse.status-dot.failed">
    <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- The project tree spells a sub-agent's state with a dot or a check instead of a caption; the colours match the icon
       the same row shows, so one glance reads the state twice. -->
  <Style Selector="Ellipse.status-dot.agent-running">
    <Setter Property="Fill" Value="{DynamicResource RunningBrush}" />
  </Style>

  <Style Selector="Ellipse.status-dot.agent-queued">
    <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="Ellipse.status-dot.agent-failed">
    <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
  </Style>

  <Style Selector="Ellipse.status-dot.agent-stopped">
    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
  </Style>

  <Style Selector="Ellipse.status-dot.agent-ended">
    <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="wc|FluentIcon.status-check">
    <Setter Property="Width" Value="11" />
    <Setter Property="Height" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Diff. -->
  <Style Selector="Border.diff-line">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Height" Value="17" />
  </Style>

  <Style Selector="Border.diff-line.add">
    <Setter Property="Background" Value="{DynamicResource DiffAddBrush}" />
  </Style>

  <Style Selector="Border.diff-line.del">
    <Setter Property="Background" Value="{DynamicResource DiffRemoveBrush}" />
  </Style>

  <Style Selector="Border.diff-line.hunk">
    <Setter Property="Background" Value="{DynamicResource DiffHunkBrush}" />
  </Style>

  <!-- Lists stay flat: panels own their backgrounds. -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="ListBoxItem /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBoxItem:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- The rules above blank the default selection chrome for the workbench's own row lists. The completion popup is a
       list too, and there the selection must be visible: without these it can be moved with the arrow keys but nothing
       looks selected. Scoped to the list class Forge adds in FileDocumentView. -->
  <Style Selector="ac|CompletionList.completion ListBoxItem">
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="MinHeight" Value="20" />
  </Style>

  <Style Selector="ac|CompletionList.completion ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
  </Style>

  <Style Selector="ac|CompletionList.completion ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="ac|CompletionList.completion ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
  </Style>

  <!-- ============================ 改动范围 / 基准分支选择器 ============================
       picker 按钮:无边框、透明底,只在悬停/按下时出灰色圆角底;内容是 图标 + 文字 + 箭头。 -->
  <Style Selector="Button.change-picker">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="CornerRadius" Value="{DynamicResource ButtonCornerRadius}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.change-picker:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
  </Style>
  <Style Selector="Button.change-picker:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconButtonPressedBrush}" />
  </Style>
  <Style Selector="Button.change-picker:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- 弹层:去掉 FlyoutPresenter 自带的边框与底,由 change-menu 自己画白色 8px 圆角卡片和柔和阴影。 -->
  <Style Selector="FlyoutPresenter.change-flyout">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="Border.change-menu">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="BoxShadow" Value="{StaticResource ShadowMd}" />
  </Style>
  <Style Selector="Button.change-menu-row">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <!-- 选中行只有一层很淡的灰底(勾号才是主提示);悬停盖在它上面。 -->
  <Style Selector="Button.change-menu-row.selected">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
  </Style>
  <Style Selector="Button.change-menu-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
  </Style>
  <Style Selector="Button.change-menu-row:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconButtonPressedBrush}" />
  </Style>
  <Style Selector="Button.change-menu-row:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Button.change-menu-row:disabled">
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="TextBlock.change-menu-group">
    <Setter Property="Margin" Value="8,6,8,2" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.4" />
  </Style>
  <Style Selector="TextBlock.change-menu-subgroup">
    <Setter Property="Margin" Value="8,4,8,0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
  </Style>
  <Style Selector="TextBlock.change-menu-check">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="wc|FluentIcon.change-menu-check">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.change-menu-hint">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
  </Style>

  <!-- 分段开关:Border.segmented 里放 Button.segment,选中的那段是抬起的浅色药丸(拆分|内联、堆叠|单文件、预览|Source)。 -->
  <Style Selector="Border.segmented">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.segmented Button.segment">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.segmented Button.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Border.segmented Button.segment.selected">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Border.segmented Button.segment.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BoxShadow" Value="{StaticResource ShadowSm}" />
  </Style>
  <Style Selector="Border.segmented Button.segment.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>

  <!-- 改动块上方的操作条:整宽、浅灰圆角;保留之后换成淡绿。 -->
  <Style Selector="Border.diff-block-bar">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.diff-block-bar.kept">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
  </Style>

  <!-- 已改动树:文件行右侧的 +x −y 计数。 -->
  <Style Selector="TextBlock.change-added">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="TextBlock.change-removed">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- Side panels follow their column: a text keeps to one line and is cut to an ellipsis instead of wrapping, and
       TrimmedTextToolTip shows the whole of a cut text on hover. A text that sets its own wrapping keeps it. -->
  <Style Selector="wc|PanelChrome:sidebar TextBlock">
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- In-window notifications (toast): one notification as a fixed-width card (Views/NotificationOverlay). A 3 px level
       bar down the left edge, the level word, the title, up to four lines of body text and the xN badge of a merged
       repeated notification. The card keeps its width, so a long text wraps (or is cut) instead of pushing the stack
       around. -->
  <Style Selector="Border.toast">
    <Setter Property="Width" Value="380" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="BoxShadow" Value="{StaticResource ShadowMd}" />
    <!-- The level bar runs into the rounded corners; the card clips it. -->
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- The level bar and the level word: one colour per severity, taken from the semantic tokens. The base rule is the
       neutral information blue; the four level classes below are the ones the template actually selects. -->
  <Style Selector="Border.toast-level">
    <Setter Property="Width" Value="3" />
    <Setter Property="Background" Value="{DynamicResource InfoBrush}" />
  </Style>
  <Style Selector="Border.toast.info Border.toast-level">
    <Setter Property="Background" Value="{DynamicResource InfoBrush}" />
  </Style>
  <Style Selector="Border.toast.success Border.toast-level">
    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="Border.toast.warning Border.toast-level">
    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="Border.toast.error Border.toast-level">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
  </Style>

  <Style Selector="TextBlock.toast-level-text">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.4" />
    <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="Border.toast.info TextBlock.toast-level-text">
    <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
  </Style>
  <Style Selector="Border.toast.success TextBlock.toast-level-text">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="Border.toast.warning TextBlock.toast-level-text">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="Border.toast.error TextBlock.toast-level-text">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <Style Selector="TextBlock.toast-title">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.toast-body">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- The ×N badge of a notification that arrived again while it was already on screen. -->
  <Style Selector="Border.toast-count">
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="MinHeight" Value="15" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource CountBadgeBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.toast-count > TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Enter and exit. `entering` is on while the toast is not leaving (so a repeat that claims a leaving toast brings
       it back), `leaving` is the center's IsLeaving flag: 160 ms, inside the 180 ms the center waits before it drops the
       item from the list, so the fade is always finished before the toast disappears. -->
  <Style Selector="Border.toast.entering">
    <Style.Animations>
      <Animation Duration="0:0:0.16" Easing="CubicEaseOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.toast.leaving">
    <Style.Animations>
      <Animation Duration="0:0:0.16" Easing="CubicEaseIn">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

</Styles>
