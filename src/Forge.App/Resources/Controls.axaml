<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wc="using:Forge.App.Workbench.Controls"
        xmlns:ac="using:AvaloniaEdit.CodeCompletion">

  <!-- Text ramp. -->
  <Style Selector="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!-- The thinking row: one step up from the caption it replaces (12 px, weight 500), still quieter than the reply. -->
  <Style Selector="TextBlock.thinking-line">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <!-- :is() so SelectableTextBlock (tool arguments/results) gets the code font too; a type selector skips subclasses. -->
  <Style Selector=":is(TextBlock).mono">
    <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCode}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!-- Text selection in a selectable transcript block takes the two selection tokens. A TextBox's own selection stays with
       Fluent, exactly like its TextControl* brushes: there is no theme key to redirect it, and a `TextBox` type selector is
       the one selector this file does not write (it reaches the inner box of a spinner or a combo box as well). -->
  <Style Selector="SelectableTextBlock">
    <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBackgroundBrush}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource SelectionForegroundBrush}" />
  </Style>

  <!-- Buttons. The base look is scoped to Forge's own button classes so the workbench chrome keeps the geometry its
       ControlThemes give it. -->

  <Style Selector="Button.ghost, Button.link, Button.icon">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="{StaticResource PaddingControl}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ButtonCornerRadius}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
  </Style>

  <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconButtonPressedBrush}" />
  </Style>

  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
  </Style>

  <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconButtonPressedBrush}" />
  </Style>

  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
    <Setter Property="Foreground" Value="{DynamicResource BrandActionBrush}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="MinWidth" Value="26" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.primary:disabled, Button.ghost:disabled, Button.icon:disabled, Button.tab:disabled, Button.link:disabled">
    <Setter Property="Opacity" Value="0.45" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <!-- Surfaces. -->

  <!-- Built-in inputs (TextBox, ComboBox, CheckBox, RadioButton, NumericUpDown, AutoCompleteBox) carry no type style:
       their height, padding, corner radius and font size come from the Fluent keys in `Tokens.axaml`, which is also the
       one place a template-child TextBox (inside a spinner or an auto-complete box) picks them up. -->

  <!-- Transcript. -->
  <Style Selector="Border.user-bubble">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource BrandTintBrush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style Selector="Border.turn-card">
    <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- The reply's own surface: a card on the text column's left edge, matching the user bubble opposite it. White rather than
       the window's off-white, so the reply sits on top of the page instead of blending into it. -->
  <Style Selector="Border.assistant-card">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Border.tool-row">
    <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="Margin" Value="0,2" />
  </Style>

  <Style Selector="Border.tool-row.expanded">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
  </Style>

  <!-- A tool card: the reply card's face (white, 1px outline, 8px corner), with only the surface moving under the pointer. -->
  <Style Selector="Button.tool-card">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="7,6,8,7" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.tool-card /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
  </Style>

  <Style Selector="Button.tool-card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
  </Style>

  <Style Selector="Button.tool-card:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
  </Style>

  <Style Selector="Button.tool-card.open /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource BrandActionBrush}" />
  </Style>

  <Style Selector="TextBlock.tool-card-name">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.tool-card-body">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="wc|FluentIcon.tool-status">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
  </Style>

  <Style Selector="wc|FluentIcon.tool-status.ok">
    <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}" />
  </Style>

  <Style Selector="wc|FluentIcon.tool-status.fail">
    <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
  </Style>

  <Style Selector="wc|FluentIcon.tool-status.run">
    <Setter Property="Foreground" Value="{DynamicResource BrandActionBrush}" />
  </Style>

  <Style Selector="wc|FluentIcon.tool-status.wait">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="Border.tool-open">
    <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="8,6" />
  </Style>

  <Style Selector="Border.notice">
    <Setter Property="BorderBrush" Value="{DynamicResource BrandInteractiveBrush}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Margin" Value="0,3" />
  </Style>

  <Style Selector="Border.notice.error">
    <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBrush}" />
  </Style>

  <!-- 树行箭头:一枚 Fluent chevron_right,展开时整个图标转 90°。 -->
  <Style Selector="wc|FluentIcon.tree-chevron">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
  </Style>

  <Style Selector="wc|FluentIcon.tree-chevron.expanded">
    <Setter Property="RenderTransform" Value="rotate(90deg)" />
  </Style>

  <Style Selector="wc|SyntaxTokenTextBlock.syntax-keyword">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxKeywordBrush}" />
  </Style>

  <Style Selector="wc|SyntaxTokenTextBlock.syntax-string">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxStringBrush}" />
  </Style>

  <Style Selector="wc|SyntaxTokenTextBlock.syntax-comment">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxCommentBrush}" />
  </Style>

  <Style Selector="wc|SyntaxTokenTextBlock.syntax-number">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxNumberBrush}" />
  </Style>

  <Style Selector="wc|SyntaxTokenTextBlock.syntax-type">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxTypeBrush}" />
  </Style>

  <Style Selector="wc|SyntaxTokenTextBlock.syntax-function">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxFunctionBrush}" />
  </Style>

  <Style Selector="wc|SyntaxTokenTextBlock.syntax-variable">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxVariableBrush}" />
  </Style>

  <Style Selector="wc|SyntaxTokenTextBlock.syntax-preprocessor">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxPreprocessorBrush}" />
  </Style>

  <Style Selector="wc|SyntaxTokenTextBlock.syntax-invalid">
    <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
  </Style>

  <!-- Lists stay flat: panels own their backgrounds. -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="ListBoxItem /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBoxItem:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- The rules above blank the default selection chrome for the workbench's own row lists. The completion popup is a
       list too, and there the selection must be visible: without these it can be moved with the arrow keys but nothing
       looks selected. Scoped to the list class Forge adds in FileDocumentView. -->
  <Style Selector="ac|CompletionList.completion ListBoxItem">
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="MinHeight" Value="20" />
  </Style>

  <Style Selector="ac|CompletionList.completion ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <Style Selector="ac|CompletionList.completion ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="ac|CompletionList.completion ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
  </Style>

  <!-- Side panels follow their column: a text keeps to one line and is cut to an ellipsis instead of wrapping, and
       TrimmedTextToolTip shows the whole of a cut text on hover. A text that sets its own wrapping keeps it. -->
  <Style Selector="wc|PanelChrome:sidebar TextBlock">
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

</Styles>
