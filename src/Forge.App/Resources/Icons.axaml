    <!-- 唯一的图标渲染件:<controls:FluentIcon>(<see cref="Avalonia.Controls.PathIcon"/> 的零逻辑子类,不改绘制)。
       它的模板把一块固定的 24x24 画布放进 Viewbox,于是缩放的是网格而不是图标的墨迹外框——FIS 的图形在 24 网格里
       通常只占 18 个单位,按墨迹拉伸会让 14px 的按钮图标比设计大一号。默认 14 与旧标题栏一致,使用处的 Width/Height
       仍然优先。刻意不覆盖内置 PathIcon 的主题:那是框架控件(下拉箭头、展开器)也在用的类型。 -->
  <ControlTheme x:Key="{x:Type controls:FluentIcon}" TargetType="controls:FluentIcon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
              <Path Data="{TemplateBinding Data}" Fill="{TemplateBinding Foreground}" Stretch="None" />
            </Canvas>
          </Viewbox>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

