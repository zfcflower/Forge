<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wc="using:Forge.App.Workbench.Controls"
        xmlns:ac="using:AvaloniaEdit.CodeCompletion">

  <!-- The change-scope and base-branch picker and its flyout. Included by Views/FilesToolView, Views/BranchPickerView and Views/NewBranchDialog. -->

  <!-- ============================ 改动范围 / 基准分支选择器 ============================
       picker 按钮:无边框、透明底,只在悬停/按下时出灰色圆角底;内容是 图标 + 文字 + 箭头。 -->
  <Style Selector="Button.change-picker">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="CornerRadius" Value="{DynamicResource ButtonCornerRadius}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.change-picker:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
  </Style>
  <Style Selector="Button.change-picker:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconButtonPressedBrush}" />
  </Style>
  <Style Selector="Button.change-picker:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- 弹层:去掉 FlyoutPresenter 自带的边框与底,由 change-menu 自己画白色 8px 圆角卡片和柔和阴影。 -->
  <Style Selector="FlyoutPresenter.change-flyout">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="Border.change-menu">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ButtonCornerRadius}" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="BoxShadow" Value="{StaticResource ShadowMd}" />
  </Style>
  <Style Selector="Button.change-menu-row">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <!-- Stretch is the row's hit area: a Button left-aligns to its content unless it says otherwise, which would leave the
         blank end of a short row (and the whole width of an empty column) outside the row - it would neither light under the
         pointer nor take the click. A row in a flyout is one full-width rectangle. -->
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <!-- 选中行只有一层很淡的灰底(勾号才是主提示);悬停盖在它上面。 -->
  <Style Selector="Button.change-menu-row.selected">
    <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
  </Style>
  <Style Selector="Button.change-menu-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
  </Style>
  <Style Selector="Button.change-menu-row:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconButtonPressedBrush}" />
  </Style>
  <Style Selector="Button.change-menu-row:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
  </Style>
  <Style Selector="Button.change-menu-row:disabled">
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="TextBlock.change-menu-group">
    <Setter Property="Margin" Value="8,6,8,2" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.4" />
  </Style>
  <Style Selector="TextBlock.change-menu-subgroup">
    <Setter Property="Margin" Value="8,4,8,0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
  </Style>
  <Style Selector="TextBlock.change-menu-check">
    <Setter Property="Foreground" Value="{DynamicResource BrandActionBrush}" />
  </Style>
  <Style Selector="wc|FluentIcon.change-menu-check">
    <Setter Property="Foreground" Value="{DynamicResource BrandActionBrush}" />
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.change-menu-hint">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
  </Style>

</Styles>
