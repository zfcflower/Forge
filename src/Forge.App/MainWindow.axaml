<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ap="using:Forge.App.Approval"
        xmlns:vm="using:Forge.App.ViewModels"
        xmlns:wb="using:Forge.App.Workbench.Controls"
        xmlns:prefs="using:Forge.App.Preferences"
        xmlns:loc="using:Forge.App.Localization"
        x:Class="Forge.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Forge"
        Width="1440"
        Height="900"
        MinWidth="900"
        MinHeight="560"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource SurfaceBackgroundBrush}">

  <Window.KeyBindings>
    <!-- Ctrl+` opens a terminal in the active session; a focused terminal leaves this gesture to the window. -->
    <KeyBinding Gesture="Ctrl+OemTilde" Command="{Binding NewTerminalCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Window top: the window background itself, so there is no separate title-bar fill. The caption buttons are drawn
         here because the client area extends into the title bar; the settings button sits to their left. -->
    <Border x:Name="TitleBar"
            Grid.Row="0"
            Height="40"
            PointerPressed="OnTitleBarPointerPressed"
            Background="{DynamicResource SurfaceBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0,8,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="Forge"
                     Classes="h2"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource AccentTextBrush}" />
          <TextBlock Classes="caption"
                     VerticalAlignment="Center"
                     MaxWidth="320"
                     Text="{Binding ActiveSessionTitle}" />
          <TextBlock Classes="caption"
                     VerticalAlignment="Center"
                     MaxWidth="200"
                     TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding HasActiveBranch}"
                     Text="{Binding ActiveBranchText}"
                     ToolTip.Tip="{Binding ActiveBranchText}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     AutomationProperties.AutomationId="title-branch" />
        </StackPanel>

        <TextBox x:Name="SearchBox"
                 Grid.Column="1"
                 Width="380"
                 Height="26"
                 MinHeight="26"
                 Padding="10,3"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 VerticalContentAlignment="Center"
                 CornerRadius="6"
                 FontSize="{DynamicResource FontSizeSm}"
                 Background="{DynamicResource SearchBoxBackgroundBrush}"
                 BorderBrush="{DynamicResource SearchBoxBorderBrush}"
                 BorderThickness="1"
                 PlaceholderText="{Binding [shell.searchPlaceholder], Source={x:Static loc:Loc.Instance}}"
                 AutomationProperties.AutomationId="shell-search"
                 AutomationProperties.Name="{Binding [shell.search], Source={x:Static loc:Loc.Instance}}" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Classes="ghost icon"
                  Width="30"
                  Height="26"
                  Command="{Binding ToggleSettingsCommand}"
                  AutomationProperties.AutomationId="open-settings" AutomationProperties.Name="{Binding [shell.settings], Source={x:Static loc:Loc.Instance}}"
                  ToolTip.Tip="{Binding [shell.settings], Source={x:Static loc:Loc.Instance}}">
            <PathIcon Data="{StaticResource IconGear}" Width="15" Height="15" />
          </Button>
          <Button x:Name="MinimizeButton"
                  Classes="ghost icon"
                  Width="34"
                  Height="26"
                  Click="OnMinimizeClick"
                  AutomationProperties.AutomationId="window-minimize" AutomationProperties.Name="{Binding [window.minimize], Source={x:Static loc:Loc.Instance}}"
                  ToolTip.Tip="{Binding [window.minimize], Source={x:Static loc:Loc.Instance}}">
            <PathIcon Data="{StaticResource IconMinimize}" Width="11" Height="11" />
          </Button>
          <Button x:Name="MaximizeButton"
                  Classes="ghost icon"
                  Width="34"
                  Height="26"
                  Click="OnMaximizeClick"
                  AutomationProperties.AutomationId="window-maximize">
            <PathIcon x:Name="MaximizeIcon" Data="{StaticResource IconMaximize}" Width="11" Height="11" />
          </Button>
          <Button x:Name="CloseButton"
                  Classes="ghost icon"
                  Width="34"
                  Height="26"
                  Click="OnCloseClick"
                  AutomationProperties.AutomationId="window-close" AutomationProperties.Name="{Binding [window.closeWindow], Source={x:Static loc:Loc.Instance}}"
                  ToolTip.Tip="{Binding [window.close], Source={x:Static loc:Loc.Instance}}">
            <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Workbench: project | main | inspector, rendered from the layout model -->
    <wb:WorkbenchHost Grid.Row="1" Layout="{Binding Workbench}" />

    <!-- Approval queue: the non-modal panel in the bottom-right corner. It resolves the shell's approval services from
         its own constructor, so the root view model does not have to carry it. -->
    <ap:ApprovalQueueOverlay Grid.Row="1" />

    <!-- Status bar -->
    <Border Grid.Row="2"
            MinHeight="26"
            Padding="14,0"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Ellipse Classes="status-dot"
                   Classes.running="{Binding Status.IsHostRunning}"
                   Classes.starting="{Binding Status.IsHostStarting}"
                   Classes.failed="{Binding Status.IsHostFailed}" />
          <TextBlock Classes="caption" Text="{Binding Status.HostText}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="1" Classes="caption" Margin="14,0,0,0" Text="{Binding Status.PluginsText}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Classes="caption" Margin="14,0,0,0" Text="{Binding Status.McpText}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Classes="caption" Margin="14,0,0,0" Text="{Binding Status.ApprovalsText}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="4"
                   Classes="caption"
                   Margin="14,0,0,0"
                   MaxWidth="260"
                   Text="{Binding Status.ProviderText}"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="5"
                   Classes="caption"
                   Margin="14,0,0,0"
                   Text="{Binding GeneralWorkspaceText}"
                   ToolTip.Tip="{Binding GeneralWorkspaceText}"
                   MaxWidth="280"
                   VerticalAlignment="Center" />
        <Button Grid.Column="6"
                Classes="tab"
                Margin="14,0,0,0"
                VerticalAlignment="Center"
                Content="{Binding TerminalButtonText}"
                Command="{Binding NewTerminalCommand}"
                AutomationProperties.AutomationId="terminal-open"
                AutomationProperties.Name="{Binding TerminalButtonText}"
                ToolTip.Tip="{Binding TerminalButtonText}" />
        <StackPanel Grid.Column="7"
                    Orientation="Horizontal"
                    Spacing="10"
                    Margin="14,0,0,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left">
          <TextBlock Classes="caption"
                     VerticalAlignment="Center"
                     IsVisible="{Binding Status.HasAheadBehind}"
                     Text="{Binding Status.AheadBehindText}"
                     AutomationProperties.AutomationId="status-ahead-behind" />
          <TextBlock Classes="caption"
                     VerticalAlignment="Center"
                     IsVisible="{Binding Status.HasChecks}"
                     Text="{Binding Status.ChecksText}"
                     AutomationProperties.AutomationId="status-checks" />
        </StackPanel>
        <TextBlock Grid.Column="7"
                   Classes="caption"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   IsVisible="{Binding Status.HasHostDetail}"
                   Text="{Binding Status.HostDetail}"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="420" />
      </Grid>
    </Border>

    <!-- Settings overlay: the body is the registered section list (provider, paths and whatever a feature adds), and
         each section's view model is rendered by the app-level data template for its type. -->
    <Border Grid.RowSpan="3"
            Background="{DynamicResource SurfaceBackgroundBrush}"
            Opacity="0.92"
            IsVisible="{Binding Settings.IsOpen}">
      <Border Classes="card"
              Width="720"
              MaxHeight="560"
              Padding="20"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              BoxShadow="{StaticResource ShadowMd}">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2"
                       VerticalAlignment="Center"
                       Text="{Binding Settings.Title}"
                       AutomationProperties.AutomationId="settings-title" />
            <Button Grid.Column="1"
                    Classes="ghost icon"
                    Command="{Binding ToggleSettingsCommand}"
                    AutomationProperties.AutomationId="close-settings" AutomationProperties.Name="{Binding [shell.closeSettings], Source={x:Static loc:Loc.Instance}}">
              <PathIcon Data="{StaticResource IconClose}" Width="13" Height="13" />
            </Button>
          </Grid>

          <!-- Two columns: a section nav on the left, the selected section's body on the right. -->
          <Grid Grid.Row="1" ColumnDefinitions="180,*" Margin="0,12,0,0">
            <ListBox Grid.Column="0"
                     ItemsSource="{Binding Settings.Sections.Items}"
                     SelectedItem="{Binding Settings.SelectedSection, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     AutomationProperties.AutomationId="settings-nav">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="prefs:SettingsSection">
                  <TextBlock Text="{Binding Title}"
                             FontSize="{DynamicResource FontSizeSm}"
                             Padding="10,7"
                             VerticalAlignment="Center"
                             AutomationProperties.AutomationId="{Binding Id}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Column="1"
                          Margin="16,0,0,0"
                          VerticalScrollBarVisibility="Auto"
                          AutomationProperties.AutomationId="settings-body">
              <ContentControl Content="{Binding Settings.SelectedSection.ViewModel}" />
            </ScrollViewer>
          </Grid>

          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
            <Button Classes="primary"
                    Command="{Binding ReloadSettingsCommand}"
                    Content="{Binding Settings.ReloadText}" />
            <Button Classes="ghost"
                    Command="{Binding ToggleSettingsCommand}"
                    Content="{Binding Settings.CloseText}" />
          </StackPanel>
        </Grid>
      </Border>
    </Border>
  </Grid>
</Window>
