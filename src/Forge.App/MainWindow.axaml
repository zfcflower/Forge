<Window xmlns="https://github.com/avaloniaui"
        xmlns:wc="using:Forge.App.Workbench.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ap="using:Forge.App.Approval"
        xmlns:vm="using:Forge.App.ViewModels"
        xmlns:wb="using:Forge.App.Workbench.Controls"
        xmlns:loc="using:Forge.App.Localization"
        xmlns:views="using:Forge.App.Views"
        x:Class="Forge.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Forge"
        Width="1440"
        Height="900"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource SurfaceBackgroundBrush}">
  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <Window.KeyBindings>
    <!-- Ctrl+` opens a terminal in the active session; a focused terminal leaves this gesture to the window. -->
    <KeyBinding Gesture="Ctrl+OemTilde" Command="{Binding NewTerminalCommand}" />
    <!-- The global palette: Ctrl+P files, Ctrl+Shift+P commands, Ctrl+Shift+F workspace text. Every gesture toggles its
         source, so pressing it again closes the palette instead of wiping the typed query. -->
    <KeyBinding Gesture="Ctrl+P" Command="{Binding OpenFilePaletteCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding OpenCommandPaletteCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding OpenSearchPaletteCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="Auto,*">

    <!-- Window top: the same chrome colour as every panel title bar below it, so the whole top edge of the window reads
    as one surface. The caption buttons are drawn here because the client area extends into the title bar; the
    settings button sits to their left. -->
    <Border x:Name="TitleBar"
            Grid.Row="0"
            Height="40"
            PointerPressed="OnTitleBarPointerPressed"
            Background="{DynamicResource PanelTitleBarBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0,8,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <!-- The title row carries the logo lockup only: the project tree on the left already shows the open session
          and its branch, so repeating them here was redundant. The wordmark is the product's own name, so it is
          not translated. -->
          <Image x:Name="AppLogo"
                 Source="avares://Forge.App/Assets/forge.png"
                 Width="18"
                 Height="18"
                 VerticalAlignment="Center"
                 AutomationProperties.Name="Forge" />
          <TextBlock x:Name="AppWordmark"
                     FontSize="{DynamicResource FontSizeWordmark}"
                     FontWeight="Medium"
                     Foreground="{DynamicResource AccentTextBrush}"
                     Text="FORGE" />
          <!-- Automations entry: opens Settings > Automations; the badge counts the running and waiting runs only and
          is hidden at zero. -->
          <Button Classes="ghost"
                  Margin="10,0,0,0"
                  Height="26"
                  Padding="6,0"
                  Command="{Binding OpenAutomationsCommand}"
                  ToolTip.Tip="{Binding AutomationsTooltip}"
                  AutomationProperties.AutomationId="automations-open"
                  AutomationProperties.Name="{Binding [automations.titleBar.label], Source={x:Static loc:Loc.Instance}}">
            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
              <wc:FluentIcon Data="{StaticResource IconBolt}" Width="14" Height="14" />
              <TextBlock Classes="caption" Text="{Binding [automations.titleBar.label], Source={x:Static loc:Loc.Instance}}" />
              <Border Classes="count-badge"
                      IsVisible="{Binding HasRunningAutomations}"
                      AutomationProperties.AutomationId="automations-running">
                <TextBlock Text="{Binding AutomationsRunningText}" />
              </Border>
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Right-aligned search affordance and host state, sitting just left of the caption buttons: the search button opens the palette
        (disabled until wave W3), and the extension host's state is the one live readout the
        header carries — the same state the status bar spells out in words. -->
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="18"
                    Margin="0,0,12,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
          <Button Classes="ghost icon"
                  Width="30"
                  Height="26"
                  Command="{Binding OpenPaletteCommand}"
                  ToolTip.Tip="{Binding [shell.searchPlaceholder], Source={x:Static loc:Loc.Instance}}"
                  AutomationProperties.Name="{Binding [shell.search], Source={x:Static loc:Loc.Instance}}"
                  AutomationProperties.AutomationId="shell-search">
            <wc:FluentIcon Data="{StaticResource IconSearch}"
                           Width="16"
                           Height="16"
                           Foreground="{DynamicResource TextMutedBrush}" />
          </Button>
          <!-- The plan panel of the active session: one click opens the plan summary, the steps and the revision
               history, and a second click closes it again. Disabled while no session is open, because there is no plan. -->
          <Button Classes="ghost icon"
                  Width="30"
                  Height="26"
                  Command="{Binding OpenPlanCommand}"
                  ToolTip.Tip="{Binding [plan.tooltip], Source={x:Static loc:Loc.Instance}}"
                  AutomationProperties.AutomationId="plan-open"
                  AutomationProperties.Name="{Binding [plan.title], Source={x:Static loc:Loc.Instance}}">
            <wc:FluentIcon Data="{StaticResource IconPlan}"
                           Width="16"
                           Height="16"
                           Foreground="{DynamicResource TextMutedBrush}" />
          </Button>
          <StackPanel Orientation="Horizontal"
                      Spacing="6"
                      VerticalAlignment="Center"
                      ToolTip.Tip="{Binding Status.HostTooltip}"
                      AutomationProperties.AutomationId="host-state">
            <Ellipse Classes="status-dot"
                     Classes.running="{Binding Status.IsHostRunning}"
                     Classes.starting="{Binding Status.IsHostStarting}"
                     Classes.failed="{Binding Status.IsHostFailed}" />
            <TextBlock Classes="caption" Text="{Binding [status.host.name], Source={x:Static loc:Loc.Instance}}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Classes="ghost icon"
                  Width="30"
                  Height="26"
                  Command="{Binding NewTerminalCommand}"
                  AutomationProperties.AutomationId="terminal-open"
                  AutomationProperties.Name="{Binding TerminalButtonText}"
                  ToolTip.Tip="{Binding TerminalButtonText}">
            <wc:FluentIcon Data="{StaticResource IconTerminal}" Width="15" Height="15" />
          </Button>
          <Button Classes="ghost icon"
                  Width="30"
                  Height="26"
                  Command="{Binding ToggleSettingsCommand}"
                  AutomationProperties.AutomationId="open-settings" AutomationProperties.Name="{Binding [shell.settings], Source={x:Static loc:Loc.Instance}}"
                  ToolTip.Tip="{Binding [shell.settings], Source={x:Static loc:Loc.Instance}}">
            <wc:FluentIcon Data="{StaticResource IconGear}" Width="15" Height="15" />
          </Button>
          <Button x:Name="MinimizeButton"
                  Classes="ghost icon"
                  Width="34"
                  Height="26"
                  Click="OnMinimizeClick"
                  AutomationProperties.AutomationId="window-minimize" AutomationProperties.Name="{Binding [window.minimize], Source={x:Static loc:Loc.Instance}}"
                  ToolTip.Tip="{Binding [window.minimize], Source={x:Static loc:Loc.Instance}}">
            <wc:FluentIcon Data="{StaticResource IconMinimize}" Width="13" Height="13" />
          </Button>
          <Button x:Name="MaximizeButton"
                  Classes="ghost icon"
                  Width="34"
                  Height="26"
                  Click="OnMaximizeClick"
                  AutomationProperties.AutomationId="window-maximize">
            <wc:FluentIcon x:Name="MaximizeIcon" Data="{StaticResource IconMaximize}" Width="13" Height="13" />
          </Button>
          <Button x:Name="CloseButton"
                  Classes="ghost icon"
                  Width="34"
                  Height="26"
                  Click="OnCloseClick"
                  AutomationProperties.AutomationId="window-close" AutomationProperties.Name="{Binding [window.closeWindow], Source={x:Static loc:Loc.Instance}}"
                  ToolTip.Tip="{Binding [window.close], Source={x:Static loc:Loc.Instance}}">
            <wc:FluentIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Workbench: project | main | inspector, rendered from the layout model -->
    <wb:WorkbenchHost Grid.Row="1" Layout="{Binding Workbench}" />

    <!-- Approval queue: the non-modal panel in the bottom-right corner. It resolves the shell's approval services from
    its own constructor, so the root view model does not have to carry it. -->
    <!-- Window overlays: each draws the template of its view model (App.axaml) and is empty while the property is null. -->
    <ContentControl Grid.Row="1" Content="{Binding Checks}" />
    <ContentControl Grid.Row="1" Content="{Binding Plan}" />
    <ContentControl Grid.Row="1" Content="{Binding Inspector}" />
    <ContentControl Grid.Row="1" Content="{Binding Onboarding}" />

    <ap:ApprovalQueueOverlay Grid.Row="1" />

    <!-- The app status bar is gone: the extension host's state lives in the title row (dot plus tooltip), ahead/behind and
    the CI marker moved into the session composer's strip, the project path into that strip's project button, and the
    provider's status into the provider section of the settings page. -->

    <!-- In-window toasts: the last child of the root grid, so they draw above the workbench. It sits in the workbench row
    (below the 40 px title bar) so a toast never covers the title. The overlay resolves the shell's NotificationCenter from
    its own constructor, and it takes no pointer: the cards are display only. -->
    <views:NotificationOverlay Grid.Row="1" />

    <!-- The palette's overlay is the last child of the grid, so its scrim dims the workbench, the approvals and the toasts
         alike: opening it puts the whole window behind one card. The other four overlays keep their order above. -->
    <ContentControl Grid.Row="1" Content="{Binding Palette}" />
  </Grid>
</Window>
