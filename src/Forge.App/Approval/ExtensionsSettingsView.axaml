<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ap="using:Forge.App.Approval"
             xmlns:loc="using:Forge.App.Localization"
             x:Class="Forge.App.Approval.ExtensionsSettingsView"
             x:DataType="ap:ExtensionsSettingsSectionViewModel">

  <UserControl.Styles>
    <StyleInclude Source="avares://Forge.App/Resources/ChromeStyles.axaml" />
    <Style Selector="Border.origin-badge">
      <Setter Property="Background" Value="{DynamicResource BrandTintBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="6">

    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Classes="h2"
                 Text="{Binding InstalledTitle}"
                 AutomationProperties.AutomationId="extensions-installed-title" />
      <Button Grid.Column="1"
              Classes="outline"
              Command="{Binding RefreshCommand}"
              Content="{Binding RefreshText}"
              AutomationProperties.AutomationId="extensions-refresh"
              AutomationProperties.Name="{Binding [Extensions.Settings.Refresh], Source={x:Static loc:Loc.Instance}}" />
    </Grid>

    <Border Classes="notice" IsVisible="{Binding HasUnavailableText}">
      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding UnavailableText}" />
    </Border>
    <Border Classes="notice error" IsVisible="{Binding HasActionProblem}">
      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding ActionProblem}" />
    </Border>
    <Border Classes="notice error" IsVisible="{Binding HasRulesProblem}">
      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding RulesProblemText}" />
    </Border>

    <!-- Installed extensions: state, tools, enable/disable, delete with a second confirmation. -->
    <StackPanel Spacing="4" IsVisible="{Binding ShowExtensions}">
      <ItemsControl ItemsSource="{Binding Installed}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="ap:InstalledExtensionViewModel">
            <Border Classes="card" Margin="0,0,0,6" Padding="8">
              <StackPanel Spacing="2">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                  <SelectableTextBlock Classes="mono" Text="{Binding Id}" />
                  <TextBlock Grid.Column="1" Classes="caption" Margin="8,0" Text="{Binding Version}" />
                  <Border Grid.Column="2" Classes="origin-badge" Margin="0,0,6,0">
                    <TextBlock Classes="caption" Text="{Binding OriginText}" />
                  </Border>
                  <TextBlock Grid.Column="3" Classes="caption" Text="{Binding StatusText}" />
                </Grid>
                <TextBlock Classes="caption"
                           IsVisible="{Binding HasTools}"
                           TextWrapping="Wrap"
                           Text="{Binding ToolsText}" />
                <TextBlock Classes="caption"
                           IsVisible="{Binding HasError}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource StatusErrorBrush}"
                           Text="{Binding ErrorText}" />
                <WrapPanel Margin="0,4,0,0">
                  <Button Classes="outline"
                          Margin="0,0,6,6"
                          IsVisible="{Binding CanEnable}"
                          Command="{Binding EnableCommand}"
                          Content="{Binding [Extensions.Settings.Enable], Source={x:Static loc:Loc.Instance}}"
                          AutomationProperties.AutomationId="extensions-enable" />
                  <Button Classes="outline"
                          Margin="0,0,6,6"
                          IsVisible="{Binding CanDisable}"
                          Command="{Binding DisableCommand}"
                          Content="{Binding [Extensions.Settings.Disable], Source={x:Static loc:Loc.Instance}}"
                          AutomationProperties.AutomationId="extensions-disable" />
                  <Button Classes="flat"
                          Margin="0,0,6,6"
                          Foreground="{DynamicResource StatusErrorBrush}"
                          IsVisible="{Binding ShowDelete}"
                          Command="{Binding DeleteCommand}"
                          Content="{Binding [Extensions.Settings.Delete], Source={x:Static loc:Loc.Instance}}"
                          AutomationProperties.AutomationId="extensions-delete" />
                  <Button Classes="flat"
                          Margin="0,0,6,6"
                          Foreground="{DynamicResource StatusErrorBrush}"
                          IsVisible="{Binding ShowConfirmDelete}"
                          Command="{Binding ConfirmDeleteCommand}"
                          Content="{Binding [Extensions.Settings.DeleteConfirm], Source={x:Static loc:Loc.Instance}}"
                          AutomationProperties.AutomationId="extensions-delete-confirm" />
                  <Button Classes="outline"
                          Margin="0,0,6,6"
                          IsVisible="{Binding ShowConfirmDelete}"
                          Command="{Binding CancelDeleteCommand}"
                          Content="{Binding [Extensions.Settings.Cancel], Source={x:Static loc:Loc.Instance}}"
                          AutomationProperties.AutomationId="extensions-delete-cancel" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="caption"
                 IsVisible="{Binding ShowInstalledEmpty}"
                 Text="{Binding [Extensions.Settings.NoInstalled], Source={x:Static loc:Loc.Instance}}" />
    </StackPanel>

    <!-- Repository: browse a repo.json index, install or update a package, or install a local zip. -->
    <StackPanel Spacing="4" IsVisible="{Binding ShowExtensions}">
      <TextBlock Classes="h2"
                 Text="{Binding RepositoryTitle}"
                 AutomationProperties.AutomationId="extensions-repository-title" />
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <TextBox Grid.Row="0"
                 Grid.Column="0"
                 PlaceholderText="{Binding [Extensions.Settings.RepositoryUrl], Source={x:Static loc:Loc.Instance}}"
                 Text="{Binding RepositoryUrl, Mode=TwoWay}"
                 AutomationProperties.AutomationId="extensions-repository-url" />
        <Button Grid.Row="0"
                Grid.Column="1"
                Classes="outline"
                Margin="6,0,0,0"
                Command="{Binding BrowseRepositoryCommand}"
                Content="{Binding RepositoryBrowseText}"
                AutomationProperties.AutomationId="extensions-repository-browse" />
        <Button Grid.Row="1"
                Grid.ColumnSpan="2"
                Classes="outline"
                Margin="0,4,0,0"
                HorizontalContentAlignment="Left"
                Click="OnInstallLocalZipClick"
                Content="{Binding [Extensions.Settings.InstallLocalZip], Source={x:Static loc:Loc.Instance}}"
                AutomationProperties.AutomationId="extensions-install-local-zip" />
      </Grid>
      <Border Classes="notice error" IsVisible="{Binding HasRepositoryProblem}">
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding RepositoryProblem}" />
      </Border>
      <ItemsControl ItemsSource="{Binding Repository}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="ap:RepositoryPackageViewModel">
            <Border Classes="card" Margin="0,0,0,6" Padding="8">
              <StackPanel Spacing="2">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                  <SelectableTextBlock Classes="mono" Text="{Binding Id}" />
                  <TextBlock Grid.Column="1" Classes="caption" Margin="8,0" Text="{Binding Version}" />
                  <Button Grid.Column="2"
                          Classes="outline"
                          Command="{Binding InstallCommand}"
                          Content="{Binding InstallText}"
                          AutomationProperties.AutomationId="extensions-repository-install" />
                  <Button Grid.Column="3"
                          Classes="outline"
                          Margin="4,0,0,0"
                          IsVisible="{Binding IsInstalling}"
                          Command="{Binding CancelCommand}"
                          Content="{Binding [Extensions.Settings.RepositoryCancel], Source={x:Static loc:Loc.Instance}}"
                          AutomationProperties.AutomationId="extensions-repository-cancel" />
                </Grid>
                <TextBlock Classes="caption" Text="{Binding Title}" />
                <TextBlock Classes="caption"
                           IsVisible="{Binding HasDescription}"
                           TextWrapping="Wrap"
                           Text="{Binding Description}" />
                <TextBlock Classes="caption"
                           IsVisible="{Binding IsInstalled}"
                           Text="{Binding InstalledText}" />
                <TextBlock Classes="caption"
                           IsVisible="{Binding IsInstalling}"
                           Text="{Binding ProgressText}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="caption"
                 IsVisible="{Binding ShowRepositoryEmpty}"
                 Text="{Binding [Extensions.Settings.RepositoryNoPackages], Source={x:Static loc:Loc.Instance}}" />
    </StackPanel>

    <!-- Staged drafts: each one opens the same approval card the agent would have shown. -->
    <StackPanel Spacing="4" IsVisible="{Binding ShowExtensions}">
      <TextBlock Classes="h2" Text="{Binding PendingTitle}" AutomationProperties.AutomationId="extensions-pending-title" />
      <ItemsControl ItemsSource="{Binding Pending}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="ap:PendingExtensionViewModel">
            <Border Classes="card" Margin="0,0,0,6" Padding="8">
              <StackPanel Spacing="2">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <SelectableTextBlock Classes="mono" Text="{Binding Id}" />
                  <TextBlock Grid.Column="1" Classes="caption" Margin="8,0" Text="{Binding Version}" />
                  <Button Grid.Column="2"
                          Classes="outline"
                          Command="{Binding OpenCommand}"
                          Content="{Binding [Extensions.Settings.OpenCard], Source={x:Static loc:Loc.Instance}}"
                          AutomationProperties.AutomationId="extensions-open-card" />
                </Grid>
                <TextBlock Classes="caption" Text="{Binding KindText}" />
                <SelectableTextBlock Classes="mono"
                                     IsVisible="{Binding HasDiagnostics}"
                                     TextWrapping="Wrap"
                                     Foreground="{DynamicResource StatusErrorBrush}"
                                     Text="{Binding DiagnosticsText}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="caption"
                 IsVisible="{Binding ShowPendingEmpty}"
                 Text="{Binding [Extensions.Settings.NoPending], Source={x:Static loc:Loc.Instance}}" />
    </StackPanel>

    <!-- Remembered rules, grouped by scope, each one revocable. -->
    <StackPanel Spacing="4">
      <TextBlock Classes="h2" Text="{Binding RulesTitle}" AutomationProperties.AutomationId="extensions-rules-title" />
      <ItemsControl ItemsSource="{Binding RuleGroups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="ap:RememberedRuleGroupViewModel">
            <StackPanel Spacing="2" Margin="0,0,0,6">
              <TextBlock Classes="caption" Text="{Binding Title}" />
              <ItemsControl ItemsSource="{Binding Rules}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="ap:RememberedRuleViewModel">
                    <Grid ColumnDefinitions="*,Auto">
                      <SelectableTextBlock Classes="mono"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding Text}" />
                      <Button Grid.Column="1"
                              Classes="link"
                              Command="{Binding RevokeCommand}"
                              Content="{Binding [Extensions.Settings.Revoke], Source={x:Static loc:Loc.Instance}}"
                              AutomationProperties.AutomationId="extensions-revoke" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="caption"
                 IsVisible="{Binding ShowRulesEmpty}"
                 Text="{Binding [Extensions.Settings.NoRules], Source={x:Static loc:Loc.Instance}}" />
    </StackPanel>
  </StackPanel>
</UserControl>
