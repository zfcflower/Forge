<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ap="using:Forge.App.Approval"
             xmlns:loc="using:Forge.App.Localization"
             x:Class="Forge.App.Approval.ApprovalQueueOverlay"
             x:DataType="ap:ApprovalQueueViewModel"
             Width="420"
             HorizontalAlignment="Right"
             VerticalAlignment="Bottom"
             Margin="0,0,16,16"
             IsVisible="{Binding HasItems}">

  <UserControl.DataTemplates>

    <!-- One waiting tool call: session, tool, side effect, working directory, arguments and the decision buttons. -->
    <DataTemplate DataType="ap:ToolApprovalCardViewModel" x:DataType="ap:ToolApprovalCardViewModel">
      <Border Classes="turn-card" Padding="10" Margin="0,0,0,8">
        <StackPanel Spacing="4">
          <TextBlock Classes="label"
                     Text="{Binding Title}"
                     AutomationProperties.AutomationId="approval-card-title" />
          <TextBlock Classes="caption"
                     Text="{Binding SessionTitle}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding SessionTitle}" />

          <Grid ColumnDefinitions="70,*" Margin="0,4,0,0">
            <TextBlock Classes="caption" Text="{Binding [Extensions.Tool.Name], Source={x:Static loc:Loc.Instance}}" />
            <SelectableTextBlock Grid.Column="1" Classes="mono" Text="{Binding ToolName}" TextWrapping="Wrap" />
          </Grid>
          <Grid ColumnDefinitions="70,*">
            <TextBlock Classes="caption" Text="{Binding [Extensions.Tool.SideEffect], Source={x:Static loc:Loc.Instance}}" />
            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding SideEffectText}" />
          </Grid>
          <Grid ColumnDefinitions="70,*">
            <TextBlock Classes="caption" Text="{Binding [Extensions.Tool.WorkingDirectory], Source={x:Static loc:Loc.Instance}}" />
            <TextBlock Grid.Column="1"
                       Classes="caption"
                       Text="{Binding WorkingDirectory}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding WorkingDirectory}" />
          </Grid>

          <StackPanel Spacing="2" Margin="0,4,0,0" IsVisible="{Binding HasMcpServer}">
            <Grid ColumnDefinitions="70,*">
              <TextBlock Classes="caption" Text="{Binding [Extensions.Tool.McpServer], Source={x:Static loc:Loc.Instance}}" />
              <SelectableTextBlock Grid.Column="1" Classes="mono" Text="{Binding McpServerName}" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="70,*">
              <TextBlock Classes="caption" Text="{Binding [Extensions.Tool.McpTransport], Source={x:Static loc:Loc.Instance}}" />
              <TextBlock Grid.Column="1" Classes="caption" Text="{Binding McpTransportText}" />
            </Grid>
            <Grid ColumnDefinitions="70,*" IsVisible="{Binding HasMcpCommand}">
              <TextBlock Classes="caption" Text="{Binding [Extensions.Tool.McpCommand], Source={x:Static loc:Loc.Instance}}" />
              <SelectableTextBlock Grid.Column="1" Classes="mono" Text="{Binding McpCommandLine}" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="70,*" IsVisible="{Binding HasMcpWorkingDirectory}">
              <TextBlock Classes="caption" Text="{Binding [Extensions.Tool.McpWorkingDirectory], Source={x:Static loc:Loc.Instance}}" />
              <TextBlock Grid.Column="1" Classes="caption" Text="{Binding McpWorkingDirectory}" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="70,*" IsVisible="{Binding HasMcpUrl}">
              <TextBlock Classes="caption" Text="{Binding [Extensions.Tool.McpUrl], Source={x:Static loc:Loc.Instance}}" />
              <SelectableTextBlock Grid.Column="1" Classes="mono" Text="{Binding McpUrl}" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="70,*" IsVisible="{Binding HasMcpEnvKeys}">
              <TextBlock Classes="caption" Text="{Binding [Extensions.Tool.McpEnvKeys], Source={x:Static loc:Loc.Instance}}" />
              <TextBlock Grid.Column="1" Classes="caption" Text="{Binding McpEnvKeysText}" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="70,*" IsVisible="{Binding HasMcpHeaderKeys}">
              <TextBlock Classes="caption" Text="{Binding [Extensions.Tool.McpHeaderKeys], Source={x:Static loc:Loc.Instance}}" />
              <TextBlock Grid.Column="1" Classes="caption" Text="{Binding McpHeaderKeysText}" TextWrapping="Wrap" />
            </Grid>
            <TextBlock Classes="caption"
                       IsVisible="{Binding McpHidesValues}"
                       Text="{Binding [Extensions.Tool.McpKeysOnly], Source={x:Static loc:Loc.Instance}}" />
            <Button Classes="link"
                    HorizontalAlignment="Left"
                    IsVisible="{Binding CanRevokeRemembered}"
                    Command="{Binding McpRevokeCommand}"
                    Content="{Binding RememberedRulesText}"
                    AutomationProperties.AutomationId="approval-mcp-revoke" />
          </StackPanel>

          <Border Classes="notice" IsVisible="{Binding HasNote}" Margin="0,4,0,0">
            <TextBlock Classes="caption" Text="{Binding Note}" TextWrapping="Wrap" />
          </Border>

          <TextBlock Classes="caption"
                     Margin="0,4,0,0"
                     IsVisible="{Binding IsArgumentsVisible}"
                     Text="{Binding [Extensions.Tool.Arguments], Source={x:Static loc:Loc.Instance}}" />
          <ScrollViewer MaxHeight="220"
                        IsVisible="{Binding IsArgumentsVisible}"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto">
            <SelectableTextBlock Classes="mono"
                                 Text="{Binding ArgumentsText}"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
          </ScrollViewer>
          <Button Classes="link"
                  HorizontalAlignment="Left"
                  IsVisible="{Binding IsArgumentsLong}"
                  Command="{Binding ToggleArgumentsCommand}"
                  Content="{Binding ArgumentsToggleText}"
                  AutomationProperties.AutomationId="approval-arguments-toggle"
                  AutomationProperties.Name="{Binding [Extensions.Tool.Arguments], Source={x:Static loc:Loc.Instance}}" />

          <WrapPanel Margin="0,6,0,0">
            <Button Classes="primary"
                    Margin="0,0,6,6"
                    Command="{Binding AllowCommand}"
                    Content="{Binding [Extensions.Tool.Allow], Source={x:Static loc:Loc.Instance}}"
                    AutomationProperties.AutomationId="approval-allow"
                    AutomationProperties.Name="{Binding [Extensions.Tool.Allow], Source={x:Static loc:Loc.Instance}}" />
            <Button Classes="ghost"
                    Margin="0,0,6,6"
                    Command="{Binding DenyCommand}"
                    Content="{Binding [Extensions.Tool.Deny], Source={x:Static loc:Loc.Instance}}"
                    AutomationProperties.AutomationId="approval-deny"
                    AutomationProperties.Name="{Binding [Extensions.Tool.Deny], Source={x:Static loc:Loc.Instance}}" />
          </WrapPanel>
          <WrapPanel IsVisible="{Binding CanRemember}">
            <Button Classes="ghost"
                    Margin="0,0,6,6"
                    Command="{Binding RememberSessionCommand}"
                    Content="{Binding [Extensions.Tool.RememberSession], Source={x:Static loc:Loc.Instance}}"
                    AutomationProperties.AutomationId="approval-remember-session"
                    AutomationProperties.Name="{Binding [Extensions.Tool.RememberSession], Source={x:Static loc:Loc.Instance}}" />
            <Button Classes="ghost"
                    Margin="0,0,6,6"
                    Command="{Binding RememberProjectCommand}"
                    IsEnabled="{Binding CanRememberProject}"
                    ToolTip.Tip="{Binding RememberProjectHint}"
                    Content="{Binding [Extensions.Tool.RememberProject], Source={x:Static loc:Loc.Instance}}"
                    AutomationProperties.AutomationId="approval-remember-project"
                    AutomationProperties.Name="{Binding [Extensions.Tool.RememberProject], Source={x:Static loc:Loc.Instance}}" />
            <Button Classes="ghost"
                    Margin="0,0,6,6"
                    Command="{Binding RememberGlobalCommand}"
                    Content="{Binding [Extensions.Tool.RememberGlobal], Source={x:Static loc:Loc.Instance}}"
                    AutomationProperties.AutomationId="approval-remember-global"
                    AutomationProperties.Name="{Binding [Extensions.Tool.RememberGlobal], Source={x:Static loc:Loc.Instance}}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- One ask_user question card: which agent asks, then each question with its options and optional free text. -->
    <DataTemplate DataType="ap:UserQuestionCardViewModel" x:DataType="ap:UserQuestionCardViewModel">
      <Border Classes="turn-card" Padding="10" Margin="0,0,0,8">
        <StackPanel Spacing="6">
          <TextBlock Classes="label"
                     Text="{Binding Title}"
                     AutomationProperties.AutomationId="question-card-title" />
          <TextBlock Classes="caption"
                     Text="{Binding AskedByText}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="caption"
                     Text="{Binding SessionTitle}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding SessionTitle}" />
          <ItemsControl ItemsSource="{Binding Questions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="ap:QuestionItemViewModel">
                <StackPanel Spacing="4" Margin="0,6,0,0">
                  <Border Classes="notice" HorizontalAlignment="Left" Padding="6,1">
                    <TextBlock Classes="caption" Text="{Binding Header}" />
                  </Border>
                  <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" />
                  <TextBlock Classes="caption"
                             IsVisible="{Binding MultiSelect}"
                             Text="{Binding BoundsHint}" />
                  <ToggleButton Classes="ghost"
                                HorizontalAlignment="Left"
                                IsChecked="{Binding IsSkipped, Mode=TwoWay}"
                                Content="{Binding [questions.card.skip], Source={x:Static loc:Loc.Instance}}"
                                AutomationProperties.AutomationId="question-skip" />
                  <ItemsControl ItemsSource="{Binding Options}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="ap:QuestionOptionViewModel">
                        <StackPanel Margin="0,2,0,0">
                          <RadioButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                       IsEnabled="{Binding IsEnabled}"
                                       Content="{Binding Label}"
                                       IsVisible="{Binding IsSingle}" />
                          <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                    IsEnabled="{Binding IsEnabled}"
                                    Content="{Binding Label}"
                                    IsVisible="{Binding IsMulti}" />
                          <TextBlock Classes="caption"
                                     Margin="28,0,0,0"
                                     IsVisible="{Binding HasDescription}"
                                     Text="{Binding Description}"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBox IsVisible="{Binding AllowFreeText}"
                           IsEnabled="{Binding IsFreeTextEnabled}"
                           Text="{Binding FreeText, Mode=TwoWay}"
                           AcceptsReturn="False"
                           PlaceholderText="{Binding [questions.card.freeText], Source={x:Static loc:Loc.Instance}}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="caption"
                     IsVisible="{Binding AllSkipped}"
                     Text="{Binding AllSkippedHint}"
                     TextWrapping="Wrap" />
          <TextBlock Classes="caption"
                     IsVisible="{Binding HasWaiting}"
                     Text="{Binding WaitingText}"
                     AutomationProperties.AutomationId="question-waiting" />
          <WrapPanel Margin="0,6,0,0">
            <Button Classes="primary"
                    Margin="0,0,6,6"
                    Command="{Binding SubmitCommand}"
                    Content="{Binding [questions.card.submit], Source={x:Static loc:Loc.Instance}}"
                    AutomationProperties.AutomationId="question-submit"
                    AutomationProperties.Name="{Binding [questions.card.submit], Source={x:Static loc:Loc.Instance}}" />
            <Button Classes="ghost"
                    Margin="0,0,6,6"
                    Command="{Binding DismissCommand}"
                    Content="{Binding [questions.card.dismiss], Source={x:Static loc:Loc.Instance}}"
                    AutomationProperties.AutomationId="question-dismiss"
                    AutomationProperties.Name="{Binding [questions.card.dismiss], Source={x:Static loc:Loc.Instance}}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- One staged extension: full text of a new draft, per-file diff of an update, permissions, dependencies and hashes. -->
    <DataTemplate DataType="ap:ExtensionApprovalCardViewModel" x:DataType="ap:ExtensionApprovalCardViewModel">
      <Border Classes="turn-card" Padding="10" Margin="0,0,0,8">
        <StackPanel Spacing="3">
          <TextBlock Classes="label"
                     Text="{Binding Title}"
                     AutomationProperties.AutomationId="approval-extension-title" />
          <TextBlock Classes="caption"
                     IsVisible="{Binding HasSession}"
                     Text="{Binding SessionTitle}"
                     TextTrimming="CharacterEllipsis" />

          <Grid ColumnDefinitions="70,*" Margin="0,4,0,0">
            <TextBlock Classes="caption" Text="{Binding [Extensions.Extension.Id], Source={x:Static loc:Loc.Instance}}" />
            <SelectableTextBlock Grid.Column="1" Classes="mono" Text="{Binding PluginId}" TextWrapping="Wrap" />
          </Grid>
          <Grid ColumnDefinitions="70,*">
            <TextBlock Classes="caption" Text="{Binding [Extensions.Extension.Version], Source={x:Static loc:Loc.Instance}}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="mono" Text="{Binding Version}" />
              <TextBlock Classes="caption"
                         IsVisible="{Binding HasLiveVersion}"
                         Text="{Binding LiveVersion, StringFormat='← {0}'}" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="70,*">
            <TextBlock Classes="caption" Text="{Binding [Extensions.Extension.Kind], Source={x:Static loc:Loc.Instance}}" />
            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding KindText}" />
          </Grid>
          <Grid ColumnDefinitions="70,*">
            <TextBlock Classes="caption" Text="{Binding [Extensions.Extension.Permissions], Source={x:Static loc:Loc.Instance}}" />
            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding PermissionsText}" TextWrapping="Wrap" />
          </Grid>
          <Grid ColumnDefinitions="70,*">
            <TextBlock Classes="caption" Text="{Binding [Extensions.Extension.Dependencies], Source={x:Static loc:Loc.Instance}}" />
            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding DependenciesText}" TextWrapping="Wrap" />
          </Grid>

          <Grid ColumnDefinitions="70,*" IsVisible="{Binding HasTool}">
            <TextBlock Classes="caption" Text="{Binding [Extensions.Extension.Tool], Source={x:Static loc:Loc.Instance}}" />
            <StackPanel Grid.Column="1" Spacing="2">
              <SelectableTextBlock Classes="mono" Text="{Binding ToolName}" TextWrapping="Wrap" />
              <TextBlock Classes="caption" Text="{Binding ToolDescription}" TextWrapping="Wrap" />
              <SelectableTextBlock Classes="mono" Text="{Binding ToolSchema}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="70,*">
            <TextBlock Classes="caption" Text="{Binding [Extensions.Extension.SourceHash], Source={x:Static loc:Loc.Instance}}" />
            <SelectableTextBlock Grid.Column="1" Classes="mono" Text="{Binding SourceHash}" TextWrapping="Wrap" />
          </Grid>
          <Grid ColumnDefinitions="70,*">
            <TextBlock Classes="caption" Text="{Binding [Extensions.Extension.DependencyHash], Source={x:Static loc:Loc.Instance}}" />
            <SelectableTextBlock Grid.Column="1" Classes="mono" Text="{Binding DependencyHash}" TextWrapping="Wrap" />
          </Grid>
          <Grid ColumnDefinitions="70,*">
            <TextBlock Classes="caption" Text="{Binding [Extensions.Extension.SdkVersion], Source={x:Static loc:Loc.Instance}}" />
            <SelectableTextBlock Grid.Column="1" Classes="mono" Text="{Binding SdkVersion}" TextWrapping="Wrap" />
          </Grid>

          <Border Classes="divider" Margin="0,6,0,2" />
          <TextBlock Classes="caption" Text="{Binding [Extensions.Extension.Files], Source={x:Static loc:Loc.Instance}}" />
          <TextBlock Classes="caption"
                     IsVisible="{Binding !IsDiffReady}"
                     Text="{Binding [Extensions.Extension.BuildingDiff], Source={x:Static loc:Loc.Instance}}" />
          <ItemsControl ItemsSource="{Binding Files}" IsVisible="{Binding IsDiffReady}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="ap:ExtensionFileViewModel">
                <StackPanel Spacing="2" Margin="0,2,0,4">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Classes="caption" Text="{Binding Badge}" Margin="0,0,6,0" />
                    <SelectableTextBlock Grid.Column="1" Classes="mono" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasRows}">
                      <TextBlock Classes="caption" Text="{Binding AddedLines}" Foreground="{DynamicResource SuccessBrush}" />
                      <TextBlock Classes="caption" Text="{Binding RemovedLines}" Foreground="{DynamicResource DangerBrush}" />
                    </StackPanel>
                  </Grid>

                  <!-- A new file: the whole text. -->
                  <ScrollViewer MaxHeight="180"
                                IsVisible="{Binding IsNew}"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Auto">
                    <SelectableTextBlock Classes="mono"
                                         Text="{Binding FullText}"
                                         Foreground="{DynamicResource TextSecondaryBrush}" />
                  </ScrollViewer>

                  <!-- An updated file: one flat, virtualized diff row list. -->
                  <ScrollViewer MaxHeight="180"
                                IsVisible="{Binding HasRows}"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="ap:ExtensionDiffRowViewModel">
                          <Border Classes="diff-line"
                                  Classes.add="{Binding IsAdd}"
                                  Classes.del="{Binding IsRemove}"
                                  Classes.hunk="{Binding IsHunk}">
                            <Grid ColumnDefinitions="40,40,Auto,*" Height="17">
                              <TextBlock Classes="mono"
                                         Text="{Binding OldNumber}"
                                         TextAlignment="Right"
                                         Margin="0,0,4,0"
                                         Foreground="{DynamicResource TextMutedBrush}" />
                              <TextBlock Grid.Column="1"
                                         Classes="mono"
                                         Text="{Binding NewNumber}"
                                         TextAlignment="Right"
                                         Margin="0,0,4,0"
                                         Foreground="{DynamicResource TextMutedBrush}" />
                              <TextBlock Grid.Column="2"
                                         Classes="mono"
                                         Text="{Binding Prefix}"
                                         Foreground="{DynamicResource TextMutedBrush}" />
                              <TextBlock Grid.Column="3"
                                         Classes="mono"
                                         Text="{Binding Text}"
                                         Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="caption"
                     IsVisible="{Binding HasNoFileChanges}"
                     Text="{Binding [Extensions.Extension.NoFileChanges], Source={x:Static loc:Loc.Instance}}" />

          <StackPanel IsVisible="{Binding HasDiagnostics}" Spacing="2" Margin="0,4,0,0">
            <TextBlock Classes="caption" Text="{Binding [Extensions.Extension.Diagnostics], Source={x:Static loc:Loc.Instance}}" />
            <SelectableTextBlock Classes="mono"
                                 Text="{Binding DiagnosticsText}"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource DangerBrush}" />
          </StackPanel>

          <TextBlock Classes="caption"
                     Margin="0,6,0,0"
                     TextWrapping="Wrap"
                     Text="{Binding [Extensions.Extension.ApproveNote], Source={x:Static loc:Loc.Instance}}" />
          <WrapPanel Margin="0,6,0,0">
            <Button Classes="primary"
                    Margin="0,0,6,6"
                    IsEnabled="{Binding CanApprove}"
                    Command="{Binding ApproveCommand}"
                    Content="{Binding [Extensions.Extension.Approve], Source={x:Static loc:Loc.Instance}}"
                    AutomationProperties.AutomationId="approval-extension-approve"
                    AutomationProperties.Name="{Binding [Extensions.Extension.Approve], Source={x:Static loc:Loc.Instance}}" />
            <Button Classes="ghost"
                    Margin="0,0,6,6"
                    Command="{Binding RejectCommand}"
                    Content="{Binding [Extensions.Extension.Reject], Source={x:Static loc:Loc.Instance}}"
                    AutomationProperties.AutomationId="approval-extension-reject"
                    AutomationProperties.Name="{Binding [Extensions.Extension.Reject], Source={x:Static loc:Loc.Instance}}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Border Background="{DynamicResource SurfaceElevatedBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource RadiusMd}"
          BoxShadow="{StaticResource ShadowMd}">
    <Grid RowDefinitions="Auto,Auto">
      <Button Classes="link"
              Padding="10,6"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
              Command="{Binding ToggleCommand}"
              AutomationProperties.AutomationId="approval-queue-toggle"
              AutomationProperties.Name="{Binding [Extensions.Queue.Title], Source={x:Static loc:Loc.Instance}}">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
          <TextBlock Classes="h2"
                     VerticalAlignment="Center"
                     Text="{Binding [Extensions.Queue.Title], Source={x:Static loc:Loc.Instance}}" />
          <Border Grid.Column="1"
                  Margin="6,0,0,0"
                  Padding="5,0"
                  MinWidth="18"
                  CornerRadius="{StaticResource RadiusSm}"
                  Background="{DynamicResource AccentSubtleBrush}"
                  VerticalAlignment="Center">
            <TextBlock Classes="caption"
                       Text="{Binding CountText}"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource AccentTextBrush}" />
          </Border>
          <TextBlock Grid.Column="3"
                     Classes="caption"
                     VerticalAlignment="Center"
                     Text="{Binding ToggleText}" />
        </Grid>
      </Button>

      <ScrollViewer Grid.Row="1"
                    IsVisible="{Binding IsExpanded}"
                    MaxHeight="560"
                    Padding="8,0,8,8"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Items}" />
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
