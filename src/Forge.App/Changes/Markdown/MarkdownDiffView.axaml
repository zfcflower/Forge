<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Forge.App.Changes.Markdown.MarkdownDiffView">
  <!-- Rendered Markdown preview of one file's diff. The Markdown presentation itself (md-text, md-h1..h6, lists, quotes,
       code, tables) is shared with the plan panel and lives in Resources/MarkdownStyles.axaml; what stays here is what frames
       a diff: the change bars, the fold rows and the gap markers. -->
  <UserControl.Styles>
    <StyleInclude Source="avares://Forge.App/Resources/MarkdownStyles.axaml" />
    <Style Selector="Border.md-block">
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="12,4,8,4" />
    </Style>
    <Style Selector="Border.md-block.md-changed">
      <Setter Property="Background" Value="{DynamicResource DiffAddBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="Border.md-block.md-deleted">
      <Setter Property="Background" Value="{DynamicResource DiffRemoveBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Button.md-fold">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="12,3" />
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
    </Style>
    <Style Selector="Border.md-gap">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="Padding" Value="12,3" />
    </Style>
    <Style Selector="Border.md-gap TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
    </Style>
  </UserControl.Styles>
  <StackPanel x:Name="Root" />
</UserControl>
